# PROOVRA — independent Bitcoin verification of OpenTimestamps proofs.
# WORKER-ONLY configuration. On the server this file is
#
#   /opt/proovra/app/secrets/bitcoin-rpc/verifier.env      (owner root, mode 0400)
#
# beside the RPC password file `password` in the same directory, which
# docker-compose.prod.yml mounts read-only into proovra-worker only and loads
# as the worker's second env_file. It must NOT be copied into the shared
# /opt/proovra/app/.env: every key of that file reaches the API container too,
# and the API and scripts/deploy-prod-pull.sh refuse any OTS_BITCOIN_* there.
#
# NO PASSWORD IN THIS FILE. The worker reads the RPC password only from
# /run/proovra/bitcoin-rpc/password (OTS_BITCOIN_RPC_PASSWORD_FILE, set by the
# compose file); in production it refuses a password from the environment.
#
# Verification stays OFF until the node has finished Initial Block Download
# and the operator sets OTS_BITCOIN_VERIFY_ENABLED=true. A misconfiguration
# makes every check UNAVAILABLE — never verified.

OTS_BITCOIN_VERIFY_ENABLED=false
# The node's PRIVATE-network JSON-RPC endpoint (http on the private network,
# no credentials in the URL), e.g. http://<node-private-address>:8332
OTS_BITCOIN_RPC_URL=http://<node-private-address>:8332
OTS_BITCOIN_RPC_USERNAME=<rpcauth-user>
OTS_BITCOIN_EXPECTED_CHAIN=main
OTS_BITCOIN_RPC_TIMEOUT_MS=5000
OTS_BITCOIN_MIN_CONFIRMATIONS=6
OTS_BITCOIN_MAX_TIP_AGE_SECONDS=7200
OTS_BITCOIN_MAX_HEADER_LAG=2
OTS_BITCOIN_MIN_NODE_VERSION=270000
