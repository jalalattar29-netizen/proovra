{
  "uid": "proovra-c2pa",
  "title": "PROOVRA — C2PA",
  "description": "Phase O1.6 — C2PA detect / validate / package summary. Bounded spans only.",
  "tags": ["proovra", "c2pa", "o1.6"],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "C2PA operations throughput (5m rate)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.detect\"}[5m]))", "legendFormat": "detect" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.validate\"}[5m]))", "legendFormat": "validate" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.package_summary\"}[5m]))", "legendFormat": "package_summary" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "C2PA validate p95/p99 latency (ms)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{span_name=\"proovra.c2pa.validate\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{span_name=\"proovra.c2pa.validate\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "C2PA validate failure rate (5m)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.validate\",status_code=\"STATUS_CODE_ERROR\"}[5m]))", "legendFormat": "validate errors" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.detect\",status_code=\"STATUS_CODE_ERROR\"}[5m]))", "legendFormat": "detect errors" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "C2PA validate success ratio (1h)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "1 - (sum(increase(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.validate\",status_code=\"STATUS_CODE_ERROR\"}[1h])) / clamp_min(sum(increase(traces_spanmetrics_calls_total{span_name=\"proovra.c2pa.validate\"}[1h])), 1))", "legendFormat": "validate success" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    }
  ]
}
