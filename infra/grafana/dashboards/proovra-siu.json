{
  "uid": "proovra-siu",
  "title": "PROOVRA — SIU",
  "description": "Phase O1.6 — SIU export preflight / generate + followup request + timeline build. Bounded spans only.",
  "tags": ["proovra", "siu", "o1.6"],
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SIU export throughput (5m rate)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.siu.export.preflight\"}[5m]))", "legendFormat": "export.preflight" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.siu.export.generate\"}[5m]))", "legendFormat": "export.generate" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SIU followup + timeline throughput (5m rate)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.siu.followup.request\"}[5m]))", "legendFormat": "followup.request" },
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=\"proovra.siu.timeline.build\"}[5m]))", "legendFormat": "timeline.build" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SIU export generate p95/p99 latency (ms)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{span_name=\"proovra.siu.export.generate\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{span_name=\"proovra.siu.export.generate\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SIU failure rate (status=error, 5m)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "sum(rate(traces_spanmetrics_calls_total{span_name=~\"proovra.siu..*\",status_code=\"STATUS_CODE_ERROR\"}[5m]))", "legendFormat": "siu errors" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SIU export success ratio (1h)",
      "datasource": "prometheus",
      "targets": [
        { "expr": "1 - (sum(increase(traces_spanmetrics_calls_total{span_name=~\"proovra.siu.export..*\",status_code=\"STATUS_CODE_ERROR\"}[1h])) / clamp_min(sum(increase(traces_spanmetrics_calls_total{span_name=~\"proovra.siu.export..*\"}[1h])), 1))", "legendFormat": "export success" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    }
  ]
}
