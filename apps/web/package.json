{
  "name": "proovra-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm run build:deps",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ./scripts/run-tests.mjs",
    "test:render": "vitest run --config vitest.render.config.ts",
    "build:deps": "pnpm --filter @proovra/shared build && pnpm --filter @proovra/shared-billing build && pnpm --filter @proovra/shared-evidence-presentation build && pnpm --filter @proovra/ui build",
    "pretypecheck": "pnpm run build:deps"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@proovra/shared": "workspace:*",
    "@proovra/shared-evidence-presentation": "workspace:*",
    "@proovra/ui": "workspace:*",
    "@sentry/browser": "^10.38.0",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "next": "^15.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "vanilla-cookieconsent": "^3.1.0",
    "@proovra/shared-billing": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
