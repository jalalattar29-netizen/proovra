NEXT_PUBLIC_API_BASE=https://api.proovra.com
NEXT_PUBLIC_WEB_BASE=https://www.proovra.com
NEXT_PUBLIC_APP_BASE=https://app.proovra.com
NEXT_PUBLIC_VERIFY_DEMO_TOKEN=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://www.proovra.com/auth/callback
NEXT_PUBLIC_APPLE_CLIENT_ID=com.proovra.web
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://www.proovra.com/auth/callback
NEXT_PUBLIC_SENTRY_DSN=
# Direct Web Capture — the published browser-extension store listing (https,
# Chrome Web Store / Edge Add-ons). Inlined at BUILD time. Unset (the default),
# the /capture page shows the extension as not yet available and offers no
# install button; a relative or non-https value is ignored.
NEXT_PUBLIC_EXTENSION_INSTALL_URL=

# Recorded-location map tiles (AUD-025). Leave BLANK unless the deployment runs
# its OWN approved tile server: the tile x/y/z are the evidence location, so a
# public provider (OpenStreetMap, Google, Mapbox, ...) is refused even if set.
# Blank: Evidence / Public Verify show the "Recorded location" card without a
# map preview. The origin is added to the CSP img-src automatically.
# Example: https://tiles.internal.example/{z}/{x}/{y}.png
NEXT_PUBLIC_CAPTURE_LOCATION_TILE_URL=
