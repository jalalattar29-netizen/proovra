{
  "manifest_version": 3,
  "name": "PROOVRA Direct Web Capture",
  "version": "1.0.0",
  "description": "Capture a web page in your browser and preserve it in PROOVRA. PROOVRA records what the extension captured and when it received it — not that the page content is true.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Preserve with PROOVRA",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
