# PROOVRA mobile — the variables the CODE actually reads.
#
# Every name below appears in `process.env.EXPO_PUBLIC_*` somewhere in
# `apps/mobile/src` or `apps/mobile/app`. Nothing else does, and nothing the
# code reads is missing — `scripts/check-env-example.mjs` fails the build if
# the two ever drift again.
#
# WHY THAT MATTERS, measured 2026-09-24: this file used to document
# `EXPO_PUBLIC_GOOGLE_CLIENT_ID`, a name nothing has read since the move to
# per-platform Google client ids. A developer who copied it got a `.env` with
# no `EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID`, so `iosClientId` was `undefined` at
# runtime and Google sign-in failed on a real iPad with a configuration error
# that named none of this.
#
# EXPO_PUBLIC_* is INLINED INTO THE BUNDLE at build time. Nothing here is a
# secret; treat every value as published.

# --- API and web origins ----------------------------------------------------
EXPO_PUBLIC_API_BASE=https://api.proovra.com

# The public web origin intake links live on (T-16). Native builds the
# one-time link as ${EXPO_PUBLIC_WEB_BASE}/intake/<token> and sends it as the
# API's intakeUrlBase. All four eas.json profiles set https://www.proovra.com.
# Absent, native refuses to create a link rather than address it wrongly.
EXPO_PUBLIC_WEB_BASE=https://www.proovra.com

# --- Google sign-in ---------------------------------------------------------
# THREE ids, one per platform, not one generic id.
#
# expo-auth-session derives the native redirect from these: iOS uses the
# reversed-client-id URL scheme, Android binds to the package plus signing
# certificate. The WEB id sets the id_token audience the API verifies, so it is
# required even on a phone.
#
# The iOS id must ALSO be registered as a URL scheme in `app.json`
# (`ios.infoPlist.CFBundleURLTypes`), reversed — that part is native
# configuration and needs a new build, not a Metro reload.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Observability ----------------------------------------------------------
# Optional. Absent means Sentry stays off, which is a supported state.
EXPO_PUBLIC_SENTRY_DSN=

# --- Build identity ---------------------------------------------------------
# Optional, used for tagging. Absent is supported.
EXPO_PUBLIC_ENV=
EXPO_PUBLIC_RELEASE=

# --- Private-distribution checkout -----------------------------------------
# External (Stripe/PayPal) checkout is offered ONLY when BOTH are set exactly as
# below (src/product/billing-purchase.ts externalCheckoutEnabled()). Anything
# else — including leaving them blank, the default here — fails closed and the
# app offers no purchase. Public store builds must leave them blank; the
# private EAS profile sets them in eas.json.
EXPO_PUBLIC_DISTRIBUTION=
EXPO_PUBLIC_PRIVATE_BILLING=
