{
  "expo": {
    "name": "Proovra",
    "slug": "proovra",
    "scheme": "proovra",
    "sdkVersion": "52.0.0",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "extra": {
      "eas": {
        "projectId": "38174f3f-4bfa-4437-9b58-a72c4ca73c8f",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ProovraBroadcast",
                  "bundleIdentifier": "com.jalalattar29.proovra.broadcast",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jalalattar29.proovra"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.jalalattar29.proovra",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/icon.png",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jalalattar29.proovra"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "PROOVRA uses the camera only when you capture a photo or video as evidence.",
        "NSMicrophoneUsageDescription": "PROOVRA uses the microphone only when you record audio or video as evidence.",
        "NSPhotoLibraryUsageDescription": "PROOVRA reads your photo library only when you choose an existing photo or video to submit as evidence.",
        "NSLocationWhenInUseUsageDescription": "PROOVRA can attach your location to evidence you capture, only when you consent at capture time.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "proovra"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.548168595768-uhugauso4ep7n9auc4rh8jbihmv971tm"
            ]
          }
        ]
      },
      "associatedDomains": [
        "applinks:www.proovra.com",
        "applinks:proovra.com"
      ]
    },
    "android": {
      "package": "com.jalalattar29.proovra",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F172A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/intake"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/portal"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/legal"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/org-invites"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "www.proovra.com",
              "pathPrefix": "/auth/mfa-recovery"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/intake"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/portal"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/legal"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/org-invites"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/auth/verify-email"
            },
            {
              "scheme": "https",
              "host": "proovra.com",
              "pathPrefix": "/auth/mfa-recovery"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-apple-authentication",
      "@sentry/react-native/expo",
      "./plugins/withProovraIosScreenBroadcast.cjs",
      "expo-audio"
    ]
  }
}
