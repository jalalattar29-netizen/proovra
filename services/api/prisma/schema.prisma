// =============================================================================
// Wave 2 — Duplicate / Similarity / Lineage decisions.
//
// Persists reviewer decisions on graph duplicate-class edges (SAME_HASH_AS,
// SIMILAR_TO, POSSIBLE_DERIVATIVE_OF) without touching the edges themselves.
// One decision per (team, edge). Bounded reason note. No FK on edgeId or
// decidedByUserId — application-level integrity. The migration adds CHECK
// constraints on edgeType + decision to keep the vocabulary closed.
// =============================================================================
model DuplicateDecision {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  edgeId          String   @map("edge_id") @db.Uuid
