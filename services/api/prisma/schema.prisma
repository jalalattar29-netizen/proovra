model ExternalReviewGrant {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                 String    @map("team_id") @db.Uuid
  scopeKind              String    @map("scope_kind") @db.VarChar(24)
  evidenceId             String?   @map("evidence_id") @db.Uuid
  caseId                 String?   @map("case_id") @db.Uuid
  packageId              String?   @map("package_id") @db.Uuid
  tokenHash              String    @unique(map: "external_review_grants_token_hash_uk") @map("token_hash") @db.VarChar(128)

  /**
   * PHASE 12 CORRECTIVE PASS §2/§3 (INV-001 + NEW-004) — WHICH TOKEN THIS IS.
   *
   * Rotation overwrites `token_hash` in place, which is correct for
   * authentication — the predecessor stops working the instant the row
   * changes. But it left NOTHING durable saying that the CONTENT of the
   * invitation had changed, and the delivery layer needs exactly that: a
   * message carrying the superseded link and a message carrying its successor
   * are different messages to a human, and must not collapse onto one
   * provider idempotency key.
   *
   * Starts at 1 and increments on every rotation. It is not a secret and it
   * is not a credential: it names WHICH generation of the link a delivery
   * carried, and nothing about the link itself.
   */
  tokenVersion           Int       @default(1) @map("token_version")
  reviewerEmail          String    @map("reviewer_email") @db.VarChar(320)
  reviewerDisplayName    String?   @map("reviewer_display_name") @db.VarChar(200)
  state                  String    @default("INVITED") @db.VarChar(24)
  invitedByUserId        String    @map("invited_by_user_id") @db.Uuid
  approvedByUserId       String?   @map("approved_by_user_id") @db.Uuid
  revokedByUserId        String?   @map("revoked_by_user_id") @db.Uuid
  expiresAtUtc           DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  acceptedAtUtc          DateTime? @map("accepted_at_utc") @db.Timestamptz(6)
  revokedAtUtc           DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  lastAccessedAtUtc      DateTime? @map("last_accessed_at_utc") @db.Timestamptz(6)
  accessCount            Int       @default(0) @map("access_count")
  allowOriginalDownload  Boolean   @default(false) @map("allow_original_download")
  allowPackageDownload   Boolean   @default(true) @map("allow_package_download")
  redactionPolicyVersion String?   @map("redaction_policy_version") @db.VarChar(32)
  safeNote               String?   @map("safe_note") @db.VarChar(500)
  createdAtUtc           DateTime  @default(now()) @map("created_at_utc") @db.Timestamptz(6)
  updatedAtUtc           DateTime  @default(now()) @map("updated_at_utc") @db.Timestamptz(6)

  roleAssignment ExternalReviewerRoleAssignment?

  @@index([teamId, reviewerEmail], map: "external_review_grants_team_reviewer_idx")
  @@index([teamId, state, expiresAtUtc(sort: Desc)], map: "external_review_grants_team_state_expires_idx")
  @@map("external_review_grants")
}

