  approvedAtUtc    DateTime? @map("approved_at_utc") @db.Timestamptz(6)
  supersededAtUtc  DateTime? @map("superseded_at_utc") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
