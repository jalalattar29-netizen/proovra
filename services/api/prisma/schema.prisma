generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Evidence {
  departmentId                     String?             @map("department_id") @db.Uuid
  id                               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                            String?             @db.VarChar(160)
  internalNotes                    String?             @map("internal_notes")
  intakePlanJson                   Json?               @map("intake_plan_json")
  type                             EvidenceType
  status                           EvidenceStatus      @default(CREATED)
  verificationStatus               VerificationStatus? @map("verification_status")
  ownerUserId                      String              @map("owner_user_id")
  organizationId                   String?             @map("organization_id") @db.Uuid
  mimeType                         String?             @map("mime_type") @db.VarChar(128)
  sizeBytes                        BigInt?             @map("size_bytes")
  durationSec                      Float?              @map("duration_sec")
  fileSha256                       String?             @map("file_sha256") @db.VarChar(64)
  storageBucket                    String?             @map("storage_bucket") @db.VarChar(255)
  storageKey                       String?             @map("storage_key") @db.VarChar(512)
  storageRegion                    String?             @map("storage_region") @db.VarChar(64)
  storageObjectLockMode            String?             @map("storage_object_lock_mode") @db.VarChar(32)
  storageObjectLockRetainUntilUtc  DateTime?           @map("storage_object_lock_retain_until_utc") @db.Timestamptz(6)
  storageObjectLockLegalHoldStatus String?             @map("storage_object_lock_legal_hold_status") @db.VarChar(16)
  originalFileName                 String?             @map("original_file_name") @db.VarChar(255)
  displayFileName                  String?             @map("display_file_name") @db.VarChar(255)

  captureMethod                  CaptureMethod?      @map("capture_method")
  identityLevelSnapshot          IdentityLevel?      @map("identity_level_snapshot")
  submittedByEmail               String?             @map("submitted_by_email") @db.VarChar(320)
  submittedByAuthProvider        AuthProvider?       @map("submitted_by_auth_provider")
  submittedByUserId              String?             @map("submitted_by_user_id") @db.Uuid
  createdByUserId                String?             @map("created_by_user_id") @db.Uuid
  uploadedByUserId               String?             @map("uploaded_by_user_id") @db.Uuid
  lastAccessedByUserId           String?             @map("last_accessed_by_user_id") @db.Uuid
  lastAccessedAtUtc              DateTime?           @map("last_accessed_at_utc") @db.Timestamptz(6)
  workspaceNameSnapshot          String?             @map("workspace_name_snapshot") @db.VarChar(180)
  organizationNameSnapshot       String?             @map("organization_name_snapshot") @db.VarChar(180)
  organizationVerifiedSnapshot   Boolean?            @map("organization_verified_snapshot")
  recordedIntegrityVerifiedAtUtc DateTime?           @map("recorded_integrity_verified_at_utc") @db.Timestamptz(6)
  // Reserved for MEANINGFUL technical verifications (report generation, an
  // explicit reviewer technical-verification action). Not bumped by anonymous
  // public verify-page page views — those are tracked separately on
  // lastPublicVerifyViewAtUtc to keep analytics out of the forensic surface.
  lastVerifiedAtUtc              DateTime?           @map("last_verified_at_utc") @db.Timestamptz(6)
  lastVerifiedSource             VerificationSource? @map("last_verified_source")
  // Analytics-only timestamp of the last anonymous /public/verify hit. Updating
  // this does NOT imply a meaningful technical verification by a reviewer.
  lastPublicVerifyViewAtUtc      DateTime?           @map("last_public_verify_view_at_utc") @db.Timestamptz(6)

  // Phase C #4 — explicit multipart hash semantics.
  // For multipart packages: SHA-256 of a canonical newline-joined list of
  // per-part SHA-256 hex digests in part-index order. Reviewers can recompute
  // this independently from the per-part hashes in the verification package's
  // package-checksums.json. For single-file evidence this column is null and
  // fileSha256 is the SHA-256 of the original file.
  multipartManifestSha256           String?   @map("multipart_manifest_sha256") @db.VarChar(64)
  // Hash semantics indicator so old records render safely. One of:
  //   "single_file"          — fileSha256 IS the original-file SHA-256.
  //   "multipart_composite"  — fileSha256 is the synthetic composite of
  //                            per-part hashes; multipartManifestSha256 is set.
  //   null                   — pre-Phase-C records; readers must infer from
  //                            evidenceParts count.
  hashSemantics                     String?   @map("hash_semantics") @db.VarChar(32)
  verificationPackageGeneratedAtUtc DateTime? @map("verification_package_generated_at_utc") @db.Timestamptz(6)
  verificationPackageVersion        Int?      @map("verification_package_version")
  verificationPackageMetadata       Json?     @map("verification_package_metadata")
  latestReportVersion               Int?      @map("latest_report_version")
  reviewReadyAtUtc                  DateTime? @map("review_ready_at_utc") @db.Timestamptz(6)
  reviewerSummaryVersion            Int?      @map("reviewer_summary_version")

  // Enterprise Technical Metadata layer (additive, nullable).
  //   technicalMetadata  — denormalized Layer-1 deterministic file facts
  //                        for SINGLE-file evidence. Canonical per-part
  //                        copies live on EvidencePart.technicalMetadata;
  //                        this mirror is a convenience for the common
  //                        single-part case so readers don't need a join.
  //                        Shape: TechnicalMetadata (see
  //                        @proovra/shared-runtime/technical-metadata).
  //   captureEnvironment — privacy-safe PROOVRA upload/capture environment
  //                        (browser/OS/device/timezone/locale + UA HASH and
  //                        masked IP only — NEVER raw UA or raw IP). Shape:
  //                        CaptureEnvironment (same module). This describes
  //                        the environment the material entered PROOVRA in;
  //                        it is NOT the file's embedded EXIF metadata and
  //                        NOT the preservation (OTS/RFC3161) state.
  technicalMetadata  Json? @map("technical_metadata")
  captureEnvironment Json? @map("capture_environment")

  lat                      Float?
  lng                      Float?
  accuracyMeters           Float?    @map("accuracy_meters")
  // Provenance of (lat, lng, accuracyMeters). Stored as text so a
  // future source (e.g. EXIF_GPS once that pipeline lands) doesn't
  // need a migration. Canonical values mirror EvidenceLocationSource
  // in @proovra/shared:
  //   CAPTURE_BROWSER_GEOLOCATION — recorded during an authenticated
  //                                 Capture session (PROOVRA-app
  //                                 user). Display label: "PROOVRA
  //                                 secure capture".
  //   INTAKE_LINK_GEOLOCATION     — recorded by the public intake
  //                                 contributor's browser during the
  //                                 upload session. Display label:
  //                                 "Contributor browser permission".
  //   EXIF_GPS                    — reserved for the future EXIF-GPS
  //                                 extraction pipeline.
  //   MANUAL_ENTRY                — reserved for operator override.
  // Backfill (migration 20270825000000_evidence_location_source):
  // every existing row with a non-null lat is stamped
  // CAPTURE_BROWSER_GEOLOCATION (the only source that ever wrote
  // coordinates pre-intake-link-location). Rows without coordinates
  // are left NULL.
  locationSource           String?   @map("location_source") @db.VarChar(40)
  capturedAtUtc            DateTime? @map("captured_at_utc") @db.Timestamptz(6)
  uploadedAtUtc            DateTime? @map("uploaded_at_utc") @db.Timestamptz(6)
  signedAtUtc              DateTime? @map("signed_at_utc") @db.Timestamptz(6)
  reportGeneratedAtUtc     DateTime? @map("report_generated_at_utc") @db.Timestamptz(6)
  fingerprintCanonicalJson String?   @map("fingerprint_canonical_json")
  fingerprintHash          String?   @map("fingerprint_hash") @db.VarChar(64)
  signatureBase64          String?   @map("signature_base64") @db.VarChar(4096)
  signingKeyId             String?   @map("signing_key_id") @db.VarChar(64)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAtUtc             DateTime? @map("deleted_at_utc") @db.Timestamptz(6)
  deletedByUserId          String?   @map("deleted_by_user_id") @db.Uuid
  deleteScheduledForUtc    DateTime? @map("delete_scheduled_for_utc") @db.Timestamptz(6)
  retentionUntilUtc        DateTime? @map("retention_until_utc") @db.Timestamptz(6)
  deviceTimeIso            String?   @map("device_time_iso") @db.VarChar(64)
  signingKeyVersion        Int?      @map("signing_key_version")
  teamId                   String?   @map("team_id") @db.Uuid
  guestIdentityId          String?   @map("guest_identity_id") @db.Uuid
  lockedAt                 DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedByUserId           String?   @map("locked_by_user_id") @db.Uuid
  archivedAt               DateTime? @map("archived_at") @db.Timestamptz(6)

  // Phase 14 — explicit public-verify publication state. Default
  // PUBLISHED preserves pre-Phase-14 behavior exactly. UNPUBLISHED /
  // SUSPENDED return 404 from the public verify route; NOT_PUBLISHED
  // is the safe pre-state for governance-required workflows.
  publicVerifyState             PublicVerifyState @default(PUBLISHED) @map("public_verify_state")
  publicVerifyPublishedAtUtc    DateTime?         @map("public_verify_published_at_utc") @db.Timestamptz(6)
  publicVerifyPublishedByUserId String?           @map("public_verify_published_by_user_id") @db.Uuid
  publicVerifySuspendedAtUtc    DateTime?         @map("public_verify_suspended_at_utc") @db.Timestamptz(6)
  publicVerifySuspendedByUserId String?           @map("public_verify_suspended_by_user_id") @db.Uuid
  publicVerifySuspensionReason  String?           @map("public_verify_suspension_reason") @db.VarChar(400)

  // Phase 14 — retention metadata. The existing retentionUntilUtc is
  // the effective expiry. These columns annotate WHERE that value
  // came from so the operator can trace why an evidence is on schedule
  // to expire. retentionAppliedAtUtc is the moment retention was
  // applied (or last recomputed) — does not affect integrity.
  retentionPolicySource               RetentionPolicySource? @map("retention_policy_source")
  retentionAppliedAtUtc               DateTime?              @map("retention_applied_at_utc") @db.Timestamptz(6)
  retentionReconciliationFlaggedAtUtc DateTime?              @map("retention_reconciliation_flagged_at_utc") @db.Timestamptz(6)

  /// Phase 27 — Enterprise governance lifecycle.
  ///
  /// `lifecycleState` is the canonical Phase 27 state machine pointer.
  /// Default ACTIVE keeps the pre-Phase-27 behaviour. Transitions go
  /// through the lifecycle orchestrator service (the Evidence row is
  /// never updated directly). Hold-aware: while a hold is active, the
  /// orchestrator refuses transitions to PENDING_DESTRUCTION / DESTROYED.
  lifecycleState            EvidenceLifecycleState @default(ACTIVE) @map("lifecycle_state")
  /// Pointer to the currently-applied retention policy version (Phase
  /// 27 RetentionPolicyVersion). NULL = no first-class policy applied;
  /// the legacy `retentionPolicySource` enum still annotates legacy
  /// sources. Cross-team SetNull preserves audit history.
  retentionPolicyVersionId  String?                @map("retention_policy_version_id") @db.Uuid
  /// Pointer to the active DestructionReview row, if any. NULL when no
  /// review is in flight. Reset on review completion.
  activeDestructionReviewId String?                @map("active_destruction_review_id") @db.Uuid

  // Phase T — Canonical workflow-template identity trio (additive, nullable).
  //
  // These three columns propagate the workflow-template identity onto the
  // canonical Evidence row so downstream surfaces (reviewer-workflow,
  // reports, packages, escalations) can attribute evidence to the
  // template that produced it WITHOUT introducing a parallel template
  // model, a sync job, or a duplicate policy system.
  //
  // Identity contract:
  //   * templateSlug  — stable VarChar(120) identity that is consistent
  //                     across the in-code seed catalog and DB-backed
  //                     EvidenceWorkflowTemplate rows.
  //   * templateVersion — matches EvidenceWorkflowTemplate.version (or
  //                     the in-code seed version) at the moment the
  //                     evidence was created.
  //   * templateDbId  — UUID FK to EvidenceWorkflowTemplate.id, populated
  //                     ONLY when a DB row backs the slug. SetNull on
  //                     delete so template deletion never orphans
  //                     evidence; legacy rows remain NULL.
  //
  // All three are NULLABLE; backfill is out of scope for this phase.
  templateSlug    String?                   @map("template_slug") @db.VarChar(120)
  templateVersion Int?                      @map("template_version")
  templateDbId    String?                   @map("template_db_id") @db.Uuid
  template        EvidenceWorkflowTemplate? @relation("EvidenceTemplate", fields: [templateDbId], references: [id], onDelete: SetNull)

  tsaFailureReason  String?   @map("tsa_failure_reason")
  tsaGenTimeUtc     DateTime? @map("tsa_gen_time_utc") @db.Timestamptz(6)
  tsaHashAlgorithm  String?   @map("tsa_hash_algorithm") @db.VarChar(32)
  tsaMessageImprint String?   @map("tsa_message_imprint") @db.VarChar(128)
  tsaInputDigestHex String?   @map("tsa_input_digest_hex") @db.VarChar(128)
  tsaInputKind      String?   @map("tsa_input_kind") @db.VarChar(64)
  tsaProvider       String?   @map("tsa_provider") @db.VarChar(64)
  tsaSerialNumber   String?   @map("tsa_serial_number") @db.VarChar(255)
  tsaStatus         String?   @map("tsa_status") @db.VarChar(32)
  tsaTokenBase64    String?   @map("tsa_token_base64")
  tsaUrl            String?   @map("tsa_url") @db.VarChar(512)

  otsProofBase64   String?   @map("ots_proof_base64")
  otsHash          String?   @map("ots_hash") @db.VarChar(64)
  otsStatus        String?   @map("ots_status") @db.VarChar(32)
  otsCalendar      String?   @map("ots_calendar") @db.VarChar(512)
  otsBitcoinTxid   String?   @map("ots_bitcoin_txid") @db.VarChar(128)
  otsAnchoredAtUtc DateTime? @map("ots_anchored_at_utc") @db.Timestamptz(6)
  otsUpgradedAtUtc DateTime? @map("ots_upgraded_at_utc") @db.Timestamptz(6)
  otsFailureReason String?   @map("ots_failure_reason")

  /// ATTENTION ARCHITECTURE CLOSURE PASS (2026-08-22) — the identity of the
  /// DELIBERATE MULTI-RECORD EXECUTION that last touched this record's
  /// integrity proofs (a repair run, a bulk re-anchor).
  ///
  /// NULL for ordinary work, which is one BullMQ job per Evidence and
  /// therefore independent by construction. It is the ONE positive correlator
  /// the current pipelines can honestly produce; failures that merely share a
  /// provider, a workspace, a filename, a reason or a minute are NOT
  /// correlated and must never be grouped.
  ///
  /// Added by migration 20271217000000_evidence_integrity_correlation. No
  /// backfill: historical failures have no recorded execution, and inventing
  /// one would manufacture the grouping the retracted TSA finding forbids.
  integrityCorrelationId String? @map("integrity_correlation_id") @db.VarChar(80)

  custodyEvents               CustodyEvent[]
  guestIdentity               GuestIdentity?                       @relation(fields: [guestIdentityId], references: [id])
  parts                       EvidencePart[]
  reports                     Report[]
  certifications              EvidenceCertification[]
  annotations                 EvidenceAnnotation[]
  aiCategorizations           EvidenceAiCategorization[]
  legalNotes                  EvidenceLegalNote[]
  reviewerComments            EvidenceReviewerComment[]
  reviewWorkflow              EvidenceReviewWorkflow?
  reviewWorkflowEvents        EvidenceReviewWorkflowEvent[]
  reviewerAuditEvents         EvidenceReviewerAuditEvent[]
  sourceRelationships         EvidenceRelationship[]               @relation("EvidenceRelationshipSource")
  targetRelationships         EvidenceRelationship[]               @relation("EvidenceRelationshipTarget")
  verificationPackages        VerificationPackage[]
  verificationViews           VerificationView[]
  anchor                      EvidenceAnchor?
  workflowIntakeSession       WorkflowIntakeSession?               @relation("WorkflowIntakeSessionEvidence")
  evidenceRequests            EvidenceRequest[]                    @relation("EvidenceRequestEvidence")
  responseForEvidenceRequest  EvidenceRequestResponse?             @relation("EvidenceRequestResponseEvidence")
  legalHolds                  EvidenceLegalHold[]                  @relation("EvidenceLegalHolds")
  securityScans               FileSecurityScan[]                   @relation("EvidenceSecurityScans")
  uploadSession               UploadSession?                       @relation("EvidenceUploadSession")
  intelligenceJobs            EvidenceIntelligenceJob[]            @relation("EvidenceIntelligenceJobs")
  extractedTexts              EvidenceExtractedText[]              @relation("EvidenceExtractedTexts")
  extractedEntities           EvidenceEntity[]                     @relation("EvidenceEntities")
  semanticChunks              EvidenceSemanticChunk[]              @relation("EvidenceSemanticChunks")
  sourceSimilarities          EvidenceSimilarity[]                 @relation("EvidenceSimilaritySource")
  targetSimilarities          EvidenceSimilarity[]                 @relation("EvidenceSimilarityTarget")
  discussionThreads           DiscussionThread[]                   @relation("EvidenceDiscussionThreads")
  communicationMessages       CommunicationMessage[]               @relation("EvidenceCommunicationMessages")
  // Phase 22 — visibility decisions per-field; step-instance reverse
  // pointer (an evidence can be the "primary mapped evidence" of a
  // step). The many-to-many between Evidence and WorkflowInstance
  // is held by EvidenceWorkflowInstanceEvidence (the join table).
  workflowVisibilityDecisions EvidenceWorkflowVisibilityDecision[] @relation("EvidenceVisibilityDecisions")
  workflowStepInstances       EvidenceWorkflowStepInstance[]       @relation("EvidenceWorkflowStepMappedEvidence")

  // Phase 27 — Enterprise lifecycle back-relations.
  destructionReviews DestructionReview[]      @relation("DestructionReviewEvidence")
  lifecycleEvents    EvidenceLifecycleEvent[] @relation("EvidenceLifecycleEvents")

  // Phase 27.5 — Governance operationalization back-relations.
  destructionExecutions     DestructionExecution[]     @relation("DestructionExecutionEvidence")
  immutableStorageChecks    ImmutableStorageCheck[]    @relation("ImmutableStorageCheckEvidence")
  governanceExportSnapshots GovernanceExportSnapshot[] @relation("GovernanceExportSnapshotEvidence")
  governanceNotifications   GovernanceNotification[]   @relation("GovernanceNotificationEvidence")

  // Phase 32.8C++++ — Dashboard intelligence back-relations.
  integritySnapshot EvidenceIntegritySnapshot? @relation("EvidenceIntegritySnapshot")
  accessAnomalies   AccessAnomaly[]            @relation("AccessAnomalyEvidence")

  // Track 1B closure — CaseEvidenceLink is the ONE case↔evidence
  // relationship authority. The legacy `caseId` scalar mirror was
  // dropped (migration 20271105000000_evidence_case_id_removal);
  // all case association reads go through this relation.
  caseLinks CaseEvidenceLink[]

  // Phase A1 — declared organization relation. Until the Phase A1
  // backfill completes, this field remains nullable; the matching
  // CHECK constraint added by the A1 migration prevents the
  // "team_id IS NOT NULL AND organization_id IS NULL" combination so
  // tenancy stays deterministic even before the column is fully
  // tightened. After backfill verifies zero NULLs across all
  // workspaces, a future migration may set this NOT NULL.
  organization Organization? @relation("EvidenceOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@index([lifecycleState])
  @@index([retentionPolicyVersionId])
  @@index([deletedAtUtc])
  @@index([deleteScheduledForUtc])
  @@index([ownerUserId, deletedAt])
  @@index([ownerUserId, deleteScheduledForUtc])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([ownerUserId, archivedAt])
  @@index([ownerUserId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, deletedAt, createdAt(sort: Desc)])
  @@index([fileSha256])
  @@index([fingerprintHash])
  @@index([guestIdentityId])
  @@index([lockedAt])
  @@index([archivedAt])
  @@index([status])
  @@index([teamId])
  @@index([storageBucket, storageKey])
  @@index([storageObjectLockMode])
  @@index([storageObjectLockRetainUntilUtc])
  @@index([captureMethod])
  @@index([identityLevelSnapshot])
  @@index([submittedByUserId])
  @@index([createdByUserId])
  @@index([uploadedByUserId])
  @@index([lastAccessedByUserId])
  @@index([lastAccessedAtUtc])
  @@index([lastPublicVerifyViewAtUtc])
  @@index([verificationStatus])
  @@index([recordedIntegrityVerifiedAtUtc])
  @@index([lastVerifiedAtUtc])
  @@index([reviewReadyAtUtc])
  @@index([latestReportVersion])
  @@index([verificationPackageVersion])
  @@index([otsHash])
  @@index([otsStatus])
  @@index([otsAnchoredAtUtc])
  // Phase T — non-unique per-workspace template lookups.
  @@index([teamId, templateSlug])
  @@map("evidence")
}

model EvidenceAnchor {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId    String    @unique @map("evidence_id") @db.Uuid
  provider      String    @db.VarChar(64)
  mode          String    @db.VarChar(32)
  anchorHash    String    @map("anchor_hash") @db.VarChar(64)
  transactionId String?   @map("transaction_id") @db.VarChar(255)
  anchoredAtUtc DateTime? @map("anchored_at_utc") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  evidence      Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([mode])
  @@index([anchoredAtUtc])
  @@map("evidence_anchors")
}

model EvidencePart {
  id                               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId                       String               @map("evidence_id") @db.Uuid
  partIndex                        Int                  @map("part_index")
  storageBucket                    String               @map("storage_bucket") @db.VarChar(255)
  storageKey                       String               @map("storage_key") @db.VarChar(512)
  originalFileName                 String?              @map("original_file_name") @db.VarChar(255)
  storageRegion                    String?              @map("storage_region") @db.VarChar(64)
  storageObjectLockMode            String?              @map("storage_object_lock_mode") @db.VarChar(32)
  storageObjectLockRetainUntilUtc  DateTime?            @map("storage_object_lock_retain_until_utc") @db.Timestamptz(6)
  storageObjectLockLegalHoldStatus String?              @map("storage_object_lock_legal_hold_status") @db.VarChar(16)
  sizeBytes                        BigInt?              @map("size_bytes")
  mimeType                         String?              @map("mime_type") @db.VarChar(128)
  sha256                           String?              @map("sha256") @db.VarChar(64)
  durationMs                       Int?                 @map("duration_ms")
  privateRole                      String?              @map("private_role") @db.VarChar(120)
  privateNote                      String?              @map("private_note") @db.VarChar(1000)
  checklistStepId                  String?              @map("checklist_step_id") @db.VarChar(120)
  sourceLabel                      String?              @map("source_label") @db.VarChar(120)
  clientSignals                    Json?                @map("client_signals")
  // Enterprise Technical Metadata layer (additive, nullable). Canonical
  // per-part deterministic Layer-1 file facts (MIME, dimensions, codec,
  // EXIF presence summary, etc.) produced by the technical-metadata
  // parser. Shape: TechnicalMetadata
  // (@proovra/shared-runtime/technical-metadata). Multipart evidence
  // stores one record per part here; single-file evidence is also
  // mirrored onto Evidence.technicalMetadata for convenience.
  technicalMetadata                Json?                @map("technical_metadata")
  technicalMetaParsedAt            DateTime?            @map("technical_meta_parsed_at") @db.Timestamptz(6)
  technicalMetaParser              String?              @map("technical_meta_parser") @db.VarChar(64)
  uploadedByUserId                 String?              @map("uploaded_by_user_id") @db.Uuid
  uploadedAtUtc                    DateTime?            @map("uploaded_at_utc") @db.Timestamptz(6)
  // Phase 12 — perceptual-similarity foundation. 64-bit pHash + dHash
  // stored as 16-hex-char strings. Nullable because backfill is
  // operator-initiated and non-image parts will never carry a hash.
  perceptualPhash                  String?              @map("perceptual_phash") @db.VarChar(16)
  perceptualDhash                  String?              @map("perceptual_dhash") @db.VarChar(16)
  createdAt                        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  annotations                      EvidenceAnnotation[]
  evidence                         Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, partIndex])
  @@index([evidenceId])
  @@index([storageBucket, storageKey])
  @@index([storageObjectLockMode])
  @@index([storageObjectLockRetainUntilUtc])
  @@index([uploadedByUserId])
  @@index([uploadedAtUtc])
  @@index([perceptualPhash])
  @@index([perceptualDhash])
  @@map("evidence_parts")
}

model Case {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(120)
  ownerUserId String  @map("owner_user_id")
  teamId      String? @map("team_id") @db.Uuid

  // Phase 32.8D — Matter lifecycle. status drives the matter queue
  // filter + closure preservation invariant (ACTIVE legal hold blocks
  // CLOSED / ARCHIVED transitions). priority feeds the queue sort.
  status          CaseStatus   @default(OPEN)
  priority        CasePriority @default(P2)
  description     String?      @db.VarChar(4000)
  referenceNumber String?      @map("reference_number") @db.VarChar(60)
  closedAtUtc     DateTime?    @map("closed_at_utc") @db.Timestamptz(6)
  closureReason   String?      @map("closure_reason") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  access              CaseAccess[]
  // PHASE 12B CLUSTER 8 — CASE-scoped rows in the canonical legal-hold
  // table (evidence_legal_holds). Restrict on delete: a Case with a
  // preservation control cannot be removed out from under it.
  canonicalLegalHolds EvidenceLegalHold[] @relation("CaseCanonicalLegalHolds")
  // Phase 32.8D — Matter Workspace relations.
  assignments         CaseAssignment[]
  statusHistory       CaseStatusHistory[]
  riskSnapshots       CaseRiskSnapshot[]
  // Track 1B closure — canonical case↔evidence links.
  evidenceLinks       CaseEvidenceLink[]

  @@unique([teamId, referenceNumber], name: "case_team_reference_number_uniq")
  @@index([ownerUserId])
  @@index([teamId])
  @@index([teamId, status])
  @@index([teamId, priority])
  @@map("cases")
}

// =============================================================================
// Phase 32.8D — Matter Workspace
//
// Three new advisory + canonical models on top of the existing Case row:
//   1. CaseAssignment       — role-scoped operational ownership
//   2. CaseStatusHistory    — audited status transitions
//   3. CaseRiskSnapshot     — deterministic risk projection
//
// Hard rules:
//   - CaseAssignment + CaseStatusHistory are canonical (every change is
//     audited; lifecycle history survives).
//   - CaseRiskSnapshot is an ADVISORY projection — writer failures
//     NEVER block evidence/report/package/verify flows. Re-derivable
//     from existing counters at any time.
//   - All operator-facing strings bounded. No raw payloads.
// =============================================================================

enum CaseStatus {
  OPEN
  INVESTIGATING
  ON_HOLD
  RESOLVED
  CLOSED
  ARCHIVED
}

enum CasePriority {
  P0
  P1
  P2
  P3
}

enum CaseAssignmentRole {
  OWNER
  INVESTIGATOR
  REVIEWER
  GOVERNANCE
  OBSERVER
}

enum CaseAssignmentStatus {
  ACTIVE
  REMOVED
}

enum CaseRiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseRiskSnapshotSource {
  DB_DERIVED
  WORKER_INTERNAL
  OTHER
}

model CaseAssignment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId           String?              @map("team_id") @db.Uuid
  caseId           String               @map("case_id") @db.Uuid
  assignedToUserId String               @map("assigned_to_user_id") @db.Uuid
  assignedByUserId String               @map("assigned_by_user_id") @db.Uuid
  role             CaseAssignmentRole
  status           CaseAssignmentStatus @default(ACTIVE)
  assignedAtUtc    DateTime             @default(now()) @map("assigned_at_utc") @db.Timestamptz(6)
  removedAtUtc     DateTime?            @map("removed_at_utc") @db.Timestamptz(6)
  removedByUserId  String?              @map("removed_by_user_id") @db.Uuid
  /// Bounded operator-safe note (e.g., "Picked up after escalation").
  note             String?              @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, assignedToUserId, role], name: "case_assignment_role_uniq")
  @@index([teamId, status])
  @@index([caseId, status])
  @@index([assignedToUserId, status])
  @@index([role])
  @@map("case_assignments")
}

model CaseStatusHistory {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String?     @map("team_id") @db.Uuid
