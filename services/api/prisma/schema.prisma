model EvidenceRequestEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceRequestId String   @map("evidence_request_id") @db.Uuid
  eventType         String   @map("event_type") @db.VarChar(64)
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  payload           Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evidenceRequest EvidenceRequest @relation(fields: [evidenceRequestId], references: [id], onDelete: Cascade)
  actor           User?           @relation("EvidenceRequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([evidenceRequestId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("evidence_request_events")
}

// -----------------------------------------------------------------------------
// Phase 8 — NotificationDelivery
//
// Tracks every operational notification we attempt. One row per channel
// attempt (so a single Evidence Request "send" creates one row for each
// recipient). Lifecycle: PENDING → SENT → DELIVERED (or FAILED /
// RETRY_SCHEDULED / CANCELLED / SKIPPED).
//
// Privacy: `metadata` JSON MUST NEVER carry raw tokens, token hashes,
// reviewer notes, IP/UA, or any other workspace-internal data. The
// rendered preview is plaintext only (not HTML) so a DB dump cannot
// re-render arbitrary scripts.
// -----------------------------------------------------------------------------

model NotificationDelivery {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Scope (workspace-bound; not exposed publicly)
  teamId String? @map("team_id") @db.Uuid

  // Event identity
  eventType String               @map("event_type") @db.VarChar(64)
  channel   NotificationChannel
  provider  NotificationProvider

  // Recipient — for EMAIL this is the address. For SMS this would be the
  // phone number. For WEBHOOK this is the destination URL. For IN_APP this
  // is the user id (as text for uniformity).
  recipient       String  @db.VarChar(512)
  recipientName   String? @map("recipient_name") @db.VarChar(180)
  recipientUserId String? @map("recipient_user_id") @db.Uuid

  // Linkage — optional FK references so cascades from request deletion
  // are honored. Each is nullable so the same table also tracks
  // notifications that aren't request-bound.
  evidenceRequestId String? @map("evidence_request_id") @db.Uuid
  evidenceId        String? @map("evidence_id") @db.Uuid
  intakeLinkId      String? @map("intake_link_id") @db.Uuid

  // Status
  status            NotificationDeliveryStatus @default(PENDING)
  subject           String?                    @db.VarChar(400)
  templateKey       String                     @map("template_key") @db.VarChar(80)
  renderedPreview   String?                    @map("rendered_preview") @db.VarChar(2000)
  providerMessageId String?                    @map("provider_message_id") @db.VarChar(255)
  errorCode         String?                    @map("error_code") @db.VarChar(80)
  errorMessage      String?                    @map("error_message") @db.VarChar(2000)
  retryCount        Int                        @default(0) @map("retry_count")
  nextAttemptAtUtc  DateTime?                  @map("next_attempt_at_utc") @db.Timestamptz(6)
  sentAtUtc         DateTime?                  @map("sent_at_utc") @db.Timestamptz(6)
  deliveredAtUtc    DateTime?                  @map("delivered_at_utc") @db.Timestamptz(6)
  failedAtUtc       DateTime?                  @map("failed_at_utc") @db.Timestamptz(6)

  // Audit / metadata — safe-only operational data.
  metadata Json?

  // Phase 8.5 — template context snapshot. Stored at create time so the
  // retry worker / manual resend can re-render without needing to look up
  // mutable workspace state. Contains ONLY the safe-to-email fields the
  // renderer's TemplateContext accepts: workspace name, request title,
  // instructions, due date, deliverable summaries, intake URL. NEVER
  // contains reviewer notes, IP/UA, token hashes, or any other workspace
  // internal data. Schema-validated before persistence by the
  // notifications orchestrator.
  templateContextJson Json? @map("template_context_json")

  initiatedByUserId String?  @map("initiated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipientUser   User?            @relation("NotificationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  initiatedBy     User?            @relation("NotificationDeliveryInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  evidenceRequest EvidenceRequest? @relation("EvidenceRequestNotifications", fields: [evidenceRequestId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([status])
  @@index([evidenceRequestId])
  @@index([evidenceId])
  @@index([intakeLinkId])
  @@index([nextAttemptAtUtc])
  @@map("notification_deliveries")
}

// -----------------------------------------------------------------------------
// Phase 9 — WorkspaceGovernancePolicy
//
// One row per workspace. ABSENCE means default behavior — workspaces
// without a policy continue to behave exactly as before Phase 9.
// All boolean fields default to permissive so an empty row is a no-op.
//
// Privacy: policy is workspace-internal. Never serialized into public
// verify, report-v2, or verification package outputs.
// -----------------------------------------------------------------------------

model WorkspaceGovernancePolicy {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @unique @map("team_id") @db.Uuid

  // Retention
  defaultRetentionDays Int? @map("default_retention_days")

  // Deletion controls
  evidenceDeletionMode                EvidenceDeletionMode @default(ALLOWED) @map("evidence_deletion_mode")
  requireLegalHoldApprovalForDeletion Boolean              @default(false) @map("require_legal_hold_approval_for_deletion")

  // Review gates
  requireReviewBeforeReport       Boolean @default(false) @map("require_review_before_report")
  requireReviewBeforePackage      Boolean @default(false) @map("require_review_before_package")
  requireReviewBeforePublicVerify Boolean @default(false) @map("require_review_before_public_verify")

  // Intake controls
  allowExternalIntake  Boolean @default(true) @map("allow_external_intake")
  allowAnonymousIntake Boolean @default(true) @map("allow_anonymous_intake")

  // Export controls
  allowPublicVerify     Boolean @default(true) @map("allow_public_verify")
  allowPackageDownload  Boolean @default(true) @map("allow_package_download")
  allowReportDownload   Boolean @default(true) @map("allow_report_download")
  // Phase 10 — original file download gate. Default true preserves
  // pre-Phase-10 behavior; a workspace can opt out without affecting
  // report/package downloads.
  allowOriginalDownload Boolean @default(true) @map("allow_original_download")

  // Metadata redaction defaults — schema-shaped per the Phase 1 visibility
  // resolver. Free-form JSON so future policy fields land here without a
  // migration. Validated at write time against shared types.
  metadataRedactionDefault Json? @map("metadata_redaction_default")

  // Phase 13.5 — Review SLA default foundation. Optional integer hour
  // values applied when a new EvidenceReviewWorkflow is created and
  // no explicit SLA is supplied. Null means "no default" — existing
  // workflow creation behavior unchanged.
  defaultReviewDueHours             Int?    @map("default_review_due_hours")
  defaultFirstResponseDueHours      Int?    @map("default_first_response_due_hours")
  defaultEscalationDueHours         Int?    @map("default_escalation_due_hours")
  // Phase 25.5 — explicit assignment / completion / due-soon SLA
  // overrides. Null = fall back to env defaults. All nullable, all
  // bounded by the route layer (1..720 hours).
  defaultAssignmentDueHours         Int?    @map("default_assignment_due_hours")
  defaultCompletionDueHours         Int?    @map("default_completion_due_hours")
  defaultDueSoonHours               Int?    @map("default_due_soon_hours")
  // Phase 25.5 — reviewer-ops governance flags. When true, the
  // corresponding sensitive review action requires a step-up
  // challenge. Defaults match Phase 25 behaviour (no extra step-up).
  requireStepUpForApprove           Boolean @default(false) @map("require_step_up_for_approve")
  requireStepUpForReject            Boolean @default(false) @map("require_step_up_for_reject")
  requireStepUpForEscalationResolve Boolean @default(false) @map("require_step_up_for_escalation_resolve")
  requireStepUpForBulk              Boolean @default(false) @map("require_step_up_for_bulk")
  // Reviewer inactivity threshold (hours). When set, the reconcile
  // pass surfaces an inactivity warning + optional escalation after
  // the threshold. Null = no inactivity detection.
  reviewerInactivityHours           Int?    @map("reviewer_inactivity_hours")

  // Phase 14 — governance approval flags. When true, the corresponding
  // action requires an additional approval step before it takes effect.
  // Default false preserves pre-14 behavior.
  requirePublicationApproval      Boolean @default(false) @map("require_publication_approval")
  requireLegalHoldReleaseApproval Boolean @default(false) @map("require_legal_hold_release_approval")

  // PHASE 12B CLUSTER 9 — optimistic-concurrency version.
  //
  // Every ACCEPTED `PUT /v1/governance/policy` increments this by exactly one
  // inside the same conditional UPDATE that writes the patch, so two
  // concurrent policy edits can never both win. A caller whose
  // `expectedVersion` no longer matches is refused with
  // 409 POLICY_VERSION_CONFLICT and mutates nothing.
  //
  // Rows that predate this column are version 1 (migration
  // 20271109000000_workspace_governance_policy_version backfills them
  // deterministically); "no row at all" is reported to clients as version 0.
  version Int @default(1)

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("WorkspaceGovernancePolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("workspace_governance_policies")
}

// -----------------------------------------------------------------------------
// Phase 9 — EvidenceLegalHold
//
// Per-evidence legal hold. ABSENCE means no hold. An ACTIVE hold blocks
// deletion / archive / retention expiry through the policy enforcement
// helpers in services/api/src/services/governance.service.ts.
//
// Holds do NOT assert legal admissibility, authenticity, or evidentiary
// truth. They are an INTERNAL governance control that flags a record
// as preserved-pending-review.
// -----------------------------------------------------------------------------

// PHASE 12B CLUSTER 8 — CANONICAL LEGAL-HOLD MODEL.
//
// `evidence_legal_holds` is the ONE legal-hold authority. It absorbed the
// scope-generic `legal_holds` table and the case-only `case_legal_holds`
// table because it already carried the strongest integrity guarantees
// (real FKs to Team / Evidence / User, a release note, a status enum, and
// placed-by / released-by attribution). Extending it — rather than
// inventing a new polymorphic table — preserves explicit referential
// integrity instead of trading it for an unvalidated polymorphic target.
//
// Reads and writes go through services/api/src/services/governance/
// legal-hold.service.ts (one placement command, one release command) and
// services/api/src/services/governance/effective-legal-hold.ts (the ONE
// destruction-gate evaluator, mirrored byte-for-byte in
// services/worker/src/governance/effective-legal-hold.ts).
model EvidenceLegalHold {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  // CLUSTER 8 — explicit scope. `evidenceId` became nullable ONLY because
  // CASE and WORKSPACE scopes have no single evidence target. The
  // scope/target consistency CHECK constraint lives in the migration.
  scope LegalHoldScope @default(EVIDENCE)

  evidenceId     String? @map("evidence_id") @db.Uuid
  caseId         String? @map("case_id") @db.Uuid
  // CLUSTER 8 — organization binding alongside teamId for workspaces that
  // resolve to an Organization. Never used as a tenant key on its own;
  // teamId remains the tenant authority on every query.
  organizationId String? @map("organization_id") @db.Uuid

  title  String  @db.VarChar(180)
  reason String? @db.VarChar(4000)

  status           LegalHoldStatus @default(ACTIVE)
  placedByUserId   String          @map("placed_by_user_id") @db.Uuid
  placedAtUtc      DateTime        @default(now()) @map("placed_at_utc") @db.Timestamptz(6)
  releasedByUserId String?         @map("released_by_user_id") @db.Uuid
  releasedAtUtc    DateTime?       @map("released_at_utc") @db.Timestamptz(6)
  releaseNote      String?         @map("release_note") @db.VarChar(4000)
  // CLUSTER 8 — absorbed from the scope-generic store. An expiry does NOT
  // auto-release: the evaluator treats a passed expiry as not-active, and
  // the status column is only moved to EXPIRED by an explicit sweep.
  expiresAtUtc     DateTime?       @map("expires_at_utc") @db.Timestamptz(6)

  // CLUSTER 8 — release-approval gate (WorkspaceGovernancePolicy
  // `requireLegalHoldReleaseApproval`) captured ON the hold so the control
  // survives a later policy change.
  releaseApprovalRequired Boolean                       @default(false) @map("release_approval_required")
  releaseApprovalState    LegalHoldReleaseApprovalState @default(NOT_REQUIRED) @map("release_approval_state")
  releaseApprovedByUserId String?                       @map("release_approved_by_user_id") @db.Uuid
  releaseApprovedAtUtc    DateTime?                     @map("release_approved_at_utc") @db.Timestamptz(6)

  // CLUSTER 8 — which WorkspaceGovernancePolicy revision governed the
  // placement / the release. Free-form attribution string
  // (`wgp:<policyRowId>@<updatedAt ISO>`); NULL on legacy + backfilled rows.
  policyVersionAttribution        String? @map("policy_version_attribution") @db.VarChar(200)
  releasePolicyVersionAttribution String? @map("release_policy_version_attribution") @db.VarChar(200)

  // CLUSTER 8 — optimistic concurrency. Every canonical mutation bumps
  // this; a stale `expectedVersion` is a 409, never a lost update.
  version Int @default(1)

  // CLUSTER 8 — convergence provenance. `sourceStore`+`sourceRowId` is the
  // deterministic idempotency key that makes the backfill migration
  // re-runnable without ever duplicating a hold. NULL sourceRowId means the
  // row was authored natively through the canonical service.
  sourceStore LegalHoldSourceStore @default(EVIDENCE_LEGAL_HOLD) @map("source_store")
  sourceRowId String?              @map("source_row_id") @db.Uuid
  // CLUSTER 8 — an orphaned hold (its target row no longer exists) is
  // preserved as HISTORICAL rather than dropped. HISTORICAL rows are
  // exempt from the scope/target CHECK and are never treated as active.
  historical  Boolean              @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team              Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence          Evidence?     @relation("EvidenceLegalHolds", fields: [evidenceId], references: [id], onDelete: Cascade)
  // CLUSTER 8 — the bare `case_id` column now has referential integrity.
  // Restrict (not Cascade): deleting a Case must never silently destroy a
  // preservation control.
  legalCase         Case?         @relation("CaseCanonicalLegalHolds", fields: [caseId], references: [id], onDelete: Restrict)
  organization      Organization? @relation("OrganizationCanonicalLegalHolds", fields: [organizationId], references: [id], onDelete: Restrict)
  placedBy          User          @relation("LegalHoldPlacedBy", fields: [placedByUserId], references: [id], onDelete: Restrict)
  releasedBy        User?         @relation("LegalHoldReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  releaseApprovedBy User?         @relation("LegalHoldReleaseApprovedBy", fields: [releaseApprovedByUserId], references: [id], onDelete: SetNull)

  @@unique([sourceStore, sourceRowId], name: "legal_hold_source_identity")
  @@index([teamId, status])
  @@index([evidenceId, status])
  @@index([caseId, status])
  @@index([teamId, scope, status])
  @@index([placedByUserId])
  @@map("evidence_legal_holds")
}

// -----------------------------------------------------------------------------
// Phase 10 — Integration platform enums + models
//
// API credentials (machine identity), webhook endpoints (outbound delivery
// destinations), webhook deliveries (per-attempt lifecycle). All additive.
// Existing app users / teams / evidence unaffected.
// -----------------------------------------------------------------------------

enum ApiCredentialStatus {
  ACTIVE
  REVOKED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRY_SCHEDULED
  CANCELLED
}

model ApiCredential {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  name        String  @db.VarChar(180)
  description String? @db.VarChar(2000)

  // Token storage — never raw, never the full key. The key body is
  // HMAC-hashed by the api-credentials service; the prefix is kept
  // clear for operator identification ("pwk_xxxxxxxx...").
  keyPrefix String @map("key_prefix") @db.VarChar(32)
  keyHash   String @unique @map("key_hash") @db.VarChar(128)

  // Scopes are canonical permission identifiers (see @proovra/shared
  // permissions.ts). Each scope grants exactly that permission to the
  // service account; service-account permission checks are intersection
  // of (scopes) ∩ (canonical role permissions if role were ADMIN).
  scopes String[] @default([])

  status          ApiCredentialStatus @default(ACTIVE)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  lastUsedAtUtc   DateTime?           @map("last_used_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime?           @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?             @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?             @map("revoked_reason") @db.VarChar(400)

  // Phase 17 — service-account hardening.
  //   expiresAtUtc      — credential auto-rejects after this moment
  //   disabledAtUtc     — soft pause (distinct from REVOKED which is permanent)
  //   disabledByUserId  — operator who paused
  //   rotationRequired  — operator hint that the next use SHOULD rotate
  //   ipAllowlist       — optional list of CIDR strings; empty = no restriction
  //   environment       — operator label (e.g. "production" / "staging");
  //                       used in the /identity UI + audit only
  expiresAtUtc     DateTime? @map("expires_at_utc") @db.Timestamptz(6)
  disabledAtUtc    DateTime? @map("disabled_at_utc") @db.Timestamptz(6)
  disabledByUserId String?   @map("disabled_by_user_id") @db.Uuid
  rotationRequired Boolean   @default(false) @map("rotation_required")
  ipAllowlist      String[]  @default([]) @map("ip_allowlist")
  environment      String?   @db.VarChar(32)

  // PHASE 2 — true dual-active rotation. When a key is rotated, the OLD
  // hash/prefix are copied into these `previous_*` columns and remain
  // valid until `previousValidUntilUtc`. After expiry the verify path
  // rejects the old key. Operator never sees the previous raw key
  // again — only the new one is disclosed once. The columns are nullable
  // for credentials that have never been rotated. A unique partial index
  // on previous_key_hash (where the column is not null) prevents two
  // credentials from sharing a "previous" hash, which mirrors the
  // existing uniqueness invariant on the live `keyHash`.
  previousKeyHash       String?   @map("previous_key_hash") @db.VarChar(128)
  previousKeyPrefix     String?   @map("previous_key_prefix") @db.VarChar(32)
  previousValidUntilUtc DateTime? @map("previous_valid_until_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team       Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("ApiCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy  User?                   @relation("ApiCredentialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  disabledBy User?                   @relation("ApiCredentialDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)
  usageLogs  ApiCredentialUsageLog[]

  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([expiresAtUtc])
  @@index([disabledAtUtc])
  @@index([previousValidUntilUtc])
  @@map("api_credentials")
}

// Phase 10.5 — per-call audit trail for service-account API key usage.
// Records route, method, action, success / failure, and a short failure
// reason for operator debugging. NEVER contains the raw key, the
// Authorization header, request body, or evidence-internal data.
model ApiCredentialUsageLog {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiCredentialId String @map("api_credential_id") @db.Uuid
  teamId          String @map("team_id") @db.Uuid

  // Routing info — bounded VARCHAR so the column never bloats.
  routePath String @map("route_path") @db.VarChar(256)
  method    String @db.VarChar(16)
  action    String @db.VarChar(96)

  statusCode    Int     @map("status_code")
  success       Boolean
  failureReason String? @map("failure_reason") @db.VarChar(96)
  requestId     String? @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  apiCredential ApiCredential @relation(fields: [apiCredentialId], references: [id], onDelete: Cascade)

  @@index([apiCredentialId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("api_credential_usage_logs")
}

model WebhookEndpoint {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  url         String                @db.VarChar(2048)
  description String?               @db.VarChar(400)
  status      WebhookEndpointStatus @default(ACTIVE)

  // AES-256-GCM ciphertext of the raw signing secret (base64). Raw
  // secret shown to the operator ONCE at creation / rotation; we
  // decrypt this column at signing time to recompute the HMAC.
  secretCiphertext String @map("secret_ciphertext") @db.VarChar(512)
  secretPrefix     String @map("secret_prefix") @db.VarChar(32)

  // Phase 4 — dual-signing rotation. After rotateWebhookSecret() the
  // PRIOR signing material is copied into these nullable columns and
  // remains valid until `previousSecretValidUntilUtc`. While the
  // window is open the dispatcher emits BOTH signatures in the
  // `X-Proovra-Signature` header (Stripe-style `v1=<new>,v1=<old>`)
  // so receivers can switch over without dropping events. After the
  // cutoff the dispatcher signs with only the new secret and the
  // previous_* triple is lazily cleared.
  previousSecretCiphertext    String?   @map("previous_secret_ciphertext") @db.VarChar(512)
  previousSecretPrefix        String?   @map("previous_secret_prefix") @db.VarChar(32)
  previousSecretValidUntilUtc DateTime? @map("previous_secret_valid_until_utc") @db.Timestamptz(6)

  // Subscribed event types. Empty = subscribe to all.
  eventTypes String[] @default([])

  // Operational counters
  failureCount     Int       @default(0) @map("failure_count")
  lastSuccessAtUtc DateTime? @map("last_success_at_utc") @db.Timestamptz(6)
  lastFailureAtUtc DateTime? @map("last_failure_at_utc") @db.Timestamptz(6)

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team       Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User                         @relation("WebhookEndpointCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries IntegrationWebhookDelivery[]

  @@index([teamId, status])
  @@index([previousSecretValidUntilUtc], map: "integration_webhook_endpoints_prev_secret_valid_until_utc_idx")
  @@map("integration_webhook_endpoints")
}

model IntegrationWebhookDelivery {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId String @map("endpoint_id") @db.Uuid
  teamId     String @map("team_id") @db.Uuid

  eventId     String @map("event_id") @db.VarChar(64)
  eventType   String @map("event_type") @db.VarChar(64)
  payloadJson Json   @map("payload_json")

  status              WebhookDeliveryStatus @default(PENDING)
  attemptCount        Int                   @default(0) @map("attempt_count")
  nextAttemptAtUtc    DateTime?             @map("next_attempt_at_utc") @db.Timestamptz(6)
  responseStatus      Int?                  @map("response_status")
  responseBodyPreview String?               @map("response_body_preview") @db.VarChar(2000)
  errorMessage        String?               @map("error_message") @db.VarChar(2000)
  sentAtUtc           DateTime?             @map("sent_at_utc") @db.Timestamptz(6)
  failedAtUtc         DateTime?             @map("failed_at_utc") @db.Timestamptz(6)
  // Phase closure — wall-clock duration of the most recent outbound
  // HTTP attempt, measured around the single `httpClient(...)` call in
  // `attemptDeliveryInner` with `process.hrtime.bigint()`. NULL when the
  // row reached a terminal status WITHOUT ever issuing the fetch (e.g.
  // signing_key_unavailable). The dispatcher MUST NOT fabricate a value.
  responseDurationMs  Int?                  @map("response_duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([status])
  @@index([nextAttemptAtUtc])
  @@index([eventId])
  @@map("integration_webhook_deliveries")
}

