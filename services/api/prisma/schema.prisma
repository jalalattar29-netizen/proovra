  // R7-capture-trust additive — attestation freshness ceiling + provider-specific
  // structured metadata. expiresAtUtc is enforced by the verifier (ASSERTION_EXPIRED
  // verdict if Date.now() > expiresAtUtc); providerMetadata captures e.g.
  // App-Attest receipt + Play-Integrity nonce metadata for audit. Both are
  // additive to the existing attestation row; the verifier still runs the same
  // checks regardless of whether these columns are populated.
  expiresAtUtc       DateTime? @map("expires_at_utc") @db.Timestamptz(6)
  providerMetadata   Json?     @map("provider_metadata")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, nonceHex])
  @@index([teamId])
  @@map("capture_device_attestations")
}

model CaptureTrustEventRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId           String    @map("team_id") @db.Uuid
  // R7-capture-trust: evidenceId is nullable for PRE-FINALISE trust events
  // (CAPTURE_STARTED / DEVICE_REGISTERED / SESSION_OPENED) that emit before the
  // evidence row exists. Trust-event chain integrity is NOT weakened:
  //   * sequence is still monotonic per (teamId, evidenceId|null, deviceId)
  //   * eventHash + prevEventHash still chain over canonical payload
  //   * trust-event.service mirrors to custody chain ONLY when evidenceId !== null
  //     (`if (input.evidenceId !== null) { appendCustodyEvent(...) }`)
  //   * captureSessionId remains the anchor for pre-finalise correlation
  evidenceId       String?   @map("evidence_id") @db.Uuid
  code             String    @db.VarChar(80)
  sequence         Int
  eventHash        String    @map("event_hash") @db.VarChar(64)
  prevEventHash    String?   @map("prev_event_hash") @db.VarChar(64)
  payload          Json?
  // R7 — additive capture-trust event fields
  atUtc            DateTime? @map("at_utc") @db.Timestamptz(6)
  captureSessionId String?   @map("capture_session_id") @db.VarChar(128)
  // R7-capture-trust additive — deviceId binds the trust event to the originating
  // device. Nullable because some trust events (e.g. SERVER_COUNTERSIGNED) are
  // server-side and have no device anchor. When present, ties the event chain
  // back to Device.id for cross-reference with attestation/signature audit rows.
  deviceId         String?   @map("device_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([teamId, evidenceId])
  @@index([evidenceId, sequence])
  @@map("capture_trust_event_records")
}

