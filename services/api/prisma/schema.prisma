// =============================================================================
// PHASE 12 POINT 4 — raw-SQL-owned subsystems brought under the ONE schema
// authority.
//
// These tables were created by hand-written migrations and accessed through
// $queryRaw/$executeRaw, but were never declared in schema.prisma. That split
// the schema authority in two: the migrations knew about them, the datamodel
// did not, and `prisma migrate diff --to-schema` therefore proposed DROPPING
// live tables. Declaring them here makes the datamodel complete.
//
// Declaring a model does NOT move the runtime onto Prisma: the owning
// subsystems keep their raw SQL, which is deliberate (bulk upserts, partial
// indexes, JSON projections). The declaration exists so the schema authority
// is single and the drift comparison is honest. The convergence guard asserts
// that no NEW Prisma writer appears for these models.
// =============================================================================

model EvidenceOcrText {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
