  reason          String?     @db.VarChar(400)
  changedAtUtc    DateTime    @default(now()) @map("changed_at_utc") @db.Timestamptz(6)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, changedAtUtc(sort: Desc)])
  @@index([teamId, changedAtUtc(sort: Desc)])
  @@index([toStatus])
  @@map("case_status_history")
}

model CaseRiskSnapshot {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("team_id") @db.Uuid
  caseId String  @map("case_id") @db.Uuid

  riskScore Int           @map("risk_score")
