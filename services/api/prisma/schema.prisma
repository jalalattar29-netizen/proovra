// Phase E10.1 — DEF-038 closure. Stripe webhook event idempotency.
//
// Stripe delivers webhooks at-least-once and re-fires events that the
// receiver did not 2xx promptly. Without a deduplication record the
// `POST /stripe` handler would re-process duplicates → duplicate
// `Payment` rows + double subscription transitions.
//
// `stripeEventId` is the canonical Stripe event id (e.g.
// `evt_1234567890abcdef`). The unique index makes the "seen?" check
// atomic — a duplicate insert raises a Prisma P2002 which the handler
// translates into a safe no-op 200.
//
// Row stays in the table after processing as the durable audit of
// what was acted on. A future bounded retention phase may add a TTL
// (companion to DEF-024 / DEF-031 / DEF-032).
model StripeWebhookEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId    String    @unique @map("stripe_event_id") @db.VarChar(128)
  eventType        String    @map("event_type") @db.VarChar(120)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  processingStatus String    @default("RECEIVED") @map("processing_status") @db.VarChar(32)
  errorReason      String?   @map("error_reason") @db.VarChar(400)

  @@index([eventType, receivedAt])
  @@index([processingStatus])
  @@map("stripe_webhook_events")
}

// Phase 10 — PayPal webhook idempotency. Direct mirror of
// `StripeWebhookEvent` above.
//
// PayPal redelivers webhooks for which the receiver did not 2xx
// promptly (and for several PAYMENT.* / BILLING.SUBSCRIPTION.* event
// classes also for transient verifier errors). Without a
// deduplication record the `POST /paypal` handler would re-process
// duplicate PAYMENT.CAPTURE.COMPLETED and
// BILLING.SUBSCRIPTION.{CREATED,ACTIVATED,UPDATED,CANCELLED,SUSPENDED,EXPIRED}
// events → duplicate `Payment` rows + double subscription
// transitions (including TEAM / PRO entitlement flips).
//
// `paypalEventId` is the canonical PayPal event id (e.g.
// `WH-XXXXXXXXXXXXXXXXX`). The unique index makes the "seen?" check
// atomic — a duplicate insert raises Prisma P2002 which the handler
// translates into a safe no-op 200.
//
// Row stays in the table after processing as the durable audit of
// what was acted on. A future bounded retention phase may add a TTL
// (companion to the Stripe-side retention work).
model PaypalWebhookEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paypalEventId    String    @unique @map("paypal_event_id") @db.VarChar(128)
  eventType        String    @map("event_type") @db.VarChar(120)
  payloadHash      String?   @map("payload_hash") @db.VarChar(128)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  processingStatus String    @default("RECEIVED") @map("processing_status") @db.VarChar(32)
  errorReason      String?   @map("error_reason") @db.VarChar(400)

  @@index([eventType, receivedAt])
  @@index([processingStatus])
  @@map("paypal_webhook_events")
}

