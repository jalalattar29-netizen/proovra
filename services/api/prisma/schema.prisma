enum CustodyEventType {
  EVIDENCE_CREATED
  // Issued by the API at intake (presign authorized) but BEFORE any bytes
  // are confirmed at the storage layer. Forensically: the system promised
  // a place for the upload to land; it does not assert that bytes moved.
  // Kept for backward compatibility with old records; new records issued
  // at presign use UPLOAD_AUTHORIZED instead.
  UPLOAD_STARTED
  // Renamed-truthful variant of UPLOAD_STARTED. Written when a presigned URL
  // is issued / the intake record is created. Means: the system authorized
  // an upload to a specific bucket/key; it does NOT mean bytes were uploaded.
  UPLOAD_AUTHORIZED
  UPLOAD_COMPLETED
  EVIDENCE_COMPLETED
  SIGNATURE_APPLIED
  TIMESTAMP_APPLIED
  TIMESTAMP_FAILED
  REPORT_GENERATED
  VERIFICATION_PACKAGE_GENERATED
  VERIFICATION_PACKAGE_DOWNLOADED
  TECHNICAL_VERIFICATION_CHECKED
  REVIEW_READY
  CERTIFICATION_REQUESTED
  CERTIFICATION_ATTESTED
  CERTIFICATION_REVOKED
  IDENTITY_SNAPSHOT_RECORDED
  // Identity snapshot recorded at report generation time, separately from the
  // intake-time IDENTITY_SNAPSHOT_RECORDED. Distinct event so two snapshots
  // for the same record do not look like duplicate / tampered audit history.
  REPORT_IDENTITY_CONTEXT_RECORDED
  ANCHOR_PUBLISHED
  ANCHOR_FAILED
  OTS_APPLIED
  OTS_FAILED
  // Written when an OTS attempt was initiated but threw before a status was
  // available (e.g., binary missing, network failure pre-call). Distinct from
  // OTS_FAILED, which carries provider-returned failure semantics.
  OTS_ATTEMPT_ERROR
  EVIDENCE_VIEWED
  EVIDENCE_DOWNLOADED
  EVIDENCE_DELETED
  EVIDENCE_DELETE_SCHEDULED
  EVIDENCE_DELETE_RESTORED
  EVIDENCE_PURGED
  VERIFY_VIEWED
  REPORT_DOWNLOADED
  EVIDENCE_LOCKED
  // Truthful counterpart of EVIDENCE_LOCKED used when retention was attempted
  // but Object Lock is disabled / unavailable / did not apply. Replaces the
  // prior practice of appending EVIDENCE_LOCKED unconditionally on the
  // post-completion path even when no lock was actually written.
  STORAGE_PROTECTION_UNAVAILABLE
  EVIDENCE_CLAIMED
  EVIDENCE_ARCHIVED
  EVIDENCE_RESTORED
  // Phase 4 — external intake. Forensic-grade events; the chain hashes them
  // the same way as every other custody event.
  EXTERNAL_INTAKE_LINK_USED
  EXTERNAL_INTAKE_CONSENT_ACCEPTED
  EXTERNAL_INTAKE_SUBMITTED
  // Phase 9 — governance / legal hold custody events. Appended to the
  // existing forensic chain so reviewers see governance decisions in
  // the same audit trail as integrity events.
  LEGAL_HOLD_PLACED
  LEGAL_HOLD_RELEASED
  DELETE_BLOCKED_BY_LEGAL_HOLD
  DELETE_BLOCKED_BY_RETENTION
  EXPORT_BLOCKED_BY_POLICY
  // Phase 14 — governance maturity custody events.
  CASE_LEGAL_HOLD_APPLIED
  CASE_LEGAL_HOLD_RELEASED
  PUBLIC_VERIFY_PUBLISHED
  PUBLIC_VERIFY_UNPUBLISHED
  PUBLIC_VERIFY_SUSPENDED
  PUBLIC_VERIFY_RESTORED
  RETENTION_CANDIDATE_IDENTIFIED
  RETENTION_ARCHIVED
  // Phase A2 — PDF artifact signature events. Distinct from the
  // existing REPORT_GENERATED event so reviewers can see the PDF
  // signing decision explicitly in the custody timeline.
  //
  //   REPORT_PDF_SIGNED              — Successful PDF artifact
  //                                    signature recorded against
  //                                    the Report row.
  //   REPORT_PDF_UNSIGNED_OPT_OUT    — Operator-acknowledged unsigned
  //                                    artifact path was taken. The
  //                                    custody entry is the audit
  //                                    record of that choice.
  //
  // SIGNING_FAILED is intentionally NOT a custody event: when the
  // worker's signing call throws, no Report row is written, so no
  // evidence custody chain entry is appropriate. The failure surfaces
  // through the existing worker DLQ + Sentry path.
  REPORT_PDF_SIGNED
  REPORT_PDF_UNSIGNED_OPT_OUT
  // Phase A0 — integrity rejection event. Appended when the worker (or
  // any future reconciler) recomputes the SHA-256 of the stored object
  // and finds it does not match the `fileSha256` recorded at completion.
  // Payload is bounded and operationally specific — `expectedSha256`,
  // `computedSha256`, `source` ("worker.report" | "completion" |
  // "reconciler"), `detectedAtUtc`. The hash chain links this event to
  // the prior custody event the same way every other event does; a
  // FAILED_HASH_MISMATCH terminal state is then set on Evidence. The
  // event itself does NOT claim tampering, authorship, or legal
  // status — it states a mechanical mismatch.
  INTEGRITY_REJECTED_HASH_MISMATCH
  // Phase 1B — Mobile Capture Trust. Emitted by the trust-event service
  // when a capture trust event is appended to the forensic chain.
  CAPTURE_TRUST_EVENT
  // Wave 3 — Investigation mutation custody events. Emitted by the
  // Investigation surfaces whose actions change the evidence meaning
  // or its graph projection. Each value fires from exactly one route
  // handler (Phase 7B wiring). Appended to the existing forensic
  // chain so reviewers see investigation decisions in the same audit
  // trail as integrity events.
  //
  //   DUPLICATE_DECISION_RECORDED        — POST /v1/graph/duplicates/
  //                                        :edgeId/decision succeeded
  //                                        (CONFIRMED | DISMISSED |
  //                                        MARKED_DERIVATIVE).
  //   MANUAL_RELATIONSHIP_CREATED        — POST /v1/graph/relationships/
  //                                        manual succeeded.
  //   MANUAL_RELATIONSHIP_RETRACTED      — DELETE /v1/graph/relationships/
  //                                        manual/:id succeeded.
  //   GRAPH_RECONCILE_REQUESTED          — POST /v1/graph/reconcile invoked
  //                                        by operator (operator-driven
  //                                        reconciliation, not the worker
  //                                        cadence).
  //   MEDIA_INTELLIGENCE_REFRESH_REQUESTED
  //                                      — POST /v1/investigation/media-
  //                                        intelligence/refresh invoked
  //                                        by operator.
  //   INVESTIGATION_GRAPH_EXPORTED       — POST /v1/graph/export succeeded.
  //   INVESTIGATION_TIMELINE_EXPORTED    — POST /v1/graph/timeline/export
  //                                        succeeded.
  //   INVESTIGATION_DUPLICATES_EXPORTED  — POST /v1/graph/duplicates/export
  //                                        succeeded.
  DUPLICATE_DECISION_RECORDED
  MANUAL_RELATIONSHIP_CREATED
  MANUAL_RELATIONSHIP_RETRACTED
  GRAPH_RECONCILE_REQUESTED
  MEDIA_INTELLIGENCE_REFRESH_REQUESTED
  INVESTIGATION_GRAPH_EXPORTED
  INVESTIGATION_TIMELINE_EXPORTED
  INVESTIGATION_DUPLICATES_EXPORTED
}

