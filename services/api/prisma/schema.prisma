/**
 * PHASE 12 CORRECTIVE PASS §2 (INV-001) — THE ROLE/FEDERATION FACET OF AN
 * INVITATION. NOT A SECOND LIFECYCLE.
 *
 * The finding asked whether an external-review invitation being TWO rows is
 * two legitimate bounded aggregates or one duplicated authority. Tracing every
 * reader and writer answered it: this row has no identity of its own. It is
 * created by `issueInvitation` with `id` set to the GRANT's id, so it is 1:1
 * by construction, and nothing ever creates one without a grant.
 *
 * What made it a DUPLICATE AUTHORITY was a set of lifecycle columns that a
 * "model catch-up" migration added here and that no writer has ever
 * populated: `grant_state` (NOT NULL DEFAULT 'PENDING'), `raw_token`,
 * `token_hash`, `expires_at_utc`, `revoked_at_utc`. They encode exactly the
 * lifecycle `ExternalReviewGrant` owns. Most readers correctly took the
 * lifecycle from the grant — `listInvitations` does — but the organization
 * external-access CSV export read them from HERE, so a compliance export
 * reported every grant as `grantState=PENDING` with no expiry and no
 * revocation, whatever the grant actually said.
 *
 * DECISION: `ExternalReviewGrant` is the sole authority for identity,
 * recipient, workspace, token hash, token version, issue time, expiry,
 * revocation, rotation, acceptance and invitation status. This row owns ONLY
 * role, MFA requirement, watermark policy, the federation/SSO binding, and
 * the operator-facing send/accept timestamps used by the console. The
 * duplicate columns are dropped by
 * `20271122000000_external_review_invitation_authority_contract`, which
 * refuses to drop them if any row ever carried a non-default value.
 *
 * `raw_token` was also a plaintext-token column. Nothing wrote it; removing
 * it removes the possibility.
 */
model ExternalReviewerRoleAssignment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId              String    @map("team_id") @db.Uuid
  evidenceId          String    @map("evidence_id") @db.Uuid
  grantedByUserId     String    @map("granted_by_user_id") @db.Uuid
  externalEmail       String    @map("external_email") @db.VarChar(320)
  // Phase 2B Closure — federation + adaptive auth
  authMethod          String    @default("TOKEN") @map("auth_method") @db.VarChar(20)
  ssoConnectionId     String?   @map("sso_connection_id") @db.VarChar(128)
  allowedDomains      String[]  @default([]) @map("allowed_domains")
  ssoSubjectHash      String?   @map("sso_subject_hash") @db.VarChar(128)
  ssoNameId           String?   @map("sso_name_id") @db.VarChar(320)
  ssoBoundAtUtc       DateTime? @map("sso_bound_at_utc") @db.Timestamptz(6)
  mfaSatisfiedAtUtc   DateTime? @map("mfa_satisfied_at_utc") @db.Timestamptz(6)
  // R7 — additive fields used by service code
  role                String?   @db.VarChar(40)
  mfaRequired         Boolean?  @map("mfa_required")
  inviteEmail         String?   @map("invite_email") @db.VarChar(320)
  watermarkPolicy     String?   @map("watermark_policy") @db.VarChar(40)
  inviteResentAtUtc   DateTime? @map("invite_resent_at_utc") @db.Timestamptz(6)
  inviteAcceptedAtUtc DateTime? @map("invite_accepted_at_utc") @db.Timestamptz(6)
  inviteSentAtUtc     DateTime? @map("invite_sent_at_utc") @db.Timestamptz(6)
  organization        String?   @db.VarChar(200)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /**
   * ARCH/INV-001 — the sidecar IS the grant, sharing its id. Declared as a
   * relation so the ORM knows it and the FK the contract migration adds is
   * expressed in the datamodel rather than living only in raw SQL.
   */
  grant      ExternalReviewGrant  @relation(fields: [id], references: [id], onDelete: Cascade)

  deliveries ExternalReviewInvitationDelivery[]
  activities ExternalReviewActivity[]
  comments   ExternalReviewComment[]
  decisions  ExternalReviewDecision[]

  @@index([teamId])
  @@index([evidenceId])
  @@map("external_reviewer_role_assignments")
}

model ExternalReviewInvitationDelivery {
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String    @map("team_id") @db.Uuid
  grantId           String    @map("grant_id") @db.Uuid
  status            String    @default("PENDING") @db.VarChar(20)
  provider          String    @default("RESEND_API") @db.VarChar(40)
  attempt           Int       @default(1)
  providerMsgId     String?   @map("provider_msg_id") @db.VarChar(200)
  bulkBatchId       String?   @map("bulk_batch_id") @db.Uuid
  failureReason     String?   @map("failure_reason") @db.VarChar(400)
  sentAtUtc         DateTime? @map("sent_at_utc") @db.Timestamptz(6)
  openedAtUtc       DateTime? @map("opened_at_utc") @db.Timestamptz(6)
  // R7 — additive delivery-tracking fields
  recipientEmail    String    @map("recipient_email") @db.VarChar(320)
  subject           String    @db.VarChar(400)
  queuedAtUtc       DateTime  @default(now()) @map("queued_at_utc") @db.Timestamptz(6)
  deliveredAtUtc    DateTime? @map("delivered_at_utc") @db.Timestamptz(6)
  failedAtUtc       DateTime? @map("failed_at_utc") @db.Timestamptz(6)
  revokedAtUtc      DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  expiredAtUtc      DateTime? @map("expired_at_utc") @db.Timestamptz(6)
  lastErrorPreview  String?   @map("last_error_preview") @db.VarChar(800)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  /**
   * PHASE 12 CORRECTIVE PASS §3 (NEW-004) — THE DURABLE LOGICAL INTENT.
   *
   * The §1.1 fix keyed the intent on `(team, grant, attempt)` and derived the
   * provider idempotency key from the row id. That collapsed ordinary repeats,
   * which was the point — but it made `attempt` carry two incompatible
   * meanings at once (how many times we have TRIED, and which MESSAGE this
   * is), and it forced a migration that renumbered historical `attempt`
   * values. Renumbering a business-visible counter is a rewrite of history,
   * and the migration described itself as "expand-only, rewrites no history",
   * which was not true.
   *
   * The two meanings are now separate columns:
   *
   *   contentVersion  WHICH generation of the invitation link this message
   *                   carried — the grant's `token_version` at send time. A
   *                   rotation changes the content, so it MUST be a new
   *                   message; without this, a rotated link would collapse
   *                   onto the superseded message's key and the reviewer
   *                   would be left holding a dead link and no successor.
   *   resendSeq       0 for the original send of a given content version, and
   *                   N for the Nth deliberate operator resend of it.
   *   attempt         unchanged in meaning: how many times THIS intent has
   *                   been physically attempted. Historical values are left
   *                   exactly as they were.
   *
   * `intentKey` is the durable identity derived from those, and it — not the
   * row's surrogate id — is what the provider idempotency key is minted from.
   * A retry finds the same intent and therefore presents the same key; a
   * resend or a rotation is a different intent and presents a different one.
   */
  contentVersion    Int       @default(1) @map("content_version")
  resendSeq         Int       @default(0) @map("resend_seq")
  intentKey         String?   @map("intent_key") @db.VarChar(200)

  grant ExternalReviewerRoleAssignment @relation(fields: [grantId], references: [id], onDelete: Cascade)

  // The real intent invariant. Enforced in the database because
  // check-then-insert cannot survive a race: two sessions can both observe
  // "no existing row" before either inserts.
  @@unique([teamId, grantId, contentVersion, resendSeq], map: "external_review_invitation_deliveries_intent_key")
  @@unique([intentKey], map: "external_review_invitation_deliveries_intent_key_uk")
  @@index([teamId, grantId])
  @@index([teamId, status])
  @@map("external_review_invitation_deliveries")
}

