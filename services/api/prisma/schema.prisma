model ReviewerDisagreement {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId           String    @map("workflow_id") @db.Uuid
  teamId               String    @map("team_id") @db.Uuid
  // R7-reviewer-workspace: relaxed to nullable — Phase 2A reviewer-disagreement.service writes use
  // `challengerUserId` as the canonical dispute-owner actor; `filedByUserId` remains as the legacy
  // "who submitted" audit column. Reports/projections coalesce: `filedByUserId ?? challengerUserId`,
  // so the verification manifest always emits a non-null actor when at least one is set.
  filedByUserId        String?   @map("filed_by_user_id") @db.Uuid
  state                String    @default("FILED") @db.VarChar(40)
  // R7-reviewer-workspace: relaxed to nullable — Phase 2A service writes `challengerRationale` as the
  // canonical 800-char free-text rationale. `reason` remains for legacy reads. Projections coalesce:
  // `reason ?? challengerRationale ?? ""`, so reports/manifests always emit a bounded string.
  reason               String?   @db.VarChar(800)
  resolution           String?   @db.VarChar(800)
  resolvedAtUtc        DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolvedByUserId     String?   @map("resolved_by_user_id") @db.Uuid
  // R7-reviewer-workspace additive — Phase 2A reviewer-disagreement service requires:
  //   * originalDecisionId  — links the disagreement back to the decision/value being challenged.
  //   * challengerUserId    — separate from filedByUserId (filer is the SUBMITTER; challenger is the DISPUTE OWNER).
  //   * secondReviewerUserId — assigned second reviewer in the FILED → UNDER_SECOND_REVIEW transition.
  //   * supervisorUserId    — supervisor on the UNDER_SUPERVISOR_REVIEW transition.
  //   * resolution / resolvedAtUtc / resolvedByUserId — canonical bounded final adjudication record.
  //   * filedAtUtc          — explicit filed-at distinct from createdAt (preserved for ordering + reports).
  originalDecisionId   String?   @map("original_decision_id") @db.Uuid
  challengerUserId     String?   @map("challenger_user_id") @db.Uuid
  // R7-reviewer-workspace additive — challenger's written rationale when filing the disagreement
  challengerRationale  String?   @map("challenger_rationale") @db.VarChar(800)
  secondReviewerUserId String?   @map("second_reviewer_user_id") @db.Uuid
  supervisorUserId     String?   @map("supervisor_user_id") @db.Uuid
  filedAtUtc           DateTime  @default(now()) @map("filed_at_utc") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teamId])
  @@index([workflowId])
  @@map("reviewer_disagreements")
}

model QcSample {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId       String    @map("workflow_id") @db.Uuid
  teamId           String    @map("team_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
