  resolvedAtUtc      DateTime?                         @map("resolved_at_utc") @db.Timestamptz(6)
  resolvedByUserId   String?                           @map("resolved_by_user_id") @db.Uuid
  // Phase 2A Closure — annotation threading (parentAnnotationId enables reply chains).
  parentAnnotationId String?                           @map("parent_annotation_id") @db.Uuid
  author             User                              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
