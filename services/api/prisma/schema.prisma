  // Phase 13 — REJECTED_INSUFFICIENT details + reopen pointer.
  rejectionReason        String?                 @map("rejection_reason") @db.VarChar(400)
  reopenCount            Int                     @default(0) @map("reopen_count")
  reopenedAtUtc          DateTime?               @map("reopened_at_utc") @db.Timestamptz(6)
  reopenedByUserId       String?                 @map("reopened_by_user_id") @db.Uuid

  // Phase 25 — explicit assignment / completion SLA dimensions.
  // Phase 13 already tracks firstResponseDueAtUtc + escalationDueAtUtc;
  // Phase 25 adds the missing assignment + completion deadlines so
  // reviewer-ops can score the four dimensions independently.
  assignmentDueAtUtc     DateTime?               @map("assignment_due_at_utc") @db.Timestamptz(6)
  completionDueAtUtc     DateTime?               @map("completion_due_at_utc") @db.Timestamptz(6)
  // Operator-readable reason a workflow is paused (legal hold, awaiting
  // contributor response, etc). Never carries internal legal text — the
  // service truncates to 400 chars and forbids overclaim wording.
  pausedReason           String?                 @map("paused_reason") @db.VarChar(400)
  // Optional pointer to the most recent open escalation. We keep the
  // existing Phase 13 escalation* fields as the denormalised current
  // state; this pointer lets us join cheaply to the first-class record.
  activeEscalationId     String?                 @map("active_escalation_id") @db.Uuid

  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  evidence         Evidence                       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  team             Team?                          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo       User?                          @relation("EvidenceWorkflowAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedBy       User?                          @relation("EvidenceWorkflowAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  escalatedBy      User?                          @relation("EvidenceWorkflowEscalatedBy", fields: [escalatedByUserId], references: [id], onDelete: SetNull)
  reopenedBy       User?                          @relation("EvidenceWorkflowReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  events           EvidenceReviewWorkflowEvent[]
  escalations      ReviewEscalation[]             @relation("ReviewEscalationWorkflow")

  @@index([teamId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([slaStatus, dueAt])
  @@index([escalationLevel, status])
  @@index([assignmentDueAtUtc])
  @@index([completionDueAtUtc])
  @@map("evidence_review_workflows")
}

