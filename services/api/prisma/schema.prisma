  evidenceId                       String    @map("evidence_id") @db.Uuid
  version                          Int
  storageBucket                    String    @map("storage_bucket") @db.VarChar(255)
  sizeBytes                        BigInt?   @map("size_bytes")
  storageKey                       String    @map("storage_key") @db.VarChar(512)
  storageRegion                    String?   @map("storage_region") @db.VarChar(64)
  storageObjectLockMode            String?   @map("storage_object_lock_mode") @db.VarChar(32)
  storageObjectLockRetainUntilUtc  DateTime? @map("storage_object_lock_retain_until_utc") @db.Timestamptz(6)
  storageObjectLockLegalHoldStatus String?   @map("storage_object_lock_legal_hold_status") @db.VarChar(16)
  generatedAtUtc                   DateTime  @map("generated_at_utc") @db.Timestamptz(6)

  verificationStatusSnapshot      VerificationStatus? @map("verification_status_snapshot")
  identityLevelSnapshot           IdentityLevel?      @map("identity_level_snapshot")
  submittedByEmailSnapshot        String?             @map("submitted_by_email_snapshot") @db.VarChar(320)
  submittedByAuthProviderSnapshot AuthProvider?       @map("submitted_by_auth_provider_snapshot")
  captureMethodSnapshot           CaptureMethod?      @map("capture_method_snapshot")
  reviewerSummaryVersion          Int?                @map("reviewer_summary_version")
  verificationPackageVersion      Int?                @map("verification_package_version")

  displayTitleSnapshot              String? @map("display_title_snapshot") @db.VarChar(200)
  displayDescriptionSnapshot        String? @map("display_description_snapshot") @db.VarChar(500)
  contentStructureSnapshot          String? @map("content_structure_snapshot") @db.VarChar(40)
  itemCountSnapshot                 Int?    @map("item_count_snapshot")
  previewableItemCountSnapshot      Int?    @map("previewable_item_count_snapshot")
  downloadableItemCountSnapshot     Int?    @map("downloadable_item_count_snapshot")
  primaryContentKindSnapshot        String? @map("primary_content_kind_snapshot") @db.VarChar(40)
  primaryContentLabelSnapshot       String? @map("primary_content_label_snapshot") @db.VarChar(80)
  contentCompositionSummarySnapshot String? @map("content_composition_summary_snapshot") @db.VarChar(300)
  contentAccessPolicyModeSnapshot   String? @map("content_access_policy_mode_snapshot") @db.VarChar(40)
  defaultPreviewItemIdSnapshot      String? @map("default_preview_item_id_snapshot") @db.Uuid

  workspaceNameSnapshot                  String?             @map("workspace_name_snapshot") @db.VarChar(180)
  organizationNameSnapshot               String?             @map("organization_name_snapshot") @db.VarChar(180)
  organizationVerifiedSnapshot           Boolean?            @map("organization_verified_snapshot")
  recordedIntegrityVerifiedAtUtcSnapshot DateTime?           @map("recorded_integrity_verified_at_utc_snapshot") @db.Timestamptz(6)
  lastVerifiedAtUtcSnapshot              DateTime?           @map("last_verified_at_utc_snapshot") @db.Timestamptz(6)
  lastVerifiedSourceSnapshot             VerificationSource? @map("last_verified_source_snapshot")
  storageImmutableSnapshot               Boolean?            @map("storage_immutable_snapshot")

  displaySnapshot             Json? @map("display_snapshot")
  contentSummarySnapshot      Json? @map("content_summary_snapshot")
  contentItemsSnapshot        Json? @map("content_items_snapshot")
  primaryContentItemSnapshot  Json? @map("primary_content_item_snapshot")
  previewPolicySnapshot       Json? @map("preview_policy_snapshot")
  reviewGuidanceSnapshot      Json? @map("review_guidance_snapshot")
  limitationsSnapshot         Json? @map("limitations_snapshot")
  anchorSnapshot              Json? @map("anchor_snapshot")
  trustDecisionSnapshot       Json? @map("trust_decision_snapshot")
  contentAccessPolicySnapshot Json? @map("content_access_policy_snapshot")
  embeddedPreviewsSnapshot    Json? @map("embedded_previews_snapshot")

  // Phase A2 — explicit PDF artifact signature status. Distinct
  // from `Evidence.signatureBase64` (which is the Ed25519 signature
  // over the canonical fingerprint, never the PDF artifact). The
  // PDF artifact signature is a separate cryptographic act handled
  // by `@signpdf/signer-p12`. Recording the status explicitly on
  // the Report row keeps the API contract honest: the frontend reads
  // this field rather than inferring from labels.
  //
  // Bounded vocabulary (mirrored in `@proovra/shared`):
  //   SIGNED               — the PDF artifact carries a valid PKCS#12
  //                          signature attached at worker time.
  //   UNSIGNED_OPT_OUT     — the operator explicitly acknowledged
  //                          the unsigned-artifact path via
  //                          PDF_ARTIFACT_SIGNATURE_OPT_OUT_ACK=true.
  //                          UI must label the artifact accordingly.
  //   SIGNING_UNAVAILABLE  — non-production environment with signing
  //                          disabled (local dev, preview). The
  //                          response surfaces this distinct from
  //                          UNSIGNED_OPT_OUT.
  //   SIGNING_FAILED       — reserved. Today the worker DLQ's on
  //                          signing failure and no Report row is
  //                          written. Kept in the enum so a future
  //                          partial-success path can record it.
  //   NOT_APPLICABLE       — reserved for non-PDF artifacts.
  pdfSignatureStatus String?   @map("pdf_signature_status") @db.VarChar(32)
  pdfSignedAtUtc     DateTime? @map("pdf_signed_at_utc") @db.Timestamptz(6)
  /// Operator-facing key id label, NEVER the certificate or private
  /// key material. Surfaced in audit metadata and the API response.
  pdfSignerKeyId     String?   @map("pdf_signer_key_id") @db.VarChar(120)
  /// Free-form (bounded) reason string when the artifact is
  /// UNSIGNED_OPT_OUT / SIGNING_FAILED / SIGNING_UNAVAILABLE.
  /// Operator-readable; NEVER carries secrets or stack traces.
  pdfSigningWarning  String?   @map("pdf_signing_warning") @db.VarChar(400)

  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@unique([evidenceId, version])
  @@index([evidenceId])
  @@index([generatedAtUtc(sort: Desc)])
  @@index([storageObjectLockMode])
  @@index([storageObjectLockRetainUntilUtc])
  @@index([verificationStatusSnapshot])
  @@index([reviewerSummaryVersion])
  @@index([verificationPackageVersion])
  @@index([recordedIntegrityVerifiedAtUtcSnapshot])
  @@index([lastVerifiedAtUtcSnapshot])
  @@map("reports")
}

