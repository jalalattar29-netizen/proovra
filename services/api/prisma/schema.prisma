  submittedAtUtc   DateTime  @default(now()) @map("submitted_at_utc") @db.Timestamptz(6)
  reviewedAtUtc    DateTime? @map("reviewed_at_utc") @db.Timestamptz(6)
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidenceRequest  EvidenceRequest        @relation(fields: [evidenceRequestId], references: [id], onDelete: Cascade)
  intakeSession    WorkflowIntakeSession? @relation("EvidenceRequestResponseIntakeSession", fields: [intakeSessionId], references: [id], onDelete: SetNull)
  responseEvidence Evidence?              @relation("EvidenceRequestResponseEvidence", fields: [responseEvidenceId], references: [id], onDelete: SetNull)
  submittedBy      User?                  @relation("EvidenceRequestResponseSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
