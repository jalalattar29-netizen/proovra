model User {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                         String?                        @db.VarChar(320)
  displayName                   String?                        @map("display_name") @db.VarChar(120)
  platformRole                  String?                        @map("platform_role") @db.VarChar(32)
  // PHASE 10 §13.2 (2026-07-22) — identity/account mode. STANDARD is the
  // normal self-service identity (personal space, personal export,
  // self-managed lifecycle). MANAGED_ENTERPRISE is an org-controlled
  // identity: NO personal space, SSO-only authentication, no personal
  // data export, org-controlled lifecycle + immediate deprovisioning.
  // Default STANDARD — existing accounts are never silently converted;
  // conversion is an explicit, audited admin action (never a login side
  // effect). §13.1/§13.3 (mandatory SSO, government mode) build on this.
  identityMode                  UserIdentityMode               @default(STANDARD) @map("identity_mode")
  // PHASE 10 §0B (2026-07-23) — MANAGED IDENTITY OWNERSHIP. `identityMode` is a
  // global flag; these bind it to the ONE managing Organization + the verified
  // provenance that established management. MANAGED_ENTERPRISE is authoritative
  // ONLY when `managingOrganizationId` is set. A managing Org governs ONLY this
  // identity's managed policy (no-personal, mandatory-SSO) — never an unrelated
  // Organization the user also belongs to. ON DELETE SET NULL: releasing the
  // managing Org / connection never deletes the User, Personal custody, or
  // other memberships. (Migration 20271002000000, authored NOT applied.)
  managingOrganizationId        String?                        @map("managing_organization_id") @db.Uuid
  managedIdentitySource         ManagedIdentitySource?         @map("managed_identity_source")
  managedBySsoConnectionId      String?                        @map("managed_by_sso_connection_id") @db.Uuid
  managingOrganization          Organization?                  @relation("ManagedIdentityOrg", fields: [managingOrganizationId], references: [id], onDelete: SetNull)
  managedBySsoConnection        SsoConnection?                 @relation("ManagedIdentityConn", fields: [managedBySsoConnectionId], references: [id], onDelete: SetNull)
  provider                      AuthProvider
  providerUserId                String                         @map("provider_user_id") @db.VarChar(128)
