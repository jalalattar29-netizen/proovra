model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Phase 17 — access lifecycle. Default ACTIVE preserves pre-17
  // behavior. SUSPENDED + REVOKED are explicit operator actions;
  // every access check MUST reject anything other than ACTIVE.
  status                TeamMemberStatus @default(ACTIVE)
  accessGrantedAtUtc    DateTime?        @map("access_granted_at_utc") @db.Timestamptz(6)
  accessGrantedByUserId String?          @map("access_granted_by_user_id") @db.Uuid
  accessReason          String?          @map("access_reason") @db.VarChar(400)
  accessExpiresAtUtc    DateTime?        @map("access_expires_at_utc") @db.Timestamptz(6)
  suspendedAtUtc        DateTime?        @map("suspended_at_utc") @db.Timestamptz(6)
  suspendedByUserId     String?          @map("suspended_by_user_id") @db.Uuid
  suspensionReason      String?          @map("suspension_reason") @db.VarChar(400)
  revokedAtUtc          DateTime?        @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId       String?          @map("revoked_by_user_id") @db.Uuid
  revocationReason      String?          @map("revocation_reason") @db.VarChar(400)
  lastSeenAtUtc         DateTime?        @map("last_seen_at_utc") @db.Timestamptz(6)

  team                 Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessGrantedBy      User?                       @relation("TeamMemberAccessGrantedBy", fields: [accessGrantedByUserId], references: [id], onDelete: SetNull)
  suspendedBy          User?                       @relation("TeamMemberSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  revokedBy            User?                       @relation("TeamMemberRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  capabilityGrants     MemberCapabilityGrant[]     @relation("MemberCapabilityGrants")
  delegatedAdminScopes MemberDelegatedAdminScope[] @relation("MemberDelegatedAdminScopes")

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, status])
  @@index([accessExpiresAtUtc])
  @@map("team_members")
}

/// PHASE 3 (2026-07-21) — normalized membership-grant provenance.
///
/// A user may hold the SAME membership through multiple sources (e.g. a
/// manual admin assignment AND an IdP group mapping). Each source is one
/// grant row; revoking one source revokes only that grant, and the
/// membership itself is deactivated only when NO active grant remains
/// (source-aware revocation — services/identity/membership-provisioning).
/// Exactly one of `teamMemberId` / `organizationMembershipId` is set.
model MembershipGrant {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamMemberId             String?               @map("team_member_id") @db.Uuid
  organizationMembershipId String?               @map("organization_membership_id") @db.Uuid
  source                   MembershipGrantSource
  /// Canonical provisioning intent that created this grant (bounded
  /// vocabulary from the orchestrator; stored as text for forward compat).
  intent                   String                @db.VarChar(60)
  grantedByUserId          String?               @map("granted_by_user_id") @db.Uuid
  /// External correlation: SCIM externalId, IdP group id, invite id, …
  externalRef              String?               @map("external_ref") @db.VarChar(200)
  /// Role carried by THIS grant source (precedence resolution input).
  grantedRole              String?               @map("granted_role") @db.VarChar(40)
  revokedAtUtc             DateTime?             @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId          String?               @map("revoked_by_user_id") @db.Uuid
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([teamMemberId, revokedAtUtc])
  @@index([organizationMembershipId, revokedAtUtc])
  @@index([source, externalRef])
  @@map("membership_grants")
}

/// PHASE 4 (2026-07-22) — canonical Enterprise contract state (§7.2).
/// ONE authoritative record of an Enterprise customer's commercial scope.
/// Plan strings on workspaces and `pendingEnterpriseSeats` are LEGACY
/// signals consumed only by the resolver's compatibility fallback until the
/// contract backfill migration is applied.
model EnterpriseContract {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                   @unique @map("organization_id") @db.Uuid
  status                 EnterpriseContractStatus @default(PENDING_ACTIVATION)
  /// Owner-onboarding progress: PENDING_OWNER | OWNER_INVITED | ACTIVATED.
  activationState        String?                  @map("activation_state") @db.VarChar(40)
  effectiveAtUtc         DateTime?                @map("effective_at_utc") @db.Timestamptz(6)
  endsAtUtc              DateTime?                @map("ends_at_utc") @db.Timestamptz(6)
  seatCount              Int?                     @map("seat_count")
  storageGb              Int?                     @map("storage_gb")
  region                 String?                  @db.VarChar(40)
  planVersion            String?                  @map("plan_version") @db.VarChar(40)
  billingCustomerRef     String?                  @map("billing_customer_ref") @db.VarChar(200)
  billingSubscriptionRef String?                  @map("billing_subscription_ref") @db.VarChar(200)
  contractOwnerUserId    String?                  @map("contract_owner_user_id") @db.Uuid
  terminatedAtUtc        DateTime?                @map("terminated_at_utc") @db.Timestamptz(6)
  terminationReason      String?                  @map("termination_reason") @db.VarChar(400)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("OrganizationEnterpriseContract", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("enterprise_contracts")
}

enum EnterpriseContractStatus {
  DRAFT
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// PHASE 4 §7.1 (2026-07-22) — Enterprise provisioning idempotency.
/// The canonical duplicate-prevention identity is the IMMUTABLE
/// `idempotencyKey` (caller-supplied provisioning-request id / CRM contract
/// reference) — NEVER normalized names or emails (names are not unique, an
/// owner may own several Organizations, and both may change). The DB unique
/// constraint makes concurrent same-key requests collapse to exactly one
/// provisioning result.
model EnterpriseProvisioningRequest {
  id                   String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey       String                              @unique @map("idempotency_key") @db.VarChar(120)
  /// SHA-256 of the canonicalized payload — same key + different payload
  /// is an idempotency CONFLICT, never a partial mutation.
  payloadHash          String                              @map("payload_hash") @db.VarChar(64)
