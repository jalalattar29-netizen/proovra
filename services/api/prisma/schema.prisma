  ssoConnections            SsoConnection[]
  scimProvisioningTokens    ScimProvisioningToken[]
  authenticatedSessions     AuthenticatedSession[]

  // Phase 26.5 — Identity hardening back-relations.
  ssoCallbackAttempts       SsoCallbackAttempt[]
  scimGroups                ScimGroup[]

  // Phase 27 — Governance lifecycle back-relations.
  evidenceRetentionPolicies EvidenceRetentionPolicy[]
  destructionReviews        DestructionReview[]
  evidenceLifecycleEvents   EvidenceLifecycleEvent[]

  // Phase 27.5 — Governance operationalization back-relations.
