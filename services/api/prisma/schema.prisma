  failureReasons   Json      @default("[]") @map("failure_reasons")
  sampledAtUtc     DateTime  @default(now()) @map("sampled_at_utc") @db.Timestamptz(6)
  verdictAtUtc     DateTime? @map("verdict_at_utc") @db.Timestamptz(6)
  // R7-reviewer-workspace additive — Phase 2A QC service requires:
  //   * state           — QC lifecycle state (SAMPLED → ASSIGNED → COMPLETED). Distinct from `verdict` which
  //                       is the QC outcome (PASS / FAIL / DEFER); state is the workflow stage.
  //   * qcReviewerUserId — the QC reviewer (separate from assignedToUserId because assignedTo can be reassigned
  //                       mid-flight while the qcReviewer is the audit-bound principal who recorded the verdict).
  state            String?   @db.VarChar(20)
  qcReviewerUserId String?   @map("qc_reviewer_user_id") @db.Uuid
  // R7-reviewer-workspace additive — Phase 2A QC service uses these on the VERDICT_RENDERED transition:
  //   * failureReason  — singular freeform reason (distinct from the existing `failureReasons` JSON array
  //                      which is the bounded enum-coded list; this `failureReason` is the reviewer's note).
  //   * rationale      — reviewer rationale for the verdict (used by reviewer-metrics for explainability).
  //   * renderedAtUtc  — when the verdict was rendered (distinct from `verdictAtUtc` which marks the
  //                      verdict CAPTURE moment; `renderedAtUtc` marks the UI render-back to the reviewer).
  //   * assignedAtUtc  — when the sample was assigned to a QC reviewer (distinct from sampledAtUtc + verdictAtUtc).
  failureReason    String?   @map("failure_reason") @db.VarChar(800)
  rationale        String?   @db.VarChar(800)
  renderedAtUtc    DateTime? @map("rendered_at_utc") @db.Timestamptz(6)
  assignedAtUtc    DateTime? @map("assigned_at_utc") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teamId])
  @@index([workflowId])
  @@map("qc_samples")
}

