  confidenceBand   String    @default("MEDIUM") @map("confidence_band") @db.VarChar(20)
  authoredByUserId String?   @map("authored_by_user_id") @db.Uuid
  decidedByUserId  String?   @map("decided_by_user_id") @db.Uuid
  decidedAtUtc     DateTime? @map("decided_at_utc") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  detections VideoTrackDetection[]

  @@index([teamId])
  @@index([evidenceId])
  @@map("video_tracks")
}

model VideoFrame {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  evidenceId    String   @map("evidence_id") @db.Uuid
  frameIndex    Int      @map("frame_index")
  timestampMs   BigInt   @map("timestamp_ms")
  extractor     String   @db.VarChar(40)
  storageBucket String?  @map("storage_bucket") @db.VarChar(255)
  storageKey    String?  @map("storage_key") @db.VarChar(512)
  storageRegion String?  @map("storage_region") @db.VarChar(64)
  byteSize      BigInt?  @map("byte_size")
  contentType   String?  @map("content_type") @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  detections VideoTrackDetection[]

  @@unique([teamId, evidenceId, frameIndex])
  @@index([teamId])
  @@index([evidenceId])
  @@map("video_frames")
}

model VideoTrackDetection {
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  trackId       String   @map("track_id") @db.Uuid
  frameId       String   @map("frame_id") @db.Uuid
  bbox          Json
  rawConfidence Float    @map("raw_confidence")

  track VideoTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  frame VideoFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  // Phase 3A Elite — one track-frame detection pair is unique by construction:
  // a single tracker run cannot emit two detections of the same track on the
  // same frame. The implicit name auto-derived from the bracket fields is
  // `trackId_frameId` — identical to the prior explicit `name:` value, so the
  // Prisma client identifier callers use remains stable.
  @@unique([trackId, frameId])
  @@index([teamId])
  @@map("video_track_detections")
}

// ---------------------------------------------------------------------------
// Phase 2B — External Review Activity / Comment / Decision
// ---------------------------------------------------------------------------

model ExternalReviewActivity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  grantId       String   @map("grant_id") @db.Uuid
  code          String   @db.VarChar(80)
  sessionId     String?  @map("session_id") @db.VarChar(128)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(400)
  payload       Json?
  occurredAtUtc DateTime @default(now()) @map("occurred_at_utc") @db.Timestamptz(6)

  grant ExternalReviewerRoleAssignment @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([teamId, grantId])
  @@index([occurredAtUtc(sort: Desc)])
  @@map("external_review_activities")
}

model ExternalReviewComment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  grantId         String    @map("grant_id") @db.Uuid
  workflowId      String    @map("workflow_id") @db.Uuid
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  body            String    @db.VarChar(4000)
  authorEmail     String    @map("author_email") @db.VarChar(320)
  authorDisplay   String?   @map("author_display") @db.VarChar(200)
  resolvedAtUtc   DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  grant   ExternalReviewerRoleAssignment @relation(fields: [grantId], references: [id], onDelete: Cascade)
  // Phase 2B — self-relation "ExternalReviewCommentThread". The thread
  // parent is the comment a reply attaches to. Children CASCADE so deleting
  // a top-level external comment removes its replies. Named relation
  // avoids ambiguity (the model could acquire other self-relations later).
  parent  ExternalReviewComment?         @relation("ExternalReviewCommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies ExternalReviewComment[]        @relation("ExternalReviewCommentThread")

  @@index([teamId, workflowId])
  @@index([teamId, grantId])
  // Phase 2B — index supports the threaded-replies query path.
  @@index([parentCommentId])
  @@map("external_review_comments")
}

model ExternalReviewDecision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  grantId         String   @map("grant_id") @db.Uuid
  workflowId      String   @map("workflow_id") @db.Uuid
  verdict         String   @db.VarChar(40)
  rationale       String?  @db.VarChar(600)
  reviewerEmail   String   @map("reviewer_email") @db.VarChar(320)
  reviewerDisplay String?  @map("reviewer_display") @db.VarChar(200)
  submittedAtUtc  DateTime @default(now()) @map("submitted_at_utc") @db.Timestamptz(6)

  grant ExternalReviewerRoleAssignment @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, workflowId], name: "external_review_decision_grant_workflow_uniq")
  @@index([teamId, workflowId])
  @@index([teamId, grantId])
  @@map("external_review_decisions")
}

// =============================================================================
// Phase 5 — Collaboration Teams
//
// The CollaborationTeam* models are the canonical Team Collaboration
// Platform. They are STRICTLY ADDITIVE and live alongside the legacy
// `Team` table (which is the runtime workspace — see DBT-WS-04). The
// legacy `Team` table is NOT renamed and these models do NOT replace it.
//
// Constitutional rules (see docs/architecture/phase-5-team-platform-
// readiness.md):
//
//   1. CollaborationTeam is a COLLABORATION SUB-UNIT, not a workspace.
//   2. Every CollaborationTeam belongs to exactly one workspace
//      (`workspaceId` references the legacy `Team.id`).
//   3. CollaborationTeam works in PERSONAL workspaces and ORGANIZATION
//      workspaces — Organization is NOT required.
//   4. CollaborationTeam does NOT own Evidence/Cases; it can be the
//      ASSIGNEE of Cases/Evidence/Reviews via CollaborationTeamAssignment.
//   5. All mutations emit a CollaborationTeamActivity row for audit.
// =============================================================================

model CollaborationTeam {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Parent workspace = the legacy `Team` row (DBT-WS-04 — runtime workspace).
  // PERSONAL workspaces have `Team.isPersonal = true`; org workspaces don't.
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(600)
  // Bounded template/type — keep tight, expand only via test pin.
  // "GENERAL" / "INVESTIGATION" / "LEGAL" / "REVIEW" / "COMPLIANCE".
  teamType        String    @default("GENERAL") @map("team_type") @db.VarChar(40)
  // ACTIVE / ARCHIVED.
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAtUtc   DateTime? @map("archived_at_utc") @db.Timestamptz(6)

  workspace Team @relation("CollaborationTeamWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User @relation("CollaborationTeamCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  members     CollaborationTeamMember[]     @relation("CollaborationTeamMembers")
  invites     CollaborationTeamInvite[]     @relation("CollaborationTeamInvites")
  activity    CollaborationTeamActivity[]   @relation("CollaborationTeamActivityFeed")
  assignments CollaborationTeamAssignment[] @relation("CollaborationTeamAssignments")

  // Phase 7 — Collaboration Completion team back-relations.
  comments                CollaborationTeamComment[]                @relation("CollaborationTeamCommentTeam")
  notifications           CollaborationTeamNotification[]           @relation("CollaborationTeamNotificationTeam")
  notificationPreferences CollaborationTeamNotificationPreference[] @relation("CollaborationTeamNotificationPreferenceTeam")
  guests                  CollaborationTeamGuest[]                  @relation("CollaborationTeamGuestTeam")
  accessReviews           CollaborationTeamAccessReview[]           @relation("CollaborationTeamAccessReviewTeam")

  @@index([workspaceId, status])
  @@index([createdByUserId])
  @@map("collaboration_teams")
}

model CollaborationTeamMember {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // Bounded role enum — kept in shared/permissions for canonical reference.
  // LEAD / ADMIN / MEMBER / VIEWER / EXTERNAL.
  role            String    @default("MEMBER") @db.VarChar(20)
  // ACTIVE / SUSPENDED / REMOVED.
  status          String    @default("ACTIVE") @db.VarChar(20)
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt     DateTime? @map("suspended_at") @db.Timestamptz(6)
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  // Optional human-readable note on suspension/removal (no PII).
  statusReason    String?   @map("status_reason") @db.VarChar(400)

  team      CollaborationTeam @relation("CollaborationTeamMembers", fields: [teamId], references: [id], onDelete: Cascade)
  user      User              @relation("CollaborationTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?             @relation("CollaborationTeamMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  // Phase 7 — Access review items reference this member.
  accessReviewItems CollaborationTeamAccessReviewItem[] @relation("CollaborationTeamAccessReviewItemMember")

  // One row per (team, user). Removed/suspended members keep a single
  // row so audit + reinstatement is straightforward.
  @@unique([teamId, userId], name: "collaboration_team_member_team_user_uniq")
  @@index([teamId, status])
  @@index([userId, status])
  @@map("collaboration_team_members")
}

model CollaborationTeamInvite {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId               String    @map("team_id") @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  // EMAIL / SMS / LINK.
  channel              String    @db.VarChar(10)
  email                String?   @db.VarChar(320)
  phone                String?   @db.VarChar(20)
  // Hashed (sha256) token — raw token is never persisted.
  tokenHash            String    @map("token_hash") @db.VarChar(128)
  // Role granted on accept — LEAD / ADMIN / MEMBER / VIEWER / EXTERNAL.
  role                 String    @default("MEMBER") @db.VarChar(20)
  // PENDING / ACCEPTED / REVOKED / EXPIRED.
  status               String    @default("PENDING") @db.VarChar(20)
  expiresAtUtc         DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  maxUses              Int       @default(1) @map("max_uses")
  useCount             Int       @default(0) @map("use_count")
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  acceptedByUserId     String?   @map("accepted_by_user_id") @db.Uuid
  acceptedAtUtc        DateTime? @map("accepted_at_utc") @db.Timestamptz(6)
  revokedAtUtc         DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  // Bounded delivery status — PENDING / SENT / DELIVERED / FAILED / BOUNCED.
  deliveryStatus       String    @default("PENDING") @map("delivery_status") @db.VarChar(20)
  // Audit-safe error preview; never raw provider payload.
  deliveryErrorPreview String?   @map("delivery_error_preview") @db.VarChar(280)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team       CollaborationTeam @relation("CollaborationTeamInvites", fields: [teamId], references: [id], onDelete: Cascade)
  workspace  Team              @relation("CollaborationTeamInviteWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("CollaborationTeamInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?             @relation("CollaborationTeamInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  // Token-hash uniqueness — sha256 hashes are highly entropic so a
  // global unique constraint is safe and prevents accidental cross-tenant
  // collision. The hash itself is indistinguishable from a random value
  // and never reveals workspace/team.
  @@unique([tokenHash], name: "collaboration_team_invite_token_hash_uniq")
  @@index([teamId, status])
  @@index([workspaceId, status])
  @@index([email, status])
  @@map("collaboration_team_invites")
}

model CollaborationTeamActivity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // Bounded event type — see CollaborationTeamActivityType enum in
  // packages/shared/src/collaboration-team.ts.
  eventType   String   @map("event_type") @db.VarChar(64)
  // Optional target reference (case / evidence / review / member /
  // invite / assignment). Stored as bounded type + id.
  targetType  String?  @map("target_type") @db.VarChar(40)
  targetId    String?  @map("target_id") @db.Uuid
  // Bounded JSON metadata — never user-provided HTML. Max ~4 KB.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team      CollaborationTeam @relation("CollaborationTeamActivityFeed", fields: [teamId], references: [id], onDelete: Cascade)
  workspace Team              @relation("CollaborationTeamActivityWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?             @relation("CollaborationTeamActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("collaboration_team_activity")
}

// =============================================================================
// Phase 7 — Collaboration Completion (additive models)
//
// All 7 tables added in Phase 7 are STRICTLY ADDITIVE alongside the
// Phase 5 collaboration_team* tables. They never alter an existing
// column, never replace the existing `Team` or `User` tables, and
// never require a data migration on existing rows. See
// docs/architecture/phase-7-collaboration-completion-final.md.
// =============================================================================

model CollaborationTeamComment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  // Bounded target type: TEAM / ASSIGNMENT / CASE / EVIDENCE / REVIEW.
  targetType      String    @map("target_type") @db.VarChar(20)
  targetId        String?   @map("target_id") @db.Uuid
  // Sanitised plain-text body (HTML escaped at the service layer).
  body            String    @db.VarChar(4000)
  // ACTIVE / EDITED / DELETED.
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAtUtc    DateTime? @map("deleted_at_utc") @db.Timestamptz(6)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid

  team      CollaborationTeam                 @relation("CollaborationTeamCommentTeam", fields: [teamId], references: [id], onDelete: Cascade)
  workspace Team                              @relation("CollaborationTeamCommentWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User                              @relation("CollaborationTeamCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  deletedBy User?                             @relation("CollaborationTeamCommentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  mentions  CollaborationTeamCommentMention[] @relation("CollaborationTeamCommentMentions")

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, targetType, targetId])
  @@map("collaboration_team_comments")
}

model CollaborationTeamCommentMention {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commentId       String   @map("comment_id") @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  // Bounded mention type: USER / TEAM / LEAD.
  mentionType     String   @map("mention_type") @db.VarChar(10)
  // Populated for USER mentions only (after resolution).
  mentionedUserId String?  @map("mentioned_user_id") @db.Uuid
  // Raw mention token from the body (e.g. "@alice"). Persisted for
  // audit so even unresolvable mentions are visible to operators.
  rawHandle       String?  @map("raw_handle") @db.VarChar(80)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment       CollaborationTeamComment @relation("CollaborationTeamCommentMentions", fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User?                    @relation("CollaborationTeamCommentMentionUser", fields: [mentionedUserId], references: [id], onDelete: SetNull)

  @@index([teamId, mentionType])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("collaboration_team_comment_mentions")
}

model CollaborationTeamNotification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  teamId      String?   @map("team_id") @db.Uuid
  // Bounded notification type — see COLLABORATION_TEAM_NOTIFICATION_TYPES
  // in packages/shared/src/collaboration-team.ts (Phase 7 additions).
  type        String    @db.VarChar(40)
  title       String    @db.VarChar(200)
  body        String?   @db.VarChar(1000)
  // Optional deep-link target (bounded for security).
  targetType  String?   @map("target_type") @db.VarChar(40)
  targetId    String?   @map("target_id") @db.Uuid
  // null = unread.
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User               @relation("CollaborationTeamNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace Team               @relation("CollaborationTeamNotificationWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  team      CollaborationTeam? @relation("CollaborationTeamNotificationTeam", fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@map("collaboration_team_notifications")
}

model CollaborationTeamNotificationPreference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  // Bounded prefs: every flag defaults to true except activityDigest.
  mentions       Boolean  @default(true)
  assignments    Boolean  @default(true)
  inviteAccepted Boolean  @default(true) @map("invite_accepted")
  // INSTANT / DAILY / MUTED.
  digest         String   @default("INSTANT") @db.VarChar(10)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team CollaborationTeam @relation("CollaborationTeamNotificationPreferenceTeam", fields: [teamId], references: [id], onDelete: Cascade)
  user User              @relation("CollaborationTeamNotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "collaboration_team_notification_preference_team_user_uniq")
  @@map("collaboration_team_notification_preferences")
}

model CollaborationTeamGuest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  // Identifier for the guest — email at minimum. NOT a User row.
  // When the guest signs in (or is auto-provisioned), `acceptedUserId`
  // is populated and the guest becomes a TeamMember with role
  // EXTERNAL. Until then this row is the canonical record.
  email           String    @db.VarChar(320)
  // Time-bounded access window.
  expiresAtUtc    DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  // Bounded status: PENDING / ACCEPTED / REVOKED / EXPIRED.
  status          String    @default("PENDING") @db.VarChar(20)
  // Audit fields.
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  acceptedUserId  String?   @map("accepted_user_id") @db.Uuid
  acceptedAtUtc   DateTime? @map("accepted_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  // Scope description (optional human note about what they can access).
  scopeNote       String?   @map("scope_note") @db.VarChar(400)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team         CollaborationTeam @relation("CollaborationTeamGuestTeam", fields: [teamId], references: [id], onDelete: Cascade)
  workspace    Team              @relation("CollaborationTeamGuestWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User              @relation("CollaborationTeamGuestInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedUser User?             @relation("CollaborationTeamGuestAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  revokedBy    User?             @relation("CollaborationTeamGuestRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([workspaceId, status])
  @@index([email, status])
  @@map("collaboration_team_guests")
}

model CollaborationTeamAccessReview {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String    @map("team_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  // OPEN / COMPLETED / CANCELLED.
  status          String    @default("OPEN") @db.VarChar(20)
  dueAtUtc        DateTime? @map("due_at_utc") @db.Timestamptz(6)
  completedAtUtc  DateTime? @map("completed_at_utc") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team      CollaborationTeam                   @relation("CollaborationTeamAccessReviewTeam", fields: [teamId], references: [id], onDelete: Cascade)
  workspace Team                                @relation("CollaborationTeamAccessReviewWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                                @relation("CollaborationTeamAccessReviewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     CollaborationTeamAccessReviewItem[] @relation("CollaborationTeamAccessReviewItems")

  @@index([teamId, status])
  @@index([workspaceId, status])
  @@map("collaboration_team_access_reviews")
}

model CollaborationTeamAccessReviewItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId        String    @map("review_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  // PENDING / KEEP / REMOVE / CHANGE_ROLE.
  decision        String    @default("PENDING") @db.VarChar(20)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  notes           String?   @db.VarChar(600)

