  storageBytesOverride   BigInt?                        @map("storage_bytes_override")

  owner                  User                           @relation("TeamOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  billingOwner           User?                          @relation("TeamBillingOwner", fields: [billingOwnerUserId], references: [id], onDelete: SetNull)

  // Phase 2 Workflow Engine: workspace category drives default template
  // selection and policy resolution. Nullable for backwards compatibility —
  // existing teams continue to behave as if categorized GENERAL.
  workspaceCategory      WorkspaceCategory?             @map("workspace_category")

  invites                TeamInvite[]
  members                TeamMember[]
  activities             TeamActivity[]
  payments               Payment[]
  subscriptions          Subscription[]
  storageAddons          WorkspaceStorageAddon[]
  evidenceReviewWorkflows EvidenceReviewWorkflow[]
  evidenceRelationships  EvidenceRelationship[]
  evidenceWorkflowTemplates EvidenceWorkflowTemplate[]
  workflowIntakeLinks    WorkflowIntakeLink[]
  evidenceRequests       EvidenceRequest[]
  governancePolicy       WorkspaceGovernancePolicy?
  legalHolds             EvidenceLegalHold[]
  apiCredentials         ApiCredential[]
  webhookEndpoints       WebhookEndpoint[]

  // Phase 17 — identity & access platform back-relations.
  securityPolicy         OrganizationSecurityPolicy?
  accessReviews          AccessReview[]
  capabilityGrants       MemberCapabilityGrant[]
  delegatedAdminScopes   MemberDelegatedAdminScope[]
  externalIdentityMappings ExternalIdentityMapping[]

  // Phase 18 — communications platform back-relations.
  communicationMessages    CommunicationMessage[]
  communicationPreferences CommunicationPreference[]
  verificationAttempts     VerificationAttempt[]

  // Phase 19 — identity security back-relations.
  stepUpChallenges         StepUpChallenge[]
  trustedDevices           TrustedDevice[]
  revokedSessions          RevokedSession[]
  riskSignals              RiskSignal[]

  // Phase 21 — observability back-relations.
  operationalIncidents     OperationalIncident[]

  // Phase 22 — Evidence Workflow Engine back-relations.
  evidenceWorkflowInstances EvidenceWorkflowInstance[]

  // Phase 24 — Enterprise Evidence Discovery back-relations.
  evidenceSearchDocuments   EvidenceSearchDocument[]
  savedSearchViews          SavedSearchView[]

  // Phase 25 — Reviewer Operations Intelligence back-relations.
  reviewEscalations         ReviewEscalation[]
  reviewerWorkloadSnapshots ReviewerWorkloadSnapshot[]

