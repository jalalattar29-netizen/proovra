   * a persisted VARCHAR carrying "PERSONAL" or "TEAM" on every existing row.
   * Renaming the column would rewrite settled history for a label; renaming
   * only the Prisma field would put a second name on one fact.
   *
   * What matters is that it is INERT: it is written once at workflow creation
   * and read back only as a display label. It authorizes nothing, selects no
   * tenant, grants no entitlement and decides no plan — which is exactly why
   * leaving the name alone is safe, and the vocabulary gate asserts that it
   * stays that way.
   */
  workspaceType    String                         @map("workspace_type") @db.VarChar(32)
  teamId           String?                        @map("team_id") @db.Uuid
  assignedToUserId String?                        @map("assigned_to_user_id") @db.Uuid
  assignedByUserId String?                        @map("assigned_by_user_id") @db.Uuid
  status           EvidenceReviewWorkflowStatus   @default(NOT_STARTED)
  priority         EvidenceReviewWorkflowPriority @default(NORMAL)
  dueAt            DateTime?                      @map("due_at") @db.Timestamptz(6)
  lastReviewedAt   DateTime?                      @map("last_reviewed_at") @db.Timestamptz(6)
  closedAt         DateTime?                      @map("closed_at") @db.Timestamptz(6)

  // Phase 13 — assignment metadata.
  assignedAtUtc         DateTime?                @map("assigned_at_utc") @db.Timestamptz(6)
  reassignedAtUtc       DateTime?                @map("reassigned_at_utc") @db.Timestamptz(6)
  // Phase 13 — SLA fields (all optional; SLA is opt-in per workflow).
  firstResponseDueAtUtc DateTime?                @map("first_response_due_at_utc") @db.Timestamptz(6)
  escalationDueAtUtc    DateTime?                @map("escalation_due_at_utc") @db.Timestamptz(6)
  completedAtUtc        DateTime?                @map("completed_at_utc") @db.Timestamptz(6)
  slaStatus             EvidenceReviewSlaStatus? @map("sla_status")
  slaPausedAtUtc        DateTime?                @map("sla_paused_at_utc") @db.Timestamptz(6)
  // Phase 13 — escalation tracking. `escalationLevel` is 0 by default
  // and increments on each manual / automatic escalation.
  escalationLevel       Int                      @default(0) @map("escalation_level")
  escalatedAtUtc        DateTime?                @map("escalated_at_utc") @db.Timestamptz(6)
  escalatedByUserId     String?                  @map("escalated_by_user_id") @db.Uuid
  escalationReason      String?                  @map("escalation_reason") @db.VarChar(400)
  // Phase 13 — REJECTED_INSUFFICIENT details + reopen pointer.
  rejectionReason       String?                  @map("rejection_reason") @db.VarChar(400)
  reopenCount           Int                      @default(0) @map("reopen_count")
  reopenedAtUtc         DateTime?                @map("reopened_at_utc") @db.Timestamptz(6)
  reopenedByUserId      String?                  @map("reopened_by_user_id") @db.Uuid

  // Phase 25 — explicit assignment / completion SLA dimensions.
  // Phase 13 already tracks firstResponseDueAtUtc + escalationDueAtUtc;
  // Phase 25 adds the missing assignment + completion deadlines so
  // reviewer-ops can score the four dimensions independently.
  assignmentDueAtUtc DateTime? @map("assignment_due_at_utc") @db.Timestamptz(6)
  completionDueAtUtc DateTime? @map("completion_due_at_utc") @db.Timestamptz(6)
  // Operator-readable reason a workflow is paused (legal hold, awaiting
  // contributor response, etc). Never carries internal legal text — the
  // service truncates to 400 chars and forbids overclaim wording.
  pausedReason       String?   @map("paused_reason") @db.VarChar(400)
  // Optional pointer to the most recent open escalation. We keep the
  // existing Phase 13 escalation* fields as the denormalised current
  // state; this pointer lets us join cheaply to the first-class record.
  activeEscalationId String?   @map("active_escalation_id") @db.Uuid

  // Phase 2A — coding schema binding (nullable so existing workflows remain valid).
  codingSchemaId      String? @map("coding_schema_id") @db.Uuid
  codingSchemaVersion Int?    @map("coding_schema_version")

  // Phase T — Canonical workflow-template identity trio (additive, nullable).
  //
  // Mirrors the columns on Evidence so a reviewer-workflow can be
  // attributed to its source template WITHOUT a separate workflow
  // identity service. Stamped at upsert time from the Evidence row;
  // legacy workflows remain NULL.
  //
  // Same identity contract as Evidence:
  //   * templateSlug    — stable slug, consistent across seed + DB.
  //   * templateVersion — matches EvidenceWorkflowTemplate.version.
  //   * templateDbId    — UUID FK, set only when a DB row backs the slug.
  //                       SetNull on delete preserves audit history.
  templateSlug    String?                   @map("template_slug") @db.VarChar(120)
  templateVersion Int?                      @map("template_version")
  templateDbId    String?                   @map("template_db_id") @db.Uuid
  template        EvidenceWorkflowTemplate? @relation("ReviewWorkflowTemplate", fields: [templateDbId], references: [id], onDelete: SetNull)

  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  evidence    Evidence                      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  team        Team?                         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo  User?                         @relation("EvidenceWorkflowAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedBy  User?                         @relation("EvidenceWorkflowAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  escalatedBy User?                         @relation("EvidenceWorkflowEscalatedBy", fields: [escalatedByUserId], references: [id], onDelete: SetNull)
  reopenedBy  User?                         @relation("EvidenceWorkflowReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  events      EvidenceReviewWorkflowEvent[]
  escalations ReviewEscalation[]            @relation("ReviewEscalationWorkflow")

  // Phase B.2 — multi-stage review back-relation. New rows are
  // additive; existing workflows simply have an empty relation.
  reviewDecisions WorkflowReviewDecision[]

  @@index([teamId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([slaStatus, dueAt])
  @@index([escalationLevel, status])
  @@index([assignmentDueAtUtc])
  @@index([completionDueAtUtc])
  // Phase T — non-unique per-workspace template lookups.
  @@index([teamId, templateSlug])
  @@map("evidence_review_workflows")
}

// =============================================================================
// Phase B.2 — Multi-stage review governance.
//
// `WorkflowReviewDecision` is the canonical per-stage decision row.
// State is DERIVED from these rows (not stored as an enum on the
// workflow), so this is a purely additive migration: no column on
// EvidenceReviewWorkflow changes, no enum is mutated.
//
// State machine the API enforces server-side:
//
//   no decisions                          → state: "first_required"
//   FIRST decided                         → state: "second_required"   (if requires_second_review)
//                                         → state: "resolved"          (otherwise)
//   FIRST + SECOND, decisions match       → state: "resolved"
//   FIRST + SECOND, decisions DIFFER      → state: "conflict_detected"
//   FIRST + SECOND + ADJUDICATION         → state: "resolved"
//
// Same-reviewer guard: server rejects a SECOND decision by the same
// userId who made the FIRST. Adjudication is only allowed when the
// state is conflict_detected, and only by callers with elevated role
// (team OWNER/ADMIN). All transitions emit audit events.
// =============================================================================

enum WorkflowReviewStage {
  FIRST
  SECOND
  ADJUDICATION

  @@map("workflow_review_stage")
}

enum WorkflowReviewDecisionKind {
  APPROVE
  REJECT
  REQUEST_INFO
  UPHOLD_FIRST
  UPHOLD_SECOND
  NEEDS_MORE_INFO
  UNRESOLVED

  @@map("workflow_review_decision_kind")
}

enum WorkflowReviewReasonCode {
  EVIDENCE_INCOMPLETE
  REPORT_FAILED
  INTEGRITY_CONCERN
  CUSTODY_CONCERN
  MISSING_CONTEXT
  LEGAL_HOLD_ISSUE
  REDACTION_REQUIRED
  REVIEWER_DISAGREEMENT
  OTHER

  @@map("workflow_review_reason_code")
}

model WorkflowReviewDecision {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId     String                     @map("workflow_id") @db.Uuid
  /// Denormalised teamId for cheap indexed lookups by workspace. Always
  /// equal to the workflow's teamId at the moment of decision; never
  /// updated after insert (so a workflow that moves workspaces — not
  /// currently supported — would keep its decision lineage tied to the
  /// workspace where the decision was actually made).
  teamId         String                     @map("team_id") @db.Uuid
  stage          WorkflowReviewStage
  reviewerUserId String                     @map("reviewer_user_id") @db.Uuid
  decision       WorkflowReviewDecisionKind
  reasonCode     WorkflowReviewReasonCode?  @map("reason_code")
  /// Operator-readable rationale. REQUIRED for non-approve decisions
  /// (REJECT, REQUEST_INFO, UPHOLD_*, NEEDS_MORE_INFO, UNRESOLVED) and
  /// for all ADJUDICATION rows. Optional for APPROVE at FIRST stage.
  rationale      String                     @db.VarChar(4000)
  decidedAt      DateTime                   @default(now()) @map("decided_at") @db.Timestamptz(6)

  workflow EvidenceReviewWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviewer User                   @relation("WorkflowReviewDecisionReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  // One row per (workflow, stage). Resubmissions are forbidden; the
  // existing row carries the audit-of-record. A new stage requires a
  // new row.
  @@unique([workflowId, stage])
  @@index([workflowId, decidedAt(sort: Desc)])
  @@index([teamId, stage])
  @@index([reviewerUserId])
  @@map("workflow_review_decisions")
}

model EvidenceReviewWorkflowEvent {
  id            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId    String                          @map("workflow_id") @db.Uuid
  evidenceId    String                          @map("evidence_id") @db.Uuid
  actorUserId   String?                         @map("actor_user_id") @db.Uuid
