  text            String
  confidence      Float?    @db.Real
  visibilityScope String    @default("TEAM") @map("visibility_scope") @db.VarChar(24)
  redacted        Boolean   @default(false)
  indexedAtUtc    DateTime? @map("indexed_at_utc") @db.Timestamptz(6)
  extractedAtUtc  DateTime  @default(now()) @map("extracted_at_utc") @db.Timestamptz(6)
  updatedAtUtc    DateTime  @default(now()) @map("updated_at_utc") @db.Timestamptz(6)

  @@index([teamId, evidenceId], map: "evidence_ocr_text_team_evidence_idx")
  @@map("evidence_ocr_text")
