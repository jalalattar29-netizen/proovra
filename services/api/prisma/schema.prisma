// ===========================================================================
// PHASE 12 — POINT 5: durable report/package generation authority.
//
// Before this model, report generation was requested by putting
// `{ evidenceId, forceRegenerate, regenerateReason }` on a BullMQ payload.
// `forceRegenerate` is the OUTCOME OF AN AUTHORIZATION DECISION — it bypasses
// the guard that refuses to regenerate an already-REPORTED artifact — and it
// was arriving as an unverified boolean on a queue message. Anything able to
// write to the queue could overwrite a finalised report.
//
// The authorized synchronous path now persists the intent here and the queue
// carries only this row's id. The worker reloads the request, re-derives the
// workspace from it, and re-checks eligibility against CURRENT policy rather
// than against whatever was true when the request was made.
//
// Claim discipline mirrors the rest of Point 5: QUEUED -> PROCESSING via a
// conditional update, terminal state written once, stale attempts refused.
// ===========================================================================
model ReportGenerationRequest {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Target evidence. The worker cross-checks Evidence.teamId against teamId
  /// above and refuses the run when they disagree.
  evidenceId String @map("evidence_id") @db.Uuid

  /// Bounded artifact vocabulary: REPORT | VERIFICATION_PACKAGE | EXCHANGE_PACKAGE.
  artifactType String @default("REPORT") @map("artifact_type") @db.VarChar(32)

  /// Why generation was requested. Bounded catalog, e.g. "evidence_completed",
  /// "operator_regenerate", "tsa_repair".
  purpose String @default("evidence_completed") @db.VarChar(64)

  /// True only when an authorized actor explicitly asked to replace an existing
  /// finalised artifact. Persisted by the authorizing request, never accepted
  /// from a queue payload.
  forceRegenerate  Boolean @default(false) @map("force_regenerate")
  regenerateReason String? @map("regenerate_reason") @db.VarChar(120)

  /// Who asked. Exactly one of these is set: a human actor or a machine
  /// identity. Both null is not a valid request and the worker refuses it.
  requestedByUserId    String? @map("requested_by_user_id") @db.Uuid
  requestedByMachineId String? @map("requested_by_machine_id") @db.VarChar(64)

  /// Policy/version binding captured at request time. The worker compares this
  /// against the CURRENT value and blocks a stale request rather than
  /// generating an artifact under a policy nobody approved.
  expectedPolicyVersion Int? @map("expected_policy_version")

  /// Collapses duplicate requests for the same intent.
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(160)

  /// QUEUED | PROCESSING | SUCCEEDED | FAILED_RETRYABLE | FAILED_TERMINAL |
  /// BLOCKED_STALE | BLOCKED_POLICY
  state String @default("QUEUED") @db.VarChar(32)

  attemptCount Int       @default(0) @map("attempt_count")
  claimedAtUtc DateTime? @map("claimed_at_utc") @db.Timestamptz(6)

  /// Terminal result. `resultReportId` is set only on SUCCEEDED;
  /// `terminalReasonCode` is a bounded code, never a raw error string.
  resultReportId     String? @map("result_report_id") @db.Uuid
  resultChecksum     String? @map("result_checksum") @db.VarChar(128)
  terminalReasonCode String? @map("terminal_reason_code") @db.VarChar(64)

  createdAtUtc   DateTime  @default(now()) @map("created_at_utc") @db.Timestamptz(6)
  updatedAtUtc   DateTime  @default(now()) @updatedAt @map("updated_at_utc") @db.Timestamptz(6)
  completedAtUtc DateTime? @map("completed_at_utc") @db.Timestamptz(6)

  @@index([teamId, state, createdAtUtc(sort: Desc)], map: "report_generation_requests_team_state_idx")
  @@index([evidenceId, state], map: "report_generation_requests_evidence_idx")
  @@index([state, claimedAtUtc], map: "report_generation_requests_claim_idx")
  @@map("report_generation_requests")
}
