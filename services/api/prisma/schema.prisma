  caseCount               Int @default(0) @map("case_count")
  openIncidentCount       Int @default(0) @map("open_incident_count")
  slaBreachCount          Int @default(0) @map("sla_breach_count")
  governanceBlockerCount  Int @default(0) @map("governance_blocker_count")
  recentVerificationCount Int @default(0) @map("recent_verification_count")
  pendingPackageCount     Int @default(0) @map("pending_package_count")
  pendingReportCount      Int @default(0) @map("pending_report_count")

  /// Optional bounded source label (e.g., "worker_refresh_v1") for
  /// debugging without leaking implementation detail.
  source String? @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([teamId, sampledAtUtc])
  @@index([teamId, sampledAtUtc(sort: Desc)])
  @@map("org_health_projections")
}

