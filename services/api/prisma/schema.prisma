//     snapshot. History is preserved in `OrgHealthProjection.sampledAtUtc`
//     time series.
//   - Refreshed by the `org-health-refresh` queue worker every 30-90s.
//   - Read-only from the dashboard surface. NEVER cross-tenant joined.
//   - Optional — the dashboard may still fall back to a live aggregate
//     if no projection row exists (e.g. immediately after team creation).
//
// Tenant safety: the refresh worker only writes the row for the
// `teamId` it was scheduled with; a runtime test asserts this.
// =============================================================================

model OrgHealthProjection {
  teamId       String   @map("team_id") @db.Uuid
  sampledAtUtc DateTime @default(now()) @map("sampled_at_utc") @db.Timestamptz(6)

