enum EvidenceStatus {
  CREATED
  UPLOADING
  UPLOADED
  SIGNED
  REPORTED
  // Phase A0 — integrity hard-gate terminal state. Reached when the
  // server-side recomputed SHA-256 of the uploaded bytes disagrees
  // with the stored `fileSha256` (the value persisted at completion
  // from the API's server-side stream-hash). A record in this state:
  //   * never produces a Report or VerificationPackage
  //   * never appears on /public/verify (the route 404s with no
  //     metadata leak; anti-enumeration)
  //   * cannot transition back to SIGNED / REPORTED. Recovery is
  //     re-capture / re-upload as a NEW Evidence row; the failed row
  //     is preserved for forensic inspection.
  // Status carries no factual judgement about WHO altered the bytes
  // — it is a mechanical statement that the recomputed digest does
  // not match what completion recorded.
  FAILED_HASH_MISMATCH
}

