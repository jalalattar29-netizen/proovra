  // PHASE 12B CLUSTER 8 — canonical legal-hold convergence. The legacy
  // scope-generic `legal_holds` table carried an EXPIRED state that
  // `evidence_legal_holds` could not represent. EXPIRED is NOT an active
  // hold, but it must round-trip so a converged row never has to be
  // downgraded to RELEASED (which would falsely attribute a release
  // decision to an operator).
  EXPIRED
}

// PHASE 12B CLUSTER 8 — explicit scope for the canonical legal-hold model.
// EVIDENCE  → protects exactly one Evidence row (evidence_id NOT NULL).
// CASE      → protects every Evidence linked to the Case (case_id NOT NULL).
// WORKSPACE → protects every Evidence in the workspace (no target columns).
// The scope/target consistency is enforced by a CHECK constraint in
// migration 20271106000000_legal_hold_canonical, not by Prisma.
enum LegalHoldScope {
  EVIDENCE
  CASE
  WORKSPACE
}

// PHASE 12B CLUSTER 8 — release-approval attribution for the canonical
// legal-hold model. NOT_REQUIRED is the default; when the workspace
// governance policy `requireLegalHoldReleaseApproval` is on at placement
// time the hold is written with PENDING and can only be released once an
// approver has been recorded (APPROVED).
enum LegalHoldReleaseApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
}

// PHASE 12B CLUSTER 8 — provenance of a canonical legal-hold row. Backfilled
// rows keep the store they came from so the convergence is auditable and
// re-runnable; duplicate semantic holds keep BOTH provenance records.
enum LegalHoldSourceStore {
  EVIDENCE_LEGAL_HOLD
  CASE_LEGAL_HOLD
  LIFECYCLE_LEGAL_HOLD
}

model EvidenceWorkflowTemplate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identity & scope
  slug              String             @db.VarChar(120)
  teamId            String?            @map("team_id") @db.Uuid
  workspaceCategory WorkspaceCategory? @map("workspace_category")

  // Versioning. Snapshots taken at session creation freeze the full payload
  // onto CaptureSession.templateSnapshot, so this column tracks only the
  // current edit-state of the template, never historical snapshots.
  version Int @default(1)

  // Display
  name        String  @db.VarChar(180)
  description String? @db.VarChar(2000)
  archived    Boolean @default(false)

  // Phase 22 — explicit template lifecycle. The legacy `archived`
  // boolean is preserved for back-compat; the new `status` enum is
  // the canonical state (DRAFT / ACTIVE / ARCHIVED). When `archived
  // = true` and `status = ACTIVE`, the service layer treats the row
  // as ARCHIVED (defense in depth during the transition).
  status String @default("ACTIVE") @db.VarChar(16)

  // Behavior knobs (validated against Phase 1 shared zod schemas)
  planMode            String   @map("plan_mode") @db.VarChar(40)
  locationRequirement String   @map("location_requirement") @db.VarChar(20)
  intakeModes         String[] @map("intake_modes")
  allowedRoles        String[] @map("allowed_roles")

  // Payload (validated against Phase 1 shared zod schemas)
  stepsJson            Json  @map("steps_json")
  rulesJson            Json? @map("rules_json")
  visibilityPolicyJson Json? @map("visibility_policy_json")
  reviewPolicyJson     Json? @map("review_policy_json")
  exportPolicyJson     Json? @map("export_policy_json")

  // Audit
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team              Team?                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy         User?                      @relation("WorkflowTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy         User?                      @relation("WorkflowTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  intakeLinks       WorkflowIntakeLink[]
  workflowInstances EvidenceWorkflowInstance[]
  // Phase T — back-relations for the canonical template identity trio on
  // Evidence and EvidenceReviewWorkflow. Distinct relation names per
  // model so the FK-bearing side resolves unambiguously.
  evidences         Evidence[]                 @relation("EvidenceTemplate")
  reviewerWorkflows EvidenceReviewWorkflow[]   @relation("ReviewWorkflowTemplate")

  @@index([teamId, archived])
  @@index([teamId, workspaceCategory])
  @@index([teamId, status])
  @@index([slug])
  @@index([workspaceCategory])
  // Note: uniqueness of (slug, teamId) and (slug WHERE teamId IS NULL) is
  // enforced via two partial unique indexes created in the migration SQL —
  // Prisma's @@unique cannot express partial conditions. See migration:
  //   20260516120000_add_workflow_template_foundation
  @@map("evidence_workflow_templates")
}

// -----------------------------------------------------------------------------
// Phase 4 — Workflow Intake Links + Sessions
//
// Domain primitives for the external contributor pipeline. The canonical
// shape lives in @proovra/shared (workflow-intake-link.ts); these are the
// persistence projections.
//
// Reuse rules:
//   - The intake LINK is a new concept (token + scope + policy).
//   - The intake SESSION tracks the lifecycle of a single contributor
//     redemption. It links to the existing CaptureSession once an upload
//     is actually staged, so the existing capture orchestration runs as-is
//     for the actual file handling.
//   - The intake SESSION links to the existing Evidence on submission, so
//     the existing report-v2 / verification-package / public-verify
//     pipelines work unchanged.
//   - Token raw values are never stored: only the HMAC-SHA256 (in
//     `token_hash`) issued via the API package's token service.
// -----------------------------------------------------------------------------

model WorkflowIntakeLink {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Workspace scope (mandatory — global intake links are not supported).
  teamId String @map("team_id") @db.Uuid

  // Workflow binding. Snapshotted at link creation so the contributor's
  // requirements cannot drift if the template is later edited.
  workflowTemplateId       String? @map("workflow_template_id") @db.Uuid
  workflowTemplateSlug     String  @map("workflow_template_slug") @db.VarChar(120)
  workflowTemplateVersion  Int     @map("workflow_template_version")
  workflowTemplateSnapshot Json    @map("workflow_template_snapshot")

  // Intake mode (one of the EXTERNAL_* values from WorkflowIntakeMode in
  // @proovra/shared). Stored as plain text so the enum can grow in the
  // shared package without a DB migration.
  intakeMode String @map("intake_mode") @db.VarChar(40)

  // Optional case/claim/matter binding. Soft-references the Case table by
  // id; no Prisma relation because Case.ownerUserId is loosely typed in
  // existing schema and a relation would require touching that surface.
  caseId String? @map("case_id") @db.Uuid

  // Token storage — never the raw token; only HMAC-SHA256 over the wire
  // value plus a version marker for future rotation.
  tokenHash    String @unique @map("token_hash") @db.VarChar(128)
  tokenVersion Int    @default(1) @map("token_version")

  // Recipient context (optional, provider-agnostic).
  recipientLabel String? @map("recipient_label") @db.VarChar(180)
  recipientEmail String? @map("recipient_email") @db.VarChar(320)
  recipientPhone String? @map("recipient_phone") @db.VarChar(32)

  // Constraints
  maxUses                Int      @default(1) @map("max_uses")
  usedCount              Int      @default(0) @map("used_count")
  maxFileCountPerSession Int?     @map("max_file_count_per_session")
  maxBytesPerSession     BigInt?  @map("max_bytes_per_session")
  allowedAcceptedKinds   String[] @map("allowed_accepted_kinds")

  // Consent — the policy version is required at acceptance time.
  consentPolicyVersion  String? @map("consent_policy_version") @db.VarChar(40)
  consentDisclosureText String? @map("consent_disclosure_text")

  // Lifecycle
  status          WorkflowIntakeLinkStatus @default(ACTIVE)
  expiresAtUtc    DateTime                 @map("expires_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime?                @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?                  @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?                  @map("revoked_reason") @db.VarChar(400)

  // Security
  ipAllowlistCidrs String[] @map("ip_allowlist_cidrs")

  // Intake-link sender identity (Phase: enterprise messaging).
  // `senderDisplayMode` is one of "PROOVRA" | "WORKSPACE" | "CUSTOM"
  // (the canonical enum lives in @proovra/shared.INTAKE_SENDER_DISPLAY_MODES;
  // stored as text so future modes don't need a migration).
  // `senderDisplayName` is only populated for CUSTOM mode and is the
  // operator-supplied display name BEFORE the mandatory " via PROOVRA"
  // suffix. Validation happens in shared.validateCustomSenderDisplayName.
  senderDisplayMode String  @default("PROOVRA") @map("sender_display_mode") @db.VarChar(40)
  senderDisplayName String? @map("sender_display_name") @db.VarChar(80)

  // Operator-initiated archive — distinct from revoke. Archiving HIDES
  // a link from the default Active view but does NOT close public
  // access (use Revoke for that). Nullable; null = not archived.
  archivedAtUtc    DateTime? @map("archived_at_utc") @db.Timestamptz(6)
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid

  // Location collection policy for the public contributor page.
  // Stored as text (mirrors the IntakeLinkLocationPolicy enum in
  // @proovra/shared) so future values can grow without a migration.
  //   NONE     — public page never asks for location (default for
  //              every pre-existing link — preserves prior behavior).
  //   OPTIONAL — public page shows "Share location / Skip" and a
  //              contributor decision is recorded; submit succeeds
  //              with or without coordinates.
  //   REQUIRED — submit is gated until the browser supplies
  //              coordinates (or surfaces an unavailable error).
  // Backfill: every pre-existing row defaults to NONE (see migration
  // 20270825000000_intake_link_location_policy) so this feature
  // ships without changing the behaviour of any link created
  // before the column existed.
  locationPolicy String @default("NONE") @map("location_policy") @db.VarChar(20)

  // Audit
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  team             Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workflowTemplate EvidenceWorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  createdBy        User                      @relation("WorkflowIntakeLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?                     @relation("WorkflowIntakeLinkRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  archivedBy       User?                     @relation("WorkflowIntakeLinkArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  sessions         WorkflowIntakeSession[]
  evidenceRequests EvidenceRequest[]         @relation("EvidenceRequestIntakeLink")

  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, archivedAtUtc])
  @@index([expiresAtUtc])
  @@index([workflowTemplateId])
  @@index([caseId])
  @@map("workflow_intake_links")
}

model WorkflowIntakeSession {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intakeLinkId String @map("intake_link_id") @db.Uuid

  // Lifecycle (canonical state machine in @proovra/shared/workflow-intake-link.ts)
  status               WorkflowIntakeSessionStatus @default(CREATED)
  openedAtUtc          DateTime?                   @map("opened_at_utc") @db.Timestamptz(6)
  uploadStartedAtUtc   DateTime?                   @map("upload_started_at_utc") @db.Timestamptz(6)
  uploadCompletedAtUtc DateTime?                   @map("upload_completed_at_utc") @db.Timestamptz(6)
  submittedAtUtc       DateTime?                   @map("submitted_at_utc") @db.Timestamptz(6)
  abandonedAtUtc       DateTime?                   @map("abandoned_at_utc") @db.Timestamptz(6)
  revokedAtUtc         DateTime?                   @map("revoked_at_utc") @db.Timestamptz(6)
  expiresAtUtc         DateTime                    @map("expires_at_utc") @db.Timestamptz(6)

  // Phase 17 — contributor access governance. revokedByUserId / revokedReason
  // record who killed the session and why (immediate revoke flow). lastSeenAtUtc
  // is touched on every successful contributor request and powers stale-access
  // detection in the access review queue.
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(400)
  lastSeenAtUtc   DateTime? @map("last_seen_at_utc") @db.Timestamptz(6)

  // Submitter identity (varies by intake mode — see consent rules)
  guestIdentityId      String? @map("guest_identity_id") @db.Uuid
  pseudonym            String? @db.VarChar(80)
  submitterDisplayName String? @map("submitter_display_name") @db.VarChar(180)
  submitterEmail       String? @map("submitter_email") @db.VarChar(320)
  // Phase 18 — contributor contact for SMS/WhatsApp delivery. Stored in
  // E.164 format. Phase 4 created the column placeholder on the intake
  // LINK; Phase 18 also captures it on the SESSION when the contributor
  // submits a phone for outreach.
  submitterPhone       String? @map("submitter_phone") @db.VarChar(32)

  // Linked artifacts — populated by later phases when upload/finalize land.
  // Phase 4 creates the link rows but never sets these.
  captureSessionId String? @unique @map("capture_session_id") @db.Uuid
  evidenceId       String? @unique @map("evidence_id") @db.Uuid

  // Consent
  consentAcceptedAtUtc DateTime? @map("consent_accepted_at_utc") @db.Timestamptz(6)
  consentSnapshotJson  Json?     @map("consent_snapshot_json")

  // Forensic context — IP is hashed (HMAC-SHA256) before storage so the
  // raw address cannot be reconstructed from a database dump.
  submitterIpHash    String? @map("submitter_ip_hash") @db.VarChar(64)
  submitterUserAgent String? @map("submitter_user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  intakeLink              WorkflowIntakeLink         @relation(fields: [intakeLinkId], references: [id], onDelete: Cascade)
  guestIdentity           GuestIdentity?             @relation(fields: [guestIdentityId], references: [id], onDelete: SetNull)
  captureSession          CaptureSession?            @relation("WorkflowIntakeSessionCapture", fields: [captureSessionId], references: [id], onDelete: SetNull)
  evidence                Evidence?                  @relation("WorkflowIntakeSessionEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  evidenceRequestResponse EvidenceRequestResponse?   @relation("EvidenceRequestResponseIntakeSession")
  revokedBy               User?                      @relation("WorkflowIntakeSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  communicationMessages   CommunicationMessage[]     @relation("WorkflowIntakeSessionCommunicationMessages")
  workflowInstances       EvidenceWorkflowInstance[] @relation("WorkflowIntakeSessionInstances")

  @@index([intakeLinkId, status])
  @@index([intakeLinkId, createdAt(sort: Desc)])
  @@index([expiresAtUtc])
  @@index([status])
  @@index([lastSeenAtUtc])
  @@map("workflow_intake_sessions")
}

// -----------------------------------------------------------------------------
// Phase 7 — Evidence Request domain
//
// EvidenceRequest         — first-class structured request created by an
//                           authenticated workspace user.
// EvidenceRequestDeliverable — concrete item(s) the request asks for.
// EvidenceRequestResponse — a submitted response (1 request can receive
//                           multiple responses; an external intake session
//                           submitting against a request creates one).
// EvidenceRequestEvent    — append-only audit log of lifecycle events.
//
// Reuse rules: links to existing tables (Evidence, Case, Team, User,
// EvidenceWorkflowTemplate, WorkflowIntakeLink, WorkflowIntakeSession)
// rather than duplicating any of them.
// -----------------------------------------------------------------------------

model EvidenceRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Scope
  teamId                  String  @map("team_id") @db.Uuid
  evidenceId              String? @map("evidence_id") @db.Uuid
  caseId                  String? @map("case_id") @db.Uuid
  workflowTemplateSlug    String? @map("workflow_template_slug") @db.VarChar(120)
  workflowTemplateVersion Int?    @map("workflow_template_version")
  workflowStepId          String? @map("workflow_step_id") @db.VarChar(120)

  // Classification
  requestType EvidenceRequestType     @map("request_type")
  status      EvidenceRequestStatus   @default(DRAFT)
  priority    EvidenceRequestPriority @default(NORMAL)

  // Display
  title        String    @db.VarChar(180)
  instructions String    @default("")
  dueAtUtc     DateTime? @map("due_at_utc") @db.Timestamptz(6)

  // Recipient
  recipientMode  EvidenceRequestRecipientMode @map("recipient_mode")
  recipientLabel String?                      @map("recipient_label") @db.VarChar(180)
  recipientEmail String?                      @map("recipient_email") @db.VarChar(320)
  recipientPhone String?                      @map("recipient_phone") @db.VarChar(32)

  // Personnel
  requestedByUserId      String  @map("requested_by_user_id") @db.Uuid
  assignedReviewerUserId String? @map("assigned_reviewer_user_id") @db.Uuid

  // Optional bound intake link (the secure URL sent to the recipient when
  // recipient is external). Phase 4 link service issues this when the
  // request is sent.
  intakeLinkId String? @map("intake_link_id") @db.Uuid

  // Policy snapshots — JSON, frozen at send time so the recipient cannot
  // be held to a policy that changed after they accepted.
  visibilityPolicyJson Json? @map("visibility_policy_json")
  exportPolicyJson     Json? @map("export_policy_json")

  // Reviewer-only fields
  reviewerNote             String?   @map("reviewer_note") @db.VarChar(4000)
  reviewerDecisionAt       DateTime? @map("reviewer_decision_at_utc") @db.Timestamptz(6)
  reviewerDecisionByUserId String?   @map("reviewer_decision_by_user_id") @db.Uuid

  // Timestamps
  sentAtUtc        DateTime? @map("sent_at_utc") @db.Timestamptz(6)
  firstOpenedAtUtc DateTime? @map("first_opened_at_utc") @db.Timestamptz(6)
  closedAtUtc      DateTime? @map("closed_at_utc") @db.Timestamptz(6)
  cancelledAtUtc   DateTime? @map("cancelled_at_utc") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  team                  Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence              Evidence?                    @relation("EvidenceRequestEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  requestedBy           User                         @relation("EvidenceRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  assignedReviewer      User?                        @relation("EvidenceRequestAssignedReviewer", fields: [assignedReviewerUserId], references: [id], onDelete: SetNull)
  reviewerDecisionBy    User?                        @relation("EvidenceRequestReviewerDecisionBy", fields: [reviewerDecisionByUserId], references: [id], onDelete: SetNull)
  intakeLink            WorkflowIntakeLink?          @relation("EvidenceRequestIntakeLink", fields: [intakeLinkId], references: [id], onDelete: SetNull)
  deliverables          EvidenceRequestDeliverable[]
  responses             EvidenceRequestResponse[]
  events                EvidenceRequestEvent[]
  notifications         NotificationDelivery[]       @relation("EvidenceRequestNotifications")
  communicationMessages CommunicationMessage[]       @relation("EvidenceRequestCommunicationMessages")
  workflowInstances     EvidenceWorkflowInstance[]   @relation("EvidenceRequestWorkflowInstances")

  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, priority])
  @@index([evidenceId])
  @@index([caseId])
  @@index([assignedReviewerUserId])
  @@index([requestedByUserId])
  @@index([dueAtUtc])
  @@index([intakeLinkId])
  @@map("evidence_requests")
}

model EvidenceRequestDeliverable {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceRequestId String @map("evidence_request_id") @db.Uuid

  title                String   @db.VarChar(180)
  description          String   @default("")
  required             Boolean  @default(true)
  acceptedKinds        String[] @map("accepted_kinds")
  minCount             Int      @default(1) @map("min_count")
  maxCount             Int?     @map("max_count")
  locationRequirement  String   @default("optional") @map("location_requirement") @db.VarChar(20)
  captureAfterRequest  Boolean  @default(false) @map("capture_after_request")
  metadataRequirements Json?    @map("metadata_requirements")
  workflowStepId       String?  @map("workflow_step_id") @db.VarChar(120)
  sortOrder            Int      @default(0) @map("sort_order")

  status         EvidenceRequestDeliverableStatus @default(PENDING)
  waivedReason   String?                          @map("waived_reason") @db.VarChar(400)
  fulfilledCount Int                              @default(0) @map("fulfilled_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidenceRequest EvidenceRequest @relation(fields: [evidenceRequestId], references: [id], onDelete: Cascade)

  @@index([evidenceRequestId, sortOrder])
  @@index([evidenceRequestId, status])
  @@map("evidence_request_deliverables")
}

model EvidenceRequestResponse {
