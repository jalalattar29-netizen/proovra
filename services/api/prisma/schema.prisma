// =============================================================================
// Phase E3 — Operational Automation Foundation
//
// Two team-scoped tables that hold bounded automation rules + per-execution
// run records. The trigger + action types are restricted to the E3
// allowlist (enforced both at the DB layer via CHECK constraints and at
// the service layer via TypeScript const unions).
//
// Hard rules (also pinned by phase-e3-automation-foundation.test.ts):
//   - Team-scoped: every row carries teamId with CASCADE on team delete.
//   - Allowlist-only trigger/action types (DB CHECK + TS const).
//   - Idempotent runs: unique on (teamId, ruleId, idempotencyKey).
//   - Bounded status enum: PENDING / RUNNING / SUCCEEDED / FAILED / SKIPPED.
//   - No evidence mutation, no custody mutation (the runtime dispatcher,
//     deferred to E3.1 per DEF-021, will enforce this via the bounded
//     action allowlist).
// =============================================================================
model AutomationRule {
  id               String    @id @default(uuid()) @db.Uuid
  teamId           String    @map("team_id") @db.Uuid
  name             String    @db.VarChar(120)
  description      String?   @db.VarChar(500)
  enabled          Boolean   @default(false)
  /// Bounded set — see DB CHECK constraint
  /// `automation_rules_trigger_type_allowlist`. Adding a value requires
  /// a coordinated migration + service update.
  triggerType      String    @map("trigger_type") @db.VarChar(60)
  /// Strict JSON condition tree. The service validates this against
  /// the bounded operator/leaf schema before persistence. No `eval`,
  /// no `vm.run`, no dynamic code execution.
  conditionJson    Json      @default("{}") @map("condition_json")
  /// Bounded set — see DB CHECK constraint
  /// `automation_rules_action_type_allowlist`.
  actionType       String    @map("action_type") @db.VarChar(60)
  /// Strict JSON action config. Service-validated against the per-
  /// action-type schema. Never executed as code.
  actionConfigJson Json      @default("{}") @map("action_config_json")
  version          Int       @default(1)
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  updatedByUserId  String    @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(6)

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User            @relation("AutomationRuleCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User            @relation("AutomationRuleUpdatedBy", fields: [updatedByUserId], references: [id])
  runs      AutomationRun[]

  @@index([teamId])
  @@index([teamId, enabled])
  @@index([teamId, triggerType])
  @@map("automation_rules")
}

model AutomationRun {
  id             String    @id @default(uuid()) @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  triggerType    String    @map("trigger_type") @db.VarChar(60)
  targetType     String    @map("target_type") @db.VarChar(60)
  targetId       String    @map("target_id") @db.Uuid
  /// Deterministic key derived by the service from (trigger + target).
  /// Unique on (teamId, ruleId, idempotencyKey) — duplicate trigger
  /// events for the same target do not duplicate runs.
  idempotencyKey String    @map("idempotency_key") @db.VarChar(120)
  /// PENDING | RUNNING | RETRY_SCHEDULED | SUCCEEDED | FAILED | SKIPPED |
  /// DEAD_LETTERED | AMBIGUOUS | DEAD_LETTERED_UNKNOWN — bounded enum, mirrored
  /// by `automation_runs_status_allowlist`.
  ///
  /// VarChar(32), not (20): `DEAD_LETTERED_UNKNOWN` is 21 characters, and at
  /// (20) the widened CHECK accepted a value the column then refused — a
  /// rejection that surfaced as a write matching no rows, which is
  /// indistinguishable from ordinary fence contention.
  status         String    @default("PENDING") @db.VarChar(32)
  /// Operator-safe reason: never contains raw evidence content,
  /// secrets, tokens, or external payloads.
  reason         String?   @db.VarChar(400)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // ---------------------------------------------------------------------
  // PHASE 12 CORRECTIVE PASS §2 CONTINUATION (ARCH-005, 2026-08-07) — the
  // DURABLE runtime. Before this the row had no fence at all: two workers
  // could claim it, an expired worker could overwrite a newer attempt's
  // terminal state, and an interrupted run stayed RUNNING forever.
  // ---------------------------------------------------------------------
  /// Durable identity of the domain event that produced this run, written
  /// INSIDE the source transaction. A rolled-back source transaction leaves
  /// no run; a replayed event collapses on the partial unique index.
  sourceEventId        String?   @map("source_event_id") @db.VarChar(160)
  /// Durable identity of the ACTION intent. A retry REUSES it, so a retried
  /// email or webhook is the same intent rather than a second one, and a lease
  /// takeover inherits it rather than minting a fresh one. A NEW intentional
  /// run gets a NEW key.
  ///
  /// REQUIRED, matching the final schema: `20271129000000` introduces it
  /// nullable, `20271130000000` populates every existing row deterministically
  /// from the run's own id, and `20271131000000` sets NOT NULL behind a
  /// readiness count that RAISEs if a single null remains. Declaring it
  /// optional here made Prisma propose relaxing the constraint the migration
  /// had just established.
  ///
  /// It is derived from the run id alone. No token, recipient, secret or
  /// mutable payload value goes into it — a key that moves with the payload
  /// cannot identify an intent across a retry.
  actionIdempotencyKey String    @map("action_idempotency_key") @db.VarChar(160)
  claimedAtUtc         DateTime? @map("claimed_at_utc") @db.Timestamptz(6)
  leaseExpiresAtUtc    DateTime? @map("lease_expires_at_utc") @db.Timestamptz(6)
  /// Monotonic fence. Every claim increments it; every terminal write names
  /// the generation it claimed under, so a stale worker updates ZERO rows.
  claimGeneration      Int       @default(0) @map("claim_generation")
  attemptCount         Int       @default(0) @map("attempt_count")
  nextAttemptAtUtc     DateTime? @map("next_attempt_at_utc") @db.Timestamptz(6)
  failedAtUtc          DateTime? @map("failed_at_utc") @db.Timestamptz(6)
  deadLetteredAtUtc    DateTime? @map("dead_lettered_at_utc") @db.Timestamptz(6)
  /// BOUNDED classification — never a message, never a response body, never
  /// a URL with a query string.
  failureCode          String?   @map("failure_code") @db.VarChar(60)

  /// ARCH-005 §1 (2026-08-07) — AMBIGUITY, on the run as on the delivery.
  ///
  /// An action whose outcome the system cannot determine is neither a success
  /// nor an ordinary failure, and it must not be re-executed on the retry
  /// ladder. It waits, bounded, and then becomes DEAD_LETTERED_UNKNOWN —
  /// which an operator must be able to tell apart from a refusal.
  ambiguousAtUtc         DateTime? @map("ambiguous_at_utc") @db.Timestamptz(6)
  reconciliationAttempts Int       @default(0) @map("reconciliation_attempts")

  team              Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rule              AutomationRule              @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  // Phase E3.2 — per-run webhook delivery audit (one row per
  // (run, destination); see AutomationWebhookDelivery model below).
  webhookDeliveries AutomationWebhookDelivery[]

  @@unique([teamId, ruleId, idempotencyKey], name: "automation_runs_team_rule_idempotency_uniq")
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, ruleId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@map("automation_runs")
}

// =============================================================================
// Phase E3.2 — Secure Webhook Delivery
//
// Team-scoped outbound webhook destinations + per-delivery audit rows.
// Backend service layer enforces:
//   - HTTPS-only URLs
//   - SSRF protection (localhost / private / metadata IPs blocked at
//     create + before send)
//   - HMAC-SHA256 signed payloads (secret stored encrypted-at-rest,
//     one-time reveal at creation)
//   - 32 KiB payload cap
//   - Bounded delivery (sync single-attempt in E3.2; retry worker
//     deferred to DEF-023)
//   - Per-team destination cap + per-team delivery rate-limit
// =============================================================================
model AutomationWebhookDestination {
  id                      String    @id @default(uuid()) @db.Uuid
  teamId                  String    @map("team_id") @db.Uuid
  name                    String    @db.VarChar(120)
  url                     String    @db.VarChar(600)
  /// Pre-computed origin used to enforce one-destination-per-origin
  /// per team (prevents outbound-spam vector via duplicate destinations).
  urlOrigin               String    @map("url_origin") @db.VarChar(200)
  /// Encrypted webhook signing secret. Plaintext generated server-side
  /// at creation, shown once via the create response, then never
  /// returned by any API. Used for HMAC-SHA256 signatures on delivery.
  encryptedSecret         String    @map("encrypted_secret")
  /// Short fingerprint of the secret (SHA-256 prefix) — used by the
  /// service to detect rotation and surface to the UI without
  /// exposing the secret itself.
  secretFingerprint       String    @map("secret_fingerprint") @db.VarChar(80)
  enabled                 Boolean   @default(false)
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  updatedByUserId         String    @map("updated_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt              DateTime? @map("disabled_at") @db.Timestamptz(6)
  lastSuccessAt           DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt           DateTime? @map("last_failure_at") @db.Timestamptz(6)
  failureCount            Int       @default(0) @map("failure_count")
  // Phase E3.3 — destination health tracking. The runtime increments
  // `consecutiveFailureCount` on every failed delivery and resets it
  // to 0 on every success. When it crosses the auto-disable
  // threshold (10), the runtime flips `enabled=false`, sets
  // `autoDisabledAt` + `disabledReason`, and emits
  // `automation_webhook_destination_auto_disabled`. Operators can
  // re-enable via the existing enable endpoint (which clears
  // `autoDisabledAt` + `disabledReason` + resets the counter).
  consecutiveFailureCount Int       @default(0) @map("consecutive_failure_count")
  autoDisabledAt          DateTime? @map("auto_disabled_at") @db.Timestamptz(6)
  disabledReason          String?   @map("disabled_reason") @db.VarChar(200)

  team       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("AutomationWebhookDestinationCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy  User                        @relation("AutomationWebhookDestinationUpdatedBy", fields: [updatedByUserId], references: [id])
  deliveries AutomationWebhookDelivery[]

  @@unique([teamId, urlOrigin], name: "automation_webhook_destinations_team_origin_uniq")
  @@index([teamId, enabled])
  @@index([teamId, consecutiveFailureCount])
  @@map("automation_webhook_destinations")
}

model AutomationWebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  runId          String    @map("run_id") @db.Uuid
  destinationId  String    @map("destination_id") @db.Uuid
  /// Deterministic key from (runId + destinationId). Unique on
  /// (team, run, destination) prevents duplicate delivery rows.
  idempotencyKey String    @map("idempotency_key") @db.VarChar(120)
  /// Bounded enum: PENDING | DELIVERING | SUCCEEDED | FAILED | SKIPPED |
  /// RETRY_SCHEDULED | RETRY_EXHAUSTED | AMBIGUOUS | DEAD_LETTERED_UNKNOWN.
  /// VarChar(32) for the same reason as AutomationRun.status.
  status         String    @default("PENDING") @db.VarChar(32)
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  /// HTTP response status code (small int, 0 when unknown).
  responseStatus Int       @default(0) @map("response_status")
  /// Operator-safe failure classification (e.g. "timeout" / "non_2xx"
  /// / "ssrf_blocked" / "destination_disabled"). NEVER the response
  /// body, NEVER the URL with query string, NEVER any payload bytes.
  failureReason  String?   @map("failure_reason") @db.VarChar(400)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ARCH-005 (2026-08-07) — the delivery outbox gets the same fence as the
  // run. E3.2's claim was a `status` precondition only, which is correct
  // within one process and says nothing about a worker that died holding the
  // row: a DELIVERING delivery was indistinguishable from a live one.
  leaseExpiresAtUtc DateTime? @map("lease_expires_at_utc") @db.Timestamptz(6)
  claimGeneration   Int       @default(0) @map("claim_generation")

  /// ARCH-005 §1 (2026-08-07) — AMBIGUITY.
  ///
  /// When the request was WRITTEN and the answer was lost, the outcome is
  /// genuinely unknown. `ambiguousAtUtc` records when we stopped knowing;
  /// `reconciliationAttempts` bounds how many times we ask before declaring
  /// DEAD_LETTERED_UNKNOWN. Neither is a failure counter — an unknown outcome
  /// must never be projected to an operator as a refusal.
  ambiguousAtUtc         DateTime? @map("ambiguous_at_utc") @db.Timestamptz(6)
  reconciliationAttempts Int       @default(0) @map("reconciliation_attempts")

  team        Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  run         AutomationRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  destination AutomationWebhookDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([teamId, runId, destinationId], name: "automation_webhook_deliveries_team_run_dest_uniq")
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@index([destinationId])
  @@map("automation_webhook_deliveries")
}

// ============================================================================
// Phase 2.7X Stage 1 — Organization domain model (additive only).
//
// This is the foundation for multi-workspace enterprise governance.
// Stage 1 ships the schema; Stage 2 backfills 1:1 from existing
// Teams; Stage 3 adds dual-read endpoints; Stage 4 adds the
// frontend org surface. NO code reads these tables yet — Stage 1
// is purely additive structural change that lets later stages
// land safely.
//
// Hard invariants encoded in this design:
//   - Workspace (Team) isolation is preserved: Evidence, Case,
//     CaseAssignment, CaseAccess remain teamId-scoped. We do NOT
//     add organizationId to those tables; doing so would invite
//     cross-workspace queries that violate evidence isolation.
//   - Organization membership is ORTHOGONAL to workspace
//     membership: a user can be ORG_ADMIN without being any
//     workspace's member, and vice versa.
//   - All FKs from existing tables to Organization are nullable
//     in Stage 1 (Team.organizationId). Tighter constraints land
//     in Stage 5+ after the backfill stabilises.
// ============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  /// Single owner per org. Can transfer ownership. Highest authority.
  ORG_OWNER
  /// Full admin below ownership. Can manage memberships, policies,
  /// workspace attachment, and billing.
  ORG_ADMIN
  /// Manages SAML/SCIM/MFA policy at the org level. Does NOT
  /// manage workspaces or billing on its own.
  ORG_SECURITY_ADMIN
  /// Manages billing relationship + seat caps. Does NOT manage
  /// workspaces or security.
  ORG_BILLING_ADMIN
  /// Read-only auditor. Sees org access review, audit log,
  /// workspace directory. Cannot mutate anything.
  ORG_AUDITOR
  /// Default org-level membership role. Indicates user belongs to
  /// the organization but has no special org privilege. Workspace
  /// privileges are managed separately via TeamMember.
  ORG_MEMBER
}

model Organization {
  id                     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                         @db.VarChar(180)
  legalName              String?                        @map("legal_name") @db.VarChar(180)
  legalEmail             String?                        @map("legal_email") @db.VarChar(320)
  address                String?
  timezone               String?                        @db.VarChar(64)
  logoUrl                String?                        @map("logo_url") @db.VarChar(512)
  status                 OrganizationStatus             @default(ACTIVE)
  /// P1 DOMAIN REMEDIATION (2026-07-21) — SYSTEM = internal 1:1
  /// bootstrap container (every Team gets one); CUSTOMER = a real
  /// enterprise customer organization (sales-provisioned). Only
  /// CUSTOMER orgs are governance boundaries; SYSTEM containers never
  /// surface as "Organizations" in product UI. Default SYSTEM — the
  /// backfill promotes orgs with enterprise provenance (an ENTERPRISE
  /// workspace or pendingEnterpriseSeats) to CUSTOMER, and the
  /// enterprise provisioning path sets CUSTOMER explicitly.
  kind                   OrganizationKind               @default(SYSTEM)
  /// Org-level billing owner. Distinct from per-Team billing
  /// ownership; Team billing fields stay for transition compatibility
  /// until Stage 5 cutover.
  billingOwnerUserId     String?                        @map("billing_owner_user_id") @db.Uuid
  /// Phase 2 Blocker 1 — brand-new-owner enterprise provisioning.
  /// When a platform admin provisions an enterprise customer whose
  /// owner has no account yet, the resolved enterprise seat count is
  /// persisted here (additive, nullable). It is consumed exactly once
  /// when the ORG_OWNER invite is accepted: the accept handler mints
  /// the ENTERPRISE workspace with these seats and clears this marker.
  /// NULL means "no pending enterprise provisioning" (the default for
  /// every existing and non-enterprise org).
  pendingEnterpriseSeats Int?                           @map("pending_enterprise_seats")
  /// Verification state — mirrors the Team-level field so the
  /// future Stage 5 cutover has a place to land.
  verificationState      OrganizationVerificationState? @map("verification_state")
  verifiedAtUtc          DateTime?                      @map("verified_at_utc") @db.Timestamptz(6)
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           OrganizationMembership[]
  invites               OrganizationInvite[]
  auditEvents           OrganizationAuditEvent[]
  workspaces            Team[]                           @relation("OrganizationToTeam")
  notificationPolicies  OrganizationNotificationPolicy[] @relation("OrganizationNotificationPolicyOrg")
  policies              OrganizationPolicy[]
  // Phase 3 — Enterprise Identity: DNS-verified domain ownership.
  domains               OrganizationDomain[]
  // Phase A1 — back-relation for the Evidence organization relation
  // declared above. Cascades are not used (Restrict) so an
  // Organization with active Evidence cannot be deleted by accident.
  evidence              Evidence[]                       @relation("EvidenceOrganization")
  // Lifecycle Phase 6 — closure request back-relation.
  closureRequests       OrganizationClosureRequest[]     @relation("OrganizationClosureRequests")
  enterpriseContract    EnterpriseContract?              @relation("OrganizationEnterpriseContract")
  // PHASE 10 §10.6/§10.8 — emergency + support access grants scoped to this org.
  emergencyAccessGrants EmergencyAccessGrant[]
  supportAccessGrants   SupportAccessGrant[]
  // PHASE 10 §0B — identities this Organization manages (MANAGED_ENTERPRISE).
  managedIdentities     User[]                           @relation("ManagedIdentityOrg")
  // PHASE 10 §2 — sessions currently holding this Organization's context.
  sessionContexts       AuthenticatedSession[]           @relation("AuthenticatedSessionOrgContext")
  // PHASE 10 §policy-convergence — the ONE security policy for this Customer Org.
  securityPolicy        OrganizationSecurityPolicy?      @relation("OrganizationSecurityPolicyOrg")
  // PHASE 12B CLUSTER 8 — canonical legal holds bound to this Organization.
  canonicalLegalHolds   EvidenceLegalHold[]              @relation("OrganizationCanonicalLegalHolds")

  @@index([status])
  @@map("organizations")
}

// =============================================================================
// Phase 3 — Enterprise Identity: Organization domain ownership verification.
//
// An organization proves ownership of an email domain by publishing a DNS
// TXT record containing the challenge token. Once verified, SSO connections
// configured with restrictToVerifiedDomains only admit logins whose email
// domain matches a VERIFIED row here. This is a REAL ownership proof, distinct
// from the admin-typed (unverified) SsoConnection.allowedEmailDomains allow-list.
//
// Hard rules:
//   - verificationToken is single-purpose (DNS challenge). It is safe to
//     surface to the org admin who is publishing the record; it is NOT a
//     secret credential.
//   - verifiedAt NULL means "pending / not proven". Enforcement paths treat
//     only rows with a non-null verifiedAt as authoritative.
//   - (organizationId, domain) is unique — a domain is claimed once per org.
// =============================================================================
model OrganizationDomain {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  /// Lowercased bare domain (e.g. "acme.com"). No scheme, no path, no port.
  domain            String    @db.VarChar(253)
  /// Opaque DNS-challenge token the admin publishes as a TXT record at
  /// `_proovra-verify.<domain>`. Regenerated is NOT supported — remove +
  /// re-add to rotate.
  verificationToken String    @map("verification_token") @db.VarChar(128)
  /// Non-null once the DNS TXT record proving ownership has been observed.
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain], name: "organization_domains_org_domain_uniq")
  @@index([domain])
  @@index([organizationId, verifiedAt])
  @@map("organization_domains")
}

/**
 * PHASE 12 CORRECTIVE PASS §2 (ARCH-004, 2026-08-07) — GOVERNANCE MEMBERSHIP
 * HAS A LIFECYCLE.
 *
 * The finding: ordinary revocation was a physical DELETE
 * (`removeOrganizationMembership`). The provenance grants were closed first,
 * so the *grant* trail survived — but the membership row did not, which means
 * the system could not answer "was this person ever a member, and who removed
 * them, and why?" from the membership itself. It also meant there was no
 * SUSPENDED state at all: an administrator who wanted to pause someone's
 * governance access had only the irreversible option.
 *
 * The lifecycle mirrors the one `TeamMember` has carried since Phase 17, on
 * purpose — two membership concepts in one product should not have two
 * different vocabularies for the same three facts.
 *
 *   ACTIVE     the only state that grants Organization authority.
 *   SUSPENDED  reversible pause. Access is refused; history is intact.
 *   REVOKED    terminal. Access is refused; the row REMAINS so the removal is
 *              attributable. Physical deletion survives only for account
 *              closure/erasure, which is a different obligation.
 *
 * PENDING is deliberately ABSENT. An invitation that has not been accepted is
 * `OrganizationInvite`'s business, and duplicating it here would create the
 * second authority this whole exercise exists to remove.
 */
model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(ORG_MEMBER)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  /** The ONLY field that decides whether this membership grants anything. */
  status              OrganizationMembershipStatus @default(ACTIVE)
  statusChangedAtUtc  DateTime?                    @map("status_changed_at_utc") @db.Timestamptz(6)
  suspendedAtUtc      DateTime?                    @map("suspended_at_utc") @db.Timestamptz(6)
  suspendedByUserId   String?                      @map("suspended_by_user_id") @db.Uuid
  suspensionReason    String?                      @map("suspension_reason") @db.VarChar(400)
  revokedAtUtc        DateTime?                    @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId     String?                      @map("revoked_by_user_id") @db.Uuid
  revocationReason    String?                      @map("revocation_reason") @db.VarChar(400)
  /** Which authority last moved this membership: MANUAL, SCIM, SYSTEM… */
  statusSource        String?                      @map("status_source") @db.VarChar(32)
  /** Contract-bounded membership, where the agreement needs one. */
  validUntilUtc       DateTime?                    @map("valid_until_utc") @db.Timestamptz(6)
  /**
   * Monotonic generation. Every transition increments it inside the same
   * guarded UPDATE that changes the status, and every transition names the
   * generation it believes it is moving FROM. A caller holding a stale
   * generation updates zero rows — which is what makes concurrent
   * suspend/restore deterministic instead of last-writer-wins.
   */
  statusGeneration    Int                          @default(0) @map("status_generation")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspendedBy  User?        @relation("OrgMembershipSuspendedBy", fields: [suspendedByUserId], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("OrgMembershipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId], name: "organization_memberships_org_user_uniq")
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

/**
 * ARCH-004. Deliberately the same three values as `TeamMemberStatus`: one
 * product should not spell the same three facts two different ways.
 */
enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model OrganizationInvite {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String           @db.VarChar(320)
  role            OrganizationRole
  // Phase 2.7X Stage 6 — token security hardening.
  // `token` is now NULLABLE — new rows write NULL; only existing
  // (pre-Stage-6) rows keep raw token values for rollback. The
  // authoritative lookup column is `tokenHash` (SHA-256 hex of
  // the raw token). Stage 7+ destructive cutover will drop the
  // raw token column once enough release cycles have proven the
  // hash-only path stable.
  token           String?          @unique @db.VarChar(128)
  tokenHash       String           @unique @map("token_hash") @db.VarChar(64)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?          @map("revoked_by_user_id") @db.Uuid
  lastResentAt    DateTime?        @map("last_resent_at") @db.Timestamptz(6)
  resendCount     Int              @default(0) @map("resend_count")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  /// P2 DOMAIN REMEDIATION (2026-07-21) — explicit per-invite WORKSPACE
  /// assignments: `[{ "teamId": uuid, "role": TeamRole }]`. Governance-only
  /// invites carry NULL/[] (OrganizationMembership only — the previous, and
  /// still valid, behavior). When present, the atomic accept transaction
  /// ALSO upserts an ACTIVE TeamMember per assignment, after validating the
  /// team belongs to this organization. Organization membership never
  /// implies all-workspace access; access is exactly what was assigned.
  workspaceAssignments Json? @map("workspace_assignments")

  /// P2 — who consumed the invite (audit/idempotency completeness).
  acceptedByUserId String? @map("accepted_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model OrganizationAuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// Free-form event taxonomy (matches TeamActivity's pattern) so
  /// new event types are write-path additions, not enum migrations.
  eventType      String   @map("event_type")
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([eventType])
  @@map("organization_audit_events")
}

model OrganizationPolicy {
  /// Lightweight (key, value) policy storage at the org level.
  /// Each row is a single policy entry: no engine, no inheritance
  /// magic. Unknown keys are ignored. Known keys live in the
  /// frontend + backend policy registry.
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  key                 String   @db.VarChar(80)
  value               Json
  lastUpdatedByUserId String   @map("last_updated_by_user_id") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key], name: "organization_policies_org_key_uniq")
  @@map("organization_policies")
}

// =============================================================================
// Phase M3.1 — Insurance SIU durability.
//
// Five additive tables that replace the M3 in-memory registry with a
// durable Prisma projection. Hard rules:
//   * Workspace-scoped via `teamId`. No cross-tenant scan.
//   * Additive only — no existing column / constraint changes.
//   * Bounded operator-facing strings (varchar caps mirror existing
//     PROOVRA conventions).
//   * Claimant PII is bounded by length AND access-gated at the
//     service layer; the SIU profile carries a `piiVisibilityPolicy`
//     enum so policy lives next to the data.
// =============================================================================

model CaseSiuProfile {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId                    String    @unique @map("case_id") @db.Uuid
  teamId                    String    @map("team_id") @db.Uuid
  /// Bounded claim type — mirrors `SIU_CLAIM_TYPES` in @proovra/shared.
  claimType                 String    @map("claim_type") @db.VarChar(24)
  /// Bounded investigation status — mirrors `SIU_INVESTIGATION_STATUSES`.
  investigationStatus       String    @map("investigation_status") @db.VarChar(24)
  claimNumber               String?   @map("claim_number") @db.VarChar(80)
  policyReference           String?   @map("policy_reference") @db.VarChar(120)
  incidentDate              DateTime? @map("incident_date") @db.Timestamptz(6)
  /// Bounded structured incident-location projection (lat/lng/locality).
  incidentLocationJson      Json?     @map("incident_location_json")
  lossDescription           String?   @map("loss_description") @db.VarChar(2000)
  assignedAdjusterUserId    String?   @map("assigned_adjuster_user_id") @db.Uuid
  assignedSiuReviewerUserId String?   @map("assigned_siu_reviewer_user_id") @db.Uuid
  /// Privacy-gated claimant name. Bounded to 200 chars. Redacted by
  /// default at the service layer unless caller has `siu.pii.view`.
  claimantName              String?   @map("claimant_name") @db.VarChar(200)
  /// Privacy-gated claimant contact. Bounded to 200 chars.
  claimantContact           String?   @map("claimant_contact") @db.VarChar(200)
  /// Bounded PII visibility policy enum (text — see
  /// `SIU_PII_VISIBILITY_POLICIES` in @proovra/shared).
  piiVisibilityPolicy       String    @default("redacted_by_default") @map("pii_visibility_policy") @db.VarChar(40)
  /// Bounded intake-template id mirrored from @proovra/shared.
  intakeTemplateId          String?   @map("intake_template_id") @db.VarChar(60)
  createdByUserId           String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId           String?   @map("updated_by_user_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklistItems   CaseSiuChecklistItem[]
  followUps        CaseSiuFollowUp[]
  reviewIndicators CaseSiuReviewIndicator[]
  exports          CaseSiuExport[]

  @@index([teamId])
  @@index([teamId, investigationStatus])
  @@index([teamId, claimType])
  @@index([assignedAdjusterUserId])
  @@index([assignedSiuReviewerUserId])
  @@map("case_siu_profiles")
}

model CaseSiuChecklistItem {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siuProfileId          String    @map("siu_profile_id") @db.Uuid
  /// Bounded template-item id from the SIU intake template.
  templateItemId        String    @map("template_item_id") @db.VarChar(120)
  label                 String    @db.VarChar(120)
  description           String?   @db.VarChar(480)
  required              Boolean   @default(false)
  /// Bounded list of accepted evidence kinds (`PHOTO|VIDEO|AUDIO|DOCUMENT`).
  acceptedKindsJson     Json      @map("accepted_kinds_json")
  /// Bounded status — mirrors `SIU_CHECKLIST_ITEM_STATUSES`.
  status                String    @default("missing") @db.VarChar(24)
  /// Bounded JSON array of evidence ids mapped to this item.
  mappedEvidenceIdsJson Json      @default("[]") @map("mapped_evidence_ids_json")
  note                  String?   @db.VarChar(480)
  dueAt                 DateTime? @map("due_at") @db.Timestamptz(6)
  satisfiedAt           DateTime? @map("satisfied_at") @db.Timestamptz(6)
