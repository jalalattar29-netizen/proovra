  // has a deterministic audit timestamp. Distinct from createdAt for back-compat reads.
  assignedAtUtc     DateTime @default(now()) @map("assigned_at_utc") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  policy GovernancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  // R7-governance: named composite unique — service upserts use `policyId_scope_scopeTargetId` as the
  // unique-where shape. Honours the Phase 4A "one policy assignment per (policy, scope, target) tuple"
  // invariant that the dashboard + enforcement engine rely on.
  @@unique([policyId, scope, scopeTargetId], name: "policyId_scope_scopeTargetId")
  @@index([policyId])
  @@index([teamId])
  @@map("governance_policy_assignments")
}

