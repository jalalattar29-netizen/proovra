  decidedByUserId String   @map("decided_by_user_id") @db.Uuid
  reasonNote      String?  @map("reason_note") @db.VarChar(400)
  createdAtUtc    DateTime @default(now()) @map("created_at_utc") @db.Timestamptz(6)

  @@unique([teamId, edgeId])
  @@index([teamId, decision])
  @@map("duplicate_decisions")
}

/// Phase A2 — Workspace-level AI governance policy.
///
/// OPTIONAL per-Team row. ABSENCE of a row means "no explicit policy":
/// the canonical evaluator (`evaluateWorkspaceAiPolicy`) applies the
/// safe code-level DEFAULT_WORKSPACE_AI_POLICY, which mirrors the pre-A2
/// runtime behaviour (advisory AI allowed subject to the global flag +
/// plan entitlement; content-intelligence / raw-content / copilots off).
/// Creating this table changes NO behaviour until an admin writes a row.
/// The master `aiEnabled=false` switch is a fail-closed backend gate:
/// no provider call may occur once the evaluator denies.
model WorkspaceAiPolicy {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @unique @map("team_id") @db.Uuid

  // Master + per-feature switches. A saved row's defaults mirror today's
  // runtime so opening + saving the settings page keeps current behaviour.
  aiEnabled                     Boolean @default(true) @map("ai_enabled")
  supportChatEnabled            Boolean @default(true) @map("support_chat_enabled")
  captureAssistanceEnabled      Boolean @default(true) @map("capture_assistance_enabled")
  evidenceCategorizationEnabled Boolean @default(true) @map("evidence_categorization_enabled")
  semanticSearchEnabled         Boolean @default(false) @map("semantic_search_enabled")
  contentIntelligenceEnabled    Boolean @default(false) @map("content_intelligence_enabled")
  reviewerCopilotEnabled        Boolean @default(false) @map("reviewer_copilot_enabled")
  caseCopilotEnabled            Boolean @default(false) @map("case_copilot_enabled")

  // Data-class permissions (default-deny beyond metadata).
  rawContentProcessingAllowed Boolean @default(false) @map("raw_content_processing_allowed")
  ocrAllowed                  Boolean @default(false) @map("ocr_allowed")
  transcriptionAllowed        Boolean @default(false) @map("transcription_allowed")
  embeddingsAllowed           Boolean @default(false) @map("embeddings_allowed")

  // Role allowlist — null = all roles permitted (current behaviour).
  allowedRolesJson Json? @map("allowed_roles_json")

  // Optional workspace-level quotas/budgets (durable ledger lands in A7;
  // these are the policy ceilings that ledger will enforce).
  dailyOperationLimit       Int?    @map("daily_operation_limit")
  monthlyOperationLimit     Int?    @map("monthly_operation_limit")
  dailyCostLimitUsdMicros   BigInt? @map("daily_cost_limit_usd_micros")
  monthlyCostLimitUsdMicros BigInt? @map("monthly_cost_limit_usd_micros")

  // AI advisory-output retention window (E1 consumes this). Null = platform default.
  retentionDays Int? @map("retention_days")

  policyVersion   Int      @default(1) @map("policy_version")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("workspace_ai_policies")
}

