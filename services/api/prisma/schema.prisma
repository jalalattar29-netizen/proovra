// FileSecurityScan — per-evidence scan record. Created when an upload
// completes (or when an external scan job runs). Status reflects the
// state of the LATEST scan, not history; for history use audit events.
// Failures here NEVER cause evidence deletion — they only annotate the
// record and may trigger REVIEW_REQUIRED flow at the application layer.
enum FileSecurityScanStatus {
  PENDING
  CLEAN
  SUSPICIOUS
  FAILED
  SKIPPED
}

model FileSecurityScan {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId String  @map("evidence_id") @db.Uuid
  teamId     String? @map("team_id") @db.Uuid

  status FileSecurityScanStatus @default(PENDING)

  // Scanner identifier (e.g. "noop", "clamav-0.103", "cloud-x").
  // Empty/null when no scanner is configured.
  scanner          String? @db.VarChar(64)
  signatureVersion String? @map("signature_version") @db.VarChar(64)

  // Operator-readable summary. NEVER store full payloads, raw signature
  // hits, or anything that would itself be unsafe to redistribute.
  findingsSummary String? @map("findings_summary") @db.VarChar(2000)

  scannedAtUtc DateTime? @map("scanned_at_utc") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceSecurityScans", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId, createdAt(sort: Desc)])
  @@index([teamId, status, createdAt(sort: Desc)])
  @@index([status])
  @@map("file_security_scans")
}

// SecurityEvent — workspace-scoped, internal-only abuse / anomaly /
// suspicious-activity signal. Never exposed on public verify, external
// intake, or report-v2. Reuses the existing AdminAuditLog only when an
// event is also a chain-relevant action; routine operational signals
// (rate-limit hits, repeated failures) live here so the audit chain
// stays focused on actor decisions.
enum SecurityEventSeverity {
  INFO
  WARNING
  HIGH
}

// Phase 32.7.2 — SecurityEvent naming-drift repair.
//
// Production inspection confirmed the `security_events` table uses
// CAMELCASE column names:
//   id, teamId, userId, eventType, severity, ipAddressHash, userAgent,
//   requestId, metadataJson, createdAtUtc
//
// The previous Prisma model expected SNAKE_CASE columns (team_id,
// event_type, created_at, etc.) via `@map(...)`. Every query emitted
// SQL like `SELECT team_id, event_type, created_at, ... FROM
// security_events` and the live DB raised P2022 ("column does not
// exist"). This cascaded:
//   * readiness `checkWorkers` SELECT on `eventType`/`createdAt`
//     failed → workers UNKNOWN with `telemetry_query_failed`.
//   * Worker reconcile heartbeat INSERT failed → no heartbeat row
//     ever landed → readiness still couldn't find a recent reconcile.
//
// Fix is purely a Prisma-side `@map(...)` realignment. NO DB
// migration is required. NO production columns are renamed or
// dropped. The wire format on the bus and downstream queries is
// preserved verbatim (the production column names are what
// downstream dashboards already use).
//
// Field-level rationale:
//   * Bounded primary fields (id, teamId, userId, eventType,
//     severity) are mapped to their literal camelCase production
//     columns. `@map("camelCase")` is explicit even when the Prisma
//     field name is also camelCase — future refactors won't quietly
//     remove the mapping thinking it's redundant.
//   * `ipAddressHash`, `userAgent`, `requestId` are new Prisma
//     fields. Production already had these columns; the previous
//     Prisma model omitted them entirely. Declaring them here
//     unblocks future writers without changing existing behavior
//     (no current writer populates them).
//   * `details` (Prisma field name preserved for caller compat)
//     maps to production column `metadataJson`.
//   * `createdAt` (Prisma field name preserved for caller compat)
//     maps to production column `createdAtUtc`.
//   * `evidenceId`, `apiCredentialId`, `webhookEndpointId` removed
//     — production has no such columns. Their values are folded
//     into the `metadataJson` blob by `emitSecurityEvent` so caller
//     interfaces stay backward-compatible.
model SecurityEvent {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("teamId") @db.Uuid
  userId String? @map("userId") @db.Uuid

  // Stable canonical event type string. Adding one requires a code
  // change so we can keep the operator-facing labels under control.
  eventType String @map("eventType") @db.VarChar(64)
  // Phase IA-securityEvent-driftFix —
  // Production inspection (via the `operator does not exist:
  // character varying = "SecurityEventSeverity"` error surfaced by
  // /v1/me/inbox when filtering `severity: "HIGH"`) confirms the live
  // `security_events.severity` column is VARCHAR — NOT the enum type
  // declared by the original Phase-11 migration. The Phase 0 catchup
  // migration realigned every other field on this table to camelCase
  // production columns; `severity` was the last field still drifting
  // because the Prisma model kept the enum type. Under the
  // `@prisma/adapter-pg` driver adapter, Prisma generates SQL with an
  // explicit enum cast on the parameter
  // (`WHERE "severity" = $1::"SecurityEventSeverity"`), which Postgres
  // rejects against the varchar column.
  //
  // Fix is Prisma-side ONLY — the column already IS varchar in
  // production. Declaring it as `String @db.VarChar(16)` aligns the
  // generated SQL with the live column type. The `SecurityEventSeverity`
  // enum is retained at the schema level for documentation + back-
  // compat with `import { SecurityEventSeverity } from "@prisma/client"`
  // call sites that use it as a label catalog. Writers in the codebase
  // already pass plain string literals (`severity: "HIGH"` etc.), so
  // their behavior is unchanged. The allowed values catalog lives in
  // application code (see `services/api/src/services/security/severity.ts`).
  severity  String @default("INFO") @map("severity") @db.VarChar(16)

  // Phase 32.7.2 — production already has these columns; Prisma
  // model declares them now so future writers (e.g., audit
  // middleware) can populate them without further schema work. No
  // current writer is required to set them.
  ipAddressHash String? @map("ipAddressHash") @db.VarChar(128)
  userAgent     String? @map("userAgent") @db.VarChar(512)
  requestId     String? @map("requestId") @db.VarChar(80)

  // Free-form JSON, bounded by service-layer redaction. Operators
  // should ONLY put non-sensitive details here. Production column
  // name is `metadataJson`; the Prisma field name `details` is
  // preserved to keep caller interfaces unchanged.
  details Json? @map("metadataJson")

  createdAt DateTime @default(now()) @map("createdAtUtc") @db.Timestamptz(6)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("security_events")
}

// =============================================================================
// Phase 12 — Reliability & large-upload platform
// =============================================================================

// UploadSession — canonical, observable lifecycle wrapper for an
// evidence upload. 1:1 with Evidence. The existing EvidenceStatus
// machine (CREATED → UPLOADING → SIGNED → REPORTED) remains the
// source of truth for forensic / chain decisions; this row mirrors
// the upload lifecycle with the richer states the operations team
// needs (STALLED, ABANDONED, PARTIAL, REVIEW_REQUIRED) and tracks
// multipart bookkeeping that would otherwise live nowhere.
//
// IMPORTANT: a UploadSession FAILED / STALLED / ABANDONED state does
// NOT delete or mutate the Evidence row or its custody chain. It is
// purely a recovery / operator-action surface.
enum UploadSessionStatus {
  CREATED
  PRESIGNED
  UPLOADING
  PARTIAL
  VERIFYING
  COMPLETED
  FAILED
  STALLED
  ABANDONED
  REVIEW_REQUIRED
}

model UploadSession {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId String @unique @map("evidence_id") @db.Uuid
  teamId     String @map("team_id") @db.Uuid

  status UploadSessionStatus @default(CREATED)

  // Multipart bookkeeping. Single-file uploads leave these null.
  isMultipart        Boolean @default(false) @map("is_multipart")
  expectedPartCount  Int?    @map("expected_part_count")
  completedPartCount Int     @default(0) @map("completed_part_count")
  // S3 multipart UploadId when client-driven multipart is used. PROOVRA
  // today uses per-part presigned PUTs (not S3-multipart), so this is
  // reserved for the resumable-multipart roadmap and stays null in
  // current deployments.
  multipartUploadId  String? @map("multipart_upload_id") @db.VarChar(256)

  retryCount    Int     @default(0) @map("retry_count")
  failureReason String? @map("failure_reason") @db.VarChar(400)

  // Heartbeat / activity tracking. `lastActivityAtUtc` is bumped on
  // every state-changing operation. Stalled / abandoned reconciliation
  // works off this column + the configured thresholds.
  lastActivityAtUtc DateTime  @default(now()) @map("last_activity_at_utc") @db.Timestamptz(6)
  stalledAtUtc      DateTime? @map("stalled_at_utc") @db.Timestamptz(6)
  abandonedAtUtc    DateTime? @map("abandoned_at_utc") @db.Timestamptz(6)
  completedAtUtc    DateTime? @map("completed_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceUploadSession", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([status, lastActivityAtUtc])
  @@index([status, createdAt(sort: Desc)])
  @@map("upload_sessions")
}

// =============================================================================
// Phase 14 — Enterprise governance platform
// =============================================================================

// PublicVerifyState — explicit publication lifecycle for an evidence
// record. Default PUBLISHED preserves pre-Phase-14 behavior exactly
// (every SIGNED / REPORTED evidence remains visible on /verify/:id).
//
//   NOT_PUBLISHED — created in safe state for governance-required flows
//   PUBLISHED     — visible on public verify (default)
//   SUSPENDED     — temporarily hidden by operator; can be RESTORED
//   UNPUBLISHED   — permanently withdrawn by operator; can be republished
enum PublicVerifyState {
  NOT_PUBLISHED
  PUBLISHED
  SUSPENDED
  UNPUBLISHED
}

// RetentionPolicySource — annotates WHERE the effective retention
// expiry came from. Operator-readable; never affects integrity.
enum RetentionPolicySource {
  WORKSPACE_DEFAULT
  WORKFLOW_TEMPLATE
  EVIDENCE_OVERRIDE
  CASE_OVERRIDE
}

// =============================================================================
// Phase 27 — Enterprise lifecycle state machine for Evidence.
//
// Transitions go through services/api/src/services/governance-lifecycle/
// lifecycle-orchestrator.service.ts. The orchestrator never lets a
// hold-protected evidence reach PENDING_DESTRUCTION or DESTROYED, and
// never lets RETENTION_LOCKED transition out except via a legal hold
// release or a policy supersede.
// =============================================================================
enum EvidenceLifecycleState {
  /// Default. Fully usable evidence.
  ACTIVE
  /// Operator review in progress (Phase 13/25 reviewer ops).
  UNDER_REVIEW
  /// At least one legal hold is active on the evidence (Phase 14).
  ON_HOLD
  /// Retention policy is immutable — destruction blocked even if
  /// retention expires. Operators can transition out only via a
  /// policy supersede.
  RETENTION_LOCKED
  /// Retention expired + destruction review queued (Phase 27).
  PENDING_DESTRUCTION
  /// Destruction certificate emitted; physical bytes purged on
  /// next worker pass. The Evidence row is preserved as a tombstone
  /// (the canonical audit signal for "this evidence used to exist").
  DESTROYED
  /// Operator-archived (not destroyed). Retains all integrity
  /// metadata but is hidden from active surfaces.
  ARCHIVED
}

// =============================================================================
// Phase 15 — Enterprise intelligence platform
// =============================================================================

// Async job mirror for OCR / transcript / embedding / similarity /
// entity-extraction work on an evidence record. Mirrors the existing
// FileSecurityScan / UploadSession pattern: a thin operational row
// that NEVER mutates evidence integrity. Job failure is recorded;
// the evidence row is untouched.
enum EvidenceIntelligenceJobKind {
  OCR
  TRANSCRIPT
  ENTITY_EXTRACTION
  EMBEDDING
  SIMILARITY
}

enum EvidenceIntelligenceJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

model EvidenceIntelligenceJob {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId     String                        @map("evidence_id") @db.Uuid
  teamId         String                        @map("team_id") @db.Uuid
  kind           EvidenceIntelligenceJobKind
  status         EvidenceIntelligenceJobStatus @default(PENDING)
  provider       String?                       @db.VarChar(64)
  attemptCount   Int                           @default(0) @map("attempt_count")
  // Short operator-readable summary; NEVER stores raw provider responses
  // or sensitive content. Use the dedicated extraction tables for that.
  lastError      String?                       @map("last_error") @db.VarChar(400)
  scheduledAtUtc DateTime?                     @map("scheduled_at_utc") @db.Timestamptz(6)
  startedAtUtc   DateTime?                     @map("started_at_utc") @db.Timestamptz(6)
  completedAtUtc DateTime?                     @map("completed_at_utc") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceIntelligenceJobs", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId, kind, status])
  @@index([teamId, status, createdAt(sort: Desc)])
  @@index([status, scheduledAtUtc])
  @@map("evidence_intelligence_jobs")
}

// Per-evidence extracted text. One row per (evidence, kind, provider).
// Kept separate from evidence to keep the forensic row free of
// derived/advisory content. Indexed only by `evidenceId` so search
// callers can join.
enum EvidenceExtractedTextKind {
  OCR_PDF
  OCR_IMAGE
  PDF_TEXT
  TRANSCRIPT_AUDIO
  TRANSCRIPT_VIDEO
}

enum EvidenceExtractedTextStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

model EvidenceExtractedText {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId      String                      @map("evidence_id") @db.Uuid
  teamId          String                      @map("team_id") @db.Uuid
  kind            EvidenceExtractedTextKind
  status          EvidenceExtractedTextStatus @default(PENDING)
  // Provider name + version. Operators can audit which engine produced
  // the text — important when results need re-running with a newer
  // provider.
  provider        String                      @db.VarChar(64)
  providerVersion String?                     @map("provider_version") @db.VarChar(64)
  language        String?                     @db.VarChar(16)
  // Plain text. NULL for SKIPPED / FAILED rows. Bounded by env at the
  // service layer; not stored elsewhere on the evidence row.
  text            String?
  // Average confidence (0..1). Treat as ADVISORY only — never as truth.
  confidence      Float?
  // Word count for cheap UI rendering without loading text.
  wordCount       Int?                        @map("word_count")
  durationMs      Int?                        @map("duration_ms")
  errorMessage    String?                     @map("error_message") @db.VarChar(400)
  extractedAtUtc  DateTime?                   @map("extracted_at_utc") @db.Timestamptz(6)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceExtractedTexts", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId, kind])
  @@index([teamId, status])
  @@map("evidence_extracted_texts")
}

// Extracted entity surface — deterministic regex-driven by default
// (see entity-extraction.service.ts). Optionally enriched by AI.
// NEVER treated as factual truth; the UI surfaces these as
// "advisory candidates".
enum EvidenceEntityKind {
  PERSON
  EMAIL
  PHONE
  ORG
  LOCATION
  DATE
  REFERENCE_ID
  URL
}

enum EvidenceEntitySource {
  OCR
  TRANSCRIPT
  METADATA
  AI
  MANUAL
}

model EvidenceEntity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId      String               @map("evidence_id") @db.Uuid
  teamId          String               @map("team_id") @db.Uuid
  kind            EvidenceEntityKind
  source          EvidenceEntitySource
  // The raw matched text — what the operator sees.
  value           String               @db.VarChar(512)
  // Normalised form for de-dup + search (e.g. lowercased email,
  // digits-only phone). Optional.
  normalizedValue String?              @map("normalized_value") @db.VarChar(512)
  confidence      Float?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceEntities", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId, kind])
  @@index([teamId, kind, normalizedValue])
  @@map("evidence_entities")
}

// Semantic chunk + (future) embedding. Phase 15 stores the chunked
// text + provider metadata; the embedding column is bytes for forward
// compatibility with pgvector or in-memory cosine similarity, but
// nothing is populated unless `SEMANTIC_SEARCH_ENABLED=true` and a
// provider is configured.
model EvidenceSemanticChunk {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId          String                       @map("evidence_id") @db.Uuid
  teamId              String                       @map("team_id") @db.Uuid
  chunkIndex          Int                          @map("chunk_index")
  chunkText           String                       @map("chunk_text")
  embeddingProvider   String?                      @map("embedding_provider") @db.VarChar(64)
  embeddingModel      String?                      @map("embedding_model") @db.VarChar(128)
  embeddingDimensions Int?                         @map("embedding_dimensions")
  embedding           Bytes?
  // Phase 15 — pgvector sibling column. Additive — `embedding`
  // (Bytes) is preserved for backward compatibility with the
  // existing in-process cosine ranker. When pgvector is installed
  // AND `SEMANTIC_SEARCH_ENABLED=true`, the worker populates this
  // column so the hybrid ranker can rely on SQL-level cosine /
  // L2-distance lookups via the ivfflat index. The column is
  // typed `Unsupported(...)` because Prisma 5 has no first-class
  // pgvector type — every read/write goes through `$queryRaw`.
  embeddingVector     Unsupported("vector(1536)")? @map("embedding_vector")
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceSemanticChunks", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, chunkIndex])
  @@index([teamId])
  @@map("evidence_semantic_chunks")
}

// Phase 16 — per-workspace-per-UTC-day rollup of paid semantic
// embedding usage. Recorded after every successful provider call
// (live indexing path, mi-embed queue, backfill script). Read by
// `canEmbedMore` (daily chunk cap + monthly EUR budget gate) and
// by `getSemanticUsageSummary` (UI surface).
//
// Bounded by construction:
//   - one row per (workspaceId, dateUtc) — UNIQUE upsert key
//   - counter columns are scalar integers + dollar-micros (no per-call
//     payload). Operators cannot pivot from a row back to chunk text.
model SemanticUsageDaily {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  dateUtc        DateTime @map("date_utc") @db.Date
  chunksEmbedded Int      @default(0) @map("chunks_embedded")
  tokensConsumed BigInt   @default(0) @map("tokens_consumed")
  eurSpentMicros BigInt   @default(0) @map("eur_spent_micros")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, dateUtc])
  @@index([workspaceId])
  @@map("semantic_usage_daily")
}

// Advisory similarity hint between two evidence rows. NOT a merge
// signal, NOT a duplicate confirmation, NOT a manipulation claim.
// Operators decide. The wording in the projector enforces "possible"
// / "candidate" language.
enum EvidenceSimilarityKind {
  HASH_DUPLICATE
  FILENAME_SIMILAR
  OCR_SIMILAR
  TRANSCRIPT_SIMILAR
  METADATA_SIMILAR
  EMBEDDING_SIMILAR
}

model EvidenceSimilarity {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId           String                 @map("team_id") @db.Uuid
  sourceEvidenceId String                 @map("source_evidence_id") @db.Uuid
  targetEvidenceId String                 @map("target_evidence_id") @db.Uuid
  kind             EvidenceSimilarityKind
  // 0..1; operators treat as relative ordering signal, not truth.
  score            Float
  // Operator-readable summary. Wording enforced as ADVISORY.
  advisorySummary  String?                @map("advisory_summary") @db.VarChar(400)
  // Phase 13 — when a text-similarity row (OCR_SIMILAR / TRANSCRIPT_SIMILAR)
  // is promoted into a SIMILAR_TO graph edge by the media-intelligence
  // worker, the resulting investigation_graph_edges.id is back-referenced
  // here. Nullable: rows that have not been promoted (or pre-Phase-13
  // rows) carry NULL. One-way promotion — the graph never writes back.
  graphEdgeId      String?                @map("graph_edge_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  source Evidence @relation("EvidenceSimilaritySource", fields: [sourceEvidenceId], references: [id], onDelete: Cascade)
  target Evidence @relation("EvidenceSimilarityTarget", fields: [targetEvidenceId], references: [id], onDelete: Cascade)

  @@unique([sourceEvidenceId, targetEvidenceId, kind])
  @@index([teamId, kind, score(sort: Desc)])
  @@index([sourceEvidenceId, kind])
  @@index([targetEvidenceId, kind])
  @@index([graphEdgeId])
  @@map("evidence_similarities")
}

// =============================================================================
// Phase 16 — Enterprise collaboration platform
// =============================================================================

// DiscussionThread — operator-facing operational discussion bound to
// an evidence record (and optionally to a review-request / workflow).
// Sits alongside the existing EvidenceReviewerComment / EvidenceLegalNote
// surface: those remain valid for flat reviewer-only notes; threads
// are for multi-participant operational coordination with status +
// resolution + optional external-contributor scoped access.
//
// IMPORTANT: threads NEVER appear on public verify. They live in the
// workspace-internal collaboration plane and obey the redaction +
// publication-state + legal-hold + retention rules already enforced by
// the governance helpers.
enum DiscussionThreadKind {
  EVIDENCE_GENERAL
  REVIEW_REQUEST_CLARIFICATION
  INVESTIGATION_COORDINATION
  WORKFLOW_DISCUSSION
}

enum DiscussionThreadStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Visibility scope — controls which audience can read the thread.
// INTERNAL is the default (workspace authenticated members only).
// CONTRIBUTOR_SCOPED allows a single external contributor (bound by
// `DiscussionParticipant.intakeSessionId`) to see the thread; the
// route layer enforces the scope.
enum DiscussionThreadVisibility {
  INTERNAL
  CONTRIBUTOR_SCOPED
}

model DiscussionThread {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String  @map("team_id") @db.Uuid
  evidenceId        String  @map("evidence_id") @db.Uuid
  // Optional linkage to a Phase 7 evidence request — when set, the
  // thread shows up on the request detail surface AND on the
  // evidence detail surface. The link is informational; deleting the
  // request does NOT cascade-delete the thread (SET NULL).
  evidenceRequestId String? @map("evidence_request_id") @db.Uuid

  kind       DiscussionThreadKind       @default(EVIDENCE_GENERAL)
  status     DiscussionThreadStatus     @default(OPEN)
  visibility DiscussionThreadVisibility @default(INTERNAL)

  title           String @db.VarChar(180)
  createdByUserId String @map("created_by_user_id") @db.Uuid

  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  assignedAtUtc    DateTime? @map("assigned_at_utc") @db.Timestamptz(6)

  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAtUtc    DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolutionNote   String?   @map("resolution_note") @db.VarChar(1000)

  reopenedAtUtc    DateTime? @map("reopened_at_utc") @db.Timestamptz(6)
  reopenedByUserId String?   @map("reopened_by_user_id") @db.Uuid
  reopenCount      Int       @default(0) @map("reopen_count")

  // Escalation flag — set by `escalateThread`. Distinct from review
  // workflow escalation; this signals the THREAD itself needs senior
  // attention.
  escalatedAtUtc    DateTime? @map("escalated_at_utc") @db.Timestamptz(6)
  escalatedByUserId String?   @map("escalated_by_user_id") @db.Uuid
  escalationReason  String?   @map("escalation_reason") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence              Evidence                @relation("EvidenceDiscussionThreads", fields: [evidenceId], references: [id], onDelete: Cascade)
  messages              DiscussionMessage[]
  participants          DiscussionParticipant[]
  communicationMessages CommunicationMessage[]  @relation("DiscussionThreadCommunicationMessages")

  @@index([teamId, status, updatedAt(sort: Desc)])
  @@index([evidenceId, status])
  @@index([assignedToUserId, status])
  @@index([visibility, status])
  @@map("discussion_threads")
}

// Author kind on each message. The route layer maps the inbound
// caller (authenticated user vs contributor token) to one of these
// values; service accounts are explicitly forbidden from posting
// human collaboration messages and have no corresponding kind value.
enum DiscussionMessageAuthorKind {
  USER
  CONTRIBUTOR
  SYSTEM
}

model DiscussionMessage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId String @map("thread_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid

  authorKind                 DiscussionMessageAuthorKind @map("author_kind")
  authorUserId               String?                     @map("author_user_id") @db.Uuid
  // For CONTRIBUTOR messages — bound to the intake session that
  // authenticated the contributor. Allows audit + revocation.
  contributorIntakeSessionId String?                     @map("contributor_intake_session_id") @db.Uuid
  // Operator-readable label for the contributor (e.g. their email or
  // a short pseudonym). NEVER trusted as identity; the session id is
  // the source of truth.
  contributorLabel           String?                     @map("contributor_label") @db.VarChar(180)

  // Plain text only. No markdown rendering, no HTML — see service
  // for sanitisation. 8 KiB upper bound at the column level.
  body String @db.VarChar(8192)

  editedAtUtc     DateTime? @map("edited_at_utc") @db.Timestamptz(6)
  deletedAtUtc    DateTime? @map("deleted_at_utc") @db.Timestamptz(6)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  thread   DiscussionThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mentions DiscussionMention[]

  @@index([threadId, createdAt(sort: Asc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@map("discussion_messages")
}

// @user mentions resolved at post time. Mention rows are persisted
// separately from message bodies so we can audit + notify cleanly
// without re-parsing prose.
model DiscussionMention {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String    @map("message_id") @db.Uuid
  threadId        String    @map("thread_id") @db.Uuid
  teamId          String?   @map("team_id") @db.Uuid
  mentionedUserId String    @map("mentioned_user_id") @db.Uuid
  notifiedAtUtc   DateTime? @map("notified_at_utc") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  message DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, mentionedUserId])
  @@index([threadId])
  @@index([mentionedUserId, notifiedAtUtc])
  @@map("discussion_mentions")
}

enum DiscussionParticipantRole {
  PARTICIPANT
  RESOLVER
  WATCHER
  CONTRIBUTOR
}

// DiscussionParticipant — explicit roster on a thread. For internal
// threads, participants are workspace users (`userId` set). For
// contributor-scoped threads, the contributor row holds
// `intakeSessionId` so the route layer can verify the inbound token
// against the participant table before granting read/post.
model DiscussionParticipant {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId        String                    @map("thread_id") @db.Uuid
  teamId          String                    @map("team_id") @db.Uuid
  userId          String?                   @map("user_id") @db.Uuid
  intakeSessionId String?                   @map("intake_session_id") @db.Uuid
  role            DiscussionParticipantRole @default(PARTICIPANT)
  addedByUserId   String?                   @map("added_by_user_id") @db.Uuid
  addedAtUtc      DateTime                  @default(now()) @map("added_at_utc") @db.Timestamptz(6)
  // Operators can revoke contributor access without deleting the row
  // — preserves audit history. The route layer treats a non-null
  // revokedAtUtc as "no longer authorised".
  revokedAtUtc    DateTime?                 @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?                   @map("revoked_by_user_id") @db.Uuid

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@unique([threadId, intakeSessionId])
  @@index([userId])
  @@index([intakeSessionId])
  @@map("discussion_participants")
}

// =============================================================================
// Phase 17 — Enterprise Identity & Access Platform
//
// Operational identity governance on top of the existing TeamMember model:
//
//   - TeamMemberStatus               — ACTIVE / SUSPENDED / REVOKED lifecycle
//   - MemberCapabilityGrant          — additive per-member permission grants
//   - MemberDelegatedAdminScope      — scoped administration (governance, review,
//                                      intelligence, integrations, collaboration)
//   - OrganizationSecurityPolicy     — org-level posture (MFA readiness, allowed
//                                      domains, IP restrictions, session timeout)
//   - AccessReview                   — periodic / triggered access review queue
//   - ExternalIdentityMapping        — SSO/SCIM-readiness placeholder linking a
//                                      User to an external identity-provider
//                                      subject (no protocol implementation yet)
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - elevated access never bypasses governance (legal hold, retention freeze,
//     publication freeze, intelligence policy gates)
//   - public verify NEVER reads any of these tables
//   - permission failures fail CLOSED
//   - least-privilege default — a missing capability grant is "deny"
// =============================================================================

enum TeamMemberStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum DelegatedAdminScopeKind {
  GOVERNANCE_ADMIN
  REVIEW_ADMIN
  INTELLIGENCE_ADMIN
  INTEGRATION_ADMIN
  COLLABORATION_ADMIN
  IDENTITY_ADMIN
  RETENTION_ADMIN
}

enum AccessReviewKind {
  PERIODIC_MEMBER_REVIEW
  STALE_ACCESS
  UNUSED_SERVICE_ACCOUNT
  EXPIRING_TEMPORARY_ACCESS
  SUSPICIOUS_ACCESS_PATTERN
  EMERGENCY_REVOCATION_FOLLOWUP
}

enum AccessReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED_KEEP
  COMPLETED_REVOKED
  COMPLETED_SUSPENDED
  COMPLETED_NO_ACTION
  CANCELLED
}

enum AccessReviewSubjectKind {
  TEAM_MEMBER
  SERVICE_ACCOUNT
  CONTRIBUTOR_SESSION
}

enum ExternalIdentityProvider {
  GENERIC_SAML
  GENERIC_OIDC
  GENERIC_SCIM
  OKTA
  AZURE_AD
  GOOGLE_WORKSPACE
}

// MemberCapabilityGrant — additive permission grant for a specific
// TeamMember. The access policy engine treats the canonical role
// permissions as the floor and unions in any non-expired, non-revoked
// capability grant. Grants are ALWAYS scoped to a team membership; a
// grant on a revoked or suspended member has no effect.
model MemberCapabilityGrant {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamMemberId String @map("team_member_id") @db.Uuid
  teamId       String @map("team_id") @db.Uuid

  // Canonical permission identifier (see @proovra/shared permissions.ts).
  permission String @db.VarChar(96)

  reason          String?   @db.VarChar(400)
  grantedAtUtc    DateTime  @default(now()) @map("granted_at_utc") @db.Timestamptz(6)
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  expiresAtUtc    DateTime? @map("expires_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teamMember TeamMember @relation("MemberCapabilityGrants", fields: [teamMemberId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("MemberCapabilityGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy  User?      @relation("MemberCapabilityGrantRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamMemberId, permission])
  @@index([teamId, permission])
  @@index([teamMemberId])
  @@index([expiresAtUtc])
  @@index([revokedAtUtc])
  @@map("member_capability_grants")
}

// MemberDelegatedAdminScope — scoped administration. A delegated admin
// for GOVERNANCE_ADMIN can run governance operations even if their
// TeamRole is MEMBER, but ONLY within the named scope. Scope kinds map
// 1:1 to the canonical permission families.
model MemberDelegatedAdminScope {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamMemberId String                  @map("team_member_id") @db.Uuid
  teamId       String                  @map("team_id") @db.Uuid
  scopeKind    DelegatedAdminScopeKind @map("scope_kind")

  reason          String?   @db.VarChar(400)
  grantedAtUtc    DateTime  @default(now()) @map("granted_at_utc") @db.Timestamptz(6)
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  expiresAtUtc    DateTime? @map("expires_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teamMember TeamMember @relation("MemberDelegatedAdminScopes", fields: [teamMemberId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("MemberDelegatedAdminScopeGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy  User?      @relation("MemberDelegatedAdminScopeRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamMemberId, scopeKind])
  @@index([teamId, scopeKind])
  @@index([teamMemberId])
  @@index([expiresAtUtc])
  @@index([revokedAtUtc])
  @@map("member_delegated_admin_scopes")
}

// OrganizationSecurityPolicy — 1:1 with Team. Stores org-level posture
// declared by the workspace owner. Phase 17 is "readiness only" for MFA
// and SSO/SCIM — the flags are stored and exposed in audit + identity
// UI, but no protocol enforcement is added in this phase (no actual MFA
// challenge, no actual SAML/OIDC flow). The session-timeout values ARE
// enforced (existing JWT layer reads them).
model OrganizationSecurityPolicy {
  // PHASE 10 §policy-convergence (2026-07-23) — the policy is a CUSTOMER
  // ORGANIZATION policy. `teamId` is retained ONLY as a zero-decision
  // compatibility key during the migration window (Phase-12 removal); the
  // AUTHORITATIVE key is `organizationId` — exactly ONE policy per Customer
  // Organization, inherited by all its WorkspaceKind.ORGANIZATION workspaces.
  // Personal/OWNED workspaces and SYSTEM organizations get NO policy row.
  //
  // §policy-lifecycle (2026-07-23) — the ORGANIZATION owns the policy lifecycle.
  // The PK is a synthetic `id` so `teamId` can be NULLABLE compatibility metadata
  // with an `onDelete: SetNull` relation: deleting/archiving a Workspace can NEVER
  // delete or re-parent the org policy. Writers upsert by `organizationId` (the
  // authoritative unique key) and never mutate `teamId` during ordinary patching.
  // Org deletion cascades the policy (org owns it). (Migrations 20271005000000 +
  // 20271006000000, authored NOT applied.)
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String? @map("team_id") @db.Uuid
  organizationId String? @unique @map("organization_id") @db.Uuid

  // MFA readiness — when true, the org has DECLARED an intent to require
  // MFA. Enforcement lands in a later phase; the flag is exposed in audit
  // and the identity UI so operators can see policy intent.
  mfaRequiredFlag Boolean @default(false) @map("mfa_required_flag")

  // Phase 19 — MFA policy level. The mfaRequiredFlag above remains a
  // boolean readiness indicator for back-compat; mfaPolicyLevel is the
  // ENFORCED policy (deterministic, role-aware). Defaults to OFF so
  // existing workspaces are not retroactively gated; operators opt in
  // via /security-center.
  mfaPolicyLevel         String  @default("OFF") @map("mfa_policy_level") @db.VarChar(32)
  // PHASE R8.1.5 — per-org MFA enforcement fail-mode override.
  //
  //   SMART       (default) personal users fail-OPEN, org-scoped
  //               users fail-CLOSED on Prisma/policy outages.
  //   FAIL_CLOSED every classified resolver error returns
  //               ENROLLMENT_REQUIRED for users without a factor
  //               or MFA_REQUIRED for users with one.
  //   FAIL_OPEN   classified errors return NOT_REQUIRED with a
  //               degraded warning event. NOT recommended for
  //               enterprise; useful for demo / low-risk tenants.
  //
  // Resolver consults this column FIRST; the global
  // MFA_ENFORCEMENT_FAIL_MODE env is fallback only when this row
  // is missing or NULL.
  mfaEnforcementFailMode String? @map("mfa_enforcement_fail_mode") @db.VarChar(16)
  stepUpTtlSeconds       Int?    @map("step_up_ttl_seconds")
  trustedDeviceTtlDays   Int?    @map("trusted_device_ttl_days")

  // Domain allow-list — when non-empty, all new member invites MUST have
  // an email whose host is in this list. Empty array = no restriction.
  allowedEmailDomains String[] @default([]) @map("allowed_email_domains")

  // CIDR allow-list — when non-empty, every reviewer-session and
  // service-account request must originate from one of these CIDRs.
  // Empty array = no restriction. Service-account ipAllowlist (per
  // credential) is the intersection of this list and the per-credential
  // allowlist (most restrictive wins).
  restrictedIpRanges String[] @default([]) @map("restricted_ip_ranges")

  // Session timeouts (seconds). The JWT layer caps reviewer access tokens
  // to reviewerSessionTimeoutSeconds; contributor session expiry uses
  // contributorSessionTimeoutSeconds (intake link issuance already reads
  // a default; this overrides per-org).
  reviewerSessionTimeoutSeconds    Int? @map("reviewer_session_timeout_seconds")
  contributorSessionTimeoutSeconds Int? @map("contributor_session_timeout_seconds")

  // SSO/SCIM readiness placeholders. When true, the org has declared an
  // intent to federate identity. No protocol is implemented in Phase 17;
  // ExternalIdentityMapping rows are populated by an out-of-band process
  // until a later phase wires the actual flows.
  ssoReadyFlag  Boolean @default(false) @map("sso_ready_flag")
  scimReadyFlag Boolean @default(false) @map("scim_ready_flag")

  // Free-form posture notes for operator-visible context. Bounded so the
  // column never bloats.
  notes String? @db.VarChar(2000)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  // PHASE 10 (§10.1–§10.7, 2026-07-23) — advanced enterprise identity policy.
  // This is the ONE canonical org security-policy aggregate; Phase 10 EXTENDS
  // it rather than adding parallel tables. Migration
  // 20271001000000_org_security_policy_phase10 (authored, NOT applied).
  //
  // §10.1 versioning — bumped on every canonical update; sessions issued
  // before the current version are re-evaluated (stale-policy revocation).
  policyVersion           Int      @default(1) @map("policy_version")
  // §10.2 mandatory SSO — managed internal identities must authenticate via
  // the org SSO connection; password/social OAuth into the org is denied.
  ssoRequired             Boolean  @default(false) @map("sso_required")
  // §10.3 managed identity required — new org members are provisioned as
  // MANAGED_ENTERPRISE (org-controlled, no personal space/export).
  managedIdentityRequired Boolean  @default(false) @map("managed_identity_required")
  // §10.5 no personal space — managed sessions never bootstrap/route into a
  // personal workspace; existing personal Evidence is preserved, never seized.
  noPersonalSpace         Boolean  @default(false) @map("no_personal_space")
  // §10.4 bundled security mode — STANDARD | HIGH_SECURITY. HIGH_SECURITY
  // composes ssoRequired + managedIdentityRequired + noPersonalSpace + strict
  // session controls, activated atomically after prerequisite validation.
  securityMode            String   @default("STANDARD") @map("security_mode") @db.VarChar(32)
  // §10.7 session/domain controls (supported set only). Null = unset.
  maxSessionAgeSeconds    Int?     @map("max_session_age_seconds")
  idleTimeoutSeconds      Int?     @map("idle_timeout_seconds")
  concurrentSessionLimit  Int?     @map("concurrent_session_limit")
  stepUpIntervalSeconds   Int?     @map("step_up_interval_seconds")
  // §10.7 allowed authentication methods (empty = no restriction). Values:
  // PASSWORD | OAUTH | SSO.
  allowedAuthMethods      String[] @default([]) @map("allowed_auth_methods")

  // §policy-lifecycle (§1.2) — Workspace deletion NEVER deletes the policy
  // (SetNull). Organization deletion does NOT cascade the policy either: it is
  // RESTRICTed, so the policy + its audit history are preserved through
  // Organization archive/suspend/cancellation (no physical Organization purge in
  // Phase 10). The Organization owns the policy as the authoritative unique key.
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organization Organization? @relation("OrganizationSecurityPolicyOrg", fields: [organizationId], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation("OrganizationSecurityPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("organization_security_policies")
}

// PHASE 10 §10.6 (2026-07-23) — Organization-scoped BREAK-GLASS emergency
// access. NOT a universal backdoor: a pre-configured emergency identity, a
// bounded time window, a restricted role, mandatory reason, immutable audit
// and owner notification. Destructive Evidence/legal-hold/retention/security/
// billing actions are denied by default (enforced at the action layer via the
// grant's restricted role). Migration 20271001000000 (authored, NOT applied).
model EmergencyAccessGrant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  // The pre-configured emergency identity actually using the grant.
  emergencyUserId   String    @map("emergency_user_id") @db.Uuid
  // Restricted role the grant confers (default read-only diagnostic).
  grantedRole       String    @default("EMERGENCY_READ_ONLY") @map("granted_role") @db.VarChar(48)
  reason            String    @db.VarChar(600)
  status            String    @default("ACTIVE") @map("status") @db.VarChar(24)
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  // Strong-auth / step-up proof id recorded at activation.
  stepUpProofId     String?   @map("step_up_proof_id") @db.VarChar(128)
  startedAtUtc      DateTime  @default(now()) @map("started_at_utc") @db.Timestamptz(6)
  expiresAtUtc      DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  revokedAtUtc      DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId   String?   @map("revoked_by_user_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([emergencyUserId])
  @@map("emergency_access_grants")
}

// PHASE 10 §10.8 (2026-07-23) — DUAL-IDENTITY support access. A support actor
// operates within an explicit customer Organization/Workspace scope for a
// bounded window with a visible banner and immutable audit — NEVER an
// invisible impersonation token minted as the customer user. Read-only /
// minimal by default; destructive & security/billing/ownership actions denied.
// Migration 20271001000000 (authored, NOT applied).
model SupportAccessGrant {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The support actor (a distinct identity — never the customer user).
  supportUserId    String    @map("support_user_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  // Optional narrower workspace scope within the org.
  teamId           String?   @map("team_id") @db.Uuid
  reason           String    @db.VarChar(600)
  // READ_ONLY (default) | ELEVATED (requires separate explicit capability).
  accessLevel      String    @default("READ_ONLY") @map("access_level") @db.VarChar(24)
  status           String    @default("ACTIVE") @map("status") @db.VarChar(24)
  // Customer/admin approval where policy requires (approver identity).
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  startedAtUtc     DateTime  @default(now()) @map("started_at_utc") @db.Timestamptz(6)
  expiresAtUtc     DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  revokedAtUtc     DateTime? @map("revoked_at_utc") @db.Timestamptz(6)

  supportUser  User         @relation("SupportAccessActor", fields: [supportUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([supportUserId, status])
  @@map("support_access_grants")
}

// AccessReview — single row in the access-review queue. Kind drives
// which subject is being reviewed and what evidence is shown in the UI.
// Decisions ALWAYS go through the RBAC service (status + audit are
// recorded together — never one without the other).
model AccessReview {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  kind   AccessReviewKind
  status AccessReviewStatus @default(PENDING)

  // Subject of the review — exactly one of (teamMember, apiCredential,
  // workflowIntakeSession) is meaningful per row. subjectKind says which.
  subjectKind            AccessReviewSubjectKind @map("subject_kind")
  subjectUserId          String?                 @map("subject_user_id") @db.Uuid
  subjectApiCredentialId String?                 @map("subject_api_credential_id") @db.Uuid
  subjectIntakeSessionId String?                 @map("subject_intake_session_id") @db.Uuid

  initiatedAtUtc    DateTime @default(now()) @map("initiated_at_utc") @db.Timestamptz(6)
  initiatedByUserId String?  @map("initiated_by_user_id") @db.Uuid

  dueAtUtc DateTime? @map("due_at_utc") @db.Timestamptz(6)

  completedAtUtc    DateTime? @map("completed_at_utc") @db.Timestamptz(6)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  decisionNote      String?   @map("decision_note") @db.VarChar(2000)

  // Snapshot of the access state at queue time — used for "what looked
  // suspicious" context, NEVER for live evaluation.
  contextSnapshotJson Json? @map("context_snapshot_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  initiatedBy User? @relation("AccessReviewInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  completedBy User? @relation("AccessReviewCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  subjectUser User? @relation("AccessReviewSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([teamId, kind])
  @@index([dueAtUtc])
  @@index([subjectUserId])
  @@index([subjectApiCredentialId])
  @@index([subjectIntakeSessionId])
  @@map("access_reviews")
}

// ExternalIdentityMapping — SSO/SCIM-readiness. Maps a workspace User to
// an external identity-provider subject. No protocol implementation yet
// — rows are written by an out-of-band process. The presence of a
// mapping is exposed in the identity UI and in audit; it does NOT (in
// this phase) change how authentication happens.
model ExternalIdentityMapping {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  provider          ExternalIdentityProvider
  // Stable subject identifier from the external provider (sub claim,
  // SCIM externalId, etc.). HMAC the raw subject before storage in a
  // future phase if it can carry PII — for now we accept the operator's
  // value as-is (it's typed as a UUID-like string in every common IdP).
  externalSubjectId String                   @map("external_subject_id") @db.VarChar(320)

  // Operator-visible metadata that is NEVER used in authentication
  // decisions in Phase 17 (label only — exposed in the identity UI).
  displayName   String? @map("display_name") @db.VarChar(180)
  externalEmail String? @map("external_email") @db.VarChar(320)

  linkedAtUtc   DateTime  @default(now()) @map("linked_at_utc") @db.Timestamptz(6)
  unlinkedAtUtc DateTime? @map("unlinked_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("ExternalIdentityMappingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSubjectId])
  @@index([teamId, userId])
  @@index([userId])
  @@index([unlinkedAtUtc])
  @@map("external_identity_mappings")
}

// =============================================================================
// Phase 18 — Enterprise Communications & External Outreach Platform
//
// Operational outbound + inbound messaging on top of the Phase 8
// notification infrastructure:
//
//   - CommunicationMessage    — every outbound/inbound message we touch
//                                (SMS, WhatsApp, email reuse-path, system)
//   - CommunicationPreference — per-user / per-external-contact opt-out
//                                + preferred channel
//   - VerificationAttempt     — Twilio Verify OTP start/check audit
//                                (NEVER stores the code)
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - Raw phone numbers are NEVER stored in CommunicationMessage; only a
//     HMAC-SHA256 hash + a short masked preview ("+••• ••• 1234").
//   - OTP code values are NEVER persisted (Twilio Verify owns them).
//   - Public verify NEVER reads any of these tables.
//   - Suspended / revoked users + revoked contributors are blocked at
//     the service layer (governance integration).
//   - Provider secrets are env-only; the schema stores ONLY provider
//     message IDs + truncated error strings.
// =============================================================================

enum CommunicationChannel {
  SMS
  WHATSAPP
  EMAIL
  SYSTEM
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

enum CommunicationPurpose {
  OTP
  EVIDENCE_REQUEST
  INTAKE_LINK
  REVIEW_ESCALATION
  REVIEW_REMINDER
  CONTRIBUTOR_CLARIFICATION
  COLLABORATION_MENTION
  GOVERNANCE_ALERT
  SECURITY_ALERT
  PREFERENCE_UPDATE
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
  RETRY_SCHEDULED
  CANCELLED
  RECEIVED
}

enum CommunicationProvider {
  TWILIO
  RESEND
  INTERNAL
  NOOP
}

enum VerificationAttemptStatus {
  STARTED
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
  FAILED
}

// CommunicationMessage — single row per outbound message we ATTEMPT
// or inbound message we RECEIVE. Status mutations happen through the
// communication.service.ts; route code never updates this table
// directly.
model CommunicationMessage {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  channel   CommunicationChannel
  direction CommunicationDirection @default(OUTBOUND)
  purpose   CommunicationPurpose
  provider  CommunicationProvider  @default(NOOP)

  // Recipient identity — NEVER raw. The hash is HMAC-SHA256(phone,
  // COMMUNICATIONS_RECIPIENT_HASH_SECRET) so the platform can rate-limit
  // and look up preferences without exposing the contact value. The
  // preview is a short masked label safe for operator UI ("+••• 1234").
  recipientHash    String @map("recipient_hash") @db.VarChar(64)
  recipientPreview String @map("recipient_preview") @db.VarChar(64)

  // Sender — for outbound, an operator label ("PROOVRA"); for inbound,
  // the provider-reported sender label. NEVER the raw phone if we can
  // avoid it.
  sender String? @db.VarChar(64)

  // Provider correlation. Phase 18 uses provider == TWILIO for
  // SMS/WhatsApp; NOOP for skipped/disabled-feature rows; RESEND for
  // future cross-channel correlation.
  providerMessageId String? @map("provider_message_id") @db.VarChar(96)

  status CommunicationStatus @default(QUEUED)

  // Body preview — safe-to-show, bounded. NEVER includes OTP codes,
  // tokens, reviewer notes, legal-hold reasons, or evidence titles.
  bodyPreview String? @map("body_preview") @db.VarChar(400)

  relatedEvidenceId         String? @map("related_evidence_id") @db.Uuid
  relatedEvidenceRequestId  String? @map("related_evidence_request_id") @db.Uuid
  relatedDiscussionThreadId String? @map("related_discussion_thread_id") @db.Uuid
  relatedIntakeSessionId    String? @map("related_intake_session_id") @db.Uuid
  relatedIntakeLinkId       String? @map("related_intake_link_id") @db.Uuid

  attemptCount     Int       @default(0) @map("attempt_count")
  nextAttemptAtUtc DateTime? @map("next_attempt_at_utc") @db.Timestamptz(6)

  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message") @db.VarChar(400)

  // Caller-supplied idempotency key for outbound delivery dedup
  // (e.g. intake-link dispatcher). HMAC-hashed by the caller so we
  // never store a guessable nonce; previously the dispatcher
  // hijacked `providerMessageId` to store this, which clobbered the
  // real Twilio SID and broke webhook correlation + delivery
  // tracking. Now kept in its own column; the unique index lets the
  // dispatcher do exact-match lookups without colliding with
  // provider SIDs.
  deliveryIdempotencyKey String? @map("delivery_idempotency_key") @db.VarChar(128)

  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sentAtUtc      DateTime? @map("sent_at_utc") @db.Timestamptz(6)
  deliveredAtUtc DateTime? @map("delivered_at_utc") @db.Timestamptz(6)
  failedAtUtc    DateTime? @map("failed_at_utc") @db.Timestamptz(6)

  team             Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("CommunicationMessageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  evidence         Evidence?              @relation("EvidenceCommunicationMessages", fields: [relatedEvidenceId], references: [id], onDelete: SetNull)
  evidenceRequest  EvidenceRequest?       @relation("EvidenceRequestCommunicationMessages", fields: [relatedEvidenceRequestId], references: [id], onDelete: SetNull)
  discussionThread DiscussionThread?      @relation("DiscussionThreadCommunicationMessages", fields: [relatedDiscussionThreadId], references: [id], onDelete: SetNull)
  intakeSession    WorkflowIntakeSession? @relation("WorkflowIntakeSessionCommunicationMessages", fields: [relatedIntakeSessionId], references: [id], onDelete: SetNull)

  // Provider idempotency for inbound delivery callbacks. Twilio resends
  // status callbacks on retry; we collapse them by (provider,
  // providerMessageId, status).
  @@unique([provider, providerMessageId, status], name: "communication_messages_provider_callback_uk")
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@index([teamId, purpose])
  @@index([teamId, channel])
  @@index([recipientHash])
  @@index([nextAttemptAtUtc])
  @@index([relatedEvidenceRequestId])
  @@index([relatedIntakeSessionId])
  @@index([relatedIntakeLinkId])
  @@index([providerMessageId])
  // Idempotency lookups by (channel, deliveryIdempotencyKey) per
  // related intake link — dispatcher uses this to dedupe double
  // submits.
  @@index([relatedIntakeLinkId, channel, deliveryIdempotencyKey], name: "communication_messages_delivery_idem_uk")
  @@map("communication_messages")
}

// CommunicationPreference — opt-out + preferred channel.
//
// Exactly one of (userId, externalContactHash) is set per row:
//   - userId            — workspace member preferences
//   - externalContactHash — contributor / one-off recipient preferences
//
// STOP / START inbound webhooks toggle smsOptOut. Operators can set the
// preferred channel for evidence request delivery (sms vs whatsapp).
model CommunicationPreference {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId              String  @map("team_id") @db.Uuid
  userId              String? @map("user_id") @db.Uuid
  externalContactHash String? @map("external_contact_hash") @db.VarChar(64)

  smsOptOut        Boolean               @default(false) @map("sms_opt_out")
  whatsappOptOut   Boolean               @default(false) @map("whatsapp_opt_out")
  // Operators may steer the default channel for an external contact
  // when both phone + WhatsApp are available. null = system default
  // (COMMUNICATIONS_DEFAULT_CHANNEL).
  preferredChannel CommunicationChannel? @map("preferred_channel")

  // Last reason for opt-out (operator-visible). STOP webhooks set this
  // to "inbound_stop"; operator UI may set a free-form reason.
  optOutReason String?   @map("opt_out_reason") @db.VarChar(400)
  optOutAtUtc  DateTime? @map("opt_out_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation("CommunicationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, externalContactHash])
  @@index([teamId])
  @@index([externalContactHash])
  @@map("communication_preferences")
}

/// Phase G3.1 — operator notification preferences.
///
/// Per-(user, workspace, preferenceType) toggle controlling whether
/// operators receive in-app + email notifications for a bounded set of
/// operational events. Distinct from `CommunicationPreference` (which
/// controls outbound SMS / WhatsApp channels for *contact* notifications,
/// not operator inbox surfacing).
///
/// Defaults are operator-friendly: every preference is enabled in-app
/// unless explicitly disabled. Email is opt-in (the `enabled` row must
/// be created explicitly with `channel = EMAIL`).
///
/// Hard rules (enforced by service-layer write paths):
///   * Bounded enum: only the values in `NotificationPreferenceType`
///     are accepted.
///   * Workspace-scoped: `teamId` is required to keep preferences
///     workspace-aware. Account-tier defaults live in a future model
///     if needed.
///   * No PII beyond user id + workspace id. No raw event content is
///     persisted on this table.
///   * Audit-safe: writes are bounded toggles; the route layer
///     records `notification_preference.updated` security events so
///     governance admins can review unusual disable patterns.
model WorkspaceNotificationPreference {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                        @map("user_id") @db.Uuid
  teamId         String                        @map("team_id") @db.Uuid
  preferenceType NotificationPreferenceType    @map("preference_type")
  channel        NotificationPreferenceChannel @default(IN_APP)
  enabled        Boolean                       @default(true)
  /// Delivery cadence for the EMAIL channel: IMMEDIATE | HOURLY |
  /// DAILY | WEEKLY | OFF. IN_APP rows ignore this (in-app is always
  /// immediate when enabled). VarChar (not an enum) so cadence changes
  /// stay additive.
  frequency      String                        @default("IMMEDIATE") @db.VarChar(16)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("WorkspaceNotificationPreferenceUser", fields: [userId], references: [id])
  team Team @relation("WorkspaceNotificationPreferenceTeam", fields: [teamId], references: [id])

  @@unique([userId, teamId, preferenceType, channel])
  @@index([userId])
  @@index([teamId])
  @@map("workspace_notification_preferences")
}

enum NotificationPreferenceType {
  /// You were @-mentioned in a discussion thread.
  MENTION
  /// A discussion thread was assigned to you.
  ASSIGNED_THREAD
  /// A reviewer-ops workflow was assigned to you.
  REVIEWER_ASSIGNMENT
  /// A reviewer escalation was opened or routed to you.
  ESCALATION
  /// An SLA timer is approaching its breach window.
  SLA_NEAR_BREACH
  /// An evidence request you own has new activity.
  EVIDENCE_REQUEST_UPDATE
  /// A governance event (destruction, retention) affecting your scope.
  GOVERNANCE_UPDATE
}

enum NotificationPreferenceChannel {
  /// Visible in the in-app inbox / topbar indicator.
  IN_APP
  /// Delivered via the existing email infrastructure (opt-in only).
  EMAIL
}

// VerificationAttempt — Twilio Verify OTP audit. The code value is
// NEVER stored. Rows record (start) and (check) attempts so operators
// can investigate rate-limit / abuse patterns without ever seeing the
// secret material.
model VerificationAttempt {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  channel CommunicationChannel
  purpose CommunicationPurpose @default(OTP)

  recipientHash    String @map("recipient_hash") @db.VarChar(64)
  recipientPreview String @map("recipient_preview") @db.VarChar(64)

  // Twilio Verify SID (VE...) — provider-side correlation for the
  // start->check round-trip. NEVER the code.
  providerVerificationSid String? @map("provider_verification_sid") @db.VarChar(96)

  status VerificationAttemptStatus @default(STARTED)

  // Number of check attempts seen for this verification. Bounded by the
  // route layer so an attacker cannot brute-force the OTP through us.
  checkAttemptCount Int @default(0) @map("check_attempt_count")

  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message") @db.VarChar(400)

  initiatedByUserId String? @map("initiated_by_user_id") @db.Uuid

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedAtUtc DateTime? @map("approved_at_utc") @db.Timestamptz(6)
  expiresAtUtc  DateTime? @map("expires_at_utc") @db.Timestamptz(6)

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  initiatedBy User? @relation("VerificationAttemptInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@index([recipientHash])
  @@index([providerVerificationSid])
  @@map("verification_attempts")
}

// =============================================================================
// Phase 19 — Enterprise Identity Security & Adaptive Access Control
//
// Adds step-up authentication + trusted device tracking + adaptive
// risk scoring + session revocation registry. Layered on top of the
// Phase 17 access policy engine and the Phase 18 Twilio Verify
// provider — does NOT replace either.
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - OTP codes are NEVER persisted on any row (Twilio Verify owns
//     them).
//   - Step-up challenge approval is SCOPED to (user, team, purpose,
//     resource) — a row may not be reused for an unrelated action.
//   - Sessions are JWT-stateless; the revocation registry is a deny
//     list checked at every requireAuth call.
//   - Public verify NEVER reads any of these tables.
// =============================================================================

enum StepUpChallengeStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

enum TrustedDeviceStatus {
  ACTIVE
  REVOKED
}

enum RevokedSessionScope {
  // Revokes a single session by its session_id_hash.
  SINGLE_SESSION
  // Revokes EVERY session for the user (any token issued before the
  // row's createdAt is invalid). Used for "log out everywhere".
  ALL_FOR_USER
}

enum RiskSubjectKind {
  USER
  SERVICE_ACCOUNT
  CONTRIBUTOR_SESSION
}

// StepUpChallenge — a fresh verification round-trip required before a
// specific sensitive action proceeds. Wraps the Phase 18
// VerificationAttempt: the challenge row is the application-side
// record; the verification row is the provider-side record. Joined by
// `verificationAttemptId` when an OTP was used.
model StepUpChallenge {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  // The actor whose session is being elevated. Service accounts and
  // contributors do NOT receive step-up challenges — those are routed
  // through their own verification flows (Phase 18 verify routes).
  initiatedByUserId String @map("initiated_by_user_id") @db.Uuid

  // Canonical purpose — must be one of @proovra/shared STEP_UP_PURPOSES.
  purpose String @db.VarChar(64)

  // Optional resource scope. If set, the challenge approval is BOUND
  // to this resource and may NOT be reused for any other resource. If
  // unset (null), the approval is purpose-only — used for "any member
  // suspension in this team", which the service layer accepts when
  // explicitly intended.
  resourceKind String? @map("resource_kind") @db.VarChar(64)
  resourceId   String? @map("resource_id") @db.VarChar(128)

  // PHASE 12B B3 — SESSION + ORGANIZATION binding.
  //
  // sessionIdHash: the canonical hash of the session that STARTED the
  //   challenge (`req.user.sessionIdHash`, the same value the session
  //   revocation store keys on). Without it an approved challenge was
  //   bearer-like: a stolen cookie replayed from another device could spend
  //   an elevation the legitimate operator had just approved. The consume
  //   path requires an exact match when the column is set.
  //
  // organizationId: the Organization the challenge was minted against,
  //   DERIVED FROM PERSISTENCE (Team.organizationId) at start time — never
  //   from a request field. Defence in depth over the teamId binding: an
  //   administrator of both Organization A and B cannot spend an A-minted
  //   elevation against a B-owned target.
  //
  // Both are NULLABLE because rows created before this migration cannot be
  // backfilled with a session that has since ended. Enforcement is
  // "match when present"; every NEW challenge is written with both set, so
  // the unbound window closes as pre-existing rows expire (max TTL 1h).
  sessionIdHash  String? @map("session_id_hash") @db.VarChar(128)
  organizationId String? @map("organization_id") @db.Uuid

  status StepUpChallengeStatus @default(PENDING)

  // Linked Phase 18 verification row (if OTP was used). May be null in
  // a future "trusted device + recent re-auth" code path; for Phase 19
  // every challenge requires a verification round-trip.
  verificationAttemptId String? @map("verification_attempt_id") @db.Uuid

  /**
   * PHASE 13 (NEW-058) — the ENROLLED FACTOR this challenge was minted for.
   *
   * Before this the destination came from the request body, so an approved
   * challenge proved possession of a handset the caller had chosen. Recording
   * the factor makes the approval attributable to something the ACCOUNT owns,
   * and recording its generation makes the approval expire the moment that
   * enrolment is replaced — a challenge issued against generation 3 cannot be
   * spent once the user re-enrols and the factor moves to generation 4.
   *
   * NULLABLE for rows written before this migration; the consume path treats a
   * null factor as UNSPENDABLE rather than as "unbound", so the pre-existing
   * window fails closed instead of open and closes entirely as those rows
   * expire (max TTL 1h).
   */
  factorId         String? @map("factor_id") @db.Uuid
  factorGeneration Int?    @map("factor_generation")

  // TTL for the approval. Defaults to STEP_UP_TTL_DEFAULT_SECONDS.
  expiresAtUtc  DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  approvedAtUtc DateTime? @map("approved_at_utc") @db.Timestamptz(6)

  // Operator-supplied context (never includes the OTP, never includes
  // private notes). Bounded so it can never bloat the row.
  reason String? @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  initiatedBy User @relation("StepUpChallengeInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([initiatedByUserId, status])
  @@index([expiresAtUtc])
  @@index([teamId, purpose, resourceId])
  // NEW-058 created `step_up_challenges_factor_id_idx` in SQL but never
  // declared it here, so the applied database carried an index the datamodel
  // did not know about and `db:raw-schema-verify` reported it as an
  // unregistered divergence. Prisma derives exactly that name from this
  // declaration (`<@@map table>_<@map column>_idx`), so the two now agree
  // without touching the migration.
  @@index([factorId])
  @@map("step_up_challenges")
}

// TrustedDevice — the result of an operator marking a device "trusted
// until N days". The cookie value is never stored raw; we keep the
// HMAC-SHA256 hash and a short preview ("Chrome on macOS").
model TrustedDevice {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  deviceIdHash String  @map("device_id_hash") @db.VarChar(64)
  uaPreview    String? @map("ua_preview") @db.VarChar(120)
  ipPreview    String? @map("ip_preview") @db.VarChar(64)
  ipHash       String? @map("ip_hash") @db.VarChar(64)

  status          TrustedDeviceStatus @default(ACTIVE)
  trustedUntilUtc DateTime            @map("trusted_until_utc") @db.Timestamptz(6)
  firstSeenAtUtc  DateTime            @default(now()) @map("first_seen_at_utc") @db.Timestamptz(6)
  lastSeenAtUtc   DateTime            @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)
  revokedAtUtc    DateTime?           @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?             @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?             @map("revoked_reason") @db.VarChar(400)

  /// Phase 26.75 — Trust decay tracking. The trust-decay sweep
  /// downgrades long-untouched devices (lastSeenAtUtc beyond the
  /// configured window) by raising `trustScoreDecay`; the adaptive
  /// auth engine reads it to weaken trusted-device privilege.
  trustScoreDecay  Int       @default(0) @map("trust_score_decay")
  /// Operator-readable reason the device was downgraded (or null).
  decayReason      String?   @map("decay_reason") @db.VarChar(120)
  /// Optional quarantine timestamp — a suspicious-device signal sets
  /// this and the adaptive auth engine forces a step-up for any
  /// privileged action on a quarantined device.
  quarantinedAtUtc DateTime? @map("quarantined_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User  @relation("TrustedDeviceUser", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("TrustedDeviceRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId, deviceIdHash])
  @@index([teamId, status])
  @@index([userId, status])
  @@index([trustedUntilUtc])
  @@index([revokedAtUtc])
  @@index([teamId, trustScoreDecay])
  @@index([teamId, quarantinedAtUtc])
  @@map("trusted_devices")
}

// =============================================================================
// PHASE R8.1 — Real MFA activation (TOTP + backup recovery codes).
//
// Two append/lifecycle-tracked tables added by R8.1:
//
//   - `MfaFactor` — per-user enrolled authenticator. Holds the AES-256-GCM
//     ciphertext of the RFC 4226 shared secret, plus the GCM IV and the
//     KEK id used for envelope encryption. NEVER stores the plaintext
//     secret. Status transitions: ENROLLING → ACTIVE → REVOKED (terminal).
//
//   - `MfaRecoveryCode` — bounded set of single-use recovery codes scoped
//     to the user, identified by a deterministic SHA-256 lookup hash AND
//     verified by scrypt(code, perRowSalt). The lookup hash makes the
//     "find the matching code in O(1)" path safe; the scrypt step makes
//     a stolen lookup hash useless without the plaintext code. Status:
//     usedAt = NULL means available; non-NULL means consumed (one-time
//     use). Codes are issued in BATCHES so regeneration invalidates the
//     whole batch atomically.
//
// Audit + security-event emission goes through the existing
// `platform-audit-log.service.ts` + `security-event.service.ts`. R8.1
// adds NO new audit tables.
// =============================================================================

enum MfaFactorStatus {
  ENROLLING
  ACTIVE
  REVOKED
}

enum MfaFactorKind {
  TOTP

  // PHASE 13 (NEW-058) — VERIFIED CONTACT FACTORS.
  //
  // The enterprise step-up gate delivers its one-time code to a phone, and
  // took that phone FROM THE REQUEST BODY: it proved possession of a handset
  // the CALLER chose, not of a factor the account had enrolled. A stolen
  // session supplied the attacker's own number and approved its own challenge.
  //
  // These kinds exist so the destination is resolved from an enrolled,
  // verified, revocable factor OWNED BY THE USER — the same authority TOTP
  // already lives in, rather than a second identity table that could disagree
  // with it about who holds what.
  SMS
  WHATSAPP
}

model MfaFactor {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  kind   MfaFactorKind   @default(TOTP)
  status MfaFactorStatus @default(ENROLLING)

  // User-supplied friendly label ("iPhone", "1Password vault"). Bounded
  // so it can never bloat the row. Never includes raw device IDs or
  // serial numbers.
  label String @db.VarChar(60)

  // AES-256-GCM envelope-encrypted RFC 4226 shared secret. The KEK id
  // is recorded so we can rotate keys without touching the ciphertext
  // column. The IV is 12 bytes; the auth tag is 16 bytes. NEVER stores
  // the plaintext secret.
  // NULLABLE only for CONTACT factors (SMS / WHATSAPP), which have no shared
  // secret. A database CHECK — `mfa_factors_kind_payload_chk` — restores the
  // invariant precisely: a TOTP row must carry all four, a contact row must
  // carry none of them and all four destination columns instead. Nullability
  // widened the column; the CHECK is what keeps the contract exact.
  secretCiphertext Bytes?  @map("secret_ciphertext")
  secretIv         Bytes?  @map("secret_iv")
  secretAuthTag    Bytes?  @map("secret_auth_tag")
  secretKekId      String? @map("secret_kek_id") @db.VarChar(64)

  // PHASE 13 (NEW-058) — the enrolled DESTINATION, for contact factors.
  //
  // Sealed with the same envelope scheme as the TOTP secret above, because it
  // is PII that the product must be able to send to and must never be able to
  // display back. `destinationHash` is the deterministic lookup/dedupe key —
  // it is what makes "this number is already enrolled for this user" answerable
  // without the plaintext. `destinationMask` is the ONLY thing any surface may
  // render.
  destinationCiphertext Bytes?  @map("destination_ciphertext")
  destinationIv         Bytes?  @map("destination_iv")
  destinationAuthTag    Bytes?  @map("destination_auth_tag")
  destinationKekId      String? @map("destination_kek_id") @db.VarChar(64)
  destinationHash       String? @map("destination_hash") @db.VarChar(64)
  destinationMask       String? @map("destination_mask") @db.VarChar(32)

  // When the enrollment was PROVEN, not when the row was written. A row with
  // `status = ACTIVE` and a null `verifiedAtUtc` is a contradiction the
  // service refuses to create and the step-up resolver refuses to trust.
  verifiedAtUtc DateTime? @map("verified_at_utc") @db.Timestamptz(6)

  /**
   * Monotonic generation, bumped whenever the factor's destination changes.
   *
   * A step-up challenge records the generation it was minted against. If the
   * user re-enrols a different handset between issuing a challenge and
   * spending it, the generation moves and the pending challenge stops being
   * spendable — which is the whole point: an approval must not survive the
   * factor that authorised it being replaced.
   */
  generation Int @default(1)

  // RFC 6238 parameters. We pin SHA-1 + 6 digits + 30s period at the
  // service layer to match every mainstream authenticator app; the
  // columns exist so future migrations to SHA-256 or 8-digit codes can
  // proceed without a backfill.
  algorithm     String @default("SHA1") @db.VarChar(16)
  digits        Int    @default(6)
  periodSeconds Int    @default(30) @map("period_seconds")

  // Lifecycle timestamps.
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  enrolledAt    DateTime? @map("enrolled_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason") @db.VarChar(120)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can have multiple authenticators (e.g. phone + hardware
  // token). The unique constraint stops duplicate active rows; we
  // enforce one-ACTIVE-per-label at the service layer.
  @@index([userId, status])
  @@index([status])
  // PHASE 13 (NEW-058) — one enrolled destination per user per channel. The
  // hash is the key because the plaintext is sealed; without this a caller
  // could enrol the same number repeatedly and leave several ACTIVE rows for
  // the resolver to choose between.
  @@unique([userId, kind, destinationHash], map: "mfa_factors_user_kind_destination_key")
  @@index([userId, kind, status])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Batch id — when the user regenerates codes we invalidate the whole
  // previous batch atomically by stamping usedAt with batchInvalidatedAt.
  batchId String @map("batch_id") @db.Uuid

  // Deterministic SHA-256(code) lookup hash. Used to find the row in
  // O(1) without a table scan. NEVER stores the plaintext code.
  codeLookupHash   String @map("code_lookup_hash") @db.VarChar(64)
  // Per-row scrypt(code, salt) verifier. A stolen lookup hash is
  // insufficient — the scrypt step is what makes brute-forcing
  // expensive even if the row were exfiltrated.
  codeVerifier     Bytes  @map("code_verifier")
  codeVerifierSalt Bytes  @map("code_verifier_salt")

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt             DateTime? @map("used_at") @db.Timestamptz(6)
  usedFromIp         String?   @map("used_from_ip") @db.VarChar(64)
  // Set when this entire batch was invalidated by regeneration; the
  // service uses this to distinguish "consumed" from "superseded".
  batchInvalidatedAt DateTime? @map("batch_invalidated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeLookupHash])
  @@index([userId, batchId])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

// PHASE R8.1.3 — durable MFA pending challenge.
//
// R8.1.2 stored pending-challenge replay state in a process-local Map.
// That was acceptable for single-node testing but unsafe under
// multi-instance / serverless / multi-region deployments — two
// replicas could each accept the same pending token once. This row is
// the SOURCE OF TRUTH for replay protection in production.
//
// Lifecycle:
//   create  → INSERT row with `consumedAt: null`, `expiresAt: now + ttl`
//   verify  → atomic `updateMany({ id, consumedAt: null, expiresAt > now })`
//             flips `consumedAt` in a single SQL statement. The
//             `updateMany` rowcount tells us whether we won the race.
//   expire  → opportunistic GC (on create + on verify-failure) deletes
//             rows where `consumedAt IS NOT NULL` AND `consumedAt < now -
//             CLEANUP_RETENTION` OR rows where `expiresAt < now -
//             CLEANUP_RETENTION`. A small bounded LIMIT keeps the GC
//             cheap.
//
// Hard invariants:
//   - NEVER stores the OTP, recovery code, secret, or signed token.
//   - `purpose` distinguishes LOGIN-time challenges (this phase) from
//     STEP_UP challenges (which currently use the Phase 19
//     StepUpChallenge table; future phases may unify).
//   - `ipHash` / `userAgentHash` are SHA-256 hashes — never the raw
//     IP/UA — so the row is safe to ship to long-term retention
//     without privacy review.
model MfaPendingChallenge {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Opaque JTI (also the signed-token's `sid`). 32 hex chars from
  // `randomBytes(16).toString("hex")`. UNIQUE so two challenges can
  // never collide on lookup.
  jti    String @map("jti") @db.VarChar(64)
  userId String @map("user_id") @db.Uuid

  // Purpose discriminator. R8.1.3 ships LOGIN; STEP_UP is reserved
  // for the future unification with Phase 19 step-up.
  purpose MfaChallengePurpose @default(LOGIN)

  // Absolute expiry — `verify` REFUSES challenges where now >=
  // expiresAt, even if `consumedAt IS NULL`.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  // Atomic consume marker. Set in the SAME UPDATE that wins the
  // race so a replay cannot also flip it.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Hashed IP + UA at issuance. SHA-256 with the
  // IDENTITY_SECURITY_HASH_SECRET pepper (same secret already used by
  // sso-auth.routes.ts deviceIdHash). Optional because non-cookie
  // mobile clients may not surface UA reliably.
  ipHash        String? @map("ip_hash") @db.VarChar(64)
  userAgentHash String? @map("user_agent_hash") @db.VarChar(64)

  // Per-row failure counter — incremented atomically on each failed
  // verify attempt against this challenge id. The route-layer rate
  // limiter still enforces a per-user window; this counter is for
  // forensics and for the future "give up after N attempts" path.
  failureCount Int @default(0) @map("failure_count")

  // Bounded JSON for downstream policy hints — e.g.
  // `{ "loginMethod": "google_id_token" }` or `{ "phase": "sso_oidc" }`.
  // NEVER carries OTP / recovery code / secret material; the
  // safeEmitSecurityEvent contract is mirrored here.
  metadata Json? @map("metadata") @db.JsonB

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jti])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("mfa_pending_challenges")
}

enum MfaChallengePurpose {
  LOGIN
  STEP_UP

  @@map("mfa_challenge_purpose")
}

// PHASE R8.1.4 — lost-factor recovery request.
//
// A bounded, auditable workflow for "I lost all my MFA factors and
// my recovery codes — please reset my MFA so I can re-enroll." It
// is INTENTIONALLY NOT a bypass: an approved request only marks the
// user as enrollment-required on their next login; it never issues
// a session, never issues a one-time MFA-skipping token, and never
// hands the operator a code they can use as a factor.
//
// Lifecycle:
//   PENDING  — user requested; visible to org admins
//   APPROVED — at least one (or two, for high-risk orgs) org-admin
//              approval(s) recorded; previous factors revoked +
//              trusted devices cleared atomically with the
//              APPROVED transition. User's next login enters the
//              enrollment-required state.
//   REJECTED — admin denied with a bounded reason code
//   EXPIRED  — TTL elapsed without admin action
//   COMPLETED — user re-enrolled a factor; the request is closed.
//
// Hard invariants:
//   - NEVER carries any OTP, recovery code, secret, ciphertext.
//   - Approval rows are append-only — once an admin approves, the
//     request id is bound to that admin (multi-admin quorum is
//     enforced via approver count, not by mutating prior rows).
//   - Tenant isolation: every row scopes to a single `teamId`
//     (the org the user belongs to); admin approvers must be
//     ACTIVE members of THAT team.
model MfaRecoveryRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // The user whose factors are being reset.
  userId String @map("user_id") @db.Uuid
  // The team scope under which the request was filed. Approvers must
  // belong to this team. Lifecycle is per-team — a user with
  // memberships in multiple teams may have at most one PENDING
  // request per team.
  teamId String @map("team_id") @db.Uuid

  // PHASE R8.1.5 — default is now EMAIL_VERIFICATION_PENDING. The
  // user must click the verification link/code emailed to their
  // account address before the request enters the admin queue.
  status MfaRecoveryRequestStatus @default(EMAIL_VERIFICATION_PENDING)

  // PHASE R8.1.5 — verified-email preflight columns.
  //
  // The raw verification token is NEVER stored — only the SHA-256
  // hash (deterministic, hex-encoded, 64 chars). One-time use is
  // enforced by clearing the hash on successful verification.
  // `emailVerificationExpiresAt` short-TTL (15 min default) bounds
  // the brute-force window even if the hash were exfiltrated.
  // `emailVerifiedAt` is the audit timestamp set at verification.
  // `emailResendCount` + `emailResendBlockedUntil` enforce a
  // bounded resend throttle (max 3 sends per request).
  emailVerificationTokenHash String?   @map("email_verification_token_hash") @db.VarChar(64)
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.Timestamptz(6)
  emailVerifiedAt            DateTime? @map("email_verified_at") @db.Timestamptz(6)
  emailResendCount           Int       @default(0) @map("email_resend_count")
  emailResendBlockedUntil    DateTime? @map("email_resend_blocked_until") @db.Timestamptz(6)

  // PHASE R8.1.5 — user-initiated cancellation timestamp. Set when
  // the user withdraws the request before approval.
  cancelledAtUtc DateTime? @map("cancelled_at_utc") @db.Timestamptz(6)

  // Bounded reason supplied by the user. Visible to admins.
  reason String @db.VarChar(400)

  // Number of admin approvals required for this request to be
  // approved. Default 1; orgs that set `mfaRecoveryQuorum = 2` in a
  // future policy update get higher safety. Stored on the row so
  // policy changes mid-request do not retroactively change the bar.
  requiredApprovals Int @default(1) @map("required_approvals")
  approvalCount     Int @default(0) @map("approval_count")

  // Bounded reason on reject; populated only when status = REJECTED.
  rejectedReason String? @map("rejected_reason") @db.VarChar(400)

  // Absolute TTL. Requests not actioned by this point flip to
  // EXPIRED via the same scheduled GC job that cleans pending
  // challenges. 7 days by default.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  approvedAtUtc  DateTime? @map("approved_at_utc") @db.Timestamptz(6)
  rejectedAtUtc  DateTime? @map("rejected_at_utc") @db.Timestamptz(6)
  completedAtUtc DateTime? @map("completed_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User                         @relation("MfaRecoveryRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  team      Team                         @relation("MfaRecoveryRequestTeam", fields: [teamId], references: [id], onDelete: Cascade)
  approvals MfaRecoveryRequestApproval[] @relation("MfaRecoveryRequestApprovals")

  @@index([userId, status])
  @@index([teamId, status])
  @@index([expiresAt])
  @@map("mfa_recovery_requests")
}

// PHASE R8.1.5 — recovery state machine hardened.
//
// Lifecycle:
//   EMAIL_VERIFICATION_PENDING  → user must verify mailbox before
//                                  admin can see / action the request
//   PENDING_ADMIN_REVIEW        → email verified; visible in admin
//                                  queue; admin may approve/reject
//   APPROVED                    → quorum reached; factors revoked
//                                  in same TX; user's next login
//                                  enters enrollment-required
//   REJECTED                    → admin denied with bounded reason
//   EXPIRED                     → TTL elapsed without admin action
//   CANCELLED                   → user withdrew before approval
//   COMPLETED                   → user re-enrolled a fresh factor
//
// Hard transition graph (enforced by the recovery service):
//   EMAIL_VERIFICATION_PENDING → PENDING_ADMIN_REVIEW (verify-email)
//   EMAIL_VERIFICATION_PENDING → CANCELLED (user cancel)
//   EMAIL_VERIFICATION_PENDING → EXPIRED (GC)
//   PENDING_ADMIN_REVIEW       → APPROVED (admin quorum)
//   PENDING_ADMIN_REVIEW       → REJECTED (admin)
//   PENDING_ADMIN_REVIEW       → CANCELLED (user cancel)
//   PENDING_ADMIN_REVIEW       → EXPIRED (GC)
//   APPROVED                   → COMPLETED (user re-enrolls)
//
// PENDING (legacy R8.1.4 value) was renamed to PENDING_ADMIN_REVIEW
// when the email-verification gate landed. Migration backfills
// existing rows to PENDING_ADMIN_REVIEW (they were already
// admin-actionable under the prior contract).
enum MfaRecoveryRequestStatus {
  EMAIL_VERIFICATION_PENDING
  PENDING_ADMIN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED

  @@map("mfa_recovery_request_status")
}

// PHASE R8.1.7 — admin notification preference for MFA recovery
// digest emails.
//
// Each row scopes to a single user + an optional teamId. The
// effective preference for (user, team) is computed as:
//
//   1. team-specific row (userId, teamId=T) wins if present
//   2. else, global row (userId, teamId=null)
//   3. else, default enabled
//
// `suppressUntil` lets an admin pause digest emails temporarily
// (e.g. "snooze for 7 days"). When the timestamp is past, the
// preference reverts to whatever `digestEnabled` is set to.
//
// HARD INVARIANT: preferences ONLY affect the operational digest
// EMAIL transport. They DO NOT suppress audit log rows, do NOT
// suppress security events, and do NOT suppress the admin SPA
// from showing the pending queue. Operator visibility is
// preserved unconditionally.
model MfaAdminDigestPreference {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  teamId        String?   @map("team_id") @db.Uuid
  digestEnabled Boolean   @default(true) @map("digest_enabled")
  suppressUntil DateTime? @map("suppress_until") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User  @relation("MfaAdminDigestPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation("MfaAdminDigestPreferenceTeam", fields: [teamId], references: [id], onDelete: Cascade)

  // (user, team) is unique — there is at most one preference row
  // per scope. NULL teamId is allowed and counts as the global
  // preference for that user.
  @@unique([userId, teamId])
  @@index([userId])
  @@map("mfa_admin_digest_preferences")
}

// PHASE R8.1.7 — per-admin-per-day digest log for multi-team
// grouping. R8.1.6 sent one email per team per day per admin; this
// row guarantees ONE consolidated email per admin per UTC day.
//
// The row is inserted ONLY AFTER the email transport returns OK,
// so a failed send does NOT mark the admin as "delivered". The
// next scheduler tick will retry.
model MfaRecoveryAdminDigestLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sentDate     String   @map("sent_date") @db.VarChar(10)
  sentAtUtc    DateTime @default(now()) @map("sent_at_utc") @db.Timestamptz(6)
  // Number of distinct teams included in the consolidated email.
  teamCount    Int      @default(0) @map("team_count")
  // Total pending request count across all teams in the digest.
  requestCount Int      @default(0) @map("request_count")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation("MfaRecoveryAdminDigestLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sentDate])
  @@index([sentAtUtc])
  @@map("mfa_recovery_admin_digest_logs")
}

// PHASE R8.1.6 — pending-digest idempotency log.
//
// Used by the worker's `runMfaRecoveryDigest` scheduler to avoid
// emailing org owners/admins more than once per day per team. The
// row's UNIQUE (teamId, sentDate) constraint makes the "have I
// sent today's digest for this org?" check a single SELECT, and
// makes the INSERT idempotent under concurrency (two workers racing
// will see exactly one row land).
//
// Stores ONLY operational counters — never the user emails the
// digest was sent to, never the recovery request reasons, never
// any token material.
model MfaRecoveryDigestLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  // YYYY-MM-DD UTC string. We use a separate column rather than
  // truncating sentAtUtc so the UNIQUE constraint is unambiguous
  // across DST changes.
  sentDate       String   @map("sent_date") @db.VarChar(10)
  sentAtUtc      DateTime @default(now()) @map("sent_at_utc") @db.Timestamptz(6)
  // Number of PENDING_ADMIN_REVIEW requests that were >24h old at
  // the time the digest was assembled.
  pendingCount   Int      @default(0) @map("pending_count")
  // Number of org admin / owner recipients the digest was sent to.
  recipientCount Int      @default(0) @map("recipient_count")

  team Team @relation("MfaRecoveryDigestLogTeam", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, sentDate])
  @@index([sentAtUtc])
  @@map("mfa_recovery_digest_logs")
}

// One admin approval. Append-only — once an approval is recorded
// for an (admin, request) pair it is never updated. The unique
// constraint prevents the same admin from approving the same
// request twice.
model MfaRecoveryRequestApproval {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  approverUserId String   @map("approver_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request  MfaRecoveryRequest @relation("MfaRecoveryRequestApprovals", fields: [requestId], references: [id], onDelete: Cascade)
  approver User               @relation("MfaRecoveryRequestApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverUserId])
  @@index([approverUserId])
  @@map("mfa_recovery_request_approvals")
}

// RevokedSession — the deny list checked by the auth middleware.
// Sessions are JWT-stateless so we cannot "delete" them; instead we
// record an entry here that the middleware reads on every request.
//
//   - SINGLE_SESSION: the auth middleware compares the hash of the
//     inbound JWT's jti (or a derived session_id) against this row.
//   - ALL_FOR_USER: the middleware additionally compares the JWT's
//     `iat` to revokedBeforeIat; any token issued at or before that
//     instant is denied.
//
// Rows are never deleted by the application — operators wanting to
// prune use the reconciliation route, which only clears CANCELLED /
// EXPIRED entries strictly older than 180 days.
model RevokedSession {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("team_id") @db.Uuid
  userId String  @map("user_id") @db.Uuid

  scope         RevokedSessionScope @default(SINGLE_SESSION)
  sessionIdHash String?             @map("session_id_hash") @db.VarChar(64)

  // For ALL_FOR_USER: every token whose iat <= revokedBeforeIat is
  // rejected. Mirrors the JWT epoch-seconds convention.
  revokedBeforeIat BigInt? @map("revoked_before_iat")

  reason          String   @db.VarChar(64)
  revokedByUserId String?  @map("revoked_by_user_id") @db.Uuid
  revokedAtUtc    DateTime @default(now()) @map("revoked_at_utc") @db.Timestamptz(6)

  team      Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  user      User  @relation("RevokedSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy User? @relation("RevokedSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionIdHash])
  @@index([userId, scope])
  @@index([teamId, revokedAtUtc(sort: Desc)])
  @@index([revokedAtUtc])
  @@map("revoked_sessions")
}

// RiskSignal — operator-visible row recording an observed risk signal
// (new IP, failed OTP burst, etc.). The score for the actor at any
// moment is the sum of unexpired signal weights. Signals are NEVER
// rolled up at write time — the read API computes the level so the
// thresholds are tunable without backfilling.
model RiskSignal {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  subjectKind            RiskSubjectKind @map("subject_kind")
  subjectUserId          String?         @map("subject_user_id") @db.Uuid
  subjectApiCredentialId String?         @map("subject_api_credential_id") @db.Uuid
  subjectIntakeSessionId String?         @map("subject_intake_session_id") @db.Uuid

  // Must be one of @proovra/shared RISK_SIGNAL_KINDS. Stored as a
  // bounded string so we can extend the catalog in shared without a
  // migration.
  signalKind String @map("signal_kind") @db.VarChar(64)

  // Operator-visible explanation. NEVER includes raw IPs, raw phones,
  // OTP codes, or session tokens. Use ip_preview / ua_preview helpers
  // upstream of inserting this row.
  reason String @db.VarChar(400)

  // Optional masked previews for operator readability.
  ipPreview String? @map("ip_preview") @db.VarChar(64)
  uaPreview String? @map("ua_preview") @db.VarChar(120)

  observedAtUtc DateTime  @default(now()) @map("observed_at_utc") @db.Timestamptz(6)
  // After this moment the signal no longer contributes to the score.
  // Defaults are set by the service (e.g. NEW_DEVICE expires after 7
  // days; IMPOSSIBLE_TRAVEL never expires until manually cleared).
  expiresAtUtc  DateTime? @map("expires_at_utc") @db.Timestamptz(6)

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  subjectUser User? @relation("RiskSignalSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([teamId, observedAtUtc(sort: Desc)])
  @@index([teamId, signalKind])
  @@index([subjectUserId])
  @@index([subjectApiCredentialId])
  @@index([subjectIntakeSessionId])
  @@index([expiresAtUtc])
  @@map("risk_signals")
}

// =============================================================================
// Phase 21 — Enterprise Observability, Incident Response & Resilience
//
// Operator-facing incident model. Auto-created by the
// `incident.service` when burst conditions trip (e.g. invalid Twilio
// webhook signatures, repeated upload stalls, repeated job failures).
// Operators acknowledge / resolve / suppress them in the /ops UI.
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - safeSummary never contains OTP codes, raw phones, secrets,
//     session tokens, signed URLs, or raw file contents.
//   - metadataJson is sanitised by `shouldRedactKey` before storage.
//   - Incidents are OPERATIONAL only. They never claim legal /
//     forensic conclusions. Wording uses "issue", "failure",
//     "anomaly", "outage".
//   - Public verify NEVER reads these tables.
// =============================================================================

enum IncidentSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum IncidentCategory {
  UPLOAD
  REPORT
  PACKAGE
  WEBHOOK
  COMMUNICATIONS
  IDENTITY_SECURITY
  GOVERNANCE
  STORAGE
  AI
  INTEGRATION
  DATABASE
  WORKER
  RECONCILIATION
  // ATTENTION ARCHITECTURE PHASE 3 — per-Evidence TSA/OTS integrity gaps.
  // Added by migration 20271216000000_evidence_integrity_incident_category.
  EVIDENCE_INTEGRITY
}

// OperationalIncident — one row per deduplicated incident. The
// fingerprint is the dedup key (`category:safeKey`). Subsequent
// occurrences increment `occurrenceCount` and refresh `lastSeenAtUtc`
// instead of creating a new row.
model OperationalIncident {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("team_id") @db.Uuid

  category IncidentCategory
  severity IncidentSeverity @default(WARNING)
  status   IncidentStatus   @default(OPEN)

  fingerprint String @db.VarChar(200)
  title       String @db.VarChar(180)
  safeSummary String @map("safe_summary") @db.VarChar(400)

  firstSeenAtUtc  DateTime @default(now()) @map("first_seen_at_utc") @db.Timestamptz(6)
  lastSeenAtUtc   DateTime @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)
  occurrenceCount Int      @default(1) @map("occurrence_count")

  // Correlation hints (operator-visible). Bounded VARCHARs so the row
  // can never bloat from a malicious header.
  requestId String? @map("request_id") @db.VarChar(128)
  traceId   String? @map("trace_id") @db.VarChar(128)

  // Optional resource pointers. These reference the most-recent
  // occurrence's context — older occurrences land in the
  // OperationalIncidentEvent table.
  relatedEvidenceId String? @map("related_evidence_id") @db.Uuid
  relatedJobId      String? @map("related_job_id") @db.VarChar(128)
  relatedProvider   String? @map("related_provider") @db.VarChar(64)

  // True when created by the auto-trigger (most rows). False for
  // operator-initiated incidents (rare in Phase 21; reserved for
  // future "open incident" button).
  openedBySystem Boolean @default(true) @map("opened_by_system")

  acknowledgedByUserId String?   @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAtUtc    DateTime? @map("acknowledged_at_utc") @db.Timestamptz(6)
  resolvedByUserId     String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAtUtc        DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolutionNote       String?   @map("resolution_note") @db.VarChar(400)

  // Phase 32.8C control plane — assignment lifecycle. NULL when no
  // operator owns this incident. Assignment is workspace-scoped: only
  // a user with workspace operator permission can be assigned.
  assignedOperatorUserId String?   @map("assigned_operator_user_id") @db.Uuid
  assignedByUserId       String?   @map("assigned_by_user_id") @db.Uuid
  assignedAtUtc          DateTime? @map("assigned_at_utc") @db.Timestamptz(6)

  // Optional pointer to a runbook (docs/runbooks/*.md). Stored as a
  // canonical slug; the UI renders the full link.
  runbookSlug String? @map("runbook_slug") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team           Team?                      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  acknowledgedBy User?                      @relation("OperationalIncidentAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?                      @relation("OperationalIncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  events         OperationalIncidentEvent[]

  // Fingerprint is the dedup key. We allow one OPEN/ACKNOWLEDGED row
  // per (teamId, fingerprint); after RESOLVED a fresh occurrence
  // reopens with the same fingerprint. The UNIQUE index includes a
  // boolean-style "active" filter via status, but Prisma doesn't
  // support partial indexes directly so we keep the dedup as a
  // (teamId, fingerprint) compound unique and the service layer
  // handles reopen logic via updateMany guards.
  @@unique([teamId, fingerprint])
  @@index([teamId, status])
  @@index([teamId, severity])
  @@index([teamId, category])
  @@index([lastSeenAtUtc(sort: Desc)])
  @@index([status])
  @@index([assignedOperatorUserId])
  @@map("operational_incidents")
}

// =============================================================================
// Phase 32.8C control plane — OperationalCorrelation
//
// Cross-system correlation rows. When the correlation engine detects N >= 2
// OPEN/ACKNOWLEDGED incidents matching a known pattern within a bounded
// window, it persists a correlation row so operators see the root cause,
// not the individual symptoms.
//
// Hard rules:
//   - ADVISORY operational data. Generator failures NEVER block evidence /
//     report / package / verify core flows.
//   - Bounded fields only — no raw payloads, no signed URLs, no secrets.
//   - The dashboard reads correlations directly; freshness is bounded by
//     `expiresAtUtc` so stale correlations don't pile up.
// =============================================================================

enum OperationalCorrelationType {
  PIPELINE_DEGRADATION
  REVIEW_BOTTLENECK
  AUDIT_READINESS_GAP
  GOVERNANCE_ESCALATION
  INFRASTRUCTURE_PRESSURE
  QUEUE_SATURATION_CHAIN
  RETRY_STORM_CHAIN
  OTHER
}

model OperationalCorrelation {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("team_id") @db.Uuid

  /// Stable correlation key (e.g., "pipeline_degradation:team:<id>"). The
  /// engine upserts on this so repeated detection collapses to one row.
  correlationKey  String                     @map("correlation_key") @db.VarChar(200)
  correlationType OperationalCorrelationType @map("correlation_type")
  severity        IncidentSeverity           @default(WARNING)

  /// Bounded array of OperationalIncident IDs grouped under this row.
  linkedIncidentIds Json? @map("linked_incident_ids")
  linkedCaseIds     Json? @map("linked_case_ids")
  linkedEvidenceIds Json? @map("linked_evidence_ids")
  linkedQueues      Json? @map("linked_queues")

  /// Operator-safe summary of the root operational cause.
  rootOperationalCause String @map("root_operational_cause") @db.VarChar(400)
  /// Operator-safe one-line summary.
  operationalSummary   String @map("operational_summary") @db.VarChar(400)
  /// Bounded recommended action (operator-facing).
  recommendedAction    String @map("recommended_action") @db.VarChar(400)

  confidence String @db.VarChar(16)

  firstDetectedAtUtc DateTime @default(now()) @map("first_detected_at_utc") @db.Timestamptz(6)
  lastDetectedAtUtc  DateTime @default(now()) @map("last_detected_at_utc") @db.Timestamptz(6)
  /// Auto-expiry hint so the dashboard reader can filter out stale rows.
  expiresAtUtc       DateTime @map("expires_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([teamId, correlationKey])
  @@index([teamId, lastDetectedAtUtc(sort: Desc)])
  @@index([teamId, severity])
  @@index([correlationType])
  @@map("operational_correlations")
}

// OperationalIncidentEvent — one row per occurrence after the first.
// First occurrence is implicit in the parent row. Subsequent ones
// land here so operators can see the recent history without exposing
// raw payloads.
model OperationalIncidentEvent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid

  eventType   String @map("event_type") @db.VarChar(64)
  safeMessage String @map("safe_message") @db.VarChar(400)

  // Sanitised metadata. NEVER contains secrets, OTP codes, raw
  // phones, raw IPs, signed URLs, or file contents.
  metadataJson Json? @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  incident OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt(sort: Desc)])
  @@map("operational_incident_events")
}

// =============================================================================
// Phase IA-reliability — InboxItemState
//
// Per-user state row that the /v1/me/inbox aggregator joins against to
// implement REAL read / unread / dismiss / snooze behavior. The
// aggregator continues to derive the items themselves from the
// canonical source tables (DiscussionMention, OperationalIncident,
// EvidenceRequest, ...) — this table stores ONLY the per-user
// adjudication of each item.
//
// Hard rules:
//   * Per-user state ONLY. Never store the source row's title, body,
//     evidence preview, or other downstream-rendered data here. If the
//     source resolves (mention notified, incident resolved, intake
//     fulfilled) the inbox simply stops emitting the row.
//   * `itemKey` is a DETERMINISTIC composite of the inbox source +
//     source id — see the `INBOX_ITEM_KEY_PREFIXES` allowlist in
//     `services/api/src/routes/me-inbox.routes.ts` for the full
//     taxonomy. The aggregator builds the key on every read; the four
//     mutation endpoints reject any key whose prefix is not in the
//     allowlist (defense against enumeration).
//   * Unique by `(userId, itemKey)` so mark-read / dismiss / snooze
//     POSTs are idempotent — Prisma upsert by the compound unique
//     resolves both insert and update in one round trip.
//   * Tenant scope: `userId` is the authority. The optional `teamId` /
//     `orgId` columns are audit context (which workspace did the item
//     belong to when the state was written) — they are never used as
//     a tenancy gate. Every endpoint scopes its query to
//     `userId = caller`.
// =============================================================================

model InboxItemState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// Deterministic composite key (e.g. "discussion_mention:<mentionId>",
  /// "report_failure:<incidentId>", "ots_failure:<evidenceId>"). Bounded
  /// at 200 chars; longer keys (which would indicate a mistake in the
  /// aggregator) are rejected at the application layer before insert.
  itemKey String @map("item_key") @db.VarChar(200)

  /// Stable short string mirror of the InboxCategory enum value the
  /// aggregator emitted (e.g. "discussion_mention", "ots_failure"). We
  /// store this denormalized so admin queries like "show me every
  /// item the user has dismissed of kind X" don't have to parse the
  /// composite key.
  sourceType String @map("source_type") @db.VarChar(64)

  /// Raw source row id (the right-hand side of itemKey). Nullable
  /// because some kinds (`onboarding:no_organizations`) have no
  /// underlying row id.
  sourceId String? @map("source_id") @db.VarChar(200)

  /// Audit context — which workspace / org the item belonged to when
  /// the state was first written. NOT a tenancy gate. Nullable
  /// because account-tier items (org invites addressed to the caller)
  /// don't have a workspace context.
  teamId String? @map("team_id") @db.Uuid
  orgId  String? @map("org_id") @db.Uuid

  /// Per-user state. All three are timestamps so "when did you do
  /// this" is preserved for audit. The application semantics:
  ///   readAt        — set on mark-read, nulled on mark-unread
  ///   dismissedAt   — set once; the row is then hidden from the
  ///                   default inbox forever (until the source row
  ///                   resolves; if it re-fires under the same itemKey
  ///                   we honor the user's dismissal). Reversible via
  ///                   /v1/me/inbox/items/:itemKey/undismiss in a
  ///                   future phase.
  ///   snoozedUntil  — the inbox hides the item until this timestamp
  ///                   passes; users can re-snooze any number of
  ///                   times.
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  dismissedAt  DateTime? @map("dismissed_at") @db.Timestamptz(6)
  snoozedUntil DateTime? @map("snoozed_until") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
  @@index([userId, dismissedAt])
  @@index([userId, readAt])
  @@index([userId, snoozedUntil])
  @@index([userId, sourceType])
  @@index([userId, teamId])
  @@map("inbox_item_state")
}

/// Operations Center — PERSISTENT history snapshots. A bounded,
/// per-user copy of each item the aggregator surfaced, preserved after
/// the canonical source row resolves/disappears so History remains
/// available. These are OPERATIONAL AUDIT RECORDS — deliberately NOT
/// part of the legal evidence chain (no hashes, no custody linkage).
/// Title/body are captured once at first surface and never rewritten,
/// so the record cannot be falsified against what the user saw.
/// Contains only content the user was already authorized to see when
/// it was surfaced; no secrets, no raw recipient PII beyond what the
/// live item showed.
model OperationsInboxSnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid

  /// Same deterministic composite key as InboxItemState.
  itemKey    String  @map("item_key") @db.VarChar(200)
  sourceType String  @map("source_type") @db.VarChar(64)
  sourceId   String? @map("source_id") @db.VarChar(200)

  /// Workspace / org audit context (NOT a tenancy gate — every read
  /// is additionally scoped by userId). Nullable for account-tier
  /// items.
  teamId String? @map("team_id") @db.Uuid
  orgId  String? @map("org_id") @db.Uuid

  category String @db.VarChar(64)
  /// info | warning | high | critical (aggregator tone).
  severity String @db.VarChar(16)
  /// P1..P5 operator priority at first surface.
  priority String @db.VarChar(4)

  /// Captured ONCE at first surface — never rewritten.
  title String @db.VarChar(300)
  body  String @db.VarChar(1200)
  /// Deep link captured at first surface (server-generated route).
  href  String @db.VarChar(300)

  /// Real due date from the source when one existed; never fabricated.
  dueAtUtc DateTime? @map("due_at_utc") @db.Timestamptz(6)

  /// Lifecycle timestamps.
  sourceOccurredAtUtc DateTime  @map("source_occurred_at_utc") @db.Timestamptz(6)
  firstSeenAtUtc      DateTime  @default(now()) @map("first_seen_at_utc") @db.Timestamptz(6)
  lastSeenAtUtc       DateTime  @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)
  readAtUtc           DateTime? @map("read_at_utc") @db.Timestamptz(6)
  dismissedAtUtc      DateTime? @map("dismissed_at_utc") @db.Timestamptz(6)
  snoozedUntilUtc     DateTime? @map("snoozed_until_utc") @db.Timestamptz(6)
  /// Set when the canonical source stopped emitting the item (resolved
  /// upstream: invite accepted, incident closed, review completed…).
  resolvedAtUtc       DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  /// Resolution provenance. "SOURCE_STATE" = the canonical source
  /// stopped emitting the item (automatic, system-labeled — never a
  /// fabricated human resolver). Future workflow-driven resolutions may
  /// record their own source labels + the acting user.
  resolutionSource    String?   @map("resolution_source") @db.VarChar(32)
  resolvedByUserId    String?   @map("resolved_by_user_id") @db.Uuid

  /// Bounded, validated context copied from the item's `context` map
  /// (names/ids the user already saw — never admin-only enrichment).
  metadataJson Json @default("{}") @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("OperationsInboxSnapshotUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId, lastSeenAtUtc(sort: Desc)])
  @@index([userId, category, lastSeenAtUtc(sort: Desc)])
  @@index([userId, resolvedAtUtc])
  @@index([userId, readAtUtc])
  @@index([userId, teamId])
  @@map("operations_inbox_snapshots")
}

/// Notification schedule settings — per user per workspace: timezone,
/// quiet hours, and digest bookkeeping. One row per (user, workspace);
/// absence means platform defaults (no quiet hours, UTC, immediate
/// delivery only).
/// Organization notification policy — enterprise controls ONLY for
/// PROOVRA-relevant requirements (mandatory critical categories, minimum
/// delivery frequency, quiet-hours override). One row per
/// (organization, category); absence of a row means platform defaults.
/// Managed exclusively by ORG_OWNER / ORG_ADMIN via the policy routes;
/// members see locked "Managed by your organization" states.
model OrganizationNotificationPolicy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  /// NotificationPreferenceType value (bounded at the app layer).
  category       String @db.VarChar(40)

  mandatoryInApp             Boolean @default(false) @map("mandatory_in_app")
  mandatoryEmail             Boolean @default(false) @map("mandatory_email")
  /// Minimum allowed EMAIL cadence (IMMEDIATE strongest … WEEKLY weakest);
  /// null = no minimum. Users cannot weaken below this.
  minimumFrequency           String? @map("minimum_frequency") @db.VarChar(16)
  /// Whether CRITICAL items in this category may bypass quiet hours.
  quietHoursCriticalOverride Boolean @default(true) @map("quiet_hours_critical_override")

  policyVersion   Int     @default(1) @map("policy_version")
  createdByUserId String  @map("created_by_user_id") @db.Uuid
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("OrganizationNotificationPolicyOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, category])
  @@index([organizationId])
  @@map("organization_notification_policies")
}

model NotificationScheduleSetting {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// IANA timezone name, validated at the application layer.
  /// NULL (2026-07-17 Settings remediation) = NO explicit workspace
  /// override — the digest scheduler inherits the account timezone
  /// (`User.timezone`), falling back to UTC. A non-null value is an
  /// EXPLICIT per-workspace override chosen by the user.
  timezone String? @db.VarChar(64)

  quietHoursEnabled     Boolean @default(false) @map("quiet_hours_enabled")
  /// Minutes after local midnight (0..1439).
  quietStartMinute      Int     @default(1320) @map("quiet_start_minute")
  quietEndMinute        Int     @default(420) @map("quiet_end_minute")
  /// When true, CRITICAL items may still deliver during quiet hours.
  quietCriticalOverride Boolean @default(true) @map("quiet_critical_override")

  /// Digest bookkeeping — last successful digest send per cadence.
  lastHourlyDigestAt DateTime? @map("last_hourly_digest_at") @db.Timestamptz(6)
  lastDailyDigestAt  DateTime? @map("last_daily_digest_at") @db.Timestamptz(6)
  lastWeeklyDigestAt DateTime? @map("last_weekly_digest_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("NotificationScheduleSettingUser", fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation("NotificationScheduleSettingTeam", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("notification_schedule_settings")
}

// =============================================================================
// Phase 22 — Evidence Workflow Engine (runtime instance + step + visibility)
//
// The Phase 1-4 surface (EvidenceWorkflowTemplate, WorkflowIntakeLink,
// WorkflowIntakeSession, EvidenceReviewWorkflow, the shared
// resolveVisibilityForViewer) is already in place. Phase 22 adds the
// RUNTIME layer that ties an evidence submission to a concrete
// workflow with a deterministic lifecycle:
//
//   - EvidenceWorkflowInstance   — one row per running workflow
//   - EvidenceWorkflowStepInstance — one row per step of an instance
//   - EvidenceWorkflowVisibilityDecision — per-field decision row
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - LEGAL_HOLD reachable from any non-terminal state; release
//     returns to the operator-recorded prior state.
//   - SUBMITTED → SHARED_EXTERNALLY is BLOCKED without
//     APPROVED → REPORT_READY → PACKAGE_READY ladder.
//   - Service accounts may NEVER create instances except via the
//     API_INGESTION intake mode + SERVICE_ACCOUNT actor role.
//   - Anonymous source identity NEVER appears in any audit / event /
//     projection. Only the actor role surfaces.
//   - Visibility decisions are advisory + auditable; the
//     report-v2 / verification-package paths still consult their
//     own governance gates, NOT this table directly.
//   - Public verify NEVER reads these tables.
// =============================================================================

model EvidenceWorkflowInstance {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  // Snapshot pointers. We store the template id + version at
  // creation time so historical instances are stable across template
  // edits (mirrors the Phase 4 intake-link snapshot pattern).
  templateId      String? @map("template_id") @db.Uuid
  templateSlug    String? @map("template_slug") @db.VarChar(120)
  templateVersion Int?    @map("template_version")

  // Lifecycle state — see @proovra/shared WORKFLOW_INSTANCE_STATUSES
  // for the canonical state machine. Stored as bounded String so the
  // catalog can extend without migrations.
  status        String  @default("DRAFT") @db.VarChar(32)
  // Operator-recorded prior status used to restore from LEGAL_HOLD.
  preHoldStatus String? @map("pre_hold_status") @db.VarChar(32)

  // Intake mode + actor role at creation time. Strings so the
  // catalog can grow without migrations.
  intakeMode String @map("intake_mode") @db.VarChar(40)
  actorRole  String @map("actor_role") @db.VarChar(40)

  // Context bindings — exactly one of these is meaningful per
  // instance kind. The service layer enforces which.
  caseId            String? @map("case_id") @db.Uuid
  claimRef          String? @map("claim_ref") @db.VarChar(128)
  matterRef         String? @map("matter_ref") @db.VarChar(128)
  evidenceRequestId String? @map("evidence_request_id") @db.Uuid
  intakeSessionId   String? @map("intake_session_id") @db.Uuid

  // External contributor correlation. HMAC-SHA256 of an inbound
  // contact (phone / email) so we can dedup without storing the raw
  // value. NEVER the raw contact.
  externalContactHash String? @map("external_contact_hash") @db.VarChar(64)

  // Reviewer assignment — at most one reviewer per instance. Reuses
  // the Phase 13 EvidenceReviewWorkflow when the instance's evidence
  // exists; otherwise this is the only assignment record.
  createdByUserId        String? @map("created_by_user_id") @db.Uuid
  assignedReviewerUserId String? @map("assigned_reviewer_user_id") @db.Uuid

  // Operator-recorded title — bounded so the row never bloats.
  title String? @db.VarChar(180)

  // Timestamps.
  submittedAtUtc DateTime? @map("submitted_at_utc") @db.Timestamptz(6)
  approvedAtUtc  DateTime? @map("approved_at_utc") @db.Timestamptz(6)
  closedAtUtc    DateTime? @map("closed_at_utc") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team                Team                                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template            EvidenceWorkflowTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy           User?                                @relation("EvidenceWorkflowInstanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedReviewer    User?                                @relation("EvidenceWorkflowInstanceAssignedReviewer", fields: [assignedReviewerUserId], references: [id], onDelete: SetNull)
  evidenceRequest     EvidenceRequest?                     @relation("EvidenceRequestWorkflowInstances", fields: [evidenceRequestId], references: [id], onDelete: SetNull)
  intakeSession       WorkflowIntakeSession?               @relation("WorkflowIntakeSessionInstances", fields: [intakeSessionId], references: [id], onDelete: SetNull)
  stepInstances       EvidenceWorkflowStepInstance[]
  visibilityDecisions EvidenceWorkflowVisibilityDecision[]
  evidenceLinks       EvidenceWorkflowInstanceEvidence[]

  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([teamId, intakeMode])
  @@index([templateId])
  @@index([evidenceRequestId])
  @@index([intakeSessionId])
  @@index([externalContactHash])
  @@map("evidence_workflow_instances")
}

// Join table for the many-to-many between an instance and its
// produced evidence rows. A single workflow can produce multiple
// evidence items (multi-step capture); a single evidence row can
// belong to one or more workflows (rare but supported, e.g. when an
// existing evidence is re-attached to a follow-up workflow).
model EvidenceWorkflowInstanceEvidence {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String @map("workflow_instance_id") @db.Uuid
  evidenceId         String @map("evidence_id") @db.Uuid

  // Optional pointer to the specific step this evidence satisfies.
  stepInstanceId String? @map("step_instance_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  instance EvidenceWorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)

  @@unique([workflowInstanceId, evidenceId])
  @@index([evidenceId])
  @@index([stepInstanceId])
  @@map("evidence_workflow_instance_evidence")
}

model EvidenceWorkflowStepInstance {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String @map("workflow_instance_id") @db.Uuid

  // Snapshot of the template step. stepKey + title are copied at
  // instance creation so the row remains readable even if the
  // template is edited.
  stepKey    String  @map("step_key") @db.VarChar(80)
  title      String  @db.VarChar(180)
  required   Boolean @default(false)
  orderIndex Int     @map("order_index")

  // Lifecycle — see @proovra/shared WORKFLOW_STEP_INSTANCE_STATUSES.
  status String @default("NOT_STARTED") @db.VarChar(32)

  // Snapshot of step constraints (so step evaluation does not need to
  // re-load the template).
  acceptedKindsJson   Json?   @map("accepted_kinds_json")
  identityRequirement String? @map("identity_requirement") @db.VarChar(40)
  locationRequirement String? @map("location_requirement") @db.VarChar(20)

  // Mapped evidence (Phase 22 step → evidence binding). One step can
  // be satisfied by zero or more evidence rows; the canonical
  // "primary" evidence id is stored here. Additional evidence
  // mappings live in the join table.
  mappedEvidenceId String? @map("mapped_evidence_id") @db.Uuid

  // Operator audit.
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAtUtc    DateTime? @map("completed_at_utc") @db.Timestamptz(6)
  waiverReason      String?   @map("waiver_reason") @db.VarChar(400)

  // Reviewer-only note. NEVER surfaced on contributor / public /
  // report / package without an explicit operator action.
  privateReviewerNote String? @map("private_reviewer_note") @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  instance       EvidenceWorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  completedBy    User?                    @relation("EvidenceWorkflowStepInstanceCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  mappedEvidence Evidence?                @relation("EvidenceWorkflowStepMappedEvidence", fields: [mappedEvidenceId], references: [id], onDelete: SetNull)

  @@unique([workflowInstanceId, stepKey])
  @@index([workflowInstanceId, status])
  @@index([workflowInstanceId, orderIndex])
  @@index([mappedEvidenceId])
  @@map("evidence_workflow_step_instances")
}

model EvidenceWorkflowVisibilityDecision {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowInstanceId String  @map("workflow_instance_id") @db.Uuid
  evidenceId         String? @map("evidence_id") @db.Uuid

  // The field key from the visibility policy. Bounded so a malicious
  // template cannot balloon the row.
  fieldKey String @map("field_key") @db.VarChar(80)

  // Per-surface decisions. Defaults skew CLOSED so adding a new
  // surface defaults to "not visible" until the engine resolves it.
  visibleInApp                 Boolean @default(true) @map("visible_in_app")
  visibleToContributor         Boolean @default(false) @map("visible_to_contributor")
  visibleInPublicVerify        Boolean @default(false) @map("visible_in_public_verify")
  visibleInReport              Boolean @default(false) @map("visible_in_report")
  visibleInVerificationPackage Boolean @default(false) @map("visible_in_verification_package")
  requiresRedaction            Boolean @default(false) @map("requires_redaction")

  // Operator-readable reason ("default deny", "policy allow",
  // "redaction required", "contributor scope only"). Bounded.
  reason String @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  instance EvidenceWorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  evidence Evidence?                @relation("EvidenceVisibilityDecisions", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([workflowInstanceId, evidenceId, fieldKey])
  @@index([workflowInstanceId])
  @@index([evidenceId])
  @@map("evidence_workflow_visibility_decisions")
}

// =============================================================================
// Phase 24 — Enterprise Evidence Discovery Platform
//
// Adds the canonical search-document projection + saved-view rows.
// The existing EvidenceRelationship model (line ~864) covers the
// relationship surface; Phase 24 REUSES it rather than creating a
// parallel table.
//
// Hard invariants enforced by the service layer (NOT the schema):
//   - The indexer NEVER projects privateReviewerNote, legal-hold
//     reason text, raw GPS (unless governance policy explicitly
//     allows), OTPs, tokens, signed URLs, or contributor identity
//     fields restricted by workflow visibility decisions.
//   - The search service ALWAYS filters by team membership +
//     visibility decisions + governance state before returning a row.
//   - Public verify NEVER reads either of these tables.
// =============================================================================

// EvidenceSearchDocument — denormalised projection used by the
// search service. One row per indexable item (an evidence, a
// workflow instance, a workflow step, a review event, etc.). The
// indexing service writes these rows; the search service reads them.
// Rows are upserted by (teamId, documentType, sourceId) so re-
// indexing a single source produces exactly one row.
model EvidenceSearchDocument {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  // Document type — must be one of @proovra/shared
  // SEARCH_DOCUMENT_TYPES. Stored as VARCHAR so the catalog can
  // grow without migrations.
  documentType String @map("document_type") @db.VarChar(40)

  // Source pointer — the id of the underlying row. Combined with
  // documentType + teamId this is the upsert key.
  sourceId String @map("source_id") @db.Uuid

  // Operator-readable identity for the row. Bounded.
  title    String  @db.VarChar(200)
  subtitle String? @db.VarChar(200)
  summary  String? @db.VarChar(400)

  // Tokenised free-text body. NEVER includes private reviewer notes,
  // legal-hold reasons, or hidden contributor fields. The indexer
  // composes this from the safe-to-search subset of the source row
  // + any extracted text from EvidenceExtractedText (Phase 15) that
  // the source's visibility policy permits.
  searchableText String? @map("searchable_text") @db.Text

  // Operator-facing structured metadata (workflow status, review
  // status, evidence type, etc.). Bounded JSON; the indexer applies
  // the recursive redactor before storage.
  searchableMetadataJson Json? @map("searchable_metadata_json")

  // Tags surfaced as operator badges. Bounded array.
  searchableTagsJson Json? @map("searchable_tags_json")

  // Visibility / governance / lifecycle snapshot — used as fast
  // filters (avoids joining back to the source on every query).
  visibilityScopeJson Json?   @map("visibility_scope_json")
  governanceScopeJson Json?   @map("governance_scope_json")
  reviewState         String? @map("review_state") @db.VarChar(40)
  workflowState       String? @map("workflow_state") @db.VarChar(40)
  exportState         String? @map("export_state") @db.VarChar(40)
  retentionState      String? @map("retention_state") @db.VarChar(40)
  legalHoldState      String? @map("legal_hold_state") @db.VarChar(40)

  contributorScoped  Boolean @default(false) @map("contributor_scoped")
  reviewerRestricted Boolean @default(false) @map("reviewer_restricted")

  // Optional pointers for fast pivoting in the UI.
  evidenceId             String? @map("evidence_id") @db.Uuid
  workflowInstanceId     String? @map("workflow_instance_id") @db.Uuid
  workflowStepInstanceId String? @map("workflow_step_instance_id") @db.Uuid
  caseId                 String? @map("case_id") @db.Uuid
  claimRef               String? @map("claim_ref") @db.VarChar(128)
  matterRef              String? @map("matter_ref") @db.VarChar(128)

  // Source-row's last update — drives the cursor ordering.
  sourceUpdatedAtUtc DateTime @map("source_updated_at_utc") @db.Timestamptz(6)
  indexedAtUtc       DateTime @default(now()) @map("indexed_at_utc") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // PHASE 12 POINT 5 — DECLARED, not added.
  //
  // This column has existed since the Phase-24/31 drift consolidation and is
  // created by two historical migrations, but the datamodel never declared it,
  // so `db:raw-schema-verify` saw a column PROPOSED FOR REMOVAL and hard-failed
  // — the datamodel must own existence.
  //
  // Nobody noticed because it is EXTENSION-CONDITIONAL: without pgvector the
  // migration that creates it is guarded out, the column is absent, and the
  // check is clean. Point 5 makes pgvector a production prerequisite (the
  // embedding chain cannot run without it), so the condition that hid this is
  // now the condition that is required.
  //
  // Declared exactly as its sibling `EvidenceSemanticChunk.embeddingVector` is
  // — `Unsupported`, because Prisma has no first-class vector type and every
  // read and write goes through `$queryRaw`. On a database without the
  // extension it becomes an extension-conditional ADDED-column divergence,
  // which is registered in `raw-schema-ownership.json` like the other one.
  embedding Unsupported("vector(384)")?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, documentType, sourceId])
  @@index([teamId, sourceUpdatedAtUtc(sort: Desc)])
  @@index([teamId, documentType])
  @@index([teamId, workflowState])
  @@index([teamId, reviewState])
  @@index([teamId, legalHoldState])
  @@index([teamId, exportState])
  @@index([teamId, contributorScoped])
  @@index([teamId, reviewerRestricted])
  @@index([evidenceId])
  @@index([workflowInstanceId])
  @@index([caseId])
  @@map("evidence_search_documents")
}

// SavedSearchView — per-user (PRIVATE) or per-team (TEAM) saved
// search filter. The queryJson is the validated SearchFilterInput
// from @proovra/shared. Operators pin frequently-used views from
// the UI; the cron route hydrates the `lastUsedAtUtc` field on
// every execution so stale views can be cleaned up.
model SavedSearchView {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String @map("team_id") @db.Uuid
  createdByUserId String @map("created_by_user_id") @db.Uuid

  name        String  @db.VarChar(120)
  description String? @db.VarChar(400)

  // Visibility scope — PRIVATE (creator-only) or TEAM (all
  // workspace members). Stored as VARCHAR so the catalog can grow.
  visibility String @default("PRIVATE") @db.VarChar(16)

  // Phase 25.5 — discriminator. "SEARCH" (default, Phase 24) or
  // "REVIEWER_OPS" (Phase 25.5 reviewer queue filters). The route
  // layer validates the queryJson shape against the matching schema.
  scope String @default("SEARCH") @db.VarChar(24)

  // Validated SearchFilterInput payload (the route layer validates
  // via @proovra/shared SearchFilterSchema before storage).
  queryJson Json @map("query_json")

  pinned Boolean @default(false)

  lastUsedAtUtc DateTime? @map("last_used_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("SavedSearchViewCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, createdByUserId, name])
  @@index([teamId, visibility])
  @@index([teamId, pinned])
  @@index([createdByUserId, updatedAt(sort: Desc)])
  // Phase 25.5 — discriminator-aware list queries.
  @@index([teamId, scope])
  @@index([teamId, scope, visibility])
  @@map("saved_search_views")
}

// =============================================================================
// Phase 25 — Reviewer Operations Intelligence + SLA Engine
// =============================================================================
//
// Layered on top of the Phase 13 EvidenceReviewWorkflow model. Phase 25
// adds two first-class objects:
//
//   1. ReviewEscalation — durable escalation record. The Phase 13
//      workflow row already carries escalation* fields as a denormalised
//      "current state" pointer; Phase 25 promotes escalations to a
//      first-class row so each one has its own lifecycle (OPEN →
//      ACKNOWLEDGED → RESOLVED / SUPPRESSED), assigned owner, optional
//      operational-incident link, and audit trail.
//
//   2. ReviewerWorkloadSnapshot — periodic per-reviewer capacity
//      snapshot. The reconcile job recomputes these so the assignment
//      suggester + dashboard can rank reviewers by capacity without
//      hitting the workflow table N times.
//
// Hard rules:
//   - Reason / note fields are bounded VARCHARs. Routes / services
//     truncate inputs before persisting. No long-form private text.
//   - The escalation `safeSummary` is operator-readable; we never
//     persist private reviewer notes or legal-hold-reason text here.
//   - Unique constraint on (workflowId, status) for OPEN escalations
//     is enforced as a *partial* index in the manual SQL (Prisma can't
//     express it). The service layer enforces it programmatically.
// =============================================================================

// ReviewEscalation — durable escalation lifecycle. Reasons + statuses
// are stored as VARCHARs so the shared catalog can grow without a
// schema migration. The service layer enforces enum membership.
model ReviewEscalation {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  // The Phase 13 workflow row this escalation belongs to. Cascade so
  // deleting an evidence record cleans up its escalations too.
  workflowId String @map("workflow_id") @db.Uuid

  // Optional pointers — populated when the escalation traces back
  // through the Phase 22 workflow engine. Both are SetNull so the
  // escalation history survives template / instance cleanups.
  workflowInstanceId String? @map("workflow_instance_id") @db.Uuid
  evidenceId         String? @map("evidence_id") @db.Uuid

  // Reason catalog. The service layer validates membership against the
  // shared REVIEW_ESCALATION_REASONS catalog before insert.
  reason   String @db.VarChar(48)
  // INFO | WARNING | HIGH | CRITICAL — mirrors IncidentSeverity.
  severity String @default("WARNING") @db.VarChar(16)
  // OPEN | ACKNOWLEDGED | REASSIGNED | RESOLVED | SUPPRESSED
  status   String @default("OPEN") @db.VarChar(16)

  // Operator-readable summary. Bounded; never carries internal legal
  // text or private reviewer notes.
  // Phase 32.6.2 — explicit @map("safe_summary"). Without this Prisma
  // client emits `INSERT/SELECT "safeSummary"` (quoted camelCase),
  // but migrations create snake_case columns. The drift left two
  // physical columns in production. Repair migration backfills
  // `safe_summary` from `"safeSummary"` where present.
  safeSummary String @map("safe_summary") @db.VarChar(400)

  // Actors.
  createdByUserId  String? @map("created_by_user_id") @db.Uuid
  assignedToUserId String? @map("assigned_to_user_id") @db.Uuid

  // Lifecycle timestamps.
  acknowledgedAtUtc    DateTime? @map("acknowledged_at_utc") @db.Timestamptz(6)
  acknowledgedByUserId String?   @map("acknowledged_by_user_id") @db.Uuid
  resolvedAtUtc        DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolvedByUserId     String?   @map("resolved_by_user_id") @db.Uuid
  // Phase 32.6.2 — explicit @map("resolution_note"). See safeSummary above.
  resolutionNote       String?   @map("resolution_note") @db.VarChar(400)
  // SUPPRESSED escalations stay in history but stop counting toward
  // backlog metrics. The route layer requires a non-empty note.
  suppressedAtUtc      DateTime? @map("suppressed_at_utc") @db.Timestamptz(6)
  suppressionReason    String?   @map("suppression_reason") @db.VarChar(400)

  // Optional link to a Phase 21 operational incident (for SLA breach
  // bursts, reviewer-inactivity sweeps, etc).
  incidentId String? @map("incident_id") @db.Uuid

  // Deduplication fingerprint. The service hashes
  // `${workflowId}:${reason}:${dayBucket}` so a runaway reconcile loop
  // can't spam duplicate escalations on the same workflow + reason on
  // the same UTC day. Routes can intentionally bypass via a manual
  // create flag.
  fingerprint String @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team           Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workflow       EvidenceReviewWorkflow @relation("ReviewEscalationWorkflow", fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy      User?                  @relation("ReviewEscalationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo     User?                  @relation("ReviewEscalationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  acknowledgedBy User?                  @relation("ReviewEscalationAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?                  @relation("ReviewEscalationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, fingerprint])
  @@index([teamId, status])
  @@index([teamId, severity])
  @@index([teamId, reason])
  @@index([workflowId, createdAt(sort: Desc)])
  @@index([workflowInstanceId])
  @@index([assignedToUserId, status])
  @@index([incidentId])
  @@map("review_escalations")
}

// ReviewerWorkloadSnapshot — periodic per-reviewer capacity snapshot.
// The reconcile job recomputes one row per (team, reviewer) per
// reconcile pass. Older snapshots are NOT purged automatically —
// operators can pull historical trends.
model ReviewerWorkloadSnapshot {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  reviewerUserId String @map("reviewer_user_id") @db.Uuid

  // Aggregate counts at snapshot time.
  activeReviewCount    Int @default(0) @map("active_review_count")
  overdueReviewCount   Int @default(0) @map("overdue_review_count")
  dueSoonReviewCount   Int @default(0) @map("due_soon_review_count")
  escalatedReviewCount Int @default(0) @map("escalated_review_count")
  needsInfoReviewCount Int @default(0) @map("needs_info_review_count")

  // Heuristic capacity score in [0..100]. 100 = idle, 0 = saturated.
  // The exact formula lives in the workload service and is the only
  // place authorised to write this column.
  capacityScore Int @default(100) @map("capacity_score")

  // Optional operator-facing note (e.g. "reviewer flagged inactive").
  // Never carries private reviewer text.
  // Phase 32.6.2 — explicit @map("safe_note"). See ReviewEscalation.safeSummary.
  safeNote String? @map("safe_note") @db.VarChar(400)

  computedAtUtc DateTime @default(now()) @map("computed_at_utc") @db.Timestamptz(6)

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewerWorkloadSnapshotReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  // The reconcile job writes one row per (team, reviewer) per pass —
  // we keep history. The (team, reviewer, computedAtUtc DESC) index
  // serves both "latest snapshot" lookups and trend queries.
  @@index([teamId, reviewerUserId, computedAtUtc(sort: Desc)])
  @@index([teamId, computedAtUtc(sort: Desc)])
  @@index([teamId, capacityScore])
  @@map("reviewer_workload_snapshots")
}

// =============================================================================
// Phase 25.5 — Reviewer Operations Hardening
// =============================================================================
//
// ReviewerOpsReminder — dedup ledger for the Phase 25.5 reminder engine.
// One row per (teamId, kind, workflowId, dayBucket) prevents reminder
// storms: even if the reconcile job runs every minute, a reviewer never
// gets the same DUE_SOON / INACTIVITY / ESCALATION_WARNING reminder
// twice in the same UTC day for the same workflow.
//
// Hard rules:
//   - Insert-only; the reconcile job NEVER updates a prior row.
//   - The unique (teamId, kind, dedupKey) constraint is the primary
//     gate; the service catches the duplicate-key error path and
//     bumps a metric.
//   - Body fields are bounded; the engine refuses to persist
//     anything containing a forbidden overclaim phrase.
//   - No private reviewer note text. Operator-safe summary only.
// =============================================================================

model ReviewerOpsReminder {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// DUE_SOON | ESCALATION_WARNING | REVIEWER_INACTIVE | REASSIGNMENT_SUGGESTION
  kind String @db.VarChar(40)

  /// SHA-256 prefix of `${workflowId}:${kind}:${dayBucket}` — unique
  /// per (teamId, kind, dedupKey).
  /// Phase 32.6.2 — explicit @map("dedup_key"). Without this Prisma
  /// client emits `"dedupKey"` (quoted camelCase) but the migration
  /// creates `dedup_key`. See ReviewEscalation.safeSummary comment.
  dedupKey String @map("dedup_key") @db.VarChar(80)

  /// Optional foreign-key-style pointers. We do NOT FK these so the
  /// reminder ledger survives downstream cleanups.
  workflowId     String? @map("workflow_id") @db.Uuid
  escalationId   String? @map("escalation_id") @db.Uuid
  reviewerUserId String? @map("reviewer_user_id") @db.Uuid

  /// Bounded operator-safe summary; the engine scrubs forbidden
  /// overclaim phrases before persisting.
  /// Phase 32.6.2 — explicit @map("safe_summary"). See dedupKey above.
  safeSummary String @map("safe_summary") @db.VarChar(400)

  /// Optional pointer at the CommunicationMessage we created on
  /// dispatch (NULL when the reminder is metric-only — e.g.
  /// reassignment suggestion).
  communicationMessageId String? @map("communication_message_id") @db.Uuid

  /// Operator-readable status string. SCHEDULED | DELIVERED | SUPPRESSED | FAILED.
  status String @default("SCHEDULED") @db.VarChar(16)

  /// `${UTC YYYY-MM-DD}` day bucket — also embedded in dedupKey.
  dayBucket String @map("day_bucket") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind, dedupKey])
  @@index([teamId, kind, createdAt(sort: Desc)])
  @@index([teamId, workflowId])
  @@index([teamId, reviewerUserId, createdAt(sort: Desc)])
  @@index([teamId, status])
  @@map("reviewer_ops_reminders")
}

// =============================================================================
// Phase 26 — Enterprise Identity Governance Platform
// =============================================================================
//
// Adds three first-class models on top of the Phase 17 identity surface:
//
//   1. SsoConnection — per-team Identity Provider config. Multiple
//      providers per team supported (Google Workspace primary + Okta
//      secondary, etc.). Holds OIDC discovery URL, client ID + hashed
//      client secret, JIT provisioning policy, allowed email domains,
//      lifecycle status. SAML metadata persisted as a separate JSON
//      blob (placeholder for Phase 27 SAML protocol wiring).
//
//   2. ScimProvisioningToken — per-team bearer token for the SCIM v2
//      endpoints. Hashed (HMAC-SHA256), prefix-visible, scope-bounded,
//      revocation + last-used tracked. NEVER stores the raw token.
//
//   3. AuthenticatedSession — active session ledger. Every successful
//      login inserts one row keyed by `sessionIdHash` (HMAC of the JWT
//      jti). Revocation marks revokedAtUtc (denormalised mirror of
//      the existing RevokedSession table for fast inventory). The admin
//      session console reads from here.
//
// Hard rules:
//   - Client secrets / SCIM tokens NEVER stored in plaintext.
//   - All reason / notes / display_name fields are bounded VARCHARs
//     scrubbed at the route layer.
//   - Operator-facing rows carry display-only previews
//     (clientIdPreview, tokenPrefix) never the raw value.
//   - Phase 17 OrganizationSecurityPolicy.ssoReadyFlag / scimReadyFlag
//     remain the workspace feature toggle; the existence of a row
//     here does NOT bypass that gate.
// =============================================================================

model SsoConnection {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Phase 17 ExternalIdentityProvider enum: GENERIC_SAML | GENERIC_OIDC |
  /// GENERIC_SCIM | OKTA | AZURE_AD | GOOGLE_WORKSPACE.
  provider ExternalIdentityProvider

  /// Operator-readable label (Acme Corp Okta, Engineering G-Suite).
  displayName String @map("display_name") @db.VarChar(180)

  /// PENDING | ACTIVE | DISABLED | REVOKED. Only ACTIVE connections
  /// initiate login flows.
  status String @default("PENDING") @db.VarChar(16)

  /// OIDC: discovery doc URL. SAML: identity-provider entityID URL.
  /// Bounded; routes validate.
  issuerUrl String? @map("issuer_url") @db.VarChar(400)

  /// OIDC: client ID (visible). NULL for SAML.
  clientId            String? @map("client_id") @db.VarChar(180)
  /// OIDC: hashed client secret (HMAC-SHA256). The raw secret is
  /// returned ONCE on creation, then immediately discarded.
  clientSecretHash    String? @map("client_secret_hash") @db.VarChar(128)
  /// Display-only preview of the client secret (e.g. "ck-***-abcd").
  /// Surfaced in the admin UI; never the raw secret.
  clientSecretPreview String? @map("client_secret_preview") @db.VarChar(32)

  /// SAML: full IdP metadata XML stored as a JSON blob. Placeholder
  /// for Phase 27 SAML protocol wiring; Phase 26 stores but does not
  /// parse this.
  samlMetadataJson Json? @map("saml_metadata_json")

  /// R8.2 — SAML SP identity. The SP entityID sent in AuthnRequests.
  /// Built as: {apiBaseUrl}/saml/metadata/{connectionId}
  samlEntityId String? @map("saml_entity_id") @db.VarChar(400)

  /// R8.2 — IdP SSO URL. The HTTP-Redirect binding endpoint the SP
  /// issues AuthnRequests to. Extracted from IdP metadata.
  samlSsoUrl String? @map("saml_sso_url") @db.VarChar(400)

  /// R8.2 — IdP X.509 certificate in PEM format (without the header/footer
  /// lines, base64 only). Used for XML signature verification.
  /// Never logged; never returned to the caller.
  samlCertificate String? @map("saml_certificate")

  /// R8.2 — SHA-256 fingerprint of samlCertificate (hex, lowercase, no
  /// colons). Displayed in the admin UI for operator-side verification.
  samlCertFingerprint String? @map("saml_cert_fingerprint") @db.VarChar(128)

  /// R8.2 — NameID format URI. Default:
  /// urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
  samlNameIdFormat String? @map("saml_name_id_format") @db.VarChar(200)

  /// R8.2 — When true, the SP signs AuthnRequests with the SP private
  /// key (per-connection samlSpPrivateKey, else the platform-wide
  /// SAML_SP_PRIVATE_KEY env). Some IdPs require this.
  samlSignRequests Boolean @default(false) @map("saml_sign_requests")

  /// Phase 3 — Optional per-connection SP signing private key (PEM,
  /// PKCS#8 or PKCS#1). When set AND samlSignRequests=true, the SP
  /// signs AuthnRequests with this key rather than the platform-wide
  /// SAML_SP_PRIVATE_KEY env. Additive + nullable. NEVER logged; NEVER
  /// returned to the caller — write-only from the admin surface.
  samlSpPrivateKey String? @map("saml_sp_private_key")

  /// Phase 3 — Optional per-connection SP X.509 certificate (base64
  /// only, no PEM header/footer) advertised in SP metadata and embedded
  /// in the AuthnRequest KeyInfo so the IdP can verify the signature.
  /// Additive + nullable.
  samlSpCertificate String? @map("saml_sp_certificate") @db.VarChar(8192)

  /// Phase 3 — Domain verification enforcement. When true, SSO logins
  /// through this connection are additionally restricted to email
  /// domains that are VERIFIED OrganizationDomain rows for the owning
  /// org (layered ON TOP of allowedEmailDomains, which is unchanged).
  /// Default false preserves existing behaviour for every connection.
  restrictToVerifiedDomains Boolean @default(false) @map("restrict_to_verified_domains")

  /// R8.2 — Optional operator-supplied JSON mapping IdP attribute names
  /// to profile fields: { email?: string, name?: string, externalId?: string }.
  samlAttributeMapping Json? @map("saml_attribute_mapping")

  /// R8.2.1 — Certificate rotation: secondary IdP certificate in
  /// base64-only format (no PEM headers). When set, assertion
  /// signatures are verified against BOTH active and next certificate
  /// so IdP cert rotation does not cause login downtime.
  samlCertificateNext String? @map("saml_certificate_next")

  /// R8.2.1 — SHA-256 fingerprint of samlCertificateNext (hex,
  /// lowercase, no colons). Displayed in admin UI for operator verification.
  samlCertNextFingerprint String? @map("saml_cert_next_fingerprint") @db.VarChar(128)

  /// R8.2.1 — Timestamp of the last admin test-connection run.
  samlLastTestedAt DateTime? @map("saml_last_tested_at") @db.Timestamptz(6)

  /// R8.2.1 — Outcome of the last test-connection run:
  /// "PASSED" | "FAILED". NULL means never tested.
  samlLastTestStatus String? @map("saml_last_test_status") @db.VarChar(16)

  /// R8.2.1 — Sanitised error code from the last failed test-connection
  /// (e.g. "SAML_SIGNATURE_INVALID"). MAX 128 chars; no raw XML/certs.
  samlLastTestError String? @map("saml_last_test_error") @db.VarChar(128)

  /// R8.2.1 — When true, this team is managed by SCIM and JIT
  /// provisioning is disabled regardless of jitDefaultRole. Admins
  /// must manage membership exclusively through SCIM.
  samlScimManaged Boolean @default(false) @map("saml_scim_managed")

  /// R8.2.2 — IdP entity ID from the IdP metadata
  /// (EntityDescriptor/@entityID). Distinct from samlEntityId which
  /// is the SP's entity ID. Stored for display and issuer validation.
  samlIdpEntityId String? @map("saml_idp_entity_id") @db.VarChar(400)

  /// R8.2.2 — Parsed X.509 NotAfter for the primary IdP cert.
  /// NULL if cert has not been ingested or expiry cannot be parsed.
  /// Used to surface expiry warnings in the admin UI and emit
  /// saml_certificate_expiring events.
  samlCertNotAfter DateTime? @map("saml_cert_not_after") @db.Timestamptz(6)

  /// R8.2.2 — Parsed X.509 NotAfter for the secondary (next) cert.
  samlCertNextNotAfter DateTime? @map("saml_cert_next_not_after") @db.Timestamptz(6)

  /// Comma-separated list of email domains accepted for this
  /// connection. Empty array means any verified domain on the team.
  /// Enforced at JIT provisioning + at callback.
  allowedEmailDomains String[] @map("allowed_email_domains")

  /// On first login (no existing User), Phase 26 may JIT-provision the
  /// member at this default role. Null = JIT disabled for this
  /// connection (operator must pre-invite).
  jitDefaultRole String? @map("jit_default_role") @db.VarChar(16)

  /// Operator-supplied notes. Bounded; never carries secrets.
  notes String? @db.VarChar(2000)

  /// Audit trail.
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Cached last-used / last-rotation timestamps.
  lastUsedAtUtc   DateTime? @map("last_used_at_utc") @db.Timestamptz(6)
  rotatedAtUtc    DateTime? @map("rotated_at_utc") @db.Timestamptz(6)
  /// Optional revocation pointer.
  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(400)

  /// Phase 26.5 — IdP outage tracking. The SSO service increments
  /// `consecutiveFailureCount` on every callback / discovery error and
  /// resets to zero on a successful exchange. When the count crosses
  /// the configured threshold, the service stamps `outageDetectedAtUtc`
  /// and opens a Phase 21 operational incident.
  consecutiveFailureCount Int       @default(0) @map("consecutive_failure_count")
  outageDetectedAtUtc     DateTime? @map("outage_detected_at_utc") @db.Timestamptz(6)
  outageClearedAtUtc      DateTime? @map("outage_cleared_at_utc") @db.Timestamptz(6)

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("SsoConnectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  /// Phase 26.5 — replay-protection back-relation.
  callbackAttempts SsoCallbackAttempt[]

  /// PHASE 10 §0B — identities this connection established management for.
  managedIdentities User[] @relation("ManagedIdentityConn")

  /// One team can have ONE active connection per provider at a time.
  @@unique([teamId, provider, status])
  @@index([teamId, status])
  @@index([teamId, provider])
  @@index([revokedAtUtc])
  @@index([outageDetectedAtUtc])
  @@map("sso_connections")
}

model ScimProvisioningToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Operator-readable label.
  name String @db.VarChar(180)

  /// Display prefix (first 8 chars). The raw token is shown ONCE on
  /// create and never persisted.
  tokenPrefix String @map("token_prefix") @db.VarChar(32)
  /// HMAC-SHA256 hash of the full token. The middleware compares hashes.
  tokenHash   String @unique @map("token_hash") @db.VarChar(128)

  /// SCIM permission scopes (whitelist of operations the token can
  /// perform). e.g. "users.read", "users.write", "users.deactivate",
  /// "groups.read". Routes enforce.
  scopes String[] @map("scopes")

  /// ACTIVE | REVOKED. Disabled tokens are kept for audit history.
  status String @default("ACTIVE") @db.VarChar(16)

  /// Optional IP allowlist (CIDR strings).
  ipAllowlist String[] @map("ip_allowlist")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAtUtc   DateTime? @map("last_used_at_utc") @db.Timestamptz(6)
  /// Optional expiry. Null = non-expiring.
  expiresAtUtc    DateTime? @map("expires_at_utc") @db.Timestamptz(6)

  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(400)

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("ScimProvisioningTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([expiresAtUtc])
  @@map("scim_provisioning_tokens")
}

model AuthenticatedSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The team this session is scoped to at issue time. Null for guest
  /// sessions without a current workspace.
  teamId String? @map("team_id") @db.Uuid
  userId String  @map("user_id") @db.Uuid

  /// HMAC-SHA256 of the JWT jti. The raw jti is in the JWT; this is
  /// the operator-safe lookup key for the inventory + revocation flow.
  sessionIdHash String @map("session_id_hash") @db.VarChar(64)

  /// Optional IdP this session was issued through. NULL = email/password
  /// or guest. Otherwise points at the SsoConnection that authenticated.
  ssoConnectionId String? @map("sso_connection_id") @db.Uuid

  /// Issuance + expiry. The JWT itself carries iat/exp; we mirror here
  /// so the inventory query stays fast.
  issuedAtUtc  DateTime @default(now()) @map("issued_at_utc") @db.Timestamptz(6)
  expiresAtUtc DateTime @map("expires_at_utc") @db.Timestamptz(6)

  /// Best-effort last-seen update (write-on-permission-check, not on
  /// every request, to avoid hot-row contention).
  lastSeenAtUtc DateTime @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)

  /// Phase 26.5 — sampled heartbeat. The heartbeat middleware writes
  /// this column at most every SESSION_HEARTBEAT_SAMPLE_WINDOW_SECONDS
  /// per session to avoid hot-row contention. Distinct from
  /// lastSeenAtUtc which Phase 26 best-effort touches on permission
  /// checks; this column drives the stale-session reconcile sweep.
  lastHeartbeatAtUtc DateTime? @map("last_heartbeat_at_utc") @db.Timestamptz(6)

  /// Phase 26.5 — risk score for adaptive auth. 0 = trusted, 100 =
  /// critical risk. Refreshed by the suspicious-session detector;
  /// drives the adaptive auth engine's step-up requirement decision.
  riskScore Int @default(0) @map("risk_score")

  /// Display-only previews. Never persists raw IP or User-Agent.
  ipPreview    String? @map("ip_preview") @db.VarChar(64)
  uaPreview    String? @map("ua_preview") @db.VarChar(120)
  deviceIdHash String? @map("device_id_hash") @db.VarChar(64)
  /// Phase 26.5 — masked country code derived from IP geolocation at
  /// issue time. Never persists raw geo coordinates; the country code
  /// is used by the suspicious-session detector for impossible-travel
  /// signals.
  countryCode  String? @map("country_code") @db.VarChar(8)

  /// Denormalised revocation pointer. The Phase 17 RevokedSession
  /// table remains the source of truth for JWT validation; this column
  /// is just for the admin inventory UI so we do not have to join.
  revokedAtUtc    DateTime? @map("revoked_at_utc") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  revokedReason   String?   @map("revoked_reason") @db.VarChar(64)

  /// Phase 26.75 — Session quarantine. A quarantined session retains
  /// READ access (so an operator can finish their current investigation)
  /// but the adaptive-auth gate refuses any high-privilege action. The
  /// quarantine state is the soft alternative to a hard revoke; the
  /// session inventory UI surfaces both lists separately.
  quarantinedAtUtc       DateTime? @map("quarantined_at_utc") @db.Timestamptz(6)
  quarantinedByUserId    String?   @map("quarantined_by_user_id") @db.Uuid
  quarantineReason       String?   @map("quarantine_reason") @db.VarChar(96)
  /// Optional release timestamp. When set, the gate auto-releases the
  /// session once the wall-clock passes the timestamp. NULL = manual
  /// release only.
  quarantineReleaseAtUtc DateTime? @map("quarantine_release_at_utc") @db.Timestamptz(6)

  /// Phase 26.75 — last runtime risk recompute. The recompute cron
  /// only re-scores sessions whose last recompute is older than the
  /// configured window to bound cost.
  lastRiskRecomputedAtUtc DateTime? @map("last_risk_recomputed_at_utc") @db.Timestamptz(6)

  /// PHASE 10 §2 (2026-07-23) — ORGANIZATION SESSION CONTEXT. `teamId` is the
  /// issue-time workspace; it is NOT the org-context this session currently
  /// occupies. `organizationContextId` is the ONE Organization whose context
  /// this global session currently holds (set when the session establishes an
  /// ORGANIZATION context — switch/SSO/invite/deep-link; NULL for Personal/OWNED
  /// or no context). It is the canonical binding for the Organization-scoped
  /// concurrent-session limit: distinct active sessionIds per (userId,
  /// organizationContextId). Switching Org-A→Org-B moves this pointer (Org-A
  /// count drops, Org-B re-evaluated). Same session across Org-A workspaces keeps
  /// the same value → counted ONCE. (Migration 20271004000000, NOT applied.)
  organizationContextId String? @map("organization_context_id") @db.Uuid

  team                Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organizationContext Organization? @relation("AuthenticatedSessionOrgContext", fields: [organizationContextId], references: [id], onDelete: SetNull)
  user                User          @relation("AuthenticatedSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionIdHash])
  @@index([teamId, revokedAtUtc])
  @@index([userId, expiresAtUtc])
  // PHASE 10 §2 — org-scoped concurrent-session count (userId, org, still-active).
  @@index([userId, organizationContextId, revokedAtUtc, expiresAtUtc])
  @@index([ssoConnectionId])
  @@index([expiresAtUtc])
  // Phase 26.5 — stale-session sweep + adaptive auth risk lookup.
  @@index([teamId, lastHeartbeatAtUtc])
  @@index([teamId, riskScore])
  // Phase 26.75 — quarantine + recompute sweep indexes.
  @@index([teamId, quarantinedAtUtc])
  @@index([teamId, lastRiskRecomputedAtUtc])
  @@map("authenticated_sessions")
}

// =============================================================================
// Phase 26.5 — Enterprise Identity Hardening
// =============================================================================
//
// Adds two first-class models on top of Phase 26 SSO + SCIM:
//
//   1. SsoCallbackAttempt — persistent replay-protection ledger for
//      the OIDC state token. Phase 26 kept state in-process; Phase 26.5
//      promotes it to a DB row so multi-instance deployments cannot
//      accept the same state twice. The state token itself is HASHED
//      (HMAC-SHA256) and the raw value never leaves the process.
//
//   2. ScimGroup — RFC 7644 Group resource. The Phase 26 SCIM service
//      only supports Users; Phase 26.5 adds Groups so IdPs can sync
//      role assignments. A Group is a role pointer: membership is
//      computed from TeamMember.role = group.mappedRole; the group
//      row stores the operator-readable display name + externalId.
//
// Hard rules:
//   - State tokens / SCIM tokens / cookies NEVER stored in plaintext.
//   - Group membership writes go through the existing Phase 17 RBAC
//     service; SCIM Groups never bypass the role-change audit.
//   - Operator-facing rows carry display-only previews / external IDs;
//     raw user emails are filtered out where the IdP includes them.
// =============================================================================

model SsoCallbackAttempt {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String @map("team_id") @db.Uuid
  ssoConnectionId String @map("sso_connection_id") @db.Uuid

  /// HMAC-SHA256 of the OIDC `state` token. Unique per row; the
  /// callback service rejects any second attempt at the same hash.
  stateHash String @unique @map("state_hash") @db.VarChar(64)

  /// HMAC-SHA256 of the nonce we signed into the IdP authorization
  /// URL. The callback verifies the IdP returned a matching nonce
  /// when we round-trip through ID-token verification.
  nonceHash String @map("nonce_hash") @db.VarChar(64)

  /// R8.2 — For SAML connections: the AuthnRequest ID (ID attribute) we
  /// issued. The ACS handler verifies the SAMLResponse InResponseTo
  /// attribute matches this value before consuming the attempt. Null for
  /// OIDC connections (which use nonce instead).
  samlAuthnRequestId String? @map("saml_authn_request_id") @db.VarChar(128)

  /// PENDING | CONSUMED | EXPIRED | REPLAYED | FAILED. Lifecycle:
  /// PENDING is the only state from which CONSUMED / FAILED can be
  /// reached; REPLAYED is a terminal status the service writes when
  /// it sees a second attempt at a CONSUMED token.
  status String @default("PENDING") @db.VarChar(16)

  /// Sanitised redirect target the callback should send the user to
  /// on success. Validated at issue + at consume against an
  /// allow-list pattern (no open redirects).
  redirectAfter String? @map("redirect_after") @db.VarChar(400)

  /// Operator-safe origin metadata (display previews only).
  ipPreview String? @map("ip_preview") @db.VarChar(64)
  uaPreview String? @map("ua_preview") @db.VarChar(120)

  /// Issued + expiry timestamps. Phase 26.5 expires state tokens
  /// after 10 minutes; the callback service rejects expired tokens
  /// with `SSO_STATE_EXPIRED`.
  issuedAtUtc      DateTime  @default(now()) @map("issued_at_utc") @db.Timestamptz(6)
  expiresAtUtc     DateTime  @map("expires_at_utc") @db.Timestamptz(6)
  consumedAtUtc    DateTime? @map("consumed_at_utc") @db.Timestamptz(6)
  consumedByUserId String?   @map("consumed_by_user_id") @db.Uuid

  /// On REPLAYED, the service stamps this with the second-attempt
  /// timestamp. Used by the suspicious-session detector + admin UI.
  replayDetectedAtUtc DateTime? @map("replay_detected_at_utc") @db.Timestamptz(6)

  /// Optional failure metadata. Operator-safe; no raw IdP error text.
  failureReason String? @map("failure_reason") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team          Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ssoConnection SsoConnection @relation(fields: [ssoConnectionId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([ssoConnectionId, status])
  @@index([expiresAtUtc])
  @@index([replayDetectedAtUtc])
  @@map("sso_callback_attempts")
}

model ScimGroup {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Operator-readable label.
  displayName String @map("display_name") @db.VarChar(180)

  /// IdP-side stable identifier. Required for SCIM PATCH targeting.
  externalId String? @map("external_id") @db.VarChar(180)

  /// The TeamMember.role this group projects onto. SCIM membership
  /// PATCH/PUT translates to TeamMember.role mutations on the
  /// referenced subjects via the Phase 17 RBAC service.
  /// Bounded VARCHAR so future roles can be added without a schema
  /// change; the SCIM service rejects unknown roles at the boundary.
  mappedRole String @map("mapped_role") @db.VarChar(24)

  /// ACTIVE | ARCHIVED. Phase 26.5 never hard-deletes a Group:
  /// SCIM DELETE marks ARCHIVED + reconciles membership.
  status String @default("ACTIVE") @db.VarChar(16)

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, externalId])
  @@unique([teamId, displayName, status])
  @@index([teamId, status])
  @@index([teamId, mappedRole])
  @@map("scim_groups")
}

// =============================================================================
// Phase 26.75 — Enterprise Identity Enforcement + Security Runtime Platform
// =============================================================================
//
// Adds one new model on top of Phase 26.5 + Phase 19. Most Phase 26.75
// hardening lives as additive columns on AuthenticatedSession +
// TrustedDevice (above); this table is the geo-intelligence cache.
//
// GeoIntelligenceLookup — bounded cache of IP-hash to country-code
// lookups. We NEVER persist a raw IP. The cache key is the same
// HMAC-SHA256 hash the trusted-device service uses (so the same hash
// can correlate sessions to country across the inventory).
//
// Hard rules:
//   - The provider is operator-selected via GEO_PROVIDER env.
//   - Lookups are bounded by GEO_LOOKUP_TIMEOUT_MS.
//   - Cache TTL is 30 days; the sweep job prunes expired rows.
//   - Country-code only. No region. No city. No coordinates.
// =============================================================================

model GeoIntelligenceLookup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// HMAC-SHA256 of the source IP (same hash the trusted-device
  /// service uses for `ipHash`). The raw IP is NEVER persisted.
  ipHash String @unique @map("ip_hash") @db.VarChar(64)

  /// ISO-3166 alpha-2 country code (e.g. "US"). Operator-readable.
  /// Provider lookups that fail return null and we still cache the
  /// null result (with a short TTL) to avoid retry storms.
  countryCode String? @map("country_code") @db.VarChar(8)

  /// Operator label: "maxmind" | "ip2location" | "offline_db" | etc.
  provider String @db.VarChar(32)

  /// Cache hit count — operator-visible signal for cache effectiveness.
  hitCount Int @default(0) @map("hit_count")

  /// Timestamps. `expiresAtUtc` drives the sweep job.
  resolvedAtUtc DateTime @default(now()) @map("resolved_at_utc") @db.Timestamptz(6)
  expiresAtUtc  DateTime @map("expires_at_utc") @db.Timestamptz(6)
  lastSeenAtUtc DateTime @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)

  @@index([countryCode])
  @@index([expiresAtUtc])
  @@map("geo_intelligence_lookups")
}

// =============================================================================
// Phase 27 — Enterprise Retention + Legal Hold + Compliance Lifecycle
// =============================================================================
//
// Adds four first-class governance models on top of the Phase 14 +
// 17 + 21 retention/hold/incident infrastructure. EvidenceLegalHold is
// the ONE source of truth for holds — the CaseLegalHold table this
// comment used to name alongside it was absorbed into it and dropped by
// 20271108000000_legal_hold_legacy_removal. This phase adds the policy
// versioning, destruction review queue, and lifecycle ledger.
//
//   1. RetentionPolicy — first-class versioned retention policy
//      object. The Phase 14 WorkspaceGovernancePolicy default-int
//      columns remain; RetentionPolicy is what operators bind to
//      specific evidence types, cases, regulatory profiles, etc.
//   2. RetentionPolicyVersion — append-only history of every policy
//      mutation. Diff'd, attributed, immutable.
//   3. DestructionReview — operator-approval queue for evidence whose
//      retention has expired. Destruction never happens without an
//      explicit approval row.
//   4. EvidenceLifecycleEvent — append-only ledger of every lifecycle
//      transition. The canonical audit signal for "what happened to
//      this evidence and when".
//
// Hard rules:
//   - Every row is team-scoped; cross-team writes are impossible at
//     the service boundary.
//   - Operator-facing fields are bounded VARCHARs. Legal reason text
//     stays in the existing EvidenceLegalHold.reason column.
//   - RetentionPolicy.archivedAt + status='SUPERSEDED' preserve
//     history; we never hard-delete a policy that ever applied.
//   - DestructionReview always references the active retention
//     policy version + the operator who initiated + the operator who
//     decided. NULL `decidedByUserId` means PENDING.
//   - EvidenceLifecycleEvent is insert-only. No update / delete.
//
// =============================================================================

model EvidenceRetentionPolicy {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Operator-readable label (e.g. "EU GDPR Standard 30d",
  /// "Insurance Claim 7y", "Litigation Hold Profile").
  displayName String @map("display_name") @db.VarChar(180)

  /// Optional description; never carries privileged legal text.
  description String? @db.VarChar(2000)

  /// ACTIVE | PAUSED | SUPERSEDED | ARCHIVED.
  status String @default("ACTIVE") @db.VarChar(16)

  /// Scope catalog: WORKSPACE | EVIDENCE_TYPE | CASE | REGULATORY.
  /// The route layer validates against `RETENTION_POLICY_SCOPES`.
  scope String @db.VarChar(24)

  /// When scope=EVIDENCE_TYPE: bounded catalog ("PHOTO", "VIDEO", "AUDIO", "DOCUMENT").
  /// When scope=REGULATORY: short jurisdiction code (e.g. "EU", "US-NY").
  /// NULL when scope=WORKSPACE.
  scopeQualifier String? @map("scope_qualifier") @db.VarChar(40)

  /// Optional case binding (when scope=CASE).
  caseId String? @map("case_id") @db.Uuid

  /// Effective retention window in days. NULL = indefinite.
  retentionDays Int? @map("retention_days")

  /// If true, the policy is IMMUTABLE — destruction is blocked even
  /// after retention expires. Operators must supersede the policy to
  /// destroy the evidence.
  immutable Boolean @default(false)

  /// If true, the retention sweep auto-extends the retention by
  /// `autoExtensionDays` whenever a new custody event lands on the
  /// covered evidence. Used for litigation profiles.
  autoExtensionEnabled Boolean @default(false) @map("auto_extension_enabled")
  autoExtensionDays    Int?    @map("auto_extension_days")

  /// Optional pointer at the next version (when superseded).
  supersededByPolicyId String? @map("superseded_by_policy_id") @db.Uuid

  /// Current version pointer. Every mutation appends a new
  /// RetentionPolicyVersion row and updates this pointer.
  currentVersion Int @default(1) @map("current_version")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAtUtc   DateTime? @map("archived_at_utc") @db.Timestamptz(6)

  team      Team                             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User                             @relation("EvidenceRetentionPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  versions  EvidenceRetentionPolicyVersion[] @relation("RetentionPolicyVersions")

  @@unique([teamId, displayName, status])
  @@index([teamId, status])
  @@index([teamId, scope])
  @@index([caseId])
  @@index([supersededByPolicyId])
  @@map("evidence_retention_policies")
}

model EvidenceRetentionPolicyVersion {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  retentionPolicyId String @map("retention_policy_id") @db.Uuid
  /// Monotonic version index. (policyId, version) is unique.
  version           Int

  /// Frozen snapshot of the policy at this version. The current
  /// columns on RetentionPolicy are the LATEST; the snapshot is the
  /// canonical "what did the policy say on this date".
  retentionDays        Int?    @map("retention_days")
  immutable            Boolean @default(false)
  autoExtensionEnabled Boolean @default(false) @map("auto_extension_enabled")
  autoExtensionDays    Int?    @map("auto_extension_days")

  /// Structured diff against the previous version (operator-readable
  /// JSON blob). Never carries privileged text.
  diffJson Json? @map("diff_json")

  /// Authoring metadata.
  authoredByUserId String   @map("authored_by_user_id") @db.Uuid
  changeNote       String?  @map("change_note") @db.VarChar(2000)
  authoredAtUtc    DateTime @default(now()) @map("authored_at_utc") @db.Timestamptz(6)

  retentionPolicy EvidenceRetentionPolicy @relation("RetentionPolicyVersions", fields: [retentionPolicyId], references: [id], onDelete: Cascade)
  authoredBy      User                    @relation("EvidenceRetentionPolicyVersionAuthor", fields: [authoredByUserId], references: [id], onDelete: Cascade)

  @@unique([retentionPolicyId, version])
  @@index([retentionPolicyId, authoredAtUtc(sort: Desc)])
  @@map("evidence_retention_policy_versions")
}

model DestructionReview {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String @map("team_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid

  /// Snapshot of the retention policy that triggered the review.
  retentionPolicyId      String? @map("retention_policy_id") @db.Uuid
  retentionPolicyVersion Int?    @map("retention_policy_version")

  /// PENDING | UNDER_REVIEW | APPROVED | DENIED | DEFERRED | RESTORED |
  /// EXECUTED | CANCELLED.
  status String @default("PENDING") @db.VarChar(16)

  /// Why the review was created (operator-readable, bounded).
  /// Catalog: "retention_expired", "manual_review", "policy_supersede".
  reason String @db.VarChar(64)

  /// Operator-supplied decision note (required for APPROVED/DENIED/RESTORED).
  decisionNote String? @map("decision_note") @db.VarChar(2000)

  /// Optional defer window. When set, the queue does not surface the
  /// row until the timestamp is reached.
  deferredUntilUtc DateTime? @map("deferred_until_utc") @db.Timestamptz(6)

  /// Lifecycle actors.
  initiatedByUserId String?   @map("initiated_by_user_id") @db.Uuid
  decidedByUserId   String?   @map("decided_by_user_id") @db.Uuid
  decidedAtUtc      DateTime? @map("decided_at_utc") @db.Timestamptz(6)

  /// When destruction was actually performed (after APPROVED →
  /// EXECUTED transition). Generates a destruction certificate.
  executedAtUtc   DateTime? @map("executed_at_utc") @db.Timestamptz(6)
  /// Hash of the destruction certificate JSON. The certificate
  /// itself lives on the EvidenceLifecycleEvent row.
  certificateHash String?   @map("certificate_hash") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence    Evidence @relation("DestructionReviewEvidence", fields: [evidenceId], references: [id], onDelete: Cascade)
  initiatedBy User?    @relation("DestructionReviewInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  decidedBy   User?    @relation("DestructionReviewDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  // Phase 27.5 — per-execution-attempt state.
  executions DestructionExecution[] @relation("DestructionExecutionReview")

  /// Only one active (PENDING / UNDER_REVIEW / DEFERRED) review per
  /// evidence at a time. Service layer enforces the membership
  /// check; the unique constraint here protects against races.
  @@index([teamId, status])
  @@index([evidenceId, createdAt(sort: Desc)])
  @@index([retentionPolicyId])
  @@index([deferredUntilUtc])
  @@map("destruction_reviews")
}

model EvidenceLifecycleEvent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String @map("team_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid

  /// EvidenceLifecycleState before + after the transition. NULL
  /// fromState means "first event" (creation).
  fromState String? @map("from_state") @db.VarChar(24)
  toState   String  @map("to_state") @db.VarChar(24)

  /// Catalog: "lifecycle_transition" | "retention_applied" |
  /// "retention_recomputed" | "hold_placed" | "hold_released" |
  /// "destruction_review_created" | "destruction_review_approved" |
  /// "destruction_review_denied" | "destruction_executed" |
  /// "policy_attached" | "policy_superseded" | "archive_requested" |
  /// "restore_requested".
  eventType String @map("event_type") @db.VarChar(48)

  /// Operator-readable summary; never carries privileged legal text.
  summary String @db.VarChar(400)

  /// Bounded operator metadata. JSON blob; the service scrubs any
  /// known-sensitive keys before persisting.
  metadata Json?

  /// Actor + provenance.
  actorUserId String? @map("actor_user_id") @db.Uuid
  requestId   String? @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence Evidence @relation("EvidenceLifecycleEvents", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([evidenceId, createdAt(sort: Desc)])
  @@index([teamId, eventType])
  @@index([teamId, toState])
  @@map("evidence_lifecycle_events")
}

// =============================================================================
// Phase 27.5 — Governance operationalization
//
// Append-only operational state. Every worker run, every destruction
// attempt, every immutable-storage drift check, every governance
// notification dispatch, and every compliance export lineage snapshot
// gets a row here. These tables are the operational substrate that
// turns Phase 27's configured governance into an enforceable runtime.
//
// Hard rules:
//   - Forward-only. No row is ever deleted by the platform. Operators
//     archive (status flip) and append.
//   - Idempotent. Workers MUST be safe to re-run on the same input.
//   - Dedupe-keyed where relevant (notifications, immutable checks).
// =============================================================================

enum GovernanceReconciliationKind {
  RETENTION
  IMMUTABLE_STORAGE
  LIFECYCLE_DRIFT
  DESTRUCTION_SWEEP
  /// Search index reconciliation for one workspace. Shares this authority
  /// deliberately: a second run table would be a second lock, and two locks
  /// over one population exclude nothing.
  SEARCH_INDEX
}

enum GovernanceReconciliationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

model GovernanceReconciliationRun {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String? @map("team_id") @db.Uuid

  kind    GovernanceReconciliationKind
  trigger String                         @db.VarChar(32)
  status  GovernanceReconciliationStatus @default(RUNNING)

  startedAtUtc      DateTime  @default(now()) @map("started_at_utc") @db.Timestamptz(6)
  finishedAtUtc     DateTime? @map("finished_at_utc") @db.Timestamptz(6)
  /// Logical lock key — used by `acquireRunLock` to refuse a second
  /// concurrent run of the same kind for the same team.
  lockKey           String    @map("lock_key") @db.VarChar(128)
  triggeredByUserId String?   @map("triggered_by_user_id") @db.Uuid

  scannedCount  Int @default(0) @map("scanned_count")
  matchedCount  Int @default(0) @map("matched_count")
  createdCount  Int @default(0) @map("created_count")
  skippedCount  Int @default(0) @map("skipped_count")
  failedCount   Int @default(0) @map("failed_count")
  incidentCount Int @default(0) @map("incident_count")

  errorSummary String? @map("error_summary") @db.VarChar(2000)
  metadata     Json?

  team        Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  triggeredBy User? @relation("GovernanceReconciliationRunTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, kind, startedAtUtc(sort: Desc)])
  @@index([kind, status])
  @@index([lockKey])
  @@map("governance_reconciliation_runs")
}

enum DestructionExecutionStatus {
  PLANNED
  EXECUTING
  STORAGE_DELETED
  TOMBSTONED
  COMPLETED
  FAILED
  ROLLED_BACK
}

model DestructionExecution {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId              String @map("team_id") @db.Uuid
  evidenceId          String @map("evidence_id") @db.Uuid
  destructionReviewId String @map("destruction_review_id") @db.Uuid

  status DestructionExecutionStatus @default(PLANNED)
  /// Operator-readable phase string, complementing the enum. The
  /// orchestrator updates this on every phase boundary so the UI can
  /// show a meaningful progress label even on terminal failure.
  phase  String                     @db.VarChar(48)

  attemptCount        Int       @default(0) @map("attempt_count")
  plannedAtUtc        DateTime  @default(now()) @map("planned_at_utc") @db.Timestamptz(6)
  startedAtUtc        DateTime? @map("started_at_utc") @db.Timestamptz(6)
  storageDeletedAtUtc DateTime? @map("storage_deleted_at_utc") @db.Timestamptz(6)
  tombstonedAtUtc     DateTime? @map("tombstoned_at_utc") @db.Timestamptz(6)
  completedAtUtc      DateTime? @map("completed_at_utc") @db.Timestamptz(6)
  failedAtUtc         DateTime? @map("failed_at_utc") @db.Timestamptz(6)
  rolledBackAtUtc     DateTime? @map("rolled_back_at_utc") @db.Timestamptz(6)

  executedByUserId String? @map("executed_by_user_id") @db.Uuid
  /// SHA-256 of the canonical destruction certificate body. Mirrored on
  /// the DestructionReview row for cross-reference.
  certificateHash  String? @map("certificate_hash") @db.VarChar(128)
  /// Lineage hash — chains the certificate + previous lifecycle ledger
  /// digest so an operator can prove "this destruction happened in this
  /// order against this prior state".
  lineageHash      String? @map("lineage_hash") @db.VarChar(128)

  errorCode   String? @map("error_code") @db.VarChar(64)
  errorDetail String? @map("error_detail") @db.VarChar(2000)
  metadata    Json?

  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence          Evidence          @relation("DestructionExecutionEvidence", fields: [evidenceId], references: [id], onDelete: Cascade)
  destructionReview DestructionReview @relation("DestructionExecutionReview", fields: [destructionReviewId], references: [id], onDelete: Cascade)
  executedBy        User?             @relation("DestructionExecutionExecutedBy", fields: [executedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([destructionReviewId, status])
  @@index([evidenceId, status])
  @@index([plannedAtUtc(sort: Desc)])
  @@map("destruction_executions")
}

enum ImmutableStorageCheckOutcome {
  OK
  MISSING_LOCK
  RETENTION_MISMATCH
  LEGAL_HOLD_MISMATCH
  COMPLIANCE_MODE_MISMATCH
  STORAGE_UNAVAILABLE
  EVIDENCE_NOT_FOUND
}

model ImmutableStorageCheck {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String @map("team_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid

  outcome      ImmutableStorageCheckOutcome @default(OK)
  checkedAtUtc DateTime                     @default(now()) @map("checked_at_utc") @db.Timestamptz(6)

  /// What the DB thought at check time.
  dbRetentionUntilUtc DateTime? @map("db_retention_until_utc") @db.Timestamptz(6)
  dbLegalHoldActive   Boolean   @default(false) @map("db_legal_hold_active")
  dbImmutable         Boolean   @default(false) @map("db_immutable")

  /// What the storage layer (S3 Object Lock / equivalent) reported.
  storageRetainUntilUtc  DateTime? @map("storage_retain_until_utc") @db.Timestamptz(6)
  storageLegalHoldActive Boolean?  @map("storage_legal_hold_active")
  storageComplianceMode  String?   @map("storage_compliance_mode") @db.VarChar(32)

  /// Optional pointer to the operational incident raised on drift. NULL
  /// when outcome=OK or when incident creation is suppressed.
  raisedIncidentId String? @map("raised_incident_id") @db.Uuid
  driftSummary     String? @map("drift_summary") @db.VarChar(400)
  metadata         Json?

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence Evidence @relation("ImmutableStorageCheckEvidence", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([teamId, outcome, checkedAtUtc(sort: Desc)])
  @@index([evidenceId, checkedAtUtc(sort: Desc)])
  @@index([raisedIncidentId])
  @@map("immutable_storage_checks")
}

enum GovernanceNotificationKind {
  DESTRUCTION_PENDING
  DESTRUCTION_APPROVED
  DESTRUCTION_EXECUTED
  DESTRUCTION_BLOCKED
  LEGAL_HOLD_PLACED
  LEGAL_HOLD_RELEASED
  RETENTION_CONFLICT
  RETENTION_EXTENSION_APPLIED
  LIFECYCLE_DRIFT
  IMMUTABLE_RECONCILIATION_FAILURE
  GOVERNANCE_INCIDENT_RAISED
  EXPORT_BLOCKED
  POLICY_OVERRIDE
  REVIEW_OVERDUE
}

enum GovernanceNotificationSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum GovernanceNotificationDeliveryStatus {
  PENDING
  SENT
  SUPPRESSED
  FAILED
}

model GovernanceNotification {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  kind      GovernanceNotificationKind
  severity  GovernanceNotificationSeverity @default(INFO)
  /// Stable fingerprint — `(teamId, kind, dedupeKey)` is unique. A
  /// second emission with the same dedupeKey increments
  /// `occurrenceCount` and refreshes `lastSeenAtUtc` instead of
  /// creating a duplicate row.
  dedupeKey String                         @map("dedupe_key") @db.VarChar(180)

  title   String @db.VarChar(200)
  summary String @db.VarChar(1000)

  relatedEvidenceId String? @map("related_evidence_id") @db.Uuid
  relatedReviewId   String? @map("related_review_id") @db.Uuid
  relatedHoldId     String? @map("related_hold_id") @db.Uuid
  relatedPolicyId   String? @map("related_policy_id") @db.Uuid
  relatedIncidentId String? @map("related_incident_id") @db.Uuid

  firstSeenAtUtc  DateTime @default(now()) @map("first_seen_at_utc") @db.Timestamptz(6)
  lastSeenAtUtc   DateTime @default(now()) @map("last_seen_at_utc") @db.Timestamptz(6)
  occurrenceCount Int      @default(1) @map("occurrence_count")

  deliveryStatus    GovernanceNotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int                                  @default(0) @map("delivery_attempts")
  lastDeliveryAtUtc DateTime?                            @map("last_delivery_at_utc") @db.Timestamptz(6)
  /// Bounded operator catalog — "email", "webhook", "in_app". Future
  /// channels are added to the catalog, not invented per emission.
  channels          String[]                             @default([])
  /// Recipient operator user IDs (preference-aware). May be empty when
  /// the notification is workspace-wide (e.g. dashboards-only).
  recipientUserIds  String[]                             @default([]) @map("recipient_user_ids") @db.Uuid

  acknowledgedAtUtc    DateTime? @map("acknowledged_at_utc") @db.Timestamptz(6)
  acknowledgedByUserId String?   @map("acknowledged_by_user_id") @db.Uuid

  metadata Json?

  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  relatedEvidence Evidence? @relation("GovernanceNotificationEvidence", fields: [relatedEvidenceId], references: [id], onDelete: SetNull)

  @@unique([teamId, kind, dedupeKey])
  @@index([teamId, deliveryStatus])
  @@index([teamId, kind, lastSeenAtUtc(sort: Desc)])
  @@index([teamId, severity, lastSeenAtUtc(sort: Desc)])
  @@index([relatedEvidenceId])
  @@map("governance_notifications")
}

enum GovernanceExportSnapshotKind {
  EVIDENCE_PACKAGE
  CASE_EXPORT
  AUDIT_EXPORT
  COMPLIANCE_BUNDLE
}

model GovernanceExportSnapshot {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId     String  @map("team_id") @db.Uuid
  evidenceId String? @map("evidence_id") @db.Uuid

  snapshotKind    GovernanceExportSnapshotKind @map("snapshot_kind")
  createdByUserId String?                      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Frozen governance state at the moment of export.
  lifecycleState           String   @map("lifecycle_state") @db.VarChar(24)
  retentionPolicyVersionId String?  @map("retention_policy_version_id") @db.Uuid
  activeHoldIds            String[] @default([]) @map("active_hold_ids") @db.Uuid
  governanceIncidentIds    String[] @default([]) @map("governance_incident_ids") @db.Uuid

  /// Catalog-bound result. "ALLOWED" snapshots are still recorded so
  /// the operator has a frozen audit of every export that left the
  /// workspace, not only blocked ones.
  exportEligibilityOutcome String @map("export_eligibility_outcome") @db.VarChar(40)
  exportEligibilityReason  String @map("export_eligibility_reason") @db.VarChar(120)

  /// SHA-256 of the canonical snapshot payload JSON. Stable and
  /// reproducible from the payload.
  snapshotHash    String @map("snapshot_hash") @db.VarChar(128)
  /// Canonical JSON body. Bounded by the writer; never carries
  /// privileged legal text.
  snapshotPayload Json   @map("snapshot_payload")

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence  Evidence? @relation("GovernanceExportSnapshotEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("GovernanceExportSnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([evidenceId, createdAt(sort: Desc)])
  @@index([teamId, snapshotKind, createdAt(sort: Desc)])
  @@index([snapshotHash])
  @@map("governance_export_snapshots")
}

// =============================================================================
// Phase 32.8C++++ — Dashboard Intelligence Closure
// =============================================================================

/// EvidenceIntegritySnapshot — durable advisory mirror of the worker's
/// integrity classifier output for an evidence record. 1:1 with Evidence
/// (unique evidenceId). This is an ADVISORY operational snapshot — failures
/// in writing must NEVER block evidence/report/package core flows.
///
/// The dashboard reads this table for fast custody/integrity intelligence.
/// When the row is missing (older evidence or unsupported state), the
/// dashboard falls back to deriving signals from Evidence.verificationStatus
/// + TSA/OTS columns. No legal-admissibility claim is ever stored here.
model EvidenceIntegritySnapshot {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId String  @unique @map("evidence_id") @db.Uuid
  teamId     String? @map("team_id") @db.Uuid

  /// nullable tri-state — true = matches, false = mismatch reported,
  /// null = signal not computed/unavailable.
  canonicalHashMatches   Boolean? @map("canonical_hash_matches")
  signatureValid         Boolean? @map("signature_valid")
  custodyChainValid      Boolean? @map("custody_chain_valid")
  timestampDigestMatches Boolean? @map("timestamp_digest_matches")
  otsHashMatches         Boolean? @map("ots_hash_matches")

  /// Bounded operator-facing string label for TSA/OTS state. Examples:
  /// "OK" | "PENDING" | "UNAVAILABLE" | "FAILED" | null. Worker is the
  /// source of truth — the dashboard never asserts these from raw bytes.
  tsaStatus String? @map("tsa_status") @db.VarChar(24)
  otsStatus String? @map("ots_status") @db.VarChar(24)

  /// Bounded summary: "OK" | "REVIEW_REQUIRED" | "FAILED" | "UNKNOWN".
  /// The dashboard's "deep integrity watch" filters on this column when
  /// present (faster than reading 5 columns + cross-relation joins).
  overallStatus String? @map("overall_status") @db.VarChar(24)

  /// Catalog of bounded reason codes (e.g., TSA_UNAVAILABLE, OTS_FAILED,
  /// PACKAGE_BLOCKED). Stored as JSON to allow multi-reason rows without
  /// schema thrash. Operators never see raw exception text from here.
  reasonCodes Json? @map("reason_codes")

  /// Snapshot lineage so dashboards can show "computed N hours ago" and
  /// detect stale advisory rows that need recomputation.
  computedAtUtc DateTime @default(now()) @map("computed_at_utc") @db.Timestamptz(6)
  sourceVersion String?  @map("source_version") @db.VarChar(32)

  /// Phase 32.8C+++++ — TSA issuer parsing fields. Worker parses if a
  /// token + parser are available; UNAVAILABLE by default. Never faked.
  tsaIssuerCommonName   String?   @map("tsa_issuer_common_name") @db.VarChar(200)
  tsaIssuerOrganization String?   @map("tsa_issuer_organization") @db.VarChar(200)
  tsaPolicyOid          String?   @map("tsa_policy_oid") @db.VarChar(80)
  /// Bounded enum-like string: "PARSED" | "UNAVAILABLE" | "FAILED" | null.
  tsaParseStatus        String?   @map("tsa_parse_status") @db.VarChar(24)
  /// Operator-safe parse error code, bounded length.
  tsaParseErrorCode     String?   @map("tsa_parse_error_code") @db.VarChar(80)
  tsaParsedAtUtc        DateTime? @map("tsa_parsed_at_utc") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation("EvidenceIntegritySnapshot", fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([teamId, overallStatus])
  @@index([computedAtUtc(sort: Desc)])
  @@index([overallStatus])
  @@map("evidence_integrity_snapshots")
}

/// AccessAnomaly — persisted output of the security/access anomaly
/// classifier. Each row represents a CLASSIFIED burst of SecurityEvent
/// rows over a bounded window. The dashboard reads these directly;
/// re-classification runs on a schedule (advisory operational data, not
/// a source-of-truth security log).
model AccessAnomaly {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String  @map("team_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  evidenceId  String? @map("evidence_id") @db.Uuid
  caseId      String? @map("case_id") @db.Uuid

  category AccessAnomalyCategory
  severity AccessAnomalySeverity @default(WARNING)
  status   AccessAnomalyStatus   @default(OPEN)

  /// Sample eventType used by the classifier when grouping events.
  sampleEventType String @map("sample_event_type") @db.VarChar(80)
  count           Int    @default(1)

  windowStartUtc DateTime @map("window_start_utc") @db.Timestamptz(6)
  windowEndUtc   DateTime @map("window_end_utc") @db.Timestamptz(6)

  /// Bounded array of SecurityEvent IDs the classifier folded into this
  /// row. Stored as JSON to avoid creating a join table for a small
  /// advisory snapshot.
  sourceEventIds Json? @map("source_event_ids")

  /// Operator-safe single-line summary computed by the classifier.
  summary String? @db.VarChar(400)

  acknowledgedAtUtc    DateTime? @map("acknowledged_at_utc") @db.Timestamptz(6)
  acknowledgedByUserId String?   @map("acknowledged_by_user_id") @db.Uuid
  resolvedAtUtc        DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolvedByUserId     String?   @map("resolved_by_user_id") @db.Uuid
  resolutionNote       String?   @map("resolution_note") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation("AccessAnomalyEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([teamId, category])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([evidenceId])
  @@index([severity])
  @@map("access_anomalies")
}

enum AccessAnomalyCategory {
  REPEATED_FAILED_ACCESS
  BLOCKED_EXPORT_ATTEMPT
  API_CREDENTIAL_CHANGE
  WEBHOOK_FAILURE_SPIKE
  ADMIN_ROLE_CHANGE
  STEP_UP_FAILED
  PERMISSION_DENIED_BURST
  UNCATEGORIZED
}

enum AccessAnomalySeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum AccessAnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

// =============================================================================
// Phase 32.8C+++++ — Dashboard Structural Intelligence Closure
//
// Five durable intelligence sources:
//   * QueueTelemetrySnapshot     — bounded sample of queue depth/backlog
//   * WorkerTelemetrySnapshot    — bounded worker heartbeat/status sample
//   * CaseEvidenceLink           — many-to-many case ↔ evidence linkage
//   * OperationalTimelineEvent   — normalized projection of system timeline
//   * CaseComment                — case-level coordination signal
//
// All five are ADVISORY operational data. Writer failures NEVER block core
// evidence/report/package/verify flows — callers wrap invocations in
// .catch(() => {}).
//
// Two field additions extend existing snapshots with TSA issuer metadata:
//   * EvidenceIntegritySnapshot.tsaIssuerCommonName / Organization /
//     PolicyOid / parseStatus / parseErrorCode
//     (Worker parses if possible; UNAVAILABLE by default — never faked.)
// =============================================================================

enum QueueTelemetryDomain {
  REPORT
  PACKAGE
  REVIEW
  GOVERNANCE
  INTAKE
  WORKER
  OTHER
}

enum QueueTelemetrySource {
  BULLMQ
  DB_DERIVED
  WORKER_INTERNAL
  OTHER
}

model QueueTelemetrySnapshot {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String?              @map("team_id") @db.Uuid
  queueName   String               @map("queue_name") @db.VarChar(80)
  queueDomain QueueTelemetryDomain @map("queue_domain")

  waitingCount   Int  @default(0) @map("waiting_count")
  activeCount    Int  @default(0) @map("active_count")
  delayedCount   Int  @default(0) @map("delayed_count")
  failedCount    Int  @default(0) @map("failed_count")
  completedCount Int? @map("completed_count")
  retryCount     Int  @default(0) @map("retry_count")
  stalledCount   Int  @default(0) @map("stalled_count")

  oldestJobAgeMs Int? @map("oldest_job_age_ms")
  latestJobAgeMs Int? @map("latest_job_age_ms")

  sampledAtUtc DateTime             @default(now()) @map("sampled_at_utc") @db.Timestamptz(6)
  source       QueueTelemetrySource @default(DB_DERIVED)
  metadataJson Json?                @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([queueName, sampledAtUtc(sort: Desc)])
  @@index([queueDomain, sampledAtUtc(sort: Desc)])
  @@index([teamId, sampledAtUtc(sort: Desc)])
  @@map("queue_telemetry_snapshots")
}

enum WorkerTelemetryKind {
  API
  WORKER
  REPORT
  PACKAGE
  REVIEWER_RECONCILE
  OTS
  TSA
  OTHER
}

enum WorkerTelemetryStatus {
  HEALTHY
  DEGRADED
  CRITICAL
  UNKNOWN
}

model WorkerTelemetrySnapshot {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId   String                @map("worker_id") @db.VarChar(120)
  workerKind WorkerTelemetryKind   @map("worker_kind")
  status     WorkerTelemetryStatus @default(UNKNOWN)

  heartbeatAtUtc         DateTime  @default(now()) @map("heartbeat_at_utc") @db.Timestamptz(6)
  lastSuccessfulRunAtUtc DateTime? @map("last_successful_run_at_utc") @db.Timestamptz(6)
  lastFailedRunAtUtc     DateTime? @map("last_failed_run_at_utc") @db.Timestamptz(6)
  lastErrorCode          String?   @map("last_error_code") @db.VarChar(80)
  /// Bounded length — operator-safe error summary only. No raw stack traces.
  lastErrorMessage       String?   @map("last_error_message") @db.VarChar(400)

  processedCount Int? @map("processed_count")
  failedCount    Int? @map("failed_count")
  durationMs     Int? @map("duration_ms")

  metadataJson Json? @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workerKind, heartbeatAtUtc(sort: Desc)])
  @@index([status, heartbeatAtUtc(sort: Desc)])
  @@index([workerId, heartbeatAtUtc(sort: Desc)])
  @@map("worker_telemetry_snapshots")
}

enum CaseEvidenceLinkRole {
  PRIMARY
  SUPPORTING
  RELATED
  DUPLICATE
  DERIVED
  CONTEXT
}

enum CaseEvidenceLinkSource {
  USER
  SYSTEM
  IMPORT
  INTAKE
  WORKFLOW
}

/// CaseEvidenceLink — many-to-many evidence ↔ case linkage. This table
/// is the ONE case↔evidence relationship authority. The legacy
/// `Evidence.caseId` singular column was dropped by migration
/// 20271105000000_evidence_case_id_removal; every read and write goes
/// through this table.
model CaseEvidenceLink {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Track 1B — nullable: personal-workspace cases have `teamId = null`
  /// (mirrors Case.teamId / Evidence.teamId). Was NOT NULL, which made it
  /// impossible to represent a personal-scope link; relaxed by migration
  /// 20271103000000_case_evidence_link_canonical.
  teamId     String? @map("team_id") @db.Uuid
  caseId     String  @map("case_id") @db.Uuid
  evidenceId String  @map("evidence_id") @db.Uuid

  role   CaseEvidenceLinkRole   @default(SUPPORTING)
  source CaseEvidenceLinkSource @default(USER)

  linkedByUserId String?  @map("linked_by_user_id") @db.Uuid
  linkedAtUtc    DateTime @default(now()) @map("linked_at_utc") @db.Timestamptz(6)
  /// Bounded operator-safe reason. Never raw evidence contents.
  reason         String?  @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, evidenceId, role])
  @@index([teamId, linkedAtUtc(sort: Desc)])
  @@index([caseId])
  @@index([evidenceId])
  @@index([role])
  @@map("case_evidence_links")
}

enum OperationalTimelineFamily {
  EVIDENCE
  CASE
  CUSTODY
  REPORT
  PACKAGE
  REVIEW
  GOVERNANCE
  SECURITY
  OPS
  EXPORT
  SYSTEM
}

enum OperationalTimelineConfidence {
  DIRECT
  INFERRED
}

/// OperationalTimelineEvent — normalized projection of system timeline.
/// The projection writer reads from existing source tables (CustodyEvent,
/// AdminAuditLog, OperationalIncident, EvidenceLifecycleEvent, etc.) and
/// folds them into a bounded operator-safe row. Dashboard reads from
/// this table directly; falls back to live aggregation when empty.
model OperationalTimelineEvent {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String? @map("team_id") @db.Uuid
  caseId      String? @map("case_id") @db.Uuid
  evidenceId  String? @map("evidence_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  eventFamily OperationalTimelineFamily @map("event_family")
  eventType   String                    @map("event_type") @db.VarChar(80)
  /// Bounded severity tag (e.g., INFO, WARNING, HIGH, CRITICAL).
  severity    String                    @db.VarChar(24)

  occurredAtUtc DateTime @map("occurred_at_utc") @db.Timestamptz(6)

  /// Source table name (e.g., "custody_events", "admin_audit_log").
  sourceTable String @map("source_table") @db.VarChar(80)
  /// Source row primary key (uuid string).
  sourceId    String @map("source_id") @db.VarChar(80)

  confidence    OperationalTimelineConfidence @default(DIRECT)
  /// Whether the projection can be safely surfaced to operators.
  safeToDisplay Boolean                       @default(true) @map("safe_to_display")

  /// Bounded operator-safe summary, ≤ 400 chars.
  summary      String  @db.VarChar(400)
  /// Optional in-app route operators can follow.
  route        String? @db.VarChar(400)
  metadataJson Json?   @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sourceTable, sourceId, eventType], name: "operational_timeline_source_uniq")
  @@index([teamId, occurredAtUtc(sort: Desc)])
  @@index([caseId, occurredAtUtc(sort: Desc)])
  @@index([evidenceId, occurredAtUtc(sort: Desc)])
  @@index([eventFamily, occurredAtUtc(sort: Desc)])
  @@index([occurredAtUtc(sort: Desc)])
  @@map("operational_timeline_events")
}

enum CaseCommentVisibility {
  INTERNAL
  REVIEWERS
  ALL_MEMBERS
}

/// CaseComment — case-level coordination. Mirrors the EvidenceReviewerComment
/// pattern but on a case row rather than an evidence row. Used for
/// coordination intelligence on the dashboard.
model CaseComment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String @map("team_id") @db.Uuid
  caseId       String @map("case_id") @db.Uuid
  authorUserId String @map("author_user_id") @db.Uuid

  /// Bounded operator-safe body. Never raw evidence contents.
  body       String                @db.VarChar(4000)
  visibility CaseCommentVisibility @default(REVIEWERS)

  resolvedAtUtc    DateTime? @map("resolved_at_utc") @db.Timestamptz(6)
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teamId, createdAt(sort: Desc)])
  @@index([caseId, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@index([resolvedAtUtc])
  @@map("case_comments")
}

// =============================================================================
// Phase 32.8C FINAL-2 — Workflow Orchestration Engine
//
// First-class operational workflow layer. Distinct from EvidenceReviewWorkflow
// (which is reviewer-side review lifecycle); these rows are platform-level
// operational tasks: report retry, package retry, governance escalation,
// queue recovery, integrity review, audit readiness, case-risk mitigation,
// coordination resolution, export blocker resolution.
//
// Hard rules:
//   - Generator failures NEVER block evidence / report / package / verify
//     core flows. Workflow creation is wrapped in try/catch by callers.
//   - workflowKey is idempotent per (teamId, source, type) — re-detecting
//     the same condition collapses into the existing row.
//   - Bounded operator-safe summaries only — no raw payloads, no signed
//     URLs, no secrets.
// =============================================================================

enum OperationalWorkflowType {
  REPORT_RETRY
  PACKAGE_RETRY
  REVIEW_ESCALATION
  GOVERNANCE_ESCALATION
  QUEUE_RECOVERY
  TELEMETRY_RECOVERY
  INTEGRITY_REVIEW
  AUDIT_READINESS
  CASE_RISK_MITIGATION
  COORDINATION_RESOLUTION
  EXPORT_BLOCKER_RESOLUTION
  OTHER
}

enum OperationalWorkflowStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_SYSTEM
  WAITING_ON_REVIEWER
  WAITING_ON_GOVERNANCE
  MITIGATING
  RESOLVED
  SUPPRESSED
  FAILED
}

enum OperationalWorkflowSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OperationalWorkflowPriority {
  P0
  P1
  P2
  P3
}

enum OperationalWorkflowEventType {
  CREATED
  ASSIGNED
  STARTED
  RETRY_SCHEDULED
  RETRY_ATTEMPTED
  ESCALATED
  MITIGATION_ADDED
  STATUS_CHANGED
  RESOLVED
  SUPPRESSED
  FAILED
  REOPENED
}

enum OperationalWorkflowActionType {
  ASSIGN
  START
  SCHEDULE_RETRY
  RECORD_RETRY_FAILURE
  ESCALATE
  ADD_MITIGATION
  RESOLVE
  SUPPRESS
  REOPEN
}

model OperationalWorkflow {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Idempotent key per (team, source, type). The generator upserts
  /// against this unique constraint.
  workflowKey  String                      @map("workflow_key") @db.VarChar(200)
  workflowType OperationalWorkflowType     @map("workflow_type")
  status       OperationalWorkflowStatus   @default(OPEN)
  severity     OperationalWorkflowSeverity @default(MEDIUM)
  priority     OperationalWorkflowPriority @default(P2)

  title       String @db.VarChar(180)
  /// Bounded operator-safe summary. Never raw payloads.
  safeSummary String @map("safe_summary") @db.VarChar(400)

  /// Source linkage — every workflow ties back to a real platform row.
  sourceIncidentId    String? @map("source_incident_id") @db.Uuid
  sourceCorrelationId String? @map("source_correlation_id") @db.Uuid
  caseId              String? @map("case_id") @db.Uuid
  evidenceId          String? @map("evidence_id") @db.Uuid
  queueName           String? @map("queue_name") @db.VarChar(80)

  /// Ownership lifecycle.
  assignedOwnerUserId String?   @map("assigned_owner_user_id") @db.Uuid
  assignedByUserId    String?   @map("assigned_by_user_id") @db.Uuid
  assignedAtUtc       DateTime? @map("assigned_at_utc") @db.Timestamptz(6)

  /// Escalation + retry state.
  escalationLevel  Int       @default(0) @map("escalation_level")
  retryCount       Int       @default(0) @map("retry_count")
  nextRetryAtUtc   DateTime? @map("next_retry_at_utc") @db.Timestamptz(6)
  lastAttemptAtUtc DateTime? @map("last_attempt_at_utc") @db.Timestamptz(6)
  lastFailureCode  String?   @map("last_failure_code") @db.VarChar(80)

  /// Bounded operator-safe notes.
  mitigationSummary String? @map("mitigation_summary") @db.VarChar(400)
  resolutionSummary String? @map("resolution_summary") @db.VarChar(400)

  dueAtUtc      DateTime? @map("due_at_utc") @db.Timestamptz(6)
  resolvedAtUtc DateTime? @map("resolved_at_utc") @db.Timestamptz(6)

  metadataJson Json? @map("metadata_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events  OperationalWorkflowEvent[]
  actions OperationalWorkflowAction[]

  @@unique([teamId, workflowKey])
  @@index([teamId, status])
  @@index([teamId, workflowType])
  @@index([severity, status])
  @@index([assignedOwnerUserId, status])
  @@index([dueAtUtc])
  @@index([sourceIncidentId])
  @@index([sourceCorrelationId])
  @@index([caseId])
  @@index([evidenceId])
  @@index([queueName])
  @@map("operational_workflows")
}

model OperationalWorkflowEvent {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId    String                       @map("workflow_id") @db.Uuid
  teamId        String                       @map("team_id") @db.Uuid
  eventType     OperationalWorkflowEventType @map("event_type")
  actorUserId   String?                      @map("actor_user_id") @db.Uuid
  fromStatus    OperationalWorkflowStatus?   @map("from_status")
  toStatus      OperationalWorkflowStatus?   @map("to_status")
  /// Bounded operator-safe one-line summary.
  summary       String                       @db.VarChar(400)
  metadataJson  Json?                        @map("metadata_json")
  occurredAtUtc DateTime                     @default(now()) @map("occurred_at_utc") @db.Timestamptz(6)

  workflow OperationalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, occurredAtUtc(sort: Desc)])
  @@index([teamId, occurredAtUtc(sort: Desc)])
  @@index([eventType])
  @@map("operational_workflow_events")
}

model OperationalWorkflowAction {
  id                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId         String                        @map("workflow_id") @db.Uuid
  teamId             String                        @map("team_id") @db.Uuid
  actionType         OperationalWorkflowActionType @map("action_type")
  /// Permission key required to execute this action (bounded enum-like
  /// string referencing the routing catalog's known permission set).
  permissionRequired String                        @map("permission_required") @db.VarChar(80)
  /// JSON array of role names allowed to execute this action.
  requiredRoles      Json                          @map("required_roles")
  safeActionLabel    String                        @map("safe_action_label") @db.VarChar(80)
  route              String?                       @db.VarChar(400)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  workflow OperationalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([teamId, actionType])
  @@map("operational_workflow_actions")
}

// =============================================================================
// Phase 32.8C FINAL-2 — Operational Causality Engine
//
// Deterministic causality links + chains. Detects N >= 2 related operational
// events / incidents / workflows and groups them under a "why is this
// happening?" view. Every link is a bounded enum relation; chains are
// idempotent by chainKey.
//
// Hard rules:
//   - No fake root-cause text. Every chain summary is constructed from real
//     linked entity types + counts.
//   - Generator failures NEVER block dashboard reads.
//   - Bounded operator-safe summaries; no raw payloads, no signed URLs.
// =============================================================================

enum OperationalCausalityRelation {
  CAUSED_BY
  FOLLOWED_BY
  ESCALATED_TO
  BLOCKED_BY
  MITIGATED_BY
  RETRIED_BY
  RELATED_TO
  PART_OF
  ROOT_CAUSE_OF
}

enum OperationalCausalityConfidence {
  DIRECT
  INFERRED_HIGH
  INFERRED_MEDIUM
  INFERRED_LOW
}

enum OperationalCausalityChainStatus {
  ACTIVE
  RESOLVED
  SUPPRESSED
}

model OperationalCausalityLink {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  /// Soft links — every column is nullable so a link can connect any two
  /// of (timeline event, incident, workflow, correlation).
  sourceEventId       String? @map("source_event_id") @db.Uuid
  targetEventId       String? @map("target_event_id") @db.Uuid
  sourceIncidentId    String? @map("source_incident_id") @db.Uuid
  targetIncidentId    String? @map("target_incident_id") @db.Uuid
  sourceWorkflowId    String? @map("source_workflow_id") @db.Uuid
  targetWorkflowId    String? @map("target_workflow_id") @db.Uuid
  sourceCorrelationId String? @map("source_correlation_id") @db.Uuid
  targetCorrelationId String? @map("target_correlation_id") @db.Uuid

  relationType OperationalCausalityRelation   @map("relation_type")
