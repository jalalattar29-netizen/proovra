{
  "name": "proovra-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/safe-migrate.mjs deploy",
    "prisma:migrate:dev": "node scripts/safe-migrate.mjs dev",
    "prisma:migrate:status": "node scripts/drift-check.mjs",
    "prisma:migrate:raw": "prisma migrate deploy",
    "db:drift-check": "node scripts/drift-check.mjs",
    "db:risk-scan": "node scripts/migration-risk-scan.mjs",
    "db:diff-guard": "node scripts/db-diff-guard.mjs",
    "db:backfill:orgs": "node scripts/backfill-organizations.mjs",
    "db:backfill:orgs:dry": "node scripts/backfill-organizations.mjs --dry-run",
    "db:backfill:personal-teams": "tsx scripts/backfill-personal-team-ownership.ts",
    "db:backfill:personal-teams:apply": "tsx scripts/backfill-personal-team-ownership.ts --apply --bootstrap-missing",
    "db:check-org-consistency": "node scripts/check-org-consistency.mjs",
    "db:not-null-readiness": "node scripts/not-null-readiness.mjs",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:use-audit-local": "node scripts/prepare-local-env.mjs",
    "repair-tsa-failed-with-token": "node --experimental-specifier-resolution=node dist/scripts/repair-tsa-failed-with-token.js",
    "smoke-evidence-forward-path": "node --experimental-specifier-resolution=node dist/scripts/smoke-evidence-forward-path.js",
    "backfill:search": "node --experimental-specifier-resolution=node dist/scripts/backfill-search-index.js",
    "deploy:safe": "node scripts/deploy-safe.mjs",
    "deploy:safe:dry": "node scripts/deploy-safe.mjs --dry-run",
    "prisma:seed": "tsx src/seed-signing-key.ts",
    "seed:key": "tsx src/seed-signing-key.ts",
    "seed:home-personas": "tsx scripts/seed-home-personas.ts",
    "dev:populate-investigation": "tsx scripts/dev-populate-investigation.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:deps": "pnpm --filter @proovra/shared build && pnpm --filter @proovra/shared-evidence-presentation build && pnpm --filter @proovra/shared-billing build && pnpm --filter @proovra/shared-runtime build",
    "test:integration:prepare": "node scripts/integration-prepare.mjs",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:integration": "pnpm run test:integration:prepare && pnpm run test:integration:run",
    "db:raw-schema-verify": "node scripts/raw-schema-verify.mjs",
    "db:point5-vector-readiness": "node scripts/point5-vector-readiness.mjs",
    "db:migration-inventory": "node scripts/migration-inventory.mjs",
    "db:migration-inventory:write": "node scripts/migration-inventory.mjs --write --git",
    "db:p6-production-snapshot": "node scripts/p6-production-migration-snapshot.mjs",
    "db:p6-reconcile": "node scripts/migration-production-reconcile.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1021.0",
    "@aws-sdk/client-rekognition": "^3.980.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/client-secrets-manager": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@azure-rest/ai-document-intelligence": "^1.0.0",
    "@deepgram/sdk": "^3.9.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.50.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.53.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@proovra/shared": "workspace:*",
    "@proovra/shared-billing": "workspace:*",
    "@proovra/shared-evidence-presentation": "workspace:*",
    "@proovra/shared-runtime": "workspace:*",
    "@sentry/node": "^10.38.0",
    "@sentry/profiling-node": "~10.41.0",
    "@types/nodemailer": "^7.0.9",
    "@xmldom/xmldom": "^0.9.4",
    "archiver": "^7.0.1",
    "bullmq": "^5.52.2",
    "canonicalize": "^2.1.0",
    "dotenv": "^17.3.1",
    "exifr": "^7.1.3",
    "fastify": "^5.7.2",
    "ioredis": "^5.7.0",
    "jose": "^6.1.3",
    "nodemailer": "^8.0.1",
    "openai": "^6.36.0",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "xml-crypto": "^6.0.1",
    "xpath": "^0.0.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^25.1.0",
    "@types/pg": "^8.6.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "testcontainers": "^12.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
