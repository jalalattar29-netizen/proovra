# ============================================================
# services/api/.env.example — Canonical template (placeholders only)
# Last consolidated: Phase 32.7 Final Production Stabilization
#                    (mirrors post-R8.C canonical .env structure)
#
# HARD RULES (also enforced by docs/recovery/MASTER_PHASE_REGISTRY.md
# and `collectStartupViolations()` in src/config/index.ts):
#
#   1. Each variable appears EXACTLY ONCE in this file. The same rule
#      applies to .env — never append new variables at the bottom for
#      updates; edit the existing entry in-place. dotenv takes the
#      FIRST occurrence; appended overrides are silently ignored.
#
#   2. NEVER commit real secrets to version control. .env is in
#      .gitignore; this .env.example uses placeholders only.
#
#   3. Production secrets come from CI/CD or a secrets manager, NOT
#      from a checked-in file.
#
#   4. Startup validation enforces:
#        - DATABASE_URL + AUTH_JWT_SECRET present in production
#        - Feature-gated hash/API secrets present when their feature
#          flag is on
#        - Signing provider consistency (KMS or local-pem)
#        - No localhost SAML ACS URL in production
#        - No localhost S3 endpoint in production (unless
#          S3_ALLOW_INSECURE=true)
#        - STRIPE_SECRET_KEY starts with sk_live_ or sk_test_
#          (publishable pk_* keys are rejected)
#
# ACTIVE PROVIDERS (change to switch backends):
#   Storage : S3_ENDPOINT — local MinIO for dev, S3/R2 for production
#   Signing : SIGNER_PROVIDER=aws-kms (production) or local-pem (dev)
# ============================================================

# ── Core ────────────────────────────────────────────────────
DATABASE_URL=postgresql://dw:dw_password@localhost:5432/dw
DIRECT_URL=
PORT=8081
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=
REDIS_URL=redis://localhost:6379

# ── Application URLs ─────────────────────────────────────────
# WEB_BASE_URL  — public marketing host (www.proovra.com in prod).
# APP_BASE_URL  — authenticated app/admin host (app.proovra.com in prod).
# ADMIN_BASE_URL — optional override read by lead-capture email helpers
#                 when the admin host differs from APP_BASE_URL. If unset,
#                 the email helper falls back through ADMIN_BASE_URL →
#                 APP_BASE_URL → https://app.proovra.com. The marketing
#                 host (WEB_BASE_URL) is NEVER used for admin deep-links.
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8081
NEXT_PUBLIC_WEB_BASE=http://localhost:3000
NEXT_PUBLIC_APP_BASE=http://localhost:3000

# ── Storage — ACTIVE provider ────────────────────────────────
# Local dev (MinIO): http://localhost:9000
# Production (AWS S3 or Cloudflare R2): set to the provider endpoint.
# Startup validator rejects http://localhost in NODE_ENV=production
# unless S3_ALLOW_INSECURE=true is set explicitly.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minio
S3_SECRET_KEY=
S3_BUCKET=dw-evidence
S3_PUBLIC_BASE_URL=
S3_ALLOW_INSECURE=false
S3_FORCE_PATH_STYLE=true

# ── Storage — Reference (R2 production) ──────────────────────
# Reference only. If migrating to Cloudflare R2, set the S3_* vars
# above to these R2 values. The storage subsystem reads S3_*.
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Database backup readiness (honest posture metadata) ──────
# The app carries NO automated DB backup — backups are the managed
# database platform's responsibility. These OPTIONAL fields let an
# operator DECLARE the managed-backup posture so GET /v1/operations/readiness
# can report it honestly. They are labels/URLs/timestamps only — never
# secrets, never a connection string. If a *_LAST_VERIFIED_AT or
# _RESTORE_TESTED_AT is missing, readiness reports "launch action required"
# (it will NOT show green). Timestamps must be ISO-8601.
DATABASE_BACKUP_PROVIDER=
DATABASE_BACKUP_POLICY_URL=
DATABASE_BACKUP_LAST_VERIFIED_AT=
DATABASE_RESTORE_TESTED_AT=

# ── Object Lock (S3 immutable storage) ───────────────────────
S3_OBJECT_LOCK_ENABLED=false
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_OBJECT_LOCK_RETAIN_DAYS=365
# LEGACY AND INERT. Nothing reads this into an S3 request; native S3 Object Lock
# legal hold is NOT implemented (PROOVRA enforces legal hold in the application,
# via EvidenceLegalHold). OFF and unset both do nothing. ON is REFUSED at
# startup: it would once have placed native holds this codebase cannot release,
# because no S3 VersionId is persisted and there is no release path.
S3_OBJECT_LOCK_LEGAL_HOLD=OFF
S3_ENABLE_OBJECT_TAGGING=false
IMMUTABLE_STORAGE_RECONCILIATION_ENABLED=false
IMMUTABLE_STORAGE_RECONCILIATION_INTERVAL_MS=1800000
IMMUTABLE_STORAGE_DRIFT_ALERTS_ENABLED=false

# ── Signing — ACTIVE provider ─────────────────────────────────
# SIGNER_PROVIDER selects the signing backend:
#   aws-kms   — production; uses KMS_KEY_ID
#   local-pem — development; uses SIGNING_PRIVATE_KEY_PATH
#
# SIGNING_KEY_ID is a metadata label stored on signature records (not
# used for crypto). Do not change without a coordinated DB migration.
SIGNER_PROVIDER=local-pem
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=
SIGNING_KEY_ID=dw_ed25519
SIGNING_KEY_VERSION=1
SIGNING_PRIVATE_KEY_PATH=keys/signing-private.pem
SIGNING_PUBLIC_KEY_PATH=keys/signing-public.pem

# ── Package Signing (verification package worker) ────────────
PACKAGE_SIGNING_KEY_ID=proovra_package_ed25519
PACKAGE_SIGNING_KEY_VERSION=1
PACKAGE_SIGNING_PRIVATE_KEY_PATH=keys/signing-private.pem
PACKAGE_SIGNING_PUBLIC_KEY_PATH=keys/signing-public.pem

# ── Authentication (JWT) ──────────────────────────────────────
# Required in production. Min 32 chars recommended.
AUTH_JWT_SECRET=

# ── OAuth (Google) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── OAuth (Apple) ─────────────────────────────────────────────
APPLE_CLIENT_ID=com.proovra.web
APPLE_REDIRECT_URI=http://localhost:3000/auth/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── SAML / SSO / SCIM ────────────────────────────────────────
# Canonical production URLs MUST NOT be localhost in production.
# Startup validator enforces this when SAML_ENABLED=true and
# NODE_ENV=production.
SAML_ENABLED=false
SAML_TEST_MODE_ENABLED=false
SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=
SAML_METADATA_URL=
SAML_DEFAULT_NAME_ID_FORMAT=emailAddress
SAML_REQUIRE_SIGNED_ASSERTIONS=true
SAML_SIGN_AUTHN_REQUESTS=false
SAML_CLOCK_SKEW_SECONDS=120
SAML_AUTHN_REQUEST_TTL_MINUTES=10
SAML_LIVE_IDP_VALIDATION_ENABLED=false
SSO_ENABLED=false
SSO_CALLBACKS_ENABLED=false
SSO_CALLBACK_REDIRECT_URI=
SSO_ALLOWED_REDIRECT_HOSTS=
SSO_STATE_TTL_MINUTES=10
SSO_JIT_PROVISIONING_ENABLED=false
SSO_DISCOVERY_CACHE_MINUTES=60
SSO_COOKIE_DOMAIN=
SSO_COOKIE_SECURE=true
SCIM_ENABLED=false
SCIM_TOKEN_TTL_DAYS=365
SCIM_MAX_PAGE_SIZE=200
SCIM_GROUP_SYNC_ENABLED=false

# ── Identity Security & MFA ───────────────────────────────────
# Feature-gated: when IDENTITY_SECURITY_ENABLED=true, the
# IDENTITY_SECURITY_HASH_SECRET must be set or startup fails.
IDENTITY_SECURITY_ENABLED=false
IDENTITY_SECURITY_HASH_SECRET=
IDENTITY_SECURITY_CRON_SECRET=
IDENTITY_RECONCILE_CRON_SECRET=
SECURITY_CENTER_ENABLED=false
MFA_DEFAULT_REQUIRED_FOR_ADMINS=false
MFA_DEFAULT_REQUIRED_FOR_REVIEWERS=false
MFA_RECOVERY_ENABLED=false
MFA_DIGEST_ENABLED=false
MFA_SESSION_VISIBILITY_ENABLED=false
MFA_ENFORCEMENT_FAIL_MODE=smart
STEP_UP_SESSION_TTL_MINUTES=15
TRUSTED_DEVICE_TTL_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=10

# ── Session Governance ────────────────────────────────────────
SESSION_GOVERNANCE_ENABLED=false
SESSION_INVENTORY_ENABLED=false
SESSION_REPLAY_PROTECTION_ENABLED=false
SESSION_QUARANTINE_ENABLED=false
SUSPICIOUS_SESSION_DETECTION_ENABLED=false
HIGH_RISK_SESSION_GOVERNANCE_ENABLED=false
SESSION_HEARTBEAT_ENABLED=false
SESSION_HEARTBEAT_MINUTES=5
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_HTTP_ONLY=true

# ── RBAC & Privilege Elevation ────────────────────────────────
ENTERPRISE_RBAC_ENABLED=false
RBAC_TEMP_ELEVATION_ENABLED=false
RBAC_TEMP_ELEVATION_DEFAULT_MINUTES=30
RBAC_TEMP_ELEVATION_MAX_MINUTES=240
ACCESS_REVIEWS_ENABLED=false
SERVICE_ACCOUNT_GOVERNANCE_ENABLED=false

# ── Adaptive Auth & Geo-Intelligence ─────────────────────────
ADAPTIVE_AUTH_ENABLED=false
ADAPTIVE_AUTH_RUNTIME_ENABLED=false
GEO_INTELLIGENCE_ENABLED=false
GEO_PROVIDER=maxmind
GEO_LOOKUP_TIMEOUT_MS=1500
GEO_CACHE_TTL_DAYS=30

# ── Communications (Twilio) ───────────────────────────────────
# Feature-gated: when COMMUNICATIONS_ENABLED=true, the
# COMMUNICATIONS_RECIPIENT_HASH_SECRET must be set.
COMMUNICATIONS_ENABLED=false
COMMUNICATIONS_RECIPIENT_HASH_SECRET=
COMMUNICATIONS_DEFAULT_CHANNEL=sms
COMMUNICATIONS_MAX_SENDS_PER_RECIPIENT_PER_DAY=10
COMMUNICATIONS_MAX_SENDS_PER_TEAM_PER_DAY=500
COMMUNICATIONS_RETRY_MAX_ATTEMPTS=5
COMMUNICATIONS_RETRY_BASE_SECONDS=60
COMMUNICATIONS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Email & Notifications ─────────────────────────────────────
NOTIFICATIONS_ENABLED=false
NOTIFICATION_REMINDERS_ENABLED=false
NOTIFICATION_REMINDER_INTERVAL_HOURS=24
NOTIFICATION_CRON_SECRET=
EMAIL_FROM="Proovra <no-reply@example.com>"
EMAIL_FROM_NAME=Proovra
EMAIL_BRAND_NAME=Proovra
EMAIL_LOGO_URL=
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=
# SMTP for local dev (mailhog); production uses Resend.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ── Marketing lead notification routing ───────────────────────
# Email used for ALL lead notifications unless a specific
# override below is set. Falls back to SUPPORT_EMAIL, then
# support@proovra.com.
DEMO_REQUEST_NOTIFICATION_EMAIL=
# Optional Contact Sales-specific routing. Resolution order:
#   CONTACT_SALES_NOTIFICATION_EMAIL
#     → DEMO_REQUEST_NOTIFICATION_EMAIL
#     → SUPPORT_EMAIL
#     → support@proovra.com
CONTACT_SALES_NOTIFICATION_EMAIL=
# Toggle visitor auto-replies. Default "true". Set to "false"
# to operate the inbox silently.
DEMO_REQUEST_AUTO_REPLY_ENABLED=true
CONTACT_SALES_AUTO_REPLY_ENABLED=true
# Optional generic webhooks (Slack, ops queue, etc.) that
# receive the full normalised lead payload alongside the email.
# Signature header uses sha256(secret + "." + body).
DEMO_REQUEST_WEBHOOK_URL=
DEMO_REQUEST_WEBHOOK_SECRET=
CONTACT_SALES_WEBHOOK_URL=
CONTACT_SALES_WEBHOOK_SECRET=

# ── Integrations ──────────────────────────────────────────────
# Feature-gated: when INTEGRATIONS_ENABLED=true, API_KEY_SECRET
# must be set or startup fails.
INTEGRATIONS_ENABLED=false
API_KEY_SECRET=
INTEGRATION_CRON_SECRET=

# ── External Intake (workflow intake links) ───────────────────
# Feature-gated: when WORKFLOW_INTAKE_LINKS_ENABLED=true,
# WORKFLOW_INTAKE_TOKEN_SECRET must be set (>=32 chars; hex,
# base64, or UTF-8). Secret is used for HMAC-SHA256 hashing of
# external contributor tokens stored in the database — protects
# against token-table theft. Both must be set or the /intake-links
# UI renders the "Configuration required" panel and the API
# responds 503 FEATURE_DISABLED to /v1/workflows/intake-links*.
WORKFLOW_INTAKE_LINKS_ENABLED=false
WORKFLOW_INTAKE_TOKEN_SECRET=

# ── AI & Intelligence ─────────────────────────────────────────
OPENAI_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_CAPTURE_MODEL=
OPENAI_INTELLIGENCE_MODEL=
AI_MAX_CHAT_MESSAGES_PER_USER_PER_DAY=100
AI_MAX_CAPTURE_ANALYSES_PER_EVIDENCE=25
AI_MONTHLY_BUDGET_EUR=300

# ── Billing (Stripe) ──────────────────────────────────────────
# STRIPE_SECRET_KEY must start with `sk_live_` (production) or
# `sk_test_` (test). The startup validator rejects publishable
# keys (pk_*) — pasting a pk_ key in the secret slot is a common
# mistake we catch loudly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# BILLING PERSONAL/ORGANIZATION MODEL (2026-08-28) — these names were WRONG.
#
# Six variables were documented here and NONE of them is read by anything.
# The resolver takes a plan AND a currency, so every name it reads carries a
# currency suffix, and the amounts are read under a `BILLING_` prefix rather
# than `STRIPE_` because an amount is the product's price whoever collects it:
#
#   ids     getStripePlanPriceId  -> STRIPE_<PLAN>_PRICE_ID_<CURRENCY>
#   amounts getPlanPriceCents     -> BILLING_<PLAN>_PRICE_CENTS_<CURRENCY>
#
# (services/api/src/services/billing-pricing.service.ts — the ONE price
# authority; the names are pinned by pricing-hardening-canonical-contract.)
#
# An operator following the old list configured six variables that did nothing.
# That was survivable while a price id was optional: Stripe CHECKOUT falls back
# to an inline `price_data` built from the amounts below, so a purchase still
# worked. It stopped being survivable when plans became changeable — a Stripe
# subscription ITEM update cannot take inline price data, so an upgrade on a
# subscription with no configured price id refuses with
# PLAN_CHANGE_NOT_AVAILABLE rather than opening a second subscription.
#
# CONSEQUENCE WORTH KNOWING: a subscription SOLD while these were unset carries
# an inline price, and cannot be upgraded later until they are set. Set them
# before selling, not after.

# Stripe Price object ids (price_...). Required for PRO <-> TEAM plan changes.
STRIPE_PRO_PRICE_ID_EUR=
STRIPE_PRO_PRICE_ID_USD=
STRIPE_TEAM_PRICE_ID_EUR=
STRIPE_TEAM_PRICE_ID_USD=
# PAYG is the legacy one-time evidence-credit product. Not a plan, and never a
# plan change — it is listed because the same resolver serves it.
STRIPE_PAYG_PRICE_ID_EUR=
STRIPE_PAYG_PRICE_ID_USD=

# Published amounts, in minor units. Each has a catalog default, so leaving one
# unset publishes the approved price rather than zero.
BILLING_PRO_PRICE_CENTS_EUR=
BILLING_PRO_PRICE_CENTS_USD=
BILLING_TEAM_PRICE_CENTS_EUR=
BILLING_TEAM_PRICE_CENTS_USD=
BILLING_PAYG_PRICE_CENTS_EUR=
BILLING_PAYG_PRICE_CENTS_USD=

# ── Billing (PayPal) ──────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ── Search ─────────────────────────────────────────────────────
SEARCH_ENGINE_ENABLED=true
SEARCH_MAX_RESULTS=100
SEARCH_DEFAULT_RESULTS=25
SEARCH_INDEXING_ENABLED=true
SEARCH_RELATIONSHIP_GRAPH_ENABLED=true
SEARCH_SAVED_VIEWS_ENABLED=true
SEARCH_AUDIT_LOGGING_ENABLED=true
SEARCH_MAX_QUERY_LENGTH=200
SEARCH_DEFAULT_LIMIT=25
SEARCH_MAX_LIMIT=100

# ── Semantic Search (Phase 15) ────────────────────────────────
# Privacy-safe, OFF by default. The /search page chip flips to
# "available" only when SEMANTIC_SEARCH_ENABLED=true AND a real
# provider is configured. The "_SEND_CONTENT_OUTBOUND" gate is
# the explicit operator opt-in for sending chunk text to an
# external embeddings vendor — without it, only the local
# deterministic provider is permitted.
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_EMBEDDINGS_PROVIDER=disabled
SEMANTIC_EMBEDDINGS_SEND_CONTENT_OUTBOUND=false
SEMANTIC_EMBEDDING_MODEL=
SEMANTIC_EMBEDDING_DIMENSIONS=1536
# Hybrid ranker blend (must sum to 1.0). Defaults applied if unset.
SEMANTIC_HYBRID_KEYWORD_WEIGHT=0.6
SEMANTIC_HYBRID_SEMANTIC_WEIGHT=0.4

# ── Semantic Search activation (Phase 16) ─────────────────────
# Real OpenAI provider tuning. The dual gate stays in force —
# SEMANTIC_SEARCH_ENABLED=true AND SEMANTIC_EMBEDDINGS_PROVIDER=openai
# AND SEMANTIC_EMBEDDINGS_SEND_CONTENT_OUTBOUND=true AND a non-empty
# OPENAI_API_KEY are ALL required before chunk text is sent outbound.
SEMANTIC_EMBEDDINGS_TIMEOUT_MS=30000
SEMANTIC_EMBEDDINGS_BATCH_SIZE=96
SEMANTIC_EMBEDDINGS_MAX_ATTEMPTS=3

# Per-workspace daily chunk cap + monthly EUR ceiling. Recorded in
# semantic_usage_daily; consulted before every outbound batch.
SEMANTIC_MAX_CHUNKS_PER_WORKSPACE_PER_DAY=5000
SEMANTIC_MONTHLY_BUDGET_EUR=100

# Cost-estimation knobs (text-embedding-3-small defaults). Operators
# tune these when provider pricing or FX rates change.
SEMANTIC_USD_PER_TOKEN=0.00000002
SEMANTIC_EUR_PER_USD=0.92

# ── Limits ────────────────────────────────────────────────────
FREE_EVIDENCE_LIMIT=3
MAX_EVIDENCE_SIZE_MB=1024
