{
  "name": "proovra-worker",
  "version": "1.0.0",
  "description": "Proovra background worker",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run build:deps",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "test": "vitest run",
    "repair-ots-hybrid": "node --experimental-specifier-resolution=node dist/scripts/repair-ots-hybrid-state.js",
    "diagnose-ots-evidence": "node --experimental-specifier-resolution=node dist/scripts/diagnose-ots-evidence.js",
    "smoke-ots-retry-state": "node --experimental-specifier-resolution=node dist/scripts/smoke-ots-retry-state.js",
    "destruction-candidates": "node --experimental-specifier-resolution=node dist/scripts/destruction-candidates.js",
    "build:deps": "pnpm -w run prisma:generate && pnpm --filter @proovra/shared build && pnpm --filter @proovra/shared-evidence-presentation build && pnpm --filter @proovra/shared-billing build && pnpm --filter @proovra/shared-runtime build",
    "pretypecheck": "pnpm run build:deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1021.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@napi-rs/canvas": "^0.1.99",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.50.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.53.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@proovra/shared": "workspace:*",
    "@proovra/shared-billing": "workspace:*",
    "@proovra/shared-evidence-presentation": "workspace:*",
    "@proovra/shared-runtime": "workspace:*",
    "@sentry/node": "^10.38.0",
    "@sentry/profiling-node": "~10.41.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.52.2",
    "fastify": "^5.7.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.7.0",
    "openai": "^6.36.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pdfkit": "^0.15.2",
    "pg": "^8.18.0",
    "pino": "^9.7.0",
    "puppeteer": "^24.41.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/archiver": "^6.0.4",
    "@types/node": "^25.1.0",
    "@types/pdfkit": "^0.13.3",
    "@types/pg": "^8.6.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
