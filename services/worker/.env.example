DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
REDIS_URL=redis://<host>:6379

S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=proovra-prod-assets
# Optional: set to CDN/base URL if used
S3_PUBLIC_BASE_URL=
# Set true for local MinIO over http
S3_ALLOW_INSECURE=false
# REQUIRED in production (AUD-010) — the same retention contract as the API:
# Object Lock on, COMPLIANCE, RETAIN_DAYS unset or >= 2920. The worker refuses
# to start in production otherwise.
S3_OBJECT_LOCK_ENABLED=true
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_RETAIN_DAYS=2920

WORKER_BUILD_INFO=local
WORKER_PORT=8090
LOG_LEVEL=info

# Package signer. Production should use aws-kms, or mount a non-repository PEM
# pair and select local-pem. The worker validates the signer before consuming
# report/package jobs.
SIGNER_PROVIDER=local-pem
KMS_KEY_ID=
SIGNING_KEY_ID=fixture-local-only-signing-key
SIGNING_KEY_VERSION=1
SIGNING_PRIVATE_KEY_PATH=../api/keys/signing-private.pem
SIGNING_PUBLIC_KEY_PATH=../api/keys/signing-public.pem
PACKAGE_SIGNING_KEY_ID=fixture-local-only-package-key
PACKAGE_SIGNING_KEY_VERSION=1
PACKAGE_SIGNING_PRIVATE_KEY_PATH=../api/keys/signing-private.pem
PACKAGE_SIGNING_PUBLIC_KEY_PATH=../api/keys/signing-public.pem

# -----------------------------------------------------------------------------
# Phase O1.1 — OpenTelemetry runtime wiring.
#
# In production the api and worker share the same `.env` for endpoint /
# protocol / headers; the bounded `OTEL_SERVICE_NAME` is pinned per
# container in `infra/docker/docker-compose.prod.yml` so each service
# reports a distinct name to Grafana.
#
# NEVER commit the actual Grafana token to git. The token lives only in
# the production `.env` (or AWS Secrets Manager) and rotates separately.
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=proovra,deployment.environment=development
LOG_AGGREGATION_ENABLED=false

# -----------------------------------------------------------------------------
# Independent Bitcoin verification of OpenTimestamps proofs (worker only).
#
# OFF by default. When enabled, the worker checks each ANCHORED proof's merkle
# root against the block header returned by a Bitcoin Core node
# (getblockhash / getblockheader only; a pruned node without txindex is fine).
# Placeholders only — NEVER commit a real URL, user or password. The URL must
# not carry credentials (userinfo is rejected).
#
# LOCAL DEVELOPMENT ONLY as written here. In production these settings live in
# the worker-only /opt/proovra/app/secrets/bitcoin-rpc/verifier.env (template:
# infra/docker/bitcoin-verifier.env.example), NEVER in the shared .env that
# also reaches the API, and the password is ONLY the read-only mounted file
# /run/proovra/bitcoin-rpc/password — the worker refuses OTS_BITCOIN_RPC_PASSWORD
# as an environment variable when NODE_ENV=production.
# -----------------------------------------------------------------------------
OTS_BITCOIN_VERIFY_ENABLED=false
OTS_BITCOIN_RPC_URL=http://127.0.0.1:8332
OTS_BITCOIN_RPC_USERNAME=proovra-verifier
OTS_BITCOIN_RPC_PASSWORD=
OTS_BITCOIN_RPC_PASSWORD_FILE=
OTS_BITCOIN_EXPECTED_CHAIN=main
OTS_BITCOIN_RPC_TIMEOUT_MS=5000
OTS_BITCOIN_MIN_CONFIRMATIONS=6
OTS_BITCOIN_MAX_TIP_AGE_SECONDS=7200
OTS_BITCOIN_MAX_HEADER_LAG=2
OTS_BITCOIN_MIN_NODE_VERSION=270000
