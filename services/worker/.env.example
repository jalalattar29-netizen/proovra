DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
REDIS_URL=redis://<host>:6379

S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=proovra-prod-assets
# Optional: set to CDN/base URL if used
S3_PUBLIC_BASE_URL=
# Set true for local MinIO over http
S3_ALLOW_INSECURE=false

WORKER_BUILD_INFO=local
WORKER_PORT=8090
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Phase O1.1 — OpenTelemetry runtime wiring.
#
# In production the api and worker share the same `.env` for endpoint /
# protocol / headers; the bounded `OTEL_SERVICE_NAME` is pinned per
# container in `infra/docker/docker-compose.prod.yml` so each service
# reports a distinct name to Grafana.
#
# NEVER commit the actual Grafana token to git. The token lives only in
# the production `.env` (or AWS Secrets Manager) and rotates separately.
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=proovra,deployment.environment=development
LOG_AGGREGATION_ENABLED=false
