{
  "//": "Typechecks the Playwright specs: pnpm typecheck:e2e. pg is a dependency of services/api, which the point7 harness opens directly; its types resolve from there instead of a second copy at the root. Everything under exclude did not typecheck when this config was added (2026-11-03) and is excluded as known debt, with the specs that import it; it is not excluded because it passes.",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "types": [
      "node"
    ],
    "paths": {
      "pg": [
        "services/api/node_modules/@types/pg"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../apps/web/e2e/**/*.ts"
  ],
  "exclude": [
    "search-layout/**",
    "updated-report/**",
    "operations-layout/**",
    "intake-links-layout/kpi-tones.spec.ts",
    "artifact-recovery-fullstack.spec.ts",
    "helpers/wait-for-worker.ts",
    "investigation-enterprise-data-flow.spec.ts",
    "../apps/web/e2e/admin-control-plane/admin-token-authority.spec.ts",
    "../apps/web/e2e/admin-control-plane/admin-states.spec.ts",
    "**/*.local.*"
  ]
}
