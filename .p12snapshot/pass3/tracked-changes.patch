+  candidate: unknown,
+  expected: { workspaceId: string; userId?: string },
+): Promise<AuthorizedWorkspaceContext> {
+  const ctx = assertMintedAuthorizedWorkspaceContext(candidate, expected);
+  const binding = AUTHORIZED_CONTEXT_BINDINGS.get(ctx)!;
