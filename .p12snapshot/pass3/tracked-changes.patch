@@ -10894,6 +10894,14 @@ model ExternalReviewInvitationDelivery {
 
   grant ExternalReviewerRoleAssignment @relation(fields: [grantId], references: [id], onDelete: Cascade)
 
+  // PHASE 12 CORRECTIVE PASS §1.1 (2026-08-06) — ONE INTENT PER ATTEMPT.
+  // The provider idempotency key is derived from this row's id, so a second
+  // row for the same logical send is a second message to a human. `attempt`
+  // is 1 for every ordinary send and increments only for a deliberate resend,
+  // which is what lets repeats collapse while a resend stays distinct.
+  // Enforced in the database because check-then-insert cannot survive a race.
+  // See migration 20271120000000_external_review_delivery_intent_idempotency.
+  @@unique([teamId, grantId, attempt], map: "external_review_invitation_deliveries_grant_attempt_key")
