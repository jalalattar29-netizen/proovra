# =============================================================================
# Phase 2.5F — Safe local-development env example.
#
# Copy this file to `services/api/.env` (or `.env` at repo root) BEFORE
# running any migration or starting the API locally. The default
# `services/api/.env` shipped by the team historically carried a
# production-like Neon DATABASE_URL — fresh checkouts MUST replace it
# with this safe local file.
#
# Two ways to use this file:
#
#   Option A — copy to services/api/.env (overwrites; recommended for
#              developers who want to work against local docker DB
#              exclusively).
#
#     cp .env.audit-local.example services/api/.env
#
#   Option B — copy to .env.audit-local at repo root (gitignored;
#              tools like `tsx --env-file` can opt in to it
#              explicitly).
#
#     cp .env.audit-local.example .env.audit-local
#
# Verify after copy:
#
#     pnpm --filter proovra-api db:preflight
#
#   The preflight aggregator will print classification=LOCAL and
#   exit 0 if this file is wired correctly.
#
# Why this file exists:
#   Phase 2.5B incident — `prisma migrate` fired against Neon because
#   `services/api/.env` carried the production-like DATABASE_URL by
#   default. Phase 2.5C/D/E added wrapper + in-process hook +
#   preflight to refuse, but the fresh-clone surface still inherits
#   the dangerous default. This example file is the structural fix:
#   ship a safe default that operators copy intentionally.
# =============================================================================

# --- Database --------------------------------------------------------------
# Points at the local docker postgres (proovra_postgres container). The
# Phase 2.5C/D/E guards classify this host as LOCAL and allow migrations.
DATABASE_URL=postgresql://audit:audit_local_password@localhost:5432/proovra_audit
DIRECT_URL=postgresql://audit:audit_local_password@localhost:5432/proovra_audit
SHADOW_DATABASE_URL=postgresql://audit:audit_local_password@localhost:5432/proovra_audit_shadow

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage --------------------------------------------------------
# Local MinIO from `infra/docker/docker-compose.full.yml`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_password
S3_BUCKET=proovra-audit-bucket
S3_PUBLIC_BASE_URL=
S3_ALLOW_INSECURE=true
S3_FORCE_PATH_STYLE=true
S3_OBJECT_LOCK_ENABLED=false
OBJECT_LOCK_VERIFICATION_BYPASS=true

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=8081
WORKER_PORT=8090
LOG_LEVEL=info
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8081
NEXT_PUBLIC_WEB_BASE=http://localhost:3000
NEXT_PUBLIC_APP_BASE=http://localhost:3000
CORS_ORIGINS=

# --- Auth & signing -------------------------------------------------------
# This JWT secret is INTENTIONALLY INSECURE — it's an audit-only value
# that must never appear in any non-local env. The string is long enough
# to satisfy the runtime validator's 32+-char minimum.
AUTH_JWT_SECRET=audit_local_jwt_secret_do_not_use_in_prod_0123456789abcdef0123456789

SIGNER_PROVIDER=local-pem
SIGNING_KEY_ID=audit_local_ed25519
SIGNING_KEY_VERSION=1
SIGNING_PRIVATE_KEY_PATH=services/api/keys/signing-private.pem
SIGNING_PUBLIC_KEY_PATH=services/api/keys/signing-public.pem
PACKAGE_SIGNING_KEY_ID=audit_local_package_ed25519
PACKAGE_SIGNING_KEY_VERSION=1
PACKAGE_SIGNING_PRIVATE_KEY_PATH=services/api/keys/signing-private.pem
PACKAGE_SIGNING_PUBLIC_KEY_PATH=services/api/keys/signing-public.pem

# --- Schema validation ---------------------------------------------------
# Keep on — the validator's fail-fast is part of how the Phase 0
# reproducibility guarantee survives drift.
SCHEMA_VALIDATION_FAIL_FAST=true

# --- Phase 1 rate limits (defaults are fine; override only for tests) ---
VERIFY_RATE_LIMIT_MAX=60
VERIFY_RATE_LIMIT_WINDOW_SEC=60

# --- Phase 2.5C/D/E migration guards ------------------------------------
# These are not required to be SET for local work — they default to safe
# behavior. They are listed here only as a reminder of the toggles.
#
# MIGRATE_ALLOW_REMOTE=1            — required to migrate non-local
# MIGRATE_BACKUP_ID=<snapshot-id>   — required for any remote migration
# PRISMA_BYPASS_SAFETY=1            — DO NOT SET; emergency only
# PRELIGHT_SKIP_DRIFT=1             — CI-only signal
