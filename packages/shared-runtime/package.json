{
  "name": "@proovra/shared-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./media-intelligence": {
      "types": "./dist/media-intelligence/index.d.ts",
      "import": "./dist/media-intelligence/index.js",
      "default": "./dist/media-intelligence/index.js"
    },
    "./technical-metadata": {
      "types": "./dist/technical-metadata/index.d.ts",
      "import": "./dist/technical-metadata/index.js",
      "default": "./dist/technical-metadata/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "default": "./dist/graph/index.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js",
      "default": "./dist/ops/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "default": "./dist/notifications/index.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js",
      "default": "./dist/reports/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "typecheck": "pnpm exec tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1055.0",
    "@prisma/client": "^7.3.0",
    "@proovra/shared": "workspace:*",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
  }
}
