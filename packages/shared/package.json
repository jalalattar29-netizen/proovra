      "default": "./dist/zod-runtime-config.js"
    },
    "./tile-endpoint-policy": {
      "types": "./dist/tile-endpoint-policy.d.ts",
      "import": "./dist/tile-endpoint-policy.js",
      "default": "./dist/tile-endpoint-policy.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^25.1.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
  }
}
