{
  "name": "@proovra/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./custody-hash": {
      "types": "./dist/custody-hash.d.ts",
      "import": "./dist/custody-hash.js",
      "default": "./dist/custody-hash.js"
    },
    "./password-rules": {
      "types": "./dist/password-rules.d.ts",
      "import": "./dist/password-rules.js",
      "default": "./dist/password-rules.js"
    },
    "./telemetry-scrub": {
      "types": "./dist/telemetry-scrub.d.ts",
      "import": "./dist/telemetry-scrub.js",
      "default": "./dist/telemetry-scrub.js"
    },
    "./legal": {
      "types": "./dist/legal.d.ts",
      "import": "./dist/legal.js",
      "default": "./dist/legal.js"
    },
    "./user-facing-errors": {
      "types": "./dist/user-facing-errors.d.ts",
      "import": "./dist/user-facing-errors.js",
      "default": "./dist/user-facing-errors.js"
    },
    "./legal-revisions": {
      "types": "./dist/legal/revisions.generated.d.ts",
      "import": "./dist/legal/revisions.generated.js",
      "default": "./dist/legal/revisions.generated.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./zod-runtime-config": {
      "types": "./dist/zod-runtime-config.d.ts",
