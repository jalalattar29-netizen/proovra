node_modules
.env
.env.*
!.env.example
# Phase 2.5F — ship safe-default example env files for fresh checkouts.
# The corresponding non-example files (.env.audit-local etc.) stay
# gitignored because they carry actual credentials.
!.env.audit-local.example
!.env.staging.example
!.env.production.example

dist
build
.next
coverage
*.log

# Phase CASES-EVIDENCE-NAMES-ROOT-CAUSE — TypeScript packages must
# never have compiled .js / .js.map artifacts inside `src/`. The
# build outputs belong in `dist/` (already ignored above). When a
# stale `src/**/*.js` shadow exists next to a `.ts` source, Node's
# ESM resolver loads the .js literally (imports use explicit `.js`
# extensions per Node ESM rules) and silently ignores the .ts. That
# is exactly how the matter-workspace "Untitled evidence" fix went
# live without effect — a stale matter-workspace.service.js from
# 2026-06-03 shadowed every subsequent .ts edit. Pinned by
# `apps/web/__tests__/no-shadow-js-in-src.test.ts`.
services/api/src/**/*.js
services/api/src/**/*.js.map
services/worker/src/**/*.js
services/worker/src/**/*.js.map

# prisma
services/**/prisma/migrations

# flutter
apps/mobile/build
apps/mobile/.dart_tool
apps/mobile/.expo

.DS_Store
Thumbs.db
_tmp_*
_tmp_report.pdf

# TypeScript incremental build artifacts — produced by tsc + Next.js
# typecheck. They are per-environment cache files; committing them
# causes spurious diff churn and rebase conflicts.
*.tsbuildinfo

# Playwright + vitest run artifacts — produced fresh on every run.
# Never intentionally tracked.
test-results/
playwright-report/

# allow API prisma migrations to be committed (required for dev/CI)
!services/api/prisma/migrations/
!services/api/prisma/migrations/**
.claude/

# PHASE 12 — POINT 8: wave-bounded migration staging.
#
# `scripts/release-deploy.mjs` materialises the migrations one release wave may
# apply into this directory and points Prisma at it. It must live INSIDE the
# package so the generated `prisma.config.ts` can resolve `prisma/config`, and
# it is disposable output, never source.
services/api/.p8-release-wave/

# PHASE 12 — POINT 7: scratch directory for the product/canary proof run.
#
# Every path under here is written by a gate while it runs — the isolation
# canary generates `canary-*.mjs` on the fly (services/api/test/setup/
# isolation-canary.mjs), the closure gate writes `gate-fixtures/*.jsonl`
# (services/api/test/phase-12-point7-closure-gate.test.ts), and the point7
# harness records the browser/network/email ledgers (e2e/point7/_harness.ts).
# It is reproducible output, never source, and must not enter a release commit.
.p7tmp/

# PHASE 12 — POINT 5: raw vitest JSON reporter output for the worker suite.
#
# This is the transient INPUT to `services/worker/scripts/build-test-census.mjs`;
# the durable artifact it produces is `docs/architecture/worker-test-census.json`,
# which IS tracked. The raw report is regenerated by re-running the suite.
services/worker/worker-report.json
