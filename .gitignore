node_modules
.env
.env.*
!.env.example
# Phase 2.5F — ship safe-default example env files for fresh checkouts.
# The corresponding non-example files (.env.audit-local etc.) stay
# gitignored because they carry actual credentials.
!.env.audit-local.example
!.env.staging.example
!.env.production.example

dist
build
.next
coverage
*.log

# prisma
services/**/prisma/migrations

# flutter
apps/mobile/build
apps/mobile/.dart_tool
apps/mobile/.expo

.DS_Store
Thumbs.db
_tmp_*
_tmp_report.pdf

# TypeScript incremental build artifacts — produced by tsc + Next.js
# typecheck. They are per-environment cache files; committing them
# causes spurious diff churn and rebase conflicts.
*.tsbuildinfo

# Playwright + vitest run artifacts — produced fresh on every run.
# Never intentionally tracked.
test-results/
playwright-report/

# allow API prisma migrations to be committed (required for dev/CI)
!services/api/prisma/migrations/
!services/api/prisma/migrations/**
.claude/
